#!/usr/bin/env bash
# Vis Agent launcher — the stable command users install.
#
# This wrapper is always the public executable. It selects either the native
# runtime or live JVM source while preserving the user's invocation directory.
# The GraalVM executable is an implementation detail and is never installed as
# the public command.
#
# Install it with `bin/install-vis-agent`: that script installs this wrapper
# first, then calls `vis-agent update --native` so the wrapper downloads its own
# private runtime. `bin/install-source` is the same wrapper with a JVM source
# runtime. Both expose `vis-agent` from any working directory.

set -euo pipefail

invocation_cwd="$PWD"

# Resolve this script through symlinks. A source checkout has deps.edn one level
# above bin/. A release bundle puts this wrapper beside vis-agent-native and may
# use a separate source checkout only when the JVM runtime is selected.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ "$src" != /* ]] && src="$dir/$src"
done
bin_dir="$(cd -P "$(dirname "$src")" && pwd)"
launcher_parent="$(cd -P "$bin_dir/.." && pwd)"
launcher_is_checkout=0
vis_home="${VIS_HOME:-$HOME/.vis}"
source_dir_file="$vis_home/source-dir"
if [[ -f "$launcher_parent/deps.edn" ]]; then
  launcher_is_checkout=1
  repo_root="$launcher_parent"
elif [[ -n "${VIS_SOURCE_DIR:-}" ]]; then
  repo_root="$VIS_SOURCE_DIR"
elif [[ -f "$source_dir_file" ]]; then
  repo_root="$(cat "$source_dir_file" 2>/dev/null || true)"
  [[ -n "$repo_root" ]] || repo_root="$HOME/.vis/sourcecode"
else
  repo_root="$HOME/.vis/sourcecode"
fi
bundled_native="$bin_dir/vis-agent-native"

# ── Runtime selection inputs ─────────────────────────────────────────────────
# Vis follows releases by default: the published native runtime, or JVM source
# pinned to the newest release tag. `dev` is the opt-in mode — and the only mode
# that follows a live, moving checkout. A one-launch flag wins over VIS_RUNTIME,
# which wins over the persisted default in ~/.vis/runtime.
runtime_file="$vis_home/runtime"
dev_checkout="${VIS_DEV_CHECKOUT:-$HOME/vis}"

dist=""   # "" = configured/automatic; else "jvm" | "native" | "dev"
jfr=0
args=()
update_cmd=0
if [[ "${1:-}" == "update" ]]; then
  update_cmd=1
fi
for arg in "$@"; do
  case "$arg" in
    --measure)        export VIS_MEASURE=1 ;;
    --jfr)            jfr=1 ;;
    # `update` owns these words too — there they say WHAT to update — so they are
    # kept in the argument list for that subcommand instead of being consumed.
    --source|--jvm)
      dist="jvm"
      if (( update_cmd )); then args+=("$arg"); fi
      ;;
    --native)
      dist="native"
      if (( update_cmd )); then args+=("$arg"); fi
      ;;
    --dev)
      dist="dev"
      if (( update_cmd )); then args+=("$arg"); fi
      ;;
    --jar)
      echo "vis-agent: --jar was removed; choose --native, --jvm (source), or --dev." >&2
      exit 2
      ;;
    *)                args+=("$arg") ;;
  esac
done
if (( ${#args[@]} > 0 )); then
  set -- "${args[@]}"
else
  set --
fi

if [[ -z "$dist" ]]; then
  case "${VIS_RUNTIME:-}" in
    native|jvm|dev) dist="$VIS_RUNTIME" ;;
    "") ;;
    *) echo "vis-agent: ignoring invalid VIS_RUNTIME '$VIS_RUNTIME'" >&2 ;;
  esac
fi

persisted_runtime=""
if [[ -f "$runtime_file" ]]; then
  persisted_runtime="$(cat "$runtime_file" 2>/dev/null || true)"
fi
dev_mode=0
case "${dist:-$persisted_runtime}" in
  dev) dev_mode=1 ;;
esac

# ── --jfr: Java Flight Recorder profiling ───────────────────────────────────
# Export VIS_JFR=1 so the client and detached gateway daemon each create their
# own role-tagged recording. This works for both JVM source and native-image.
if (( jfr )); then
  export VIS_JFR=1
  mkdir -p "$HOME/.vis" 2>/dev/null || true
  echo "vis-agent: JFR profiling on → ~/.vis/vis-{client,gateway}-<pid>-<ts>.jfr" >&2
  echo "vis-agent:   snapshot: jcmd <pid> JFR.dump name=vis-<role>" >&2
fi

# Dev mode — and only dev mode — hands off to a live developer checkout. Carry
# the installed sidecar across that handoff: the checkout wrapper otherwise
# cannot discover the native runtime beside the original installed wrapper.
if (( dev_mode )) \
      && [[ -z "${VIS_NO_DEV_CHECKOUT:-}" \
      && "$repo_root" != "$dev_checkout" \
      && -x "$dev_checkout/bin/vis-agent" \
      && -f "$dev_checkout/deps.edn" ]]; then
  export VIS_NO_DEV_CHECKOUT=1
  export VIS_RUNTIME=dev
  if [[ -x "$bundled_native" ]]; then
    export VIS_INSTALLED_NATIVE="$bundled_native"
  fi
  exec "$dev_checkout/bin/vis-agent" "$@"
fi

measure_enabled() {
  case "${VIS_MEASURE:-0}" in
    1|true|TRUE|yes|YES|on|ON) return 0 ;;
    *) return 1 ;;
  esac
}

measure_now_ms() {
  perl -MTime::HiRes=time -e 'printf "%.3f", time() * 1000'
}

measure_log_since() {
  local label="$1"
  local start_ms="$2"
  if measure_enabled; then
    local end_ms elapsed_ms
    end_ms="$(measure_now_ms)"
    elapsed_ms="$(awk -v end="$end_ms" -v start="$start_ms" 'BEGIN { printf "%.1f", end - start }')"
    printf '[vis measure] shell:%s %s ms\n' "$label" "$elapsed_ms" >&2
  fi
}

measure_log() {
  if measure_enabled; then
    printf '[vis measure] shell:%s\n' "$1" >&2
  fi
}

edn_escape_string() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  printf '%s' "$s"
}

extension_dep_symbol() {
  local scope="$1"
  local name="$2"
  name="$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9._-]+/-/g; s/^-+//; s/-+$//')"
  [[ -n "$name" ]] || name="extension"
  printf 'vis-user-extension.%s/%s' "$scope" "$name"
}

collect_user_extension_sdeps() {
  local roots=("project:$invocation_cwd/.vis/vis-extensions" "global:$HOME/.vis/vis-extensions")
  local root_spec root_scope root deps_file ext_dir ext_name dep_sym escaped
  local -a entries=()
  shopt -s nullglob
  for root_spec in "${roots[@]}"; do
    root_scope="${root_spec%%:*}"
    root="${root_spec#*:}"
    for deps_file in "$root"/*/deps.edn; do
      [[ -f "$deps_file" ]] || continue
      ext_dir="$(cd -P "$(dirname "$deps_file")" && pwd)"
      ext_name="$(basename "$ext_dir")"
      dep_sym="$(extension_dep_symbol "$root_scope" "$ext_name")"
      escaped="$(edn_escape_string "$ext_dir")"
      entries+=("$dep_sym {:local/root \"$escaped\"}")
    done
  done
  shopt -u nullglob
  if (( ${#entries[@]} > 0 )); then
    printf '{:deps {'
    printf '%s ' "${entries[@]}"
    printf '}}'
  fi
}

user_extension_sdeps="$(collect_user_extension_sdeps)"
vis_extension_sdeps=()
if [[ -n "$user_extension_sdeps" ]]; then
  vis_extension_sdeps=(-Sdeps "$user_extension_sdeps")
  measure_log "user extension deps enabled"
fi

run_measured_or_exec() {
  local label="$1"
  shift
  if measure_enabled; then
    local start_ms code
    start_ms="$(measure_now_ms)"
    "$@"
    code=$?
    measure_log_since "$label exit=$code" "$start_ms"
    exit "$code"
  else
    exec "$@"
  fi
}

# A JVM/source launch must not inherit an incompatible GraalVM from a long-lived
# parent (IDE, terminal multiplexer, service runner, etc.). Clojure's launcher
# prefers JAVA_CMD / the `java` on PATH over JAVA_HOME, so merely running
# `sdk env` in a newer shell does not repair an already-started runner.
#
# Stock JDKs are deliberately accepted: the Maven-pinned Truffle runtime runs
# unchained there. When the selected JVM IS GraalVM, however, its built-in
# Truffle must be the exact CE release pinned by this checkout. Resolve an
# already-installed pin through the repository's single JDK gate and export all
# three selectors that the Clojure CLI may consult.
ensure_compatible_jvm_runtime() {
  local java_cmd vendor pinned_home

  if [[ -n "${JAVA_CMD:-}" ]]; then
    java_cmd="$(command -v "$JAVA_CMD" 2>/dev/null || true)"
  else
    java_cmd="$(command -v java 2>/dev/null || true)"
  fi
  [[ -n "$java_cmd" ]] || return 0

  vendor="$("$java_cmd" -XshowSettings:properties -version 2>&1 |
    sed -n 's/^ *java\.vendor\.version = //p' | head -n1)"
  [[ "$vendor" == *GraalVM* ]] || return 0

  # shellcheck source=/dev/null
  . "$repo_root/.graalvm-version"
  [[ "$vendor" == "$GRAAL_VENDOR_VERSION" ]] && return 0

  if pinned_home="$("$repo_root/bin/require-graalvm" 2>/dev/null)"; then
    export JAVA_HOME="$pinned_home"
    export GRAALVM_HOME="$pinned_home"
    export JAVA_CMD="$pinned_home/bin/java"
    export PATH="$pinned_home/bin:$PATH"
    echo "vis-agent: JVM launcher replaced incompatible $vendor with $GRAAL_VENDOR_VERSION." >&2
    measure_log "selected pinned JVM $pinned_home"
    return 0
  fi

  echo "vis-agent: incompatible JVM runtime: $vendor" >&2
  echo "vis-agent: this checkout embeds GraalPy/Truffle $GRAAL_VERSION and requires $GRAAL_VENDOR_VERSION." >&2
  echo "vis-agent: install it with '$repo_root/bin/require-graalvm --install', or run --jvm on a stock JDK 25." >&2
  return 1
}

# ── Managed runtime and release install ──────────────────────────────────────
# vis_home is initialized before source discovery so an installed wrapper can
# find the checkout recorded by bin/install-source.
vis_install_dir="$vis_home/install"
vis_repo_slug="Blockether/vis"
native_bin="$repo_root/target/vis"

find_native() {
  local candidate
  for candidate in "${VIS_INSTALLED_NATIVE:-}" "$bundled_native" "$vis_install_dir/vis-agent-native" "$native_bin"; do
    [[ -n "$candidate" ]] || continue
    if [[ -x "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

find_jvm_source() {
  # Dev mode runs the live checkout as-is. Every other mode prefers the managed
  # checkout that `vis-agent update` keeps pinned to a release tag or SHA.
  local mode=""
  [[ ! -f "$vis_install_dir/mode" ]] || mode="$(cat "$vis_install_dir/mode" 2>/dev/null || true)"
  if (( dev_mode )) && [[ -f "$repo_root/deps.edn" ]]; then
    printf '%s\n' "$repo_root"
  elif [[ "$mode" == "jvm-sha" || "$mode" == "jvm-tag" ]] \
        && [[ -f "$vis_install_dir/src/deps.edn" ]]; then
    printf '%s\n' "$vis_install_dir/src"
  elif [[ -f "$repo_root/deps.edn" ]]; then
    printf '%s\n' "$repo_root"
  else
    return 1
  fi
}

# The release tag or SHA the managed source is pinned to; empty when unpinned.
vis_pinned_ref() {
  local file
  for file in "$vis_install_dir/ref" "$vis_install_dir/sha"; do
    if [[ -f "$file" ]]; then
      cat "$file" 2>/dev/null || true
      return 0
    fi
  done
  return 0
}

configured_runtime() {
  local value=""
  [[ -f "$runtime_file" ]] && value="$(cat "$runtime_file" 2>/dev/null)"
  case "$value" in
    native|jvm|dev) printf '%s\n' "$value" ;;
    "") return 1 ;;
    *) echo "vis-agent: ignoring invalid runtime setting in $runtime_file: $value" >&2; return 1 ;;
  esac
}

runtime_effective() {
  local configured=""
  configured="$(configured_runtime 2>/dev/null || true)"
  if [[ -n "$configured" ]]; then
    printf '%s\n' "$configured"
    return
  fi
  # Automatic means "follow the releases": the published native runtime when it
  # is installed, otherwise release-tagged JVM source. A live checkout is never
  # picked implicitly — that is dev mode, and it must be asked for.
  if find_native >/dev/null; then
    printf 'native\n'
  else
    printf 'jvm\n'
  fi
}

vis_runtime() {
  case "${1:-show}" in
    show)
      local configured="" native="unavailable" source="unavailable" pinned=""
      configured="$(configured_runtime 2>/dev/null || true)"
      native="$(find_native 2>/dev/null || printf 'unavailable')"
      source="$(find_jvm_source 2>/dev/null || printf 'unavailable')"
      pinned="$(vis_pinned_ref)"
      echo "Configured default: ${configured:-automatic (release: native, else tagged source)}"
      echo "Effective runtime: $(runtime_effective)"
      echo "Native: $native"
      echo "JVM source: $source"
      echo "Source pinned at: ${pinned:-unpinned}"
      echo "Dev checkout: $dev_checkout"
      ;;
    use)
      case "${2:-}" in
        native|jvm|dev)
          mkdir -p "$vis_home"
          printf '%s\n' "$2" > "$runtime_file.tmp"
          mv -f "$runtime_file.tmp" "$runtime_file"
          echo "vis-agent: default runtime is now $2"
          if [[ "$2" == "dev" ]]; then
            echo "vis-agent: dev mode follows the live checkout at $dev_checkout"
            echo "vis-agent: (override with VIS_DEV_CHECKOUT; leave it with 'vis-agent runtime use auto')."
          fi
          ;;
        auto|default)
          rm -f "$runtime_file"
          echo "vis-agent: default runtime is now automatic (native release runtime, else tagged source)"
          ;;
        *) echo "Usage: vis-agent runtime use native|jvm|dev|auto" >&2; return 2 ;;
      esac
      ;;
    *)
      echo "Usage: vis-agent runtime [show]" >&2
      echo "       vis-agent runtime use native|jvm|dev|auto" >&2
      echo "         native  release runtime downloaded by 'vis-agent update'" >&2
      echo "         jvm     source pinned to the newest release tag" >&2
      echo "         dev     live checkout, tracking its branch" >&2
      echo "         auto    no persisted choice (native, else tagged source)" >&2
      return 2
      ;;
  esac
}

# Every release publishes exactly one asset per platform: the bundle that carries
# the launcher together with its native runtime.
#   vis-agent-<os>-<arch>-community.tar.gz
vis_platform_slug() {
  local os arch
  case "$(uname -s)" in
    Darwin) os=macos ;;
    Linux)  os=linux ;;
    *) echo "vis-agent update: unsupported OS $(uname -s)" >&2; return 1 ;;
  esac
  case "$(uname -m)" in
    arm64|aarch64) arch=arm64 ;;
    x86_64|amd64) arch=x64 ;;
    *) echo "vis-agent update: unsupported arch $(uname -m)" >&2; return 1 ;;
  esac
  printf '%s-%s' "$os" "$arch"
}

vis_platform_asset() {
  local slug
  slug="$(vis_platform_slug)" || return 1
  printf 'vis-agent-%s-community.tar.gz' "$slug"
}

# Exact-name match: the trailing quote keeps the bundle from matching a longer
# sibling asset (checksum, signature) that shares its name as a prefix.
vis_asset_url() {
  local json="$1" name="$2" url
  url="$(printf '%s' "$json" | grep -o "https://[^\"]*/${name}\"" | head -1)" || url=""
  printf '%s' "${url%\"}"
}

# The checkout Vis owns and may move between release tags. A developer's own
# checkout — the one this launcher is a tracked file of — is never moved.
vis_managed_source() {
  if [[ -d "$vis_install_dir/src/.git" ]]; then
    printf '%s\n' "$vis_install_dir/src"
  elif (( ! launcher_is_checkout )) && [[ -d "$repo_root/.git" ]]; then
    printf '%s\n' "$repo_root"
  else
    return 1
  fi
}

# Follow tagged commits: pin the managed source checkout to the newest release
# tag. Only dev mode tracks a moving branch.
vis_update_tagged_source() {
  local src="" tag=""
  command -v git >/dev/null || { echo "vis-agent update needs git on PATH to update source" >&2; exit 1; }
  src="$(vis_managed_source 2>/dev/null || true)"
  if [[ -z "$src" ]]; then
    src="$vis_install_dir/src"
    echo "vis-agent: cloning $vis_repo_slug into $src"
    git clone --filter=blob:none "https://github.com/$vis_repo_slug.git" "$src" || exit 1
  fi
  echo "vis-agent: fetching release tags for $src"
  git -C "$src" fetch --tags --force --prune origin || exit 1
  tag="$(git -C "$src" tag --list 'v*' --sort=-v:refname | head -1)"
  [[ -n "$tag" ]] || { echo "vis-agent update: no release tag (vX.Y.Z) is published yet" >&2; exit 1; }
  git -C "$src" checkout --force --detach "refs/tags/$tag" || exit 1
  mkdir -p "$vis_home"
  if [[ "$src" == "$vis_install_dir/src" ]]; then
    printf 'jvm-tag\n' > "$vis_install_dir/mode"
  fi
  printf '%s\n' "$tag" > "$vis_install_dir/ref"
  echo "vis-agent: source follows release tag $tag ($src)"
}

vis_do_update() {
  local target="" fetch_native=0 fetch_source=0 rebuild=0 dev_update=0 a
  for a in "$@"; do
    case "$a" in
      --native)        fetch_native=1 ;;  # DOWNLOAD the published release bundle
      --source|--jvm)  fetch_source=1 ;;  # move managed source to the newest tag
      --dev)           dev_update=1 ;;    # fast-forward the live checkout instead
      --rebuild)       rebuild=1 ;;       # also BUILD the native from that source
      *)               target="$a" ;;
    esac
  done
  if (( dev_mode )); then dev_update=1; fi
  mkdir -p "$vis_install_dir"

  # A git SHA selects an exact JVM source checkout.
  if [[ "$target" =~ ^[0-9a-fA-F]{7,40}$ ]]; then
    command -v git >/dev/null     || { echo "vis-agent update <sha> needs git on PATH" >&2; exit 1; }
    command -v clojure >/dev/null || { echo "vis-agent update <sha> needs the Clojure CLI" >&2; exit 1; }
    local src="$vis_install_dir/src"
    [[ -d "$src/.git" ]] || git clone --filter=blob:none "https://github.com/$vis_repo_slug.git" "$src" || exit 1
    git -C "$src" fetch --filter=blob:none origin || exit 1
    git -C "$src" checkout --force "$target" || exit 1
    printf 'jvm-sha\n' > "$vis_install_dir/mode"
    printf '%s\n' "$target" > "$vis_install_dir/sha"
    printf '%s\n' "$target" > "$vis_install_dir/ref"
    mkdir -p "$vis_home"
    printf 'jvm\n' > "$runtime_file"
    echo "vis-agent: default runtime is now JVM source @ $target ($src)"
    exit 0
  fi

  # Dev mode is the only mode that follows a moving branch: fast-forward the live
  # checkout. --rebuild also builds native locally; --native additionally
  # downloads the release bundle.
  if (( dev_update )) && [[ -z "$target" && -d "$repo_root/.git" ]]; then
    command -v git >/dev/null || { echo "vis-agent update needs git on PATH to update source" >&2; exit 1; }
    echo "vis-agent: updating source at $repo_root (git fetch + pull --ff-only)"
    git -C "$repo_root" fetch --tags origin || exit 1
    git -C "$repo_root" pull --ff-only || {
      # Say WHAT blocked the fast-forward: dirty tree vs. diverged history
      # (usually an upstream force-push), with the counts and the exact recovery
      # command. A bare 'not possible to fast-forward' tells the user nothing.
      local vis_branch vis_upstream vis_counts vis_ahead vis_behind
      vis_branch="$(git -C "$repo_root" rev-parse --abbrev-ref HEAD 2>/dev/null)"
      vis_upstream="$(git -C "$repo_root" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)"
      echo "vis-agent update: 'git pull --ff-only' failed on branch '${vis_branch:-?}'." >&2
      if [[ -n "$(git -C "$repo_root" status --porcelain 2>/dev/null)" ]]; then
        echo "  - Working tree has local changes: commit or stash them, then retry." >&2
      fi
      if [[ -n "$vis_upstream" ]]; then
        vis_counts="$(git -C "$repo_root" rev-list --left-right --count "HEAD...$vis_upstream" 2>/dev/null)"
        vis_ahead="${vis_counts%%[[:space:]]*}"
        vis_behind="${vis_counts##*[[:space:]]}"
        if [[ -n "$vis_counts" && ( "$vis_ahead" != 0 || "$vis_behind" != 0 ) ]]; then
          echo "  - '$vis_branch' and '$vis_upstream' have diverged: $vis_ahead local commit(s), $vis_behind upstream commit(s)." >&2
        fi
        if [[ "${vis_ahead:-0}" != 0 ]]; then
          echo "      keep your work:    git -C '$repo_root' rebase $vis_upstream" >&2
        fi
        echo "      discard local commits (DESTRUCTIVE, after an upstream force-push):" >&2
        echo "                         git -C '$repo_root' reset --hard $vis_upstream" >&2
      else
        echo "  - Branch '${vis_branch:-?}' has no upstream; set one with 'git branch -u origin/main'." >&2
      fi
      echo "    Then run 'vis-agent update' again." >&2
      exit 1
    }
    if (( rebuild )); then
      command -v clojure >/dev/null || { echo "vis-agent update --rebuild needs the Clojure CLI" >&2; exit 1; }
      echo "vis-agent: building native runtime from updated source ('clojure -T:build native')"
      ( cd "$repo_root" && clojure -T:build native ) || exit 1
      echo "vis-agent: source updated + native runtime built from source."
      exit 0
    elif (( fetch_native )); then
      # Source is current; now pull the latest release bundle below.
      echo "vis-agent: source updated; fetching the latest release bundle…"
    else
      echo "vis-agent: source updated; the JVM runtime will use it on the next launch."
      echo "  Build native with 'vis-agent update --rebuild', or install the latest"
      echo "  release runtime with 'vis-agent update --native'."
      exit 0
    fi
  fi

  # Default channel with the source runtime: follow tagged commits. The managed
  # checkout is moved onto the newest release tag; a developer's own checkout is
  # left untouched (that is what dev mode is for).
  if [[ -z "$target" ]] && (( ! fetch_native )); then
    if (( fetch_source )) || [[ "$(runtime_effective)" == "jvm" ]]; then
      vis_update_tagged_source
      if (( rebuild )); then
        command -v clojure >/dev/null || { echo "vis-agent update --rebuild needs the Clojure CLI" >&2; exit 1; }
        echo "vis-agent: building native runtime from the tagged source"
        ( cd "$(vis_managed_source)" && clojure -T:build native ) || exit 1
      fi
      if (( launcher_is_checkout )); then
        echo "vis-agent: developing here? 'vis-agent update --dev' fast-forwards this checkout,"
        echo "vis-agent: and 'vis-agent runtime use dev' makes it the default runtime."
      fi
      exit 0
    fi
  fi

  # Releases ship the launcher and its native runtime as a single bundle.
  command -v curl >/dev/null || { echo "vis-agent update needs curl on PATH" >&2; exit 1; }
  command -v tar >/dev/null  || { echo "vis-agent update needs tar on PATH" >&2; exit 1; }
  local asset api dl json archive unpack native_dir
  asset="$(vis_platform_asset)" || exit 1
  if [[ -z "$target" || "$target" == latest ]]; then
    api="https://api.github.com/repos/$vis_repo_slug/releases/latest"
  else
    api="https://api.github.com/repos/$vis_repo_slug/releases/tags/$target"
  fi
  echo "vis-agent: resolving $asset from $api"
  json="$(curl -fsSL "$api")" || true
  # `set -o pipefail` + `set -e` would kill this function on a no-match grep,
  # swallowing the actionable message below. Keep the failure local.
  dl="$(vis_asset_url "$json" "$asset")"
  if [[ -z "$dl" ]]; then
    echo "vis-agent update: no native runtime published for '$asset'." >&2
    echo "  Checked $api" >&2
    echo "  Releases currently carry Linux x64 and arm64 only." >&2
    echo "  Elsewhere: install the source runtime (bin/install-source), or build" >&2
    echo "  the runtime from a checkout with 'vis-agent native'." >&2
    exit 1
  fi

  # Where the private runtime belongs: beside an installed launcher, or in Vis
  # state when the launcher is a tracked checkout file we must never overwrite.
  if (( launcher_is_checkout )); then
    mkdir -p "$vis_install_dir"
    native_dir="$vis_install_dir"
  else
    [[ -w "$bin_dir" && -w "$src" ]] || {
      echo "vis-agent update: cannot replace installation in $bin_dir (permission denied)" >&2
      echo "  Re-run the installer with the permissions used for that directory." >&2
      exit 1
    }
    native_dir="$bin_dir"
  fi

  archive="$(mktemp "${TMPDIR:-/tmp}/vis-agent-bundle.XXXXXX.tar.gz")"
  unpack="$(mktemp -d "${TMPDIR:-/tmp}/vis-agent-unpack.XXXXXX")"
  trap 'rm -rf "$unpack" "$archive"' RETURN
  echo "vis-agent: downloading $dl"
  curl -fSL "$dl" -o "$archive" || exit 1
  tar -xzf "$archive" -C "$unpack" || exit 1
  [[ -x "$unpack/vis-agent" && -x "$unpack/vis-agent-native" ]] || {
    echo "vis-agent update: release bundle is missing its launcher or native runtime" >&2
    exit 1
  }

  mv -f "$unpack/vis-agent-native" "$native_dir/vis-agent-native"
  if (( launcher_is_checkout )); then
    # Never overwrite a tracked development launcher: the released one lives in
    # Vis state; source stays the checkout's responsibility.
    mv -f "$unpack/vis-agent" "$vis_install_dir/vis-agent"
    [[ ! -f "$unpack/install-vis-agent" ]] || mv -f "$unpack/install-vis-agent" "$vis_install_dir/install-vis-agent"
  else
    # Installed bundles are co-located: the public wrapper and its private
    # native sidecar update together. This Bash process has already read itself.
    mv -f "$unpack/vis-agent" "$src"
    [[ ! -f "$unpack/install-vis-agent" ]] || mv -f "$unpack/install-vis-agent" "$bin_dir/install-vis-agent"
  fi
  rm -rf "$unpack" "$archive"
  trap - RETURN
  echo "vis-agent: installed launcher + native runtime from $asset"
  echo "vis-agent: choose it with 'vis-agent runtime use native'."
  exit 0
}

# Wrapper-owned commands. The JVM app never sees these.
case "${1:-}" in
  runtime)
    shift
    vis_runtime "$@"
    exit $?
    ;;
  native|uber)
    [[ -f "$repo_root/deps.edn" ]] || {
      echo "vis-agent: '$1' requires a source checkout (run bin/install-source)." >&2
      exit 1
    }
    measure_log "exec clojure -T:build $1"
    cd "$repo_root"
    run_measured_or_exec "build $1" clojure -T:build "$1"
    ;;
  update)
    shift
    vis_do_update "$@"
    ;;
esac

# Pick exactly one public runtime. A one-launch --native/--jvm/--dev override
# wins; otherwise the persisted default wins; otherwise follow the release
# channel: the installed native runtime, else tagged JVM source. The uberjar is
# deliberately not a runtime.
if [[ -z "$dist" ]]; then
  dist="$(runtime_effective)"
fi

case "$dist" in
  native)
    nb="$(find_native 2>/dev/null || true)"
    if [[ -z "$nb" ]]; then
      echo "vis-agent: native runtime selected, but none is installed." >&2
      echo "vis-agent: download it with 'vis-agent update --native'," >&2
      echo "vis-agent: build it from a checkout with 'vis-agent native'," >&2
      echo "vis-agent: or switch to source with 'vis-agent runtime use jvm'." >&2
      exit 1
    fi
    measure_log "native → $nb"
    cd "$invocation_cwd"
    # Native-image does not derive Java's user.home from HOME. Pass it through
    # the wrapper so release and container builds never retain the builder's home.
    run_measured_or_exec "process native runtime" "$nb" "-Duser.home=${HOME:-$vis_home}" "$@"
    ;;
  jvm|dev)
    jvm_source="$(find_jvm_source 2>/dev/null || true)"
    if [[ -z "$jvm_source" ]]; then
      if (( dev_mode )); then
        echo "vis-agent: dev mode selected, but no source checkout was found." >&2
        echo "vis-agent: clone one to $dev_checkout (or point VIS_DEV_CHECKOUT at it)," >&2
        echo "vis-agent: or leave dev mode with 'vis-agent runtime use auto'." >&2
      else
        echo "vis-agent: JVM runtime selected, but no source checkout is installed." >&2
        echo "vis-agent: install release-tagged source with 'vis-agent update --jvm'," >&2
        echo "vis-agent: or use the native runtime: 'vis-agent update --native'." >&2
      fi
      exit 1
    fi
    repo_root="$jvm_source"
    ;;
  *)
    echo "vis-agent: unknown runtime: $dist" >&2
    exit 2
    ;;
esac

# JVM source launch. Preserve the invocation directory through user.dir while
# resolving deps from the selected checkout.
stream_trace_jvm_opts=()
case "${VIS_STREAM_TRACE:-0}" in
  1|true|TRUE|yes|YES|on|ON)
    stream_trace_jvm_opts=("-J-Dsvar.stream.trace=true")
    measure_log "svar stream trace enabled"
    ;;
esac

measure_log "exec cold clojure -M:vis from $repo_root"
ensure_compatible_jvm_runtime
cd "$repo_root"
if (( ${#vis_extension_sdeps[@]} > 0 )); then
  run_measured_or_exec "process cold clojure -M:vis" clojure "-J-Duser.dir=$invocation_cwd" ${stream_trace_jvm_opts[@]+"${stream_trace_jvm_opts[@]}"} "${vis_extension_sdeps[@]}" -M:vis "$@"
else
  run_measured_or_exec "process cold clojure -M:vis" clojure "-J-Duser.dir=$invocation_cwd" ${stream_trace_jvm_opts[@]+"${stream_trace_jvm_opts[@]}"} -M:vis "$@"
fi
