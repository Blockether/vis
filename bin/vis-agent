#!/usr/bin/env bash
# vis-agent — the one public Vis command.
#
# It does two things and nothing else:
#   1. run Vis,
#   2. update Vis — and this command with it — (`vis-agent update`).
#
# There is nothing to choose. How Vis was installed decides what runs:
#   native  the released build, unpacked beside this wrapper (release bundle,
#           container image), or one Vis built from the source it owns
#   jvm     `clojure -M:vis` from the source Vis owns, pinned to main's newest
#           commit — what `bin/install-vis-agent` puts in place
#
# The native build wins whenever one is installed, because it is the published
# runtime. `vis-agent runtime` reports which one runs; it never switches, and
# `vis-agent update` keeps that runtime — and this command — current.
#
# Where this file sits decides nothing either. A copy of this wrapper inside a
# repository checkout is still only the command: it runs the runtime Vis owns
# under ~/.vis, never the tree it happens to be sitting in.
#
# Vis follows main. Everything Vis owns lives under ~/.vis:
#   install/vis-agent-native   the private native runtime
#   install/src                the checkout Vis owns
#   install/ref                the commit that checkout is pinned to
#   install/track              the distribution track this install follows
#                              (`stable` release tags, or the rolling `beta`)
#
# Install with `bin/install-vis-agent`: it installs this wrapper and then lets
# it fetch its own runtime, so wrapper and runtime can never drift apart.

set -euo pipefail

# Raise the open-file (descriptor) soft limit for Vis and every child it spawns
# (the client, the detached gateway daemon, sandbox subprocesses). Vis runs
# Python on GraalPy, where a file object dropped WITHOUT `with open(...)` is not
# closed by refcounting the way CPython does — the JVM GC closes it later — so a
# tool that walks a large tree reading files can pile up thousands of live
# descriptors before GC catches up. The JVM's descriptor table is SHARED across
# everything (classpath jars, the HTTP server, SQLite, git spawns, the provider
# auth sockets), so one leak starves the control plane and wedges the session
# (vis session 7d3f9026: a sandbox os.walk without `with` hit EMFILE, which then
# broke credential hydration, the OAuth refresh socket, git, and cancel). The
# default soft cap (often ~256–10240 on macOS) is far too small a cushion; raise
# it toward the OS per-process hard cap. rlimits inherit across fork/exec, so
# setting it once here covers the whole tree. Best-effort: never fail launch.
if command -v ulimit >/dev/null 2>&1; then
  _vis_fd_target=65536
  _vis_fd_soft="$(ulimit -Sn 2>/dev/null || echo 0)"
  _vis_fd_hard="$(ulimit -Hn 2>/dev/null || echo unlimited)"
  # Only ever RAISE: never lower an already-generous inherited soft limit.
  if [[ "$_vis_fd_soft" =~ ^[0-9]+$ && "$_vis_fd_soft" -gt "$_vis_fd_target" ]]; then
    _vis_fd_target="$_vis_fd_soft"
  fi
  # Never exceed the OS per-process hard cap.
  if [[ "$_vis_fd_hard" =~ ^[0-9]+$ && "$_vis_fd_hard" -lt "$_vis_fd_target" ]]; then
    _vis_fd_target="$_vis_fd_hard"
  fi
  ulimit -n "$_vis_fd_target" 2>/dev/null || true
  unset _vis_fd_target _vis_fd_soft _vis_fd_hard
fi

invocation_cwd="$PWD"

vis_home="${VIS_HOME:-$HOME/.vis}"
vis_install_dir="$vis_home/install"
vis_repo_slug="${VIS_REPO_SLUG:-Blockether/vis}"
vis_repo_url="${VIS_REPO_URL:-https://github.com/$vis_repo_slug.git}"
# The branch the source runtime follows. There is no branch to choose: Vis
# follows main, and release tags are never consulted either — a release is a
# commit like any other, and this source tracks the newest one.
vis_branch="main"
managed_src="$vis_install_dir/src"
managed_ref_file="$vis_install_dir/ref"
# The distribution TRACK this install follows: `stable` (release tags) or `beta`
# (the rolling per-commit prerelease). Those two are the whole followable axis —
# a runtime stamped `dev` (a build of your own) or `dry-run` (a CI build that
# published nothing) belongs to no track at all, and is replaced by rebuilding
# it rather than by updating. Remembered here so `update` never jumps tracks on
# its own — only an explicit `--track` moves it.
# Deliberately NOT called a channel: in Vis a channel is a user interface an
# extension registers (TUI, web, Telegram).
vis_track_file="$vis_install_dir/track"

say()  { printf 'vis-agent: %s\n' "$*"; }
warn() { printf 'vis-agent: %s\n' "$*" >&2; }
die()  { printf 'vis-agent: %s\n' "$1" >&2; shift; for line in "$@"; do printf '  %s\n' "$line" >&2; done; exit 1; }

# First non-blank line of a state file, or nothing.
read_state() {
  [[ -f "$1" ]] || return 0
  head -n1 "$1" 2>/dev/null | tr -d '[:space:]' || true
}

# The remembered distribution track, defaulting to stable. Anything else on disk
# is treated as stable rather than trusted: an unreadable track must not send an
# update at an endpoint nobody publishes.
vis_track() {
  case "$(read_state "$vis_track_file")" in
    beta)   printf 'beta' ;;
    *)      printf 'stable' ;;
  esac
}

# Resolve this script through symlinks: an install puts this wrapper on PATH, and
# a release bundle puts it beside vis-agent-native.
launcher_path="${BASH_SOURCE[0]}"
while [ -L "$launcher_path" ]; do
  dir="$(cd -P "$(dirname "$launcher_path")" && pwd)"
  launcher_path="$(readlink "$launcher_path")"
  [[ "$launcher_path" != /* ]] && launcher_path="$dir/$launcher_path"
done
bin_dir="$(cd -P "$(dirname "$launcher_path")" && pwd)"
launcher_parent="$(cd -P "$bin_dir/.." && pwd)"
# Who owns this FILE, and nothing more. A wrapper with deps.edn one level above
# bin/ is a tracked file in a repository checkout: git is what replaces it, so an
# update leaves it alone and unpacks the released bundle into Vis state instead.
# What RUNS is decided by what is installed — here as everywhere else.
launcher_is_git_owned=0
if [[ -f "$launcher_parent/deps.edn" ]]; then launcher_is_git_owned=1; fi
bundled_native="$bin_dir/vis-agent-native"
clojure_install_dir="$vis_install_dir/clojure"
if [[ -d "$clojure_install_dir/bin" ]]; then
  export PATH="$clojure_install_dir/bin:$PATH"
fi

# ── Arguments the wrapper owns ───────────────────────────────────────────────
jfr=0
# `--jvm` forces the SOURCE (JVM) runtime, skipping any installed native — the
# dev override for "run this checkout's live edits, not the packaged build".
# Also honoured via VIS_JVM=1. The wrapper swallows it; it never reaches Vis.
force_jvm=0
case "${VIS_JVM:-0}" in 1|true|TRUE|yes|YES|on|ON) force_jvm=1 ;; esac
args=()
end_of_flags=0
for arg in "$@"; do
  # `--` ends the WRAPPER's parsing too, not just the app's, so every later word
  # reaches Vis verbatim — the one escape hatch the help promises must never eat
  # its own argument.
  if (( end_of_flags )); then args+=("$arg"); continue; fi
  case "$arg" in
    --)        end_of_flags=1; args+=("$arg") ;;
    --measure) export VIS_MEASURE=1 ;;
    --jfr)     jfr=1 ;;
    --jvm)     force_jvm=1 ;;
    --stream-trace) export VIS_STREAM_TRACE=1 ;;
    *) args+=("$arg") ;;
  esac
done
if (( ${#args[@]} > 0 )); then set -- "${args[@]}"; else set --; fi

# ── --jfr: Java Flight Recorder profiling ────────────────────────────────────
# Export VIS_JFR=1 so the client and detached gateway daemon each create their
# own role-tagged recording. This works for both JVM source and native-image.
if (( jfr )); then
  export VIS_JFR=1
  mkdir -p "$vis_home" 2>/dev/null || true
  warn "JFR profiling on → $vis_home/vis-{client,gateway}-<pid>-<ts>.jfr"
  warn "  snapshot: jcmd <pid> JFR.dump name=vis-<role>"
fi

# ── Provider SSE tracing: OPT-IN ─────────────────────────────────────────────
# svar's own stream tracer logs every SSE line with its gap and the running
# reasoning length. It answered its question — stunted thinking blocks are the
# provider's summarized output, not lost deltas — so it is off by default again;
# it costs tens of thousands of log lines per run. Turn it on with
# `--stream-trace` or `VIS_STREAM_TRACE=1` (`true`/`yes`/`on`). The switch is
# a system property svar reads at load, so it is passed to both runtimes;
# exporting the variable also carries it into the detached gateway daemon,
# where the model loop actually runs.
stream_trace_on() {
  case "${VIS_STREAM_TRACE:-0}" in
    1|true|TRUE|yes|YES|on|ON) return 0 ;;
  esac
  return 1
}
if stream_trace_on; then export VIS_STREAM_TRACE=1; fi

# ── Measurement ──────────────────────────────────────────────────────────────
measure_enabled() {
  case "${VIS_MEASURE:-0}" in
    1|true|TRUE|yes|YES|on|ON) return 0 ;;
    *) return 1 ;;
  esac
}

measure_now_ms() {
  perl -MTime::HiRes=time -e 'printf "%.3f", time() * 1000'
}

measure_log_since() {
  local label="$1"
  local start_ms="$2"
  if measure_enabled; then
    local end_ms elapsed_ms
    end_ms="$(measure_now_ms)"
    elapsed_ms="$(awk -v end="$end_ms" -v start="$start_ms" 'BEGIN { printf "%.1f", end - start }')"
    printf '[vis measure] shell:%s %s ms\n' "$label" "$elapsed_ms" >&2
  fi
}

measure_log() {
  if measure_enabled; then
    printf '[vis measure] shell:%s\n' "$1" >&2
  fi
}

run_measured_or_exec() {
  local label="$1"
  shift
  if measure_enabled; then
    local start_ms code
    start_ms="$(measure_now_ms)"
    "$@"
    code=$?
    measure_log_since "$label exit=$code" "$start_ms"
    exit "$code"
  else
    exec "$@"
  fi
}

# ── User extensions (JVM runtime only) ───────────────────────────────────────
edn_escape_string() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  printf '%s' "$s"
}

extension_dep_symbol() {
  local scope="$1"
  local name="$2"
  name="$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9._-]+/-/g; s/^-+//; s/-+$//')"
  [[ -n "$name" ]] || name="extension"
  printf 'vis-user-extension.%s/%s' "$scope" "$name"
}

collect_user_extension_sdeps() {
  local roots=("project:$invocation_cwd/.vis/vis-extensions" "global:$vis_home/vis-extensions")
  local root_spec root_scope root deps_file ext_dir ext_name dep_sym escaped
  local -a entries=()
  shopt -s nullglob
  for root_spec in "${roots[@]}"; do
    root_scope="${root_spec%%:*}"
    root="${root_spec#*:}"
    for deps_file in "$root"/*/deps.edn; do
      [[ -f "$deps_file" ]] || continue
      ext_dir="$(cd -P "$(dirname "$deps_file")" && pwd)"
      ext_name="$(basename "$ext_dir")"
      dep_sym="$(extension_dep_symbol "$root_scope" "$ext_name")"
      escaped="$(edn_escape_string "$ext_dir")"
      entries+=("$dep_sym {:local/root \"$escaped\"}")
    done
  done
  shopt -u nullglob
  if (( ${#entries[@]} > 0 )); then
    printf '{:deps {'
    printf '%s ' "${entries[@]}"
    printf '}}'
  fi
}

# ── Runtime discovery ────────────────────────────────────────────────────────
# The source the jvm runtime runs: the one checkout Vis owns, pinned to main's
# newest commit. There is no second source. A checkout of your own is yours —
# `vis-agent` never runs the tree it was invoked from, whatever directory that is.
find_jvm_source() {
  # The runtime Vis OWNS (installed under ~/.vis) wins when present.
  if [[ -f "$managed_src/deps.edn" ]]; then printf '%s\n' "$managed_src"; return 0; fi
  # Otherwise auto-derive: when THIS wrapper is a tracked file inside a real Vis
  # checkout (deps.edn one level up — `launcher_is_git_owned`), run THAT checkout.
  # Invoking `bin/vis-agent` from a source tree with nothing installed obviously
  # means "run this tree", so run its live source through `clojure -M:vis`.
  # Location still decides nothing for an INSTALLED wrapper (no deps.edn beside
  # it) — this only fires for a checkout invocation with no owned runtime.
  if (( launcher_is_git_owned )) && [[ -f "$launcher_parent/deps.edn" ]]; then
    printf '%s\n' "$launcher_parent"; return 0
  fi
  return 1
}

# The released native wins: an installed one (beside this wrapper, or in Vis
# state) is preferred over `target/vis`, the binary the source Vis owns produced.
# Building one yourself never shadows a release.
find_native() {
  local candidate
  for candidate in "$bundled_native" \
                   "$vis_install_dir/vis-agent-native" \
                   "$managed_src/target/vis"; do
    [[ -x "$candidate" ]] || continue
    printf '%s\n' "$candidate"
    return 0
  done
  return 1
}

# What runs: the native build when one is installed, otherwise the source Vis
# owns (or, from a checkout with nothing installed, that checkout — see
# `find_jvm_source`). Installing IS the decision; the ONE override is `--jvm` /
# `VIS_JVM=1`, which forces the source runtime so a developer can run live edits
# from a checkout even when a native is installed.
runtime_effective() {
  if (( ! force_jvm )) && find_native >/dev/null 2>&1; then
    printf 'native\n'
  else
    printf 'jvm\n'
  fi
}

vis_runtime() {
  if [[ -n "${1:-}" ]]; then
    case "$1" in
      -h|--help) vis_runtime_usage; return 0 ;;
      *) warn "runtime takes no arguments (got '$1')"; vis_runtime_usage; return 2 ;;
    esac
  fi
  local effective native source_root ref stamp built pin_sha track stamp_track
  effective="$(runtime_effective)"
  native="$(find_native 2>/dev/null || printf 'not installed')"
  source_root="$(find_jvm_source 2>/dev/null || printf 'not installed')"
  ref="$(read_state "$managed_ref_file")"
  [[ -n "$ref" ]] || ref="unpinned"
  # What that native runtime IS: the stamp `clojure -T:build native` writes beside
  # the image and every release bundle ships — `<version> <commit> <track>
  # <built-at>`. Read as a FILE, never by running the binary: the runtime whose
  # provenance you need is precisely the one that aborts on every command.
  stamp=""
  if [[ "$native" == "not installed" ]]; then
    built="not installed"
  elif [[ -r "$native.build" ]]; then
    stamp="$(head -n 1 "$native.build")"
    built="${stamp:-unknown}"
  else
    built="unknown (this runtime predates build stamps — 'vis-agent update')"
  fi
  # A pin is a claim about the source on disk, so check it instead of repeating
  # it: source that has been walked off its ref is what a source launch would
  # silently run.
  pin_sha=""
  if [[ "$source_root" == "$managed_src" && -d "$managed_src/.git" ]] \
     && command -v git >/dev/null 2>&1; then
    local head_sha
    head_sha="$(git -C "$managed_src" rev-parse --verify --quiet HEAD 2>/dev/null || true)"
    pin_sha="$(git -C "$managed_src" rev-parse --verify --quiet "$ref^{commit}" 2>/dev/null || true)"
    if [[ -n "$head_sha" && -n "$pin_sha" && "$head_sha" != "$pin_sha" ]]; then
      ref="$ref (DRIFTED: source is at $head_sha — restore it with 'vis-agent update')"
    fi
  fi
  # A binary is a build of ONE commit and the pin names one. A native runtime
  # older than the source beside it is what gets reported as a bug that was fixed
  # weeks earlier, so say so here rather than letting the binary say nothing.
  if [[ -n "$stamp" && -n "$pin_sha" ]]; then
    local built_commit="${stamp#* }"
    built_commit="${built_commit%% *}"
    if [[ -n "$built_commit" && "$built_commit" != "$pin_sha" ]]; then
      built="$built"$'\n'"              STALE: not the pinned $pin_sha — rebuild with 'vis-agent update --rebuild'"
    fi
  fi
  # Which track this install FOLLOWS, against the one the installed binary was
  # BUILT for. They part company after a hand-installed bundle, and that is
  # exactly when a "beta bug" turns out to be a stale stable runtime. `dev` and
  # `dry-run` name no published track, so a binary carrying one was built here or
  # by a CI dry run: say THAT, instead of reporting the everyday state of a
  # locally built runtime as a discrepancy with a track it never claimed.
  track="$(vis_track)"
  if [[ -n "$stamp" ]]; then
    stamp_track="${stamp#* }"
    stamp_track="${stamp_track#* }"
    stamp_track="${stamp_track%% *}"
    case "$stamp_track" in
      ""|"$track") ;;
      dev)     track="$track (this runtime was built from source here, not from a published track)" ;;
      dry-run) track="$track (this runtime is a CI dry-run build and was never published)" ;;
      *)       track="$track (this runtime was built on the $stamp_track track)" ;;
    esac
  fi
  printf 'Runtime:      %s\n' "$effective"
  printf 'Native:       %s\n' "$native"
  printf 'Built:        %s\n' "$built"
  printf 'Track:        %s\n' "$track"
  printf 'Source:       %s\n' "$source_root"
  printf 'Pinned at:    %s\n' "$ref"
}

clojure_cli_ready() {
  command -v clojure >/dev/null 2>&1
}

ensure_clojure_cli() {
  clojure_cli_ready && return 0
  case "${VIS_NO_AUTO_INSTALL:-}" in
    1|true|TRUE|yes|YES|on|ON)
      return 1
      ;;
  esac

  local os installer
  os="$(uname -s 2>/dev/null || printf 'unknown')"
  case "$os" in
    Darwin)
      if ! command -v brew >/dev/null 2>&1; then
        warn "Clojure CLI is missing and Homebrew is not installed"
        warn "Install Homebrew from https://brew.sh, then run this command again"
        return 1
      fi
      say "Clojure CLI not found; installing it with Homebrew"
      brew install clojure/tools/clojure || return 1
      hash -r 2>/dev/null || true
      ;;
    Linux)
      if ! command -v curl >/dev/null 2>&1; then
        warn "Clojure CLI is missing and curl is not installed"
        return 1
      fi
      mkdir -p "$clojure_install_dir" || return 1
      installer="$(mktemp "${TMPDIR:-/tmp}/vis-clojure-install.XXXXXX")" || return 1
      say "Clojure CLI not found; installing it under $clojure_install_dir"
      if ! curl -fL "https://github.com/clojure/brew-install/releases/latest/download/linux-install.sh" -o "$installer"; then
        rm -f "$installer"
        return 1
      fi
      chmod +x "$installer"
      if ! "$installer" --prefix "$clojure_install_dir"; then
        rm -f "$installer"
        return 1
      fi
      rm -f "$installer"
      export PATH="$clojure_install_dir/bin:$PATH"
      hash -r 2>/dev/null || true
      ;;
    *)
      warn "Clojure CLI is missing and automatic installation is unsupported on $os"
      return 1
      ;;
  esac

  if clojure_cli_ready; then
    say "Clojure CLI is ready"
    return 0
  fi
  warn "Clojure CLI installation finished, but 'clojure' is still not on PATH"
  return 1
}

ensure_java_runtime() {
  if [[ -n "${JAVA_CMD:-}" ]] && {
    [[ -x "$JAVA_CMD" ]] || command -v "$JAVA_CMD" >/dev/null 2>&1
  }; then
    return 0
  fi
  [[ -x "${JAVA_HOME:-}/bin/java" ]] && return 0
  command -v java >/dev/null 2>&1 && return 0

  case "${VIS_NO_AUTO_INSTALL:-}" in
    1|true|TRUE|yes|YES|on|ON)
      return 1
      ;;
  esac

  local pinned_home
  if pinned_home="$("$source_root/bin/require-graalvm" --install)"; then
    export JAVA_HOME="$pinned_home"
    export GRAALVM_HOME="$pinned_home"
    export JAVA_CMD="$pinned_home/bin/java"
    export PATH="$pinned_home/bin:$PATH"
    hash -r 2>/dev/null || true
    measure_log "selected pinned JVM $pinned_home"
    return 0
  fi
  return 1
}

vis_runtime_usage() {
  cat >&2 <<'EOF'
Usage: vis-agent runtime
         Report what runs, where it is installed, which commit the native
         runtime was BUILT from, which distribution track this install follows,
         and the commit the source Vis owns sits at.
         There is nothing to switch: how Vis was installed decides the runtime,
         and 'vis-agent update' keeps it current.
EOF
}

# ── Release bundle ───────────────────────────────────────────────────────────
# Every release publishes exactly one asset per platform: the bundle that carries
# the launcher together with its native runtime.
#   vis-agent-<os>-<arch>-community.tar.gz
vis_platform_asset() {
  local os arch
  case "$(uname -s)" in
    Darwin) os=macos ;;
    Linux)  os=linux ;;
    *) die "update: unsupported OS $(uname -s)" ;;
  esac
  case "$(uname -m)" in
    arm64|aarch64) arch=arm64 ;;
    x86_64|amd64)  arch=x64 ;;
    *) die "update: unsupported architecture $(uname -m)" ;;
  esac
  printf 'vis-agent-%s-%s-community.tar.gz' "$os" "$arch"
}

# Exact-name match: the trailing quote keeps the bundle from matching a longer
# sibling asset (checksum, signature) that shares its name as a prefix.
vis_asset_url() {
  local json="$1" name="$2" url
  url="$(printf '%s' "$json" | grep -o "https://[^\"]*/${name}\"" | head -1)" || url=""
  printf '%s' "${url%\"}"
}

require_cmd() {
  local cmd="$1" why="$2"
  command -v "$cmd" >/dev/null 2>&1 || die "update: $why needs '$cmd' on PATH"
}

build_native_runtime() {
  local source_root="$1"
  require_cmd clojure "--rebuild"
  say "building the native runtime from $source_root ('clojure -T:build native')"
  # A build of YOURS, whatever environment it inherited: a rebuild run from a CI
  # shell must not stamp itself with that job's track (build.clj `release-tracks`).
  ( cd "$source_root" && VIS_RELEASE_TRACK=dev clojure -T:build native ) || exit 1
}

# ── update: source runtime ───────────────────────────────────────────────────
# Follow the development branch: the checkout Vis owns is moved onto the newest
# commit of `$vis_branch`, or onto an exact ref you name. Release tags are not
# consulted at all — a release is a commit like any other, and asking for the
# newest tag is how an install lands on published-but-broken source. A checkout
# of your own is never moved by this path: git owns it.
#
# Pinned is meant literally. This source is built by hand — `git init` plus ONE
# shallow ref — rather than cloned, and every branch and remote-tracking ref is
# dropped afterwards. A clone left `main` behind: HEAD sat on the pin while
# `git checkout main && git pull` walked the source Vis actually runs a hundred
# commits past it, having downloaded the whole history to do it. What is not
# there cannot be followed, and an install downloads one commit instead of every
# commit ever made.

# Fetch exactly one ref and nothing else. A branch (or tag) is advertised, so a
# single shallow commit is enough; an exact SHA usually is not advertised, and
# only that case pays for history.
fetch_pinned_ref() {
  local ref="$1"
  git -C "$managed_src" fetch --quiet --force --depth 1 origin "$ref" 2>/dev/null && return 0
  say "$ref is not an advertised branch or tag — fetching history to find it"
  git -C "$managed_src" fetch --force --prune origin '+refs/heads/*:refs/remotes/origin/*'
}

# Leave no branch to step off: with every local and remote-tracking branch gone
# the pinned commit is reachable through HEAD alone, and `git checkout main` in
# there has nothing to check out.
drop_moving_refs() {
  local ref
  while read -r ref; do
    [[ -z "$ref" ]] || git -C "$managed_src" update-ref -d "$ref" 2>/dev/null || true
  done < <(git -C "$managed_src" for-each-ref --format='%(refname)' refs/heads refs/remotes 2>/dev/null)
}

update_source() {
  local ref="${1:-}" target pinned
  require_cmd git "the source runtime"
  if [[ ! -d "$managed_src/.git" ]]; then
    say "creating $managed_src for $vis_repo_slug"
    mkdir -p "$managed_src" || exit 1
    git -C "$managed_src" init --quiet || exit 1
  fi
  git -C "$managed_src" remote add origin "$vis_repo_url" 2>/dev/null \
    || git -C "$managed_src" remote set-url origin "$vis_repo_url" || exit 1
  # This source is a detached pin, never a branch — so even a hand-run `git fetch`
  # in there brings back nothing to step onto.
  git -C "$managed_src" config remote.origin.fetch \
      "+refs/heads/$vis_branch:refs/remotes/origin/$vis_branch" || exit 1
  if [[ -z "$ref" ]]; then
    ref="$vis_branch"
    say "asking $vis_repo_slug for the newest commit on $vis_branch"
  fi
  say "fetching $ref for $managed_src"
  fetch_pinned_ref "$ref" || exit 1
  # A named branch never becomes a local ref here, so check out what was fetched.
  target="$ref"
  git -C "$managed_src" rev-parse --verify --quiet "$ref^{commit}" >/dev/null 2>&1 \
    || target=FETCH_HEAD
  git -C "$managed_src" checkout --force --detach "$target" || exit 1
  drop_moving_refs
  # The pin recorded is the COMMIT, never the branch that pointed at it: a branch
  # name in there is a moving pin, and no drift check can verify a moving pin.
  pinned="$(git -C "$managed_src" rev-parse --verify HEAD)" || exit 1
  mkdir -p "$vis_install_dir"
  printf '%s\n' "$pinned" > "$managed_ref_file"
  say "source pinned at $pinned ($managed_src)"
}

# ── update: the vis-agent command itself ─────────────────────────────────────
# The command and its runtime must never drift apart, so an update refreshes
# both. A release bundle carries the wrapper beside the native runtime; a source
# update copies the wrapper out of the source it just pinned, because an
# installed wrapper is a COPY made at install time and nothing else refreshes
# it. A wrapper that lives IN a checkout is source: git owns it, never this.
sync_wrapper_from_source() {
  local source_root="$1" incoming="$1/bin/vis-agent"
  (( ! launcher_is_git_owned )) || return 0
  [[ -f "$incoming" ]] || return 0
  if cmp -s "$incoming" "$launcher_path"; then return 0; fi
  if [[ ! -w "$launcher_path" || ! -w "$bin_dir" ]]; then
    warn "the vis-agent command at $launcher_path is not writable — it stays at its old version"
    warn "  re-run this update with the permissions that directory needs"
    return 0
  fi
  # Replacing the file in place is safe: Bash has already read this script.
  if install -m 0755 "$incoming" "$launcher_path.tmp" 2>/dev/null \
     && mv -f "$launcher_path.tmp" "$launcher_path" 2>/dev/null; then
    say "vis-agent command updated from $source_root"
  else
    rm -f "$launcher_path.tmp" 2>/dev/null || true
    warn "could not replace the vis-agent command at $launcher_path — it stays at its old version"
  fi
}

# ── update: native runtime ───────────────────────────────────────────────────
# Releases ship the launcher and its native runtime as a single bundle, so both
# are replaced together and can never drift apart.
update_native() {
  local target="${1:-latest}" track="${2:-stable}"
  require_cmd curl "the native runtime"
  require_cmd tar "the native runtime"
  local asset api dl json archive unpack native_dir
  asset="$(vis_platform_asset)"
  if [[ "$target" != latest ]]; then
    api="https://api.github.com/repos/$vis_repo_slug/releases/tags/$target"
  elif [[ "$track" == beta ]]; then
    # The beta track is ONE rolling prerelease: CI moves the `beta` tag onto the
    # newest commit that passed everything, so "the newest beta" IS that tag and
    # there is no version to name.
    api="https://api.github.com/repos/$vis_repo_slug/releases/tags/beta"
  else
    api="https://api.github.com/repos/$vis_repo_slug/releases/latest"
  fi
  say "resolving $asset on the $track track from $api"
  json="$(curl -fsSL "$api")" || true
  # `set -o pipefail` + `set -e` would kill this function on a no-match grep,
  # swallowing the actionable message below. Keep the failure local.
  dl="$(vis_asset_url "$json" "$asset")"
  if [[ -z "$dl" ]]; then
    die "update: no native runtime published for '$asset' on the $track track." \
        "Checked $api" \
        "The stable track carries Linux x64 and arm64; the beta track is built on" \
        "free runners only, so it carries the same two and never macOS." \
        "Elsewhere Vis runs from the source it owns: install it with bin/install-vis-agent"
  fi

  # Where the private runtime belongs: beside an installed launcher, or in Vis
  # state when the launcher is a tracked checkout file we must never overwrite.
  if (( launcher_is_git_owned )); then
    mkdir -p "$vis_install_dir"
    native_dir="$vis_install_dir"
  else
    [[ -w "$bin_dir" && -w "$launcher_path" ]] || \
      die "update: cannot replace the installation in $bin_dir (permission denied)" \
          "Re-run with the permissions used for that directory."
    native_dir="$bin_dir"
  fi

  archive="$(mktemp "${TMPDIR:-/tmp}/vis-agent-bundle.XXXXXX.tar.gz")"
  unpack="$(mktemp -d "${TMPDIR:-/tmp}/vis-agent-unpack.XXXXXX")"
  trap 'rm -rf "$unpack" "$archive"' RETURN
  say "downloading $dl"
  curl -fSL "$dl" -o "$archive" || exit 1
  tar -xzf "$archive" -C "$unpack" || exit 1
  [[ -x "$unpack/vis-agent" && -x "$unpack/vis-agent-native" ]] || \
    die "update: the release bundle is missing its launcher or native runtime"

  mv -f "$unpack/vis-agent-native" "$native_dir/vis-agent-native"
  # The stamp travels with the runtime it describes, and is replaced with it:
  # otherwise `vis-agent runtime` dates a new binary by the old build.
  rm -f "$native_dir/vis-agent-native.build"
  [[ ! -f "$unpack/vis-agent-native.build" ]] || \
    mv -f "$unpack/vis-agent-native.build" "$native_dir/vis-agent-native.build"
  # The language-resources sidecar travels WITH the runtime it was built for.
  # Always clear the old one first: a bundle that predates -H:+CopyLanguageResources
  # carries no directory, and its binary has the resources embedded, so a stale
  # directory from a newer build must not survive a downgrade.
  rm -rf "$native_dir/vis-agent-resources"
  [[ ! -d "$unpack/vis-agent-resources" ]] || \
    mv -f "$unpack/vis-agent-resources" "$native_dir/vis-agent-resources"
  if (( launcher_is_git_owned )); then
    # Never overwrite a tracked development launcher: the released one lives in
    # Vis state; source stays the checkout's responsibility.
    mv -f "$unpack/vis-agent" "$vis_install_dir/vis-agent"
    [[ ! -f "$unpack/install-vis-agent" ]] || mv -f "$unpack/install-vis-agent" "$vis_install_dir/install-vis-agent"
  else
    # Installed bundles are co-located: the public wrapper and its private native
    # sidecar update together. This Bash process has already read itself.
    mv -f "$unpack/vis-agent" "$launcher_path"
    [[ ! -f "$unpack/install-vis-agent" ]] || mv -f "$unpack/install-vis-agent" "$bin_dir/install-vis-agent"
  fi
  rm -rf "$unpack" "$archive"
  trap - RETURN
  say "installed launcher + native runtime from $asset"
}

vis_update_usage() {
  cat >&2 <<'EOF'
Usage: vis-agent update [vX.Y.Z] [--track stable|beta] [--rebuild]
         (no target)   the newest release on the remembered track for a native
                       install, or main's newest commit for a source install
         vX.Y.Z        that release instead of the newest, once — naming a
                       version never moves the remembered track
         --track NAME  follow that distribution track from now on:
                         stable  release tags, every platform we publish
                         beta    the rolling per-commit prerelease, Linux only
                       A build of your own is stamped `dev` and follows nothing;
                       `--rebuild` is what moves it
         --rebuild     after a source update, build the native runtime from
                       that source
       Update takes the runtime that is installed forward; it never swaps one
       runtime for the other, and never changes track on its own. The vis-agent
       command travels with it: a native update replaces this file from the
       release bundle, a source update copies it out of the source it just
       pinned.
EOF
}

# `update` moves the installed runtime forward — the only runtime there is.
vis_do_update() {
  local target="" rebuild=0 track="" arg
  while (( $# )); do
    arg="$1"
    case "$arg" in
      --rebuild) rebuild=1 ;;
      --track) track="${2:-}"; [[ -n "$track" ]] || die "update: --track needs a name" \
                                                        "Tracks are 'stable' and 'beta'"; shift ;;
      --track=*) track="${arg#*=}" ;;
      -h|--help) vis_update_usage; exit 0 ;;
      -*) die "update: unknown option $arg" \
              "Usage: vis-agent update [vX.Y.Z] [--track stable|beta] [--rebuild]" ;;
      # A published release, or nothing at all. A git ref would name source
      # nobody published, and Vis does not install source nobody published.
      latest|v[0-9]*)
        [[ -z "$target" ]] || die "update: one target at a time, not '$target' and '$arg'"
        target="$arg"
        ;;
      *) die "update: '$arg' is not a released version" \
             "Name a release (vX.Y.Z), or nothing at all to take the newest" ;;
    esac
    shift
  done
  case "$track" in
    ""|stable|beta) ;;
    dev|dry-run)
      die "update: '$track' is not a distribution track — nothing publishes it" \
          "'dev' is what a build of your own stamps ('vis-agent update --rebuild')," \
          "'dry-run' a CI build that published nothing." \
          "Tracks are 'stable' (release tags) and 'beta' (the rolling per-commit prerelease)" ;;
    *) die "update: unknown track '$track'" \
           "Tracks are 'stable' (release tags) and 'beta' (the rolling per-commit prerelease)" ;;
  esac
  # The beta track has no versions to name: its ONE tag moves.
  [[ -z "$target" || "$target" == latest || "$track" != beta ]] || \
    die "update: the beta track has no versions — its single 'beta' release moves" \
        "Take the newest beta with 'vis-agent update --track beta'"
  mkdir -p "$vis_install_dir"
  # Switching tracks is an explicit act and it STICKS: every later `update`
  # follows the remembered track, and nothing else ever moves it. Otherwise a
  # beta tester silently falls back to stable on the next update, and a bug is
  # filed against a build that was never running.
  if [[ -n "$track" ]]; then
    printf '%s\n' "$track" > "$vis_track_file"
    say "following the $track track"
  fi

  case "$(runtime_effective)" in
    jvm)
      [[ -z "$track" ]] || die "update: --track selects a PUBLISHED native distribution, and this Vis runs the source runtime" \
                               "The source runtime follows main; there is no track to choose"
      update_source "$target"
      sync_wrapper_from_source "$managed_src"
      if (( rebuild )); then build_native_runtime "$managed_src"; fi
      ;;
    native)
      (( ! rebuild )) || die "update: --rebuild builds FROM source, and this Vis runs the native runtime" \
                             "Install the source runtime with bin/install-vis-agent to build from it"
      update_native "${target:-latest}" "$(vis_track)"
      ;;
  esac
  exit 0
}

# ── Wrapper-owned commands. The Vis app never sees these. ────────────────────
case "${1:-}" in
  runtime)
    shift
    vis_runtime "$@"
    exit $?
    ;;
  update)
    shift
    vis_do_update "$@"
    ;;
esac

# ── Launch ───────────────────────────────────────────────────────────────────
runtime="$(runtime_effective)"
case "$runtime" in
  native)
    native_runtime="$(find_native 2>/dev/null || true)"
    [[ -n "$native_runtime" ]] || die "no Vis runtime is installed" \
                                      "Install it:  vis-agent update"
    measure_log "native → $native_runtime"
    cd "$invocation_cwd"
    # Native-image does not derive Java's user.home from HOME. Pass it through
    # the wrapper so release and container builds never retain the builder's home.
    # GraalPy/Truffle language resources are NOT inside the binary: the image is
    # built with -H:+CopyLanguageResources, so they ship as a directory beside the
    # runtime (see resources/META-INF/native-image/com.blockether/vis/
    # native-image.properties). native-image finds `resources/` next to the
    # executable by itself; the RELEASE bundle names the directory
    # `vis-agent-resources` (the runtime is `vis-agent-native`, not `vis`), so
    # point the engine at it explicitly. Without it every Python tool dies with
    # "No module named 'ast'".
    native_home="$(cd -P "$(dirname "$native_runtime")" && pwd)"
    resource_args=()
    for candidate in "${VIS_NATIVE_RESOURCES:-}" "$native_home/vis-agent-resources" "$native_home/resources"; do
      [[ -n "$candidate" && -d "$candidate" ]] || continue
      resource_args=("-Dpolyglot.engine.resourcePath=$candidate")
      break
    done
    stream_trace_args=()
    if stream_trace_on; then stream_trace_args=("-Dsvar.stream.trace=true"); fi
    run_measured_or_exec "process native runtime" "$native_runtime" "-Duser.home=${HOME:-$vis_home}" ${resource_args[@]+"${resource_args[@]}"} ${stream_trace_args[@]+"${stream_trace_args[@]}"} "$@"
    ;;
  jvm)
    source_root="$(find_jvm_source 2>/dev/null || true)"
    if [[ -z "$source_root" ]]; then
      die "no Vis runtime is installed" \
          "Install it:  vis-agent update"
    fi
    if ! ensure_clojure_cli; then
      die "the source runtime needs the Clojure CLI" \
          "Automatic installation failed; set VIS_NO_AUTO_INSTALL=1 to disable it"
    fi
    if ! ensure_java_runtime; then
      die "the source runtime needs a Java 25 runtime, and automatic installation failed" \
          "Install manually with:  $source_root/bin/require-graalvm --install"
    fi
    ;;
esac

# ── JVM source launch ────────────────────────────────────────────────────────
# A JVM launch must not inherit an incompatible GraalVM from a long-lived parent
# (IDE, terminal multiplexer, service runner, …). Clojure's launcher prefers
# JAVA_CMD / the `java` on PATH over JAVA_HOME, so merely running `sdk env` in a
# newer shell does not repair an already-started runner.
#
# Stock JDKs are deliberately accepted: the Maven-pinned Truffle runtime runs
# unchained there. When the selected JVM IS GraalVM, however, its built-in
# Truffle must be the exact CE release pinned by this source. Resolve an
# already-installed pin through the repository's single JDK gate and export all
# three selectors that the Clojure CLI may consult.
ensure_compatible_jvm_runtime() {
  local java_cmd vendor pinned_home

  if [[ -n "${JAVA_CMD:-}" ]]; then
    java_cmd="$(command -v "$JAVA_CMD" 2>/dev/null || true)"
  else
    java_cmd="$(command -v java 2>/dev/null || true)"
  fi
  [[ -n "$java_cmd" ]] || return 0

  vendor="$("$java_cmd" -XshowSettings:properties -version 2>&1 |
    sed -n 's/^ *java\.vendor\.version = //p' | head -n1)"
  [[ "$vendor" == *GraalVM* ]] || return 0

  # shellcheck source=/dev/null
  . "$source_root/.graalvm-version"
  [[ "$vendor" == "$GRAAL_VENDOR_VERSION" ]] && return 0

  if pinned_home="$("$source_root/bin/require-graalvm" 2>/dev/null)"; then
    export JAVA_HOME="$pinned_home"
    export GRAALVM_HOME="$pinned_home"
    export JAVA_CMD="$pinned_home/bin/java"
    export PATH="$pinned_home/bin:$PATH"
    warn "JVM launcher replaced incompatible $vendor with $GRAAL_VENDOR_VERSION."
    measure_log "selected pinned JVM $pinned_home"
    return 0
  fi

  warn "incompatible JVM runtime: $vendor"
  warn "this source embeds GraalPy/Truffle $GRAAL_VERSION and requires $GRAAL_VENDOR_VERSION."
  warn "install it with '$source_root/bin/require-graalvm --install', or run on a stock JDK 25."
  return 1
}

user_extension_sdeps="$(collect_user_extension_sdeps)"
vis_extension_sdeps=()
if [[ -n "$user_extension_sdeps" ]]; then
  vis_extension_sdeps=(-Sdeps "$user_extension_sdeps")
  measure_log "user extension deps enabled"
fi

stream_trace_jvm_opts=()
if stream_trace_on; then
  stream_trace_jvm_opts=("-J-Dsvar.stream.trace=true")
  measure_log "svar stream trace enabled"
fi

# Preserve the invocation directory through user.dir while resolving deps from
# the selected source.
measure_log "exec cold clojure -M:vis from $source_root"
ensure_compatible_jvm_runtime || exit 1
cd "$source_root"
if (( ${#vis_extension_sdeps[@]} > 0 )); then
  run_measured_or_exec "process cold clojure -M:vis" clojure "-J-Duser.dir=$invocation_cwd" ${stream_trace_jvm_opts[@]+"${stream_trace_jvm_opts[@]}"} "${vis_extension_sdeps[@]}" -M:vis "$@"
else
  run_measured_or_exec "process cold clojure -M:vis" clojure "-J-Duser.dir=$invocation_cwd" ${stream_trace_jvm_opts[@]+"${stream_trace_jvm_opts[@]}"} -M:vis "$@"
fi
