#!/usr/bin/env bash
# vis-agent — the one public Vis command.
#
# It does two things and nothing else:
#   1. run Vis,
#   2. update Vis — and this command with it — (`vis-agent update`).
#
# Release and beta install native engine, Python and TUI bundles. Dev follows main
# on the JVM. `update` defaults to release; only --track selects beta or dev.
# --jvm selects source for one launch without changing the installed track.
#
# Managed source and installation state live under ~/.vis:
#   install/vis-agent-native   native engine for a checkout-owned launcher
#   install/src                the development checkout Vis owns
#   install/ref                that checkout's pinned source commit
#   install/track              installed selection: release, beta or dev
#
# Install with `bin/install-vis-agent`: it installs this wrapper and then lets
# it fetch its own runtime, so wrapper and runtime can never drift apart.

set -euo pipefail

# Raise the open-file (descriptor) soft limit for Vis and every child it spawns
# (the client, the detached gateway daemon, sandbox subprocesses). Vis runs
# Python inside the process, and a sandbox block that walks a large tree can hold
# many files at once. The process descriptor table is SHARED across everything
# (classpath jars, the HTTP server, SQLite, git spawns, the provider
# auth sockets), so one leak starves the control plane and wedges the session
# (vis session 7d3f9026: a sandbox os.walk without `with` hit EMFILE, which then
# broke credential hydration, the OAuth refresh socket, git, and cancel). The
# default soft cap (often ~256–10240 on macOS) is far too small a cushion; raise
# it toward the OS per-process hard cap. rlimits inherit across fork/exec, so
# setting it once here covers the whole tree. Best-effort: never fail launch.
if command -v ulimit >/dev/null 2>&1; then
  _vis_fd_target=65536
  _vis_fd_soft="$(ulimit -Sn 2>/dev/null || echo 0)"
  _vis_fd_hard="$(ulimit -Hn 2>/dev/null || echo unlimited)"
  # Only ever RAISE: never lower an already-generous inherited soft limit.
  if [[ "$_vis_fd_soft" =~ ^[0-9]+$ && "$_vis_fd_soft" -gt "$_vis_fd_target" ]]; then
    _vis_fd_target="$_vis_fd_soft"
  fi
  # Never exceed the OS per-process hard cap.
  if [[ "$_vis_fd_hard" =~ ^[0-9]+$ && "$_vis_fd_hard" -lt "$_vis_fd_target" ]]; then
    _vis_fd_target="$_vis_fd_hard"
  fi
  ulimit -n "$_vis_fd_target" 2>/dev/null || true
  unset _vis_fd_target _vis_fd_soft _vis_fd_hard
fi

invocation_cwd="$PWD"

vis_home="${VIS_HOME:-$HOME/.vis}"
vis_install_dir="$vis_home/install"
vis_repo_slug="${VIS_REPO_SLUG:-Blockether/vis}"
vis_repo_url="${VIS_REPO_URL:-https://github.com/$vis_repo_slug.git}"
# Dev follows main; native updates pin existing source to the artifact build stamp.
vis_branch="main"
managed_src="$vis_install_dir/src"
managed_ref_file="$vis_install_dir/ref"
# The installed selection controls launch, not the default for a later update.
vis_track_file="$vis_install_dir/track"

say()  { printf 'vis-agent: %s\n' "$*"; }
warn() { printf 'vis-agent: %s\n' "$*" >&2; }
die()  { printf 'vis-agent: %s\n' "$1" >&2; shift; for line in "$@"; do printf '  %s\n' "$line" >&2; done; exit 1; }

# First non-blank line of a state file, or nothing.
read_state() {
  [[ -f "$1" ]] || return 0
  head -n1 "$1" 2>/dev/null | tr -d '[:space:]' || true
}

# Resolve this script through symlinks: an install puts this wrapper on PATH, and
# a release bundle puts it beside vis-agent-native.
launcher_path="${BASH_SOURCE[0]}"
while [ -L "$launcher_path" ]; do
  dir="$(cd -P "$(dirname "$launcher_path")" && pwd)"
  launcher_path="$(readlink "$launcher_path")"
  [[ "$launcher_path" != /* ]] && launcher_path="$dir/$launcher_path"
done
bin_dir="$(cd -P "$(dirname "$launcher_path")" && pwd)"
launcher_parent="$(cd -P "$bin_dir/.." && pwd)"
# Who owns this FILE, and nothing more. A wrapper with deps.edn one level above
# bin/ is a tracked file in a repository checkout: git is what replaces it, so an
# update leaves it alone and unpacks the released bundle into Vis state instead.
# What RUNS is decided by what is installed — here as everywhere else.
launcher_is_git_owned=0
if [[ -f "$launcher_parent/deps.edn" ]]; then launcher_is_git_owned=1; fi
bundled_native="$bin_dir/vis-agent-native"
clojure_install_dir="$vis_install_dir/clojure"
if [[ -d "$clojure_install_dir/bin" ]]; then
  export PATH="$clojure_install_dir/bin:$PATH"
fi

# ── Arguments the wrapper owns ───────────────────────────────────────────────
jfr=0
jvm_requested=0
args=()
end_of_flags=0
for arg in "$@"; do
  # `--` ends the WRAPPER's parsing too, not just the app's, so every later word
  # reaches Vis verbatim — the one escape hatch the help promises must never eat
  # its own argument.
  # Arguments after `python uv` belong to uv, including a child command's flags.
  if [[ "${args[0]:-}" == python && "${args[1]:-}" == uv ]]; then end_of_flags=1; fi
  if (( end_of_flags )); then args+=("$arg"); continue; fi
  case "$arg" in
    --)        end_of_flags=1; args+=("$arg") ;;
    --measure) export VIS_MEASURE=1 ;;
    --jfr)     jfr=1 ;;
    --jvm)     jvm_requested=1 ;;
    --stream-trace) export VIS_STREAM_TRACE=1 ;;
    *) args+=("$arg") ;;
  esac
done
if (( ${#args[@]} > 0 )); then set -- "${args[@]}"; else set --; fi

# `tui` is a launcher-owned surface: the terminal client is a separate process,
# never prompt text for the one-shot agent. Keep its arguments verbatim after
# swallowing the command word.
tui_requested=0
if [[ "${1:-}" == tui ]]; then
  tui_requested=1
  shift
fi

# ── --jfr: Java Flight Recorder profiling ────────────────────────────────────
# Export VIS_JFR=1 so the client and detached gateway daemon each create their
# own role-tagged recording. This works for both JVM source and native-image.
if (( jfr )); then
  export VIS_JFR=1
  mkdir -p "$vis_home" 2>/dev/null || true
  warn "JFR profiling on → $vis_home/vis-{client,gateway}-<pid>-<ts>.jfr"
  warn "  snapshot: jcmd <pid> JFR.dump name=vis-<role>"
fi

# ── Provider SSE tracing: OPT-IN ─────────────────────────────────────────────
# svar's own stream tracer logs every SSE line with its gap and the running
# reasoning length. It answered its question — stunted thinking blocks are the
# provider's summarized output, not lost deltas — so it is off by default again;
# it costs tens of thousands of log lines per run. Turn it on with
# `--stream-trace` or `VIS_STREAM_TRACE=1` (`true`/`yes`/`on`). The switch is
# a system property svar reads at load, so it is passed to both runtimes;
# exporting the variable also carries it into the detached gateway daemon,
# where the model loop actually runs.
stream_trace_on() {
  case "${VIS_STREAM_TRACE:-0}" in
    1|true|TRUE|yes|YES|on|ON) return 0 ;;
  esac
  return 1
}
if stream_trace_on; then export VIS_STREAM_TRACE=1; fi

# ── Measurement ──────────────────────────────────────────────────────────────
measure_enabled() {
  case "${VIS_MEASURE:-0}" in
    1|true|TRUE|yes|YES|on|ON) return 0 ;;
    *) return 1 ;;
  esac
}

measure_now_ms() {
  perl -MTime::HiRes=time -e 'printf "%.3f", time() * 1000'
}

measure_log_since() {
  local label="$1"
  local start_ms="$2"
  if measure_enabled; then
    local end_ms elapsed_ms
    end_ms="$(measure_now_ms)"
    elapsed_ms="$(awk -v end="$end_ms" -v start="$start_ms" 'BEGIN { printf "%.1f", end - start }')"
    printf '[vis measure] shell:%s %s ms\n' "$label" "$elapsed_ms" >&2
  fi
}

measure_log() {
  if measure_enabled; then
    printf '[vis measure] shell:%s\n' "$1" >&2
  fi
}

run_measured_or_exec() {
  local label="$1"
  shift
  if measure_enabled; then
    local start_ms code
    start_ms="$(measure_now_ms)"
    "$@"
    code=$?
    measure_log_since "$label exit=$code" "$start_ms"
    exit "$code"
  else
    exec "$@"
  fi
}

# ── Runtime discovery ────────────────────────────────────────────────────────
# Prefer the managed source pin, synchronized by update when it already exists.
find_jvm_source() {
  # The runtime Vis OWNS (installed under ~/.vis) wins when present.
  if [[ -f "$managed_src/deps.edn" ]]; then printf '%s\n' "$managed_src"; return 0; fi
  # Otherwise auto-derive: when THIS wrapper is a tracked file inside a real Vis
  # checkout (deps.edn one level up — `launcher_is_git_owned`), run THAT checkout.
  # Invoking `bin/vis-agent` from a source tree with nothing installed obviously
  # means "run this tree", so run its live source through `clojure -M:vis`.
  # Location still decides nothing for an INSTALLED wrapper (no deps.edn beside
  # it) — this only fires for a checkout invocation with no owned runtime.
  if (( launcher_is_git_owned )) && [[ -f "$launcher_parent/deps.edn" ]]; then
    printf '%s\n' "$launcher_parent"; return 0
  fi
  return 1
}

# The released native wins: an installed one (beside this wrapper, or in Vis
# state) is preferred over `target/vis`, the binary the source Vis owns produced.
# Building one yourself never shadows a release.
find_native() {
  local candidate
  for candidate in "$bundled_native" \
                   "$vis_install_dir/vis-agent-native" \
                   "$managed_src/target/vis"; do
    [[ -x "$candidate" ]] || continue
    printf '%s\n' "$candidate"
    return 0
  done
  return 1
}

# Resolve trust from the active JDK as well as the host. Corporate macOS setups
# commonly install inspection roots in each SDKMAN JDK but not in Keychain. Linux
# CA packages instead maintain a Java store at one of the conventional paths
# below. VIS_TRUSTSTORE remains the explicit application override;
# VIS_SYSTEM_TRUSTSTORE and VIS_SYSTEM_CA_CERT cover non-standard locations.
find_system_java_truststore() {
  local candidate sdkman_candidates="${SDKMAN_CANDIDATES_DIR:-${HOME:-}/.sdkman/candidates}"
  if [[ -n "${VIS_SYSTEM_TRUSTSTORE:-}" ]]; then
    printf '%s\n' "$VIS_SYSTEM_TRUSTSTORE"
    return 0
  fi
  for candidate in "${JAVA_HOME:-}/lib/security/cacerts" \
                   "${JAVA_HOME:-}/jre/lib/security/cacerts" \
                   "$sdkman_candidates/java/current/lib/security/cacerts" \
                   "$sdkman_candidates/java/current/jre/lib/security/cacerts" \
                   /etc/ssl/certs/java/cacerts \
                   /etc/pki/java/cacerts \
                   /etc/pki/ca-trust/extracted/java/cacerts; do
    [[ -n "$candidate" && -r "$candidate" ]] || continue
    printf '%s\n' "$candidate"
    return 0
  done
  return 1
}

find_java_keytool() {
  local candidate resolved sdkman_candidates="${SDKMAN_CANDIDATES_DIR:-${HOME:-}/.sdkman/candidates}"
  for candidate in "${JAVA_HOME:-}/bin/keytool" \
                   "$sdkman_candidates/java/current/bin/keytool" \
                   keytool; do
    [[ -n "$candidate" ]] || continue
    if [[ "$candidate" == */* ]]; then
      [[ -x "$candidate" ]] || continue
      printf '%s\n' "$candidate"
      return 0
    fi
    resolved="$(command -v "$candidate" 2>/dev/null || true)"
    [[ -n "$resolved" ]] || continue
    printf '%s\n' "$resolved"
    return 0
  done
  return 1
}

# Turn a JDK trust store into the PEM format used by curl, Git, Node, Python and
# the process-wide composite TLS context. The original store remains untouched.
refresh_java_ca_bundle() {
  local store="$1" password="$2" trust_dir="$vis_home/trust" output="" tmp="" java_pem="" keytool="" ca_bundle=""
  [[ -n "$store" ]] || return 0
  output="$trust_dir/system-ca.pem"
  keytool="$(find_java_keytool 2>/dev/null || true)"
  [[ -n "$keytool" ]] || {
    warn "cannot export certificates from $store because keytool is unavailable"
    return 0
  }
  mkdir -p "$trust_dir" || {
    warn "cannot create $trust_dir; using the Java trust store only for Vis"
    return 0
  }
  tmp="$(mktemp "$trust_dir/.system-ca.XXXXXX")" || return 0
  java_pem="$(mktemp "$trust_dir/.java-ca.XXXXXX")" || {
    rm -f "$tmp"
    return 0
  }
  chmod 600 "$tmp" "$java_pem"
  if "$keytool" -J-Duser.language=en -list -rfc -keystore "$store" \
       -storepass "$password" 2>/dev/null |
       awk '/-----BEGIN CERTIFICATE-----/{copy=1} copy{print} /-----END CERTIFICATE-----/{copy=0}' \
       >"$java_pem" && grep -q -- '-----BEGIN CERTIFICATE-----' "$java_pem"; then
    ca_bundle="$(find_system_ca_bundle 2>/dev/null || true)"
    if [[ -n "$ca_bundle" ]]; then
      cat "$ca_bundle" >"$tmp"
      printf '\n' >>"$tmp"
    fi
    cat "$java_pem" >>"$tmp"
    mv -f "$tmp" "$output"
    rm -f "$java_pem"
    export_system_ca_bundle "$output"
  else
    rm -f "$tmp" "$java_pem"
    warn "could not export certificates from Java trust store $store"
  fi
}

is_wsl() {
  [[ -n "${WSL_DISTRO_NAME:-}" || "$(uname -r 2>/dev/null || true)" == *[Mm]icrosoft* ]]
}
export_system_ca_bundle() {
  local bundle="$1"
  export VIS_SYSTEM_CA_CERT="$bundle"
  export CURL_CA_BUNDLE="$bundle" SSL_CERT_FILE="$bundle" REQUESTS_CA_BUNDLE="$bundle"
  export NODE_EXTRA_CA_CERTS="$bundle" GIT_SSL_CAINFO="$bundle"
  # pip keeps its own explicit CA selection; runtime supplies the shared default.
  export AWS_CA_BUNDLE="$bundle" CARGO_HTTP_CAINFO="$bundle" DENO_CERT="$bundle"
}

# WSL has its own Linux trust database; installing a root in the Windows host
# does not copy it into the distribution. Export the host's CurrentUser and
# LocalMachine root stores through WSL interop when the managed bundle is
# created or refreshed. Ordinary launches reuse that bundle without invoking
# PowerShell; install/update refreshes it before network access.
refresh_wsl_windows_ca_bundle() {
  local powershell="" trust_dir="$vis_home/trust" output="" tmp="" linux_bundle=""
  output="$trust_dir/system-ca.pem"
  [[ -z "${VIS_SYSTEM_CA_CERT:-}" ]] || return 0
  is_wsl || return 0

  if command -v powershell.exe >/dev/null 2>&1; then
    powershell="$(command -v powershell.exe)"
  elif command -v pwsh.exe >/dev/null 2>&1; then
    powershell="$(command -v pwsh.exe)"
  else
    measure_log "Windows certificate export unavailable; using the WSL trust store"
    return 0
  fi

  mkdir -p "$trust_dir" || {
    warn "cannot create $trust_dir; using the WSL trust store"
    return 0
  }
  tmp="$(mktemp "$trust_dir/.wsl-system-ca.XXXXXX")" || return 0
  chmod 600 "$tmp"
  linux_bundle="$(find_system_ca_bundle 2>/dev/null || true)"
  if [[ -n "$linux_bundle" ]]; then
    cat "$linux_bundle" >"$tmp"
    printf '\n' >>"$tmp"
  fi
  # The dollar expressions belong to PowerShell, not Bash.
  # shellcheck disable=SC2016
  if "$powershell" -NoLogo -NoProfile -NonInteractive -Command '
      $ErrorActionPreference = "Stop"
      $seen = @{}
      foreach ($cert in Get-ChildItem -Path @(
          "Cert:\CurrentUser\Root",
          "Cert:\LocalMachine\Root") -ErrorAction Stop) {
        if (-not $seen.ContainsKey($cert.Thumbprint)) {
          $seen[$cert.Thumbprint] = $true
          "-----BEGIN CERTIFICATE-----"
          [System.Convert]::ToBase64String($cert.RawData)
          "-----END CERTIFICATE-----"
        }
      }
    ' 2>/dev/null | tr -d '\r' >>"$tmp" && [[ -s "$tmp" ]]; then
    mv -f "$tmp" "$output"
    export_system_ca_bundle "$output"
  else
    rm -f "$tmp"
    measure_log "Windows certificate export failed; using the WSL trust store"
  fi
}

find_system_ca_bundle() {
  local candidate
  if [[ -n "${VIS_SYSTEM_CA_CERT:-}" ]]; then
    printf '%s\n' "$VIS_SYSTEM_CA_CERT"
    return 0
  fi
  for candidate in "${SSL_CERT_FILE:-}" "${CURL_CA_BUNDLE:-}" \
                   /etc/ssl/certs/ca-certificates.crt \
                   /etc/pki/tls/certs/ca-bundle.crt \
                   /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem \
                   /etc/ssl/cert.pem; do
    [[ -n "$candidate" && -r "$candidate" ]] || continue
    printf '%s\n' "$candidate"
    return 0
  done
  return 1
}

trust_property_is_configured() {
  [[ " ${JAVA_TOOL_OPTIONS:-} ${JDK_JAVA_OPTIONS:-} ${_JAVA_OPTIONS:-} " == *" -Djavax.net.ssl.trustStore="* ]]
}

configure_system_trust() {
  local runtime="$1" refresh="${2:-0}" store="" store_type="" store_password="changeit" ca_bundle=""
  local explicit_ca_bundle="${VIS_SYSTEM_CA_CERT:-}" managed_ca_bundle="$vis_home/trust/system-ca.pem"
  trust_native_args=()
  trust_jvm_args=()
  if [[ -z "$explicit_ca_bundle" && "$refresh" != 1 && -r "$managed_ca_bundle" ]]; then
    export_system_ca_bundle "$managed_ca_bundle"
  else
    refresh_wsl_windows_ca_bundle
  fi

  if [[ -n "${VIS_SYSTEM_TRUSTSTORE:-}" && ! -r "$VIS_SYSTEM_TRUSTSTORE" ]]; then
    die "VIS_SYSTEM_TRUSTSTORE is not readable: $VIS_SYSTEM_TRUSTSTORE"
  fi
  if [[ -n "${VIS_SYSTEM_CA_CERT:-}" && ! -r "$VIS_SYSTEM_CA_CERT" ]]; then
    die "VIS_SYSTEM_CA_CERT is not readable: $VIS_SYSTEM_CA_CERT"
  fi

  if [[ -n "${VIS_TRUSTSTORE:-}" ]]; then
    [[ -r "$VIS_TRUSTSTORE" ]] || die "VIS_TRUSTSTORE is not readable: $VIS_TRUSTSTORE"
    store="$VIS_TRUSTSTORE"
    store_type="${VIS_TRUSTSTORE_TYPE:-PKCS12}"
    store_password="${VIS_TRUSTSTORE_PASSWORD:-changeit}"
  elif [[ -n "${VIS_SYSTEM_TRUSTSTORE:-}" ]] || ! trust_property_is_configured; then
    store="$(find_system_java_truststore 2>/dev/null || true)"
    if [[ -n "$store" ]]; then
      store_type="${VIS_SYSTEM_TRUSTSTORE_TYPE:-JKS}"
      store_password="${VIS_SYSTEM_TRUSTSTORE_PASSWORD:-changeit}"
    fi
  fi

  # A discovered SDKMAN/JAVA_HOME store is also the corporate source for tools
  # that cannot read JKS. An explicit PEM override remains exact and untouched.
  # The managed bundle is rebuilt during install/update, or lazily if an older
  # installation does not have one yet. Normal launches only export its path.
  if [[ -z "$explicit_ca_bundle" && ( "$refresh" = 1 || ! -r "$managed_ca_bundle" ) ]]; then
    refresh_java_ca_bundle "$store" "$store_password"
  fi
  if [[ -z "$explicit_ca_bundle" && -r "$managed_ca_bundle" ]]; then
    export_system_ca_bundle "$managed_ca_bundle"
  fi

  if [[ -n "$store" ]]; then
    trust_native_args=("-Djavax.net.ssl.trustStore=$store"
                       "-Djavax.net.ssl.trustStoreType=$store_type"
                       "-Djavax.net.ssl.trustStorePassword=$store_password")
    trust_jvm_args=("-J-Djavax.net.ssl.trustStore=$store"
                    "-J-Djavax.net.ssl.trustStoreType=$store_type"
                    "-J-Djavax.net.ssl.trustStorePassword=$store_password")
    measure_log "system Java trust enabled from $store"
  fi

  ca_bundle="$(find_system_ca_bundle 2>/dev/null || true)"
  if [[ -n "$ca_bundle" ]]; then
    if [[ -n "${VIS_SYSTEM_CA_CERT:-}" ]]; then
      export_system_ca_bundle "$ca_bundle"
    else
      [[ -n "${CURL_CA_BUNDLE:-}" ]] || export CURL_CA_BUNDLE="$ca_bundle"
      [[ -n "${SSL_CERT_FILE:-}" ]] || export SSL_CERT_FILE="$ca_bundle"
      [[ -n "${REQUESTS_CA_BUNDLE:-}" ]] || export REQUESTS_CA_BUNDLE="$ca_bundle"
      [[ -n "${NODE_EXTRA_CA_CERTS:-}" ]] || export NODE_EXTRA_CA_CERTS="$ca_bundle"
      [[ -n "${GIT_SSL_CAINFO:-}" ]] || export GIT_SSL_CAINFO="$ca_bundle"
      [[ -n "${PIP_CERT:-}" ]] || export PIP_CERT="$ca_bundle"
      [[ -n "${AWS_CA_BUNDLE:-}" ]] || export AWS_CA_BUNDLE="$ca_bundle"
      [[ -n "${CARGO_HTTP_CAINFO:-}" ]] || export CARGO_HTTP_CAINFO="$ca_bundle"
      [[ -n "${DENO_CERT:-}" ]] || export DENO_CERT="$ca_bundle"
      export VIS_SYSTEM_CA_CERT="$ca_bundle"
    fi
    measure_log "system PEM trust enabled from $ca_bundle"
  fi
}

# A selected native track never falls back to source. Direct checkout execution
# remains available before an installation is selected; dev always ignores native.
runtime_effective() {
  case "$(read_state "$vis_track_file")" in
    dev) printf 'jvm\n' ;;
    release|beta) printf 'native\n' ;;
    *)
      if (( launcher_is_git_owned )) && ! find_native >/dev/null 2>&1; then
        printf 'jvm\n'
      else
        printf 'native\n'
      fi
      ;;
  esac
}

clojure_cli_ready() {
  command -v clojure >/dev/null 2>&1
}

ensure_clojure_cli() {
  clojure_cli_ready && return 0
  case "${VIS_NO_AUTO_INSTALL:-}" in
    1|true|TRUE|yes|YES|on|ON)
      return 1
      ;;
  esac

  local os installer
  os="$(uname -s 2>/dev/null || printf 'unknown')"
  case "$os" in
    Darwin)
      if ! command -v brew >/dev/null 2>&1; then
        warn "Clojure CLI is missing and Homebrew is not installed"
        warn "Install Homebrew from https://brew.sh, then run this command again"
        return 1
      fi
      say "Clojure CLI not found; installing it with Homebrew"
      brew install clojure/tools/clojure || return 1
      hash -r 2>/dev/null || true
      ;;
    Linux)
      if ! command -v curl >/dev/null 2>&1; then
        warn "Clojure CLI is missing and curl is not installed"
        return 1
      fi
      mkdir -p "$clojure_install_dir" || return 1
      installer="$(mktemp "${TMPDIR:-/tmp}/vis-clojure-install.XXXXXX")" || return 1
      say "Clojure CLI not found; installing it under $clojure_install_dir"
      if ! curl -fL "https://github.com/clojure/brew-install/releases/latest/download/linux-install.sh" -o "$installer"; then
        rm -f "$installer"
        return 1
      fi
      chmod +x "$installer"
      if ! "$installer" --prefix "$clojure_install_dir"; then
        rm -f "$installer"
        return 1
      fi
      rm -f "$installer"
      export PATH="$clojure_install_dir/bin:$PATH"
      hash -r 2>/dev/null || true
      ;;
    *)
      warn "Clojure CLI is missing and automatic installation is unsupported on $os"
      return 1
      ;;
  esac

  if clojure_cli_ready; then
    say "Clojure CLI is ready"
    return 0
  fi
  warn "Clojure CLI installation finished, but 'clojure' is still not on PATH"
  return 1
}

# Runtime selection is independent of the GraalVM native-image build toolchain.
# Respect an explicit selector: a broken JAVA_CMD/JAVA_HOME is an error, not a fallback.
ensure_java_runtime() {
  local java_cmd properties major
  if [[ -n "${JAVA_CMD:-}" ]]; then
    java_cmd="$(command -v "$JAVA_CMD" 2>/dev/null || true)"
  elif [[ -n "${JAVA_HOME:-}" ]]; then
    java_cmd="$JAVA_HOME/bin/java"
  else
    java_cmd="$(command -v java 2>/dev/null || true)"
  fi
  if [[ -z "$java_cmd" || ! -x "$java_cmd" ]]; then
    warn "Java not found; install a JDK 25+ or set JAVA_CMD / JAVA_HOME"
    return 1
  fi
  if ! properties="$("$java_cmd" -XshowSettings:properties -version 2>&1)"; then
    warn "could not run Java: $java_cmd"
    return 1
  fi
  major="$(printf '%s\n' "$properties" | sed -n 's/^ *java\.specification\.version = //p')"
  if [[ ! "$major" =~ ^[0-9]+$ ]] || (( 10#$major < 25 )); then
    warn "JDK 25+ required; selected Java reports '${major:-unknown}' ($java_cmd)"
    return 1
  fi
  export JAVA_CMD="$java_cmd"
}

# ── Release bundle ───────────────────────────────────────────────────────────
# Every supported platform has an engine/Python bundle and a matching TUI bundle.
#   vis-agent-<os>-<arch>.tar.gz and vis-tui-<os>-<arch>.tar.gz
vis_platform_asset() {
  local os arch
  case "$(uname -s)" in
    Darwin) os=macos ;;
    Linux)  os=linux ;;
    *) die "update: unsupported OS $(uname -s)" ;;
  esac
  case "$(uname -m)" in
    arm64|aarch64) arch=arm64 ;;
    x86_64|amd64)  arch=x64 ;;
    *) die "update: unsupported architecture $(uname -m)" ;;
  esac
  printf 'vis-agent-%s-%s.tar.gz' "$os" "$arch"
}

# Exact-name match: the trailing quote keeps the bundle from matching a longer
# sibling asset (checksum, signature) that shares its name as a prefix.
vis_asset_url() {
  local json="$1" name="$2" url
  url="$(printf '%s' "$json" | grep -o "https://[^\"]*/${name}\"" | head -1)" || url=""
  printf '%s' "${url%\"}"
}

require_cmd() {
  local cmd="$1" why="$2"
  command -v "$cmd" >/dev/null 2>&1 || die "update: $why needs '$cmd' on PATH"
}

# ── update: source runtime ───────────────────────────────────────────────────
# Follow the development branch: the checkout Vis owns is moved onto the newest
# commit of `$vis_branch`, or onto an exact ref you name. Release tags are not
# consulted at all by default — a release is a commit like any other, and asking
# for the newest tag is how an install lands on published-but-broken source. A
# checkout of your own is never moved by this path: git owns it.
#
# Pinned is meant literally. This source is built by hand — `git init` plus ONE
# shallow ref — rather than cloned, and every branch and remote-tracking ref is
# dropped afterwards. A clone left `main` behind: HEAD sat on the pin while
# `git checkout main && git pull` walked the source Vis actually runs a hundred
# commits past it, having downloaded the whole history to do it. What is not
# there cannot be followed, and an install downloads one commit instead of every
# commit ever made.

# Repair derived indexes first. Damaged pack data needs a verified fresh checkout
# while retaining the original source directory for recovery (#177).
repair_pack_indexes() {
  local pack index index_error
  for pack in "$managed_src/.git/objects/pack/"*.pack; do
    [[ -f "$pack" ]] || continue
    index="${pack%.pack}.idx"
    if [[ -r "$index" ]] && git -C "$managed_src" verify-pack "$index" >/dev/null 2>&1; then
      continue
    fi
    say "rebuilding pack index for ${pack##*/}"
    if ! index_error="$(git -C "$managed_src" index-pack "$pack" 2>&1)"; then
      [[ -z "$index_error" ]] || printf '%s\n' "$index_error" >&2
      return 1
    fi
  done
}

# Fetch exactly one ref and nothing else. A transport reset is not evidence that
# `main` disappeared: retry the same shallow fetch first. Only an `ls-remote`
# result that proves the ref is not advertised unlocks the existing exact-SHA
# fallback through branch history.
fetch_pinned_ref() {
  local ref="$1" attempt advertised_status fetch_error="" advertisement_error=""
  for attempt in 1 2 3; do
    if fetch_error="$(git -C "$managed_src" fetch --quiet --force --depth 1 origin "$ref" 2>&1)"; then
      return 0
    fi
    if (( attempt < 3 )); then
      say "fetch failed for $ref - retrying ($((attempt + 1))/3)"
      sleep "$attempt"
    fi
  done

  if advertisement_error="$(git -C "$managed_src" ls-remote --exit-code origin "$ref" 2>&1)"; then
    [[ -z "$fetch_error" ]] || printf '%s\n' "$fetch_error" >&2
    return 1
  else
    advertised_status=$?
  fi
  if (( advertised_status != 2 )); then
    [[ -n "$advertisement_error" ]] || advertisement_error="$fetch_error"
    [[ -z "$advertisement_error" ]] || printf '%s\n' "$advertisement_error" >&2
    return 1
  fi

  say "$ref is not an advertised branch or tag — fetching history to find it"
  git -C "$managed_src" fetch --force --prune origin '+refs/heads/*:refs/remotes/origin/*'
}

# Leave no branch to step off: with every local and remote-tracking branch gone
# the pinned commit is reachable through HEAD alone, and `git checkout main` in
# there has nothing to check out.
drop_moving_refs() {
  local ref
  while read -r ref; do
    [[ -z "$ref" ]] || git -C "$managed_src" update-ref -d "$ref" 2>/dev/null || true
  done < <(git -C "$managed_src" for-each-ref --format='%(refname)' refs/heads refs/remotes 2>/dev/null)
}

# Stage recovery beside the source so directory renames stay on the same filesystem.
recover_source() {
  local ref="$1" recovery pinned
  recovery="$(mktemp -d "$vis_install_dir/src-recovery.XXXXXX")" || exit 1
  say "damaged source pack; downloading a fresh checkout"
  if ! (
    managed_src="$recovery/src" managed_ref_file="$recovery/ref" update_source "$ref"
    git -C "$recovery/src" fsck --full --no-dangling
  ); then
    die "update: source recovery failed; original source and pin were preserved" \
        "Retry with 'vis-agent update'. Recovery files: $recovery"
  fi
  pinned="$(cat "$recovery/ref")" || exit 1
  mv "$managed_src" "$recovery/previous" || exit 1
  if ! mv "$recovery/src" "$managed_src"; then
    mv "$recovery/previous" "$managed_src" || \
      die "update: restore the preserved source from $recovery/previous"
    die "update: could not install recovered source; original restored. Retry 'vis-agent update'."
  fi
  printf '%s\n' "$pinned" > "$managed_ref_file"
  say "source recovered; previous source preserved at $recovery/previous"
}

require_clean_source() {
  local changes
  changes="$(git -C "$managed_src" status --porcelain --untracked-files=all)" || \
    die "update: cannot inspect source at $managed_src. Repair the checkout and retry."
  [[ -z "$changes" ]] || die "update: local modifications in $managed_src." \
    "Commit or stash local changes (including untracked files), then retry; no source files were replaced."
}

update_source() {
  local ref="${1:-}" target pinned
  require_cmd git "the source runtime"
  # `latest` is the source runtime's moving main, not a literal Git ref.
  [[ "$ref" != latest ]] || ref=""
  if [[ ! -d "$managed_src/.git" ]]; then
    say "creating $managed_src for $vis_repo_slug"
    mkdir -p "$managed_src" || exit 1
    git -C "$managed_src" init --quiet || exit 1
  fi
  if ! repair_pack_indexes; then
    recover_source "$ref"
    return
  fi
  require_clean_source
  git -C "$managed_src" remote add origin "$vis_repo_url" 2>/dev/null \
    || git -C "$managed_src" remote set-url origin "$vis_repo_url" || exit 1
  # This source is a detached pin, never a branch — so even a hand-run `git fetch`
  # in there brings back nothing to step onto.
  git -C "$managed_src" config remote.origin.fetch \
      "+refs/heads/$vis_branch:refs/remotes/origin/$vis_branch" || exit 1
  if [[ -z "$ref" ]]; then
    ref="$vis_branch"
    say "asking $vis_repo_slug for the newest commit on $vis_branch"
  fi
  say "fetching $ref for $managed_src"
  fetch_pinned_ref "$ref" || exit 1
  # A named branch never becomes a local ref here, so check out what was fetched.
  target="$ref"
  if [[ ! "$ref" =~ ^[0-9a-f]{40}$ ]]; then
    git -C "$managed_src" rev-parse --verify --quiet "$ref^{commit}" >/dev/null 2>&1 \
      || target=FETCH_HEAD
  fi
  # The old detached pin is Vis-owned implementation state, not a local commit the
  # reader needs Git's branch-recovery warning for.
  git -C "$managed_src" checkout --quiet --detach "$target" || exit 1
  drop_moving_refs
  # The pin recorded is the COMMIT, never the branch that pointed at it: a branch
  # name in there is a moving pin, and no drift check can verify a moving pin.
  pinned="$(git -C "$managed_src" rev-parse --verify HEAD)" || exit 1
  mkdir -p "$vis_install_dir"
  printf '%s\n' "$pinned" > "$managed_ref_file"
  say "source pinned at $pinned ($managed_src)"
}

# ── update: the vis-agent command itself ─────────────────────────────────────
# The command and its runtime must never drift apart, so an update refreshes
# both. A release bundle carries the wrapper beside the native runtime; a source
# update copies the wrapper out of the source it just pinned, because an
# installed wrapper is a COPY made at install time and nothing else refreshes
# it. A wrapper that lives IN a checkout is source: git owns it, never this.
sync_wrapper_from_source() {
  local source_root="$1" incoming="$1/bin/vis-agent"
  (( ! launcher_is_git_owned )) || return 0
  [[ -f "$incoming" ]] || return 0
  if cmp -s "$incoming" "$launcher_path"; then return 0; fi
  if [[ ! -w "$launcher_path" || ! -w "$bin_dir" ]]; then
    die "update: cannot replace the vis-agent command at $launcher_path (permission denied)" \
        "Re-run with the permissions used to install that command."
  fi
  # Replacing the file in place is safe: Bash has already read this script.
  if install -m 0755 "$incoming" "$launcher_path.tmp" 2>/dev/null \
     && mv -f "$launcher_path.tmp" "$launcher_path" 2>/dev/null; then
    say "vis-agent command updated from $source_root"
  else
    rm -f "$launcher_path.tmp" 2>/dev/null || true
    die "update: could not replace the vis-agent command at $launcher_path" \
        "The source runtime was updated, but this command must be updated with it."
  fi
}

# The beta publication gate records its newest complete immutable release here.
# GitHub's release listing order does not identify the newest published beta.
vis_beta_tag() {
  local tag
  tag="$(curl -fsSL "https://github.com/$vis_repo_slug/releases/download/installer/native-beta")" || \
    die "update: could not read the published native beta selection"
  [[ "$tag" =~ ^beta-[0-9a-f]{40}$ ]] || \
    die "update: invalid published native beta selection"
  printf '%s\n' "$tag"
}

# Releases replace the launcher and its native runtime together.
update_native() {
  local target="${1:-latest}" track="${2:-release}"
  require_cmd curl "the native runtime"
  require_cmd tar "the native runtime"
  local asset api dl json archive unpack native_dir tui_asset tui_dl tui_archive tui_unpack
  local native_version native_commit _native_metadata
  asset="$(vis_platform_asset)"
  if [[ "$track" == beta ]]; then target="$(vis_beta_tag)" || exit 1; fi
  if [[ "$target" != latest ]]; then
    api="https://api.github.com/repos/$vis_repo_slug/releases/tags/$target"
  else
    api="https://api.github.com/repos/$vis_repo_slug/releases/latest"
  fi
  say "resolving $asset on the $track track from $api"
  json="$(curl -fsSL "$api")" || true
  # `set -o pipefail` + `set -e` would kill this function on a no-match grep,
  # swallowing the actionable message below. Keep the failure local.
  dl="$(vis_asset_url "$json" "$asset")"
  if [[ -z "$dl" ]]; then
    die "update: no native runtime published for '$asset' on the $track track." \
        "Checked $api" \
        "Native bundles support Linux x64/arm64 and macOS arm64." \
        "No JVM fallback was installed. For source development use vis-agent update --track dev."
  fi

  tui_asset="${asset/vis-agent-/vis-tui-}"
  tui_dl="$(vis_asset_url "$json" "$tui_asset")"
  [[ -n "$tui_dl" ]] || die "update: incomplete release: missing $tui_asset" \
      "The engine and terminal client must come from the same release."
  # Where the private runtime belongs: beside an installed launcher, or in Vis
  # state when the launcher is a tracked checkout file we must never overwrite.
  if (( launcher_is_git_owned )); then
    mkdir -p "$vis_install_dir"
    native_dir="$vis_install_dir"
  else
    [[ -w "$bin_dir" && -w "$launcher_path" ]] || \
      die "update: cannot replace the installation in $bin_dir (permission denied)" \
          "Re-run with the permissions used for that directory."
    native_dir="$bin_dir"
  fi

  archive="$(mktemp "${TMPDIR:-/tmp}/vis-agent-bundle.XXXXXX.tar.gz")"
  unpack="$(mktemp -d "${TMPDIR:-/tmp}/vis-agent-unpack.XXXXXX")"
  tui_archive="$(mktemp "${TMPDIR:-/tmp}/vis-tui-bundle.XXXXXX.tar.gz")"
  tui_unpack="$(mktemp -d "${TMPDIR:-/tmp}/vis-tui-unpack.XXXXXX")"
  trap 'rm -rf "$unpack" "$archive" "$tui_unpack" "$tui_archive"' EXIT
  say "downloading $dl"
  curl -fSL "$dl" -o "$archive" || exit 1
  tar -xzf "$archive" -C "$unpack" || exit 1
  say "downloading $tui_dl"
  curl -fSL "$tui_dl" -o "$tui_archive" || exit 1
  tar -xzf "$tui_archive" -C "$tui_unpack" || exit 1
  [[ -x "$unpack/vis-agent" && -x "$unpack/vis-agent-native" && -s "$unpack/vis-agent-native.build" ]] || \
    die "update: the release bundle is missing its launcher, native runtime or build stamp"
  if [[ ! -d "$unpack/vis-agent-python/python" ]] || ! compgen -G "$unpack/vis-agent-python/libvispython.*" >/dev/null; then
    die "update: the release bundle is missing its Python runtime"
  fi
  [[ -x "$tui_unpack/vis-tui" ]] || die "update: the release bundle is missing its terminal client"
  read -r native_version native_commit _native_metadata < "$unpack/vis-agent-native.build" || \
    die "update: invalid build stamp; native installation unchanged."
  say "selected native $native_version revision $native_commit ($track)"
  if [[ -e "$managed_src" ]]; then
    [[ "$native_commit" =~ ^[0-9a-f]{40}$ ]] || \
      die "update: build stamp has no exact source commit; native installation unchanged."
    # Refresh before replacing native so a dirty tree or failed fetch leaves it intact.
    # A subshell contains update_source's exit paths and keeps native launcher ownership.
    if ! (
      require_cmd git "refreshing existing source"
      require_clean_source
      update_source "$native_commit"
    ); then
      die "update: source refresh failed for native $native_version revision $native_commit." \
        "Native installation and selected track unchanged; resolve the source error and retry."
    fi
    say "source $(cat "$managed_src/VIS_VERSION" 2>/dev/null || printf unknown) revision $native_commit"
  else
    say "no managed source checkout; native-only update"
  fi
  mv -f "$unpack/vis-agent-native" "$native_dir/vis-agent-native"
  mv -f "$unpack/vis-agent-native.build" "$native_dir/vis-agent-native.build"
  mv -f "$tui_unpack/vis-tui" "$native_dir/vis-tui"
  # The embedded-CPython sidecar travels WITH the runtime it was built for: the
  # interpreter is a cdylib plus a vendored tree, never part of the binary.
  # Always clear the old one first, so a stale directory cannot outlive a
  # downgrade and hand the runtime an interpreter it was not built against.
  rm -rf "$native_dir/vis-agent-python"
  mv -f "$unpack/vis-agent-python" "$native_dir/vis-agent-python"
  if (( launcher_is_git_owned )); then
    # Never overwrite a tracked development launcher: the released one lives in
    # Vis state; source stays the checkout's responsibility.
    mv -f "$unpack/vis-agent" "$vis_install_dir/vis-agent"
    [[ ! -f "$unpack/install-vis-agent" ]] || mv -f "$unpack/install-vis-agent" "$vis_install_dir/install-vis-agent"
  else
    # Installed bundles are co-located: the public wrapper and its private native
    # sidecar update together. This Bash process has already read itself.
    mv -f "$unpack/vis-agent" "$launcher_path"
    [[ ! -f "$unpack/install-vis-agent" ]] || mv -f "$unpack/install-vis-agent" "$bin_dir/install-vis-agent"
  fi
  rm -rf "$unpack" "$archive" "$tui_unpack" "$tui_archive"
  trap - EXIT
  say "installed launcher + native runtime + Python + TUI: $native_version revision $native_commit ($track)"
}

vis_update_usage() {
  cat >&2 <<'EOF'
Usage: vis-agent update [vX.Y.Z] [--track release|beta|dev] [--keep-gateway]
         --track NAME  release  newest complete stable native release (default)
                       beta     newest published native beta from green main CI
                       dev      newest main source, always run on the JVM
         vX.Y.Z        install that version on the release track only
         --keep-gateway
                       leave a running gateway alone. Otherwise an idle managed
                       gateway is released before replacing its old runtime.
                       Busy or user-owned gateways are never stopped.

         Every update without --track selects release, even after beta or dev.
         A successful update records the selection for subsequent launches.
         Native updates include the matching Python worker and terminal client.
         Existing managed source is pinned to the native build commit; Git is required.
         Local source changes must be committed or stashed before updating.
         Dev requires Git and JDK 25+; it never builds or selects a native image.
EOF
}

# Release an IDLE managed gateway BEFORE replacing the runtime, using the client that
# started it and therefore still speaks its protocol. Doing this after the install made
# a protocol-3 client ask a protocol-2 gateway to stop; the safety query itself was
# refused, so a successful update ended with a fatal-looking mismatch. An idle daemon
# holds no work, so a later install failure costs nothing: the next client starts the
# still-installed runtime again. A busy or user-owned daemon is never touched, and a
# failure here never fails the update. Once its users leave, it self-reaps; the next
# client starts the build now on disk.
release_stale_gateway() {
  local native source_root
  case "$(runtime_effective)" in
    native)
      native="$(find_native 2>/dev/null || true)"
      [[ -n "$native" ]] || return 0
      "$native" "-Duser.home=${HOME:-$vis_home}" gateway stop --if-idle || true
      ;;
    jvm)
      source_root="$(find_jvm_source 2>/dev/null || true)"
      [[ -n "$source_root" ]] || return 0
      ( cd "$source_root" && clojure -M:vis gateway stop --if-idle ) || true
      ;;
  esac
}
# One public selector; commit its state only after installation succeeds.
vis_do_update() {
  local target="" keep_gateway=0 track=release arg
  while (( $# )); do
    arg="$1"
    case "$arg" in
      --keep-gateway) keep_gateway=1 ;;
      --track) track="${2:-}"; [[ -n "$track" ]] || die "update: --track needs release, beta or dev"; shift ;;
      --track=*) track="${arg#*=}" ;;
      -h|--help) vis_update_usage; exit 0 ;;
      -*) die "update: unknown option $arg" "Run: vis-agent update --help" ;;
      latest|v[0-9]*)
        [[ -z "$target" ]] || die "update: one version at a time"
        target="$arg"
        ;;
      *) die "update: '$arg' is not a released version" "Use --track dev for main source" ;;
    esac
    shift
  done
  case "$track" in
    release|beta|dev) ;;
    *) die "update: unknown track '$track'" "Tracks are release, beta and dev" ;;
  esac
  [[ -z "$target" || "$target" == latest || "$track" == release ]] || \
    die "update: versions are available only on the release track"
  mkdir -p "$vis_install_dir"

  # Use the OLD selection and executable to talk to its own gateway protocol.
  if (( keep_gateway )); then
    say "leaving the gateway alone (--keep-gateway)"
  else
    release_stale_gateway
  fi
  case "$track" in
    dev)
      update_source
      sync_wrapper_from_source "$managed_src"
      ;;
    release|beta)
      update_native "${target:-latest}" "$track"
      ;;
  esac
  printf '%s\n' "$track" > "$vis_track_file.tmp"
  mv -f "$vis_track_file.tmp" "$vis_track_file"
  say "installed the $track track"
  exit 0
}

# ── Wrapper-owned commands. The Vis app never sees these. ────────────────────
case "${1:-}" in
  runtime) die "unknown command: runtime" "Run: vis-agent update --help" ;;
  update)
    shift
    (( ! jvm_requested )) || die "update: --jvm selects a launch runtime, not an update track" \
      "Use: vis-agent update --track dev"
    # Git and curl need the same corporate roots as the runtime they update.
    configure_system_trust "$(runtime_effective)" 1
    vis_do_update "$@"
    ;;
esac

# ── Launch ───────────────────────────────────────────────────────────────────
runtime="$(runtime_effective)"
if (( jvm_requested )); then runtime=jvm; fi

# A native terminal client is deliberately a sibling process, not code linked
# into the engine image. Native tracks use it; dev launches the app from the same
# pinned source checkout. Missing clients never become prompt text for a model.
# Explicit targets and informational commands never acquire a local gateway.
tui_local=1
[[ -z "${VIS_GATEWAY_URL:-}" || -z "${VIS_GATEWAY_URL// /}" ]] || tui_local=0
for arg in "$@"; do
  case "$arg" in
    --gateway|--gateway=*|--gateway-token|--gateway-token=*|--help|-h|help|--version|-V|version) tui_local=0 ;;
  esac
done
if (( tui_requested )) && [[ "$runtime" == native ]]; then
  native_runtime="$(find_native 2>/dev/null || true)"
  native_home="${native_runtime:+$(cd -P "$(dirname "$native_runtime")" && pwd)}"
  tui_runtime=""
  for candidate in "${native_home:+$native_home/vis-tui}" "$vis_install_dir/vis-tui"; do
    if [[ -x "$candidate" ]]; then tui_runtime="$candidate"; break; fi
  done
  if [[ -z "$tui_runtime" ]] && command -v vis-tui >/dev/null 2>&1; then
    tui_runtime="$(command -v vis-tui)"
  fi
  if [[ -n "$tui_runtime" ]]; then
    configure_system_trust native
    measure_log "native TUI → $tui_runtime"
    cd "$invocation_cwd"
    if (( ! tui_local )); then
      run_measured_or_exec "process native TUI" "$tui_runtime" "-Duser.home=${HOME:-$vis_home}" "$@"
    fi
    [[ -n "$native_runtime" ]] || die "the native engine is not installed" "Run: vis-agent update"
    set -- gateway tui -- "$tui_runtime" "-Duser.home=${HOME:-$vis_home}" "$@"
  fi
  if [[ -z "$tui_runtime" ]]; then
    die "the native terminal client is not installed" \
        "Run: vis-agent update" "For JVM development: vis-agent update --track dev"
  fi
fi

configure_system_trust "$runtime"
case "$runtime" in
  native)
    native_runtime="$(find_native 2>/dev/null || true)"
    [[ -n "$native_runtime" ]] || die "no Vis runtime is installed" \
                                      "Install it:  vis-agent update"
    measure_log "native → $native_runtime"
    cd "$invocation_cwd"
    # Native-image does not derive Java's user.home from HOME. Pass it through
    # the wrapper so release and container builds never retain the builder's home.
    # The Python interpreter is NOT inside the binary: the image carries the FFM
    # bridge, while the interpreter itself ships as a cdylib plus a vendored
    # CPython tree in `vis-agent-python/` beside the runtime. Point the runtime
    # at that cdylib; it takes the interpreter home from the `python/` directory
    # beside it. Without this every Python tool dies with "no runtime library".
    native_home="$(cd -P "$(dirname "$native_runtime")" && pwd)"
    if [[ -z "${VIS_PYTHON_NATIVE_PATH:-}" ]]; then
      for candidate in "$native_home/vis-agent-python" "$native_home/python"; do
        [[ -d "$candidate" ]] || continue
        for library in "$candidate"/libvispython.*; do
          [[ -f "$library" ]] || continue
          export VIS_PYTHON_NATIVE_PATH="$library"
          break
        done
        [[ -z "${VIS_PYTHON_NATIVE_PATH:-}" ]] || break
      done
    fi
    stream_trace_args=()
    if stream_trace_on; then stream_trace_args=("-Dsvar.stream.trace=true"); fi
    run_measured_or_exec "process native runtime" "$native_runtime" "-Duser.home=${HOME:-$vis_home}" ${trust_native_args[@]+"${trust_native_args[@]}"} ${stream_trace_args[@]+"${stream_trace_args[@]}"} "$@"
    ;;
  jvm)
    source_root="$(find_jvm_source 2>/dev/null || true)"
    if [[ -z "$source_root" ]]; then
      die "the JVM source runtime is not installed" \
          "Install it:  vis-agent update --track dev"
    fi
    if ! ensure_java_runtime; then
      die "the source runtime needs JDK 25+ (any distribution)" \
          "Set JAVA_CMD or JAVA_HOME; GraalVM is required only to build native images"
    fi
    if ! ensure_clojure_cli; then
      die "the source runtime needs the Clojure CLI" \
          "Automatic installation failed; set VIS_NO_AUTO_INSTALL=1 to disable it"
    fi
    ;;
esac

# ── JVM source launch ────────────────────────────────────────────────────────
absolute_project_classpath() {
  local project_root="$1" raw entry out=""
  shift
  raw="$(clojure "$@")" || return 1
  local IFS=':'
  for entry in $raw; do
    [[ -z "$entry" ]] && continue
    [[ "$entry" != /* ]] && entry="$project_root/$entry"
    out="${out:+$out:}$entry"
  done
  printf '%s' "$out"
}

if (( tui_requested )); then
  tui_root="$source_root/apps/vis-tui"
  [[ -f "$tui_root/deps.edn" ]] || die "the terminal UI is not installed" \
    "Run:  vis-agent update --track dev"
  measure_log "JVM TUI → $tui_root"
  cd "$tui_root"
  tui_classpath="$(absolute_project_classpath "$tui_root" -Spath -M:run)" || exit 1
  tui_command=(clojure -J--enable-native-access=ALL-UNNAMED "-J-Duser.dir=$invocation_cwd" ${trust_jvm_args[@]+"${trust_jvm_args[@]}"} -Scp "$tui_classpath" -M:run)
  if (( ! tui_local )); then
    run_measured_or_exec "process JVM TUI" "${tui_command[@]}" "$@"
  fi
  # The engine resolves its own classpath below and re-execs that JVM for the daemon.
  set -- gateway tui -- "$JAVA_CMD" --enable-native-access=ALL-UNNAMED "-Duser.dir=$invocation_cwd" ${trust_native_args[@]+"${trust_native_args[@]}"} -cp "$tui_classpath" clojure.main -m com.blockether.vis.tui.main "$@"
fi

stream_trace_jvm_opts=()
if stream_trace_on; then
  stream_trace_jvm_opts=("-J-Dsvar.stream.trace=true")
  measure_log "svar stream trace enabled"
fi

# Preserve the invocation directory through user.dir while resolving deps from
# the selected source. Git dependencies compile their JVM bridges into their own
# prep output; tools.deps skips work whose :deps/prep-lib :ensure path exists.
measure_log "exec cold clojure -M:vis from $source_root"
cd "$source_root"
# `prep` compiles a git dependency's own JVM bridge, and tools.deps skips the work
# when the :ensure path is already there — but finding that out costs a JVM start,
# measured at 1.03s on EVERY vis-agent invocation, for a step that does nothing
# after the first. So the answer is remembered against the thing that invalidates
# it: the dependency set. A changed deps.edn (a bumped pin, a new library) is a
# different stamp and preps again.
vis_prep_stamp=""
if command -v shasum >/dev/null 2>&1; then
  vis_prep_stamp="$(shasum -a 256 "$source_root/deps.edn" 2>/dev/null | cut -d' ' -f1)"
fi
vis_prep_marker="$vis_home/run/prepped-${vis_prep_stamp:-none}"
if [[ -z "$vis_prep_stamp" || ! -f "$vis_prep_marker" ]]; then
  clojure -X:deps prep >&2 || exit 1
  if [[ -n "$vis_prep_stamp" ]]; then
    mkdir -p "$vis_home/run" 2>/dev/null || true
    : > "$vis_prep_marker" 2>/dev/null || true
  fi
fi
# The classpath tools.deps caches names this project's own roots RELATIVELY
# (`src`, `resources`, …), and the JVM resolves a relative classpath entry
# against `user.dir` — which the launch below deliberately points at the
# INVOCATION directory, not this checkout. Left alone, a dev run from any
# other directory dies with "Could not locate com/blockether/vis/core". So the
# cached classpath is read back (`-Spath` costs no JVM once the cache is fresh),
# every relative entry is anchored to the source root, and `-Scp` hands the
# absolute one over; the alias' :jvm-opts/:main-opts still come from the cache.
vis_classpath="$(absolute_project_classpath "$source_root" -Spath -M:vis)" || exit 1
run_measured_or_exec "process cold clojure -M:vis" clojure "-J-Duser.dir=$invocation_cwd" ${trust_jvm_args[@]+"${trust_jvm_args[@]}"} ${stream_trace_jvm_opts[@]+"${stream_trace_jvm_opts[@]}"} -Scp "$vis_classpath" -M:vis "$@"
