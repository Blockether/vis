#!/usr/bin/env bash
# vis-agent — the one public Vis command.
#
# It does three things and nothing else:
#   1. run Vis on the selected runtime,
#   2. show or persist that selection   (`vis-agent runtime`),
#   3. update that same runtime         (`vis-agent update`).
#
# Three runtimes, one word each:
#   native  the published runtime, downloaded beside this wrapper
#   jvm     `clojure -M:vis` from source pinned to the newest vX.Y.Z tag
#   dev     `clojure -M:vis` from a live checkout — the only moving runtime
#
# Vis follows releases by default; `dev` is opt-in. Everything Vis owns lives
# under ~/.vis:
#   runtime                    persisted selection (absent = automatic)
#   install/vis-agent-native   the private native runtime
#   install/src                the checkout Vis owns
#   install/ref                the tag or commit that checkout is pinned to
#
# Install with `bin/install-vis-agent` (`--runtime jvm` for the source runtime);
# it installs this wrapper and then lets it fetch its own runtime, so wrapper and
# runtime can never drift apart.

set -euo pipefail

invocation_cwd="$PWD"

vis_home="${VIS_HOME:-$HOME/.vis}"
vis_install_dir="$vis_home/install"
vis_runtime_file="$vis_home/runtime"
vis_repo_slug="${VIS_REPO_SLUG:-Blockether/vis}"
managed_src="$vis_install_dir/src"
managed_ref_file="$vis_install_dir/ref"

say()  { printf 'vis-agent: %s\n' "$*"; }
warn() { printf 'vis-agent: %s\n' "$*" >&2; }
die()  { printf 'vis-agent: %s\n' "$1" >&2; shift; for line in "$@"; do printf '  %s\n' "$line" >&2; done; exit 1; }

# First non-blank line of a state file, or nothing.
read_state() {
  [[ -f "$1" ]] || return 0
  head -n1 "$1" 2>/dev/null | tr -d '[:space:]' || true
}

# Resolve this script through symlinks. A source checkout has deps.edn one level
# above bin/; a release bundle puts this wrapper beside vis-agent-native.
launcher_path="${BASH_SOURCE[0]}"
while [ -L "$launcher_path" ]; do
  dir="$(cd -P "$(dirname "$launcher_path")" && pwd)"
  launcher_path="$(readlink "$launcher_path")"
  [[ "$launcher_path" != /* ]] && launcher_path="$dir/$launcher_path"
done
bin_dir="$(cd -P "$(dirname "$launcher_path")" && pwd)"
launcher_parent="$(cd -P "$bin_dir/.." && pwd)"
launcher_is_checkout=0
if [[ -f "$launcher_parent/deps.edn" ]]; then launcher_is_checkout=1; fi
bundled_native="$bin_dir/vis-agent-native"

# The live checkout `dev` runs: this one when the launcher is a checkout file,
# otherwise $VIS_DEV_CHECKOUT (default ~/vis).
if (( launcher_is_checkout )); then
  dev_checkout="${VIS_DEV_CHECKOUT:-$launcher_parent}"
else
  dev_checkout="${VIS_DEV_CHECKOUT:-$HOME/vis}"
fi

# ── Arguments the wrapper owns ───────────────────────────────────────────────
# --native/--jvm/--dev name a runtime. On a launch they say which runtime RUNS;
# on `update` they say which runtime is UPDATED, so `update` keeps them.
flag_runtime=""
jfr=0
args=()
update_cmd=0
if [[ "${1:-}" == "update" ]]; then update_cmd=1; fi
for arg in "$@"; do
  case "$arg" in
    --measure) export VIS_MEASURE=1 ;;
    --jfr)     jfr=1 ;;
    --native|--jvm|--dev)
      if [[ -n "$flag_runtime" && "$flag_runtime" != "${arg#--}" ]]; then
        die "name one runtime, not --$flag_runtime and $arg"
      fi
      flag_runtime="${arg#--}"
      if (( update_cmd )); then args+=("$arg"); fi
      ;;
    *) args+=("$arg") ;;
  esac
done
if (( ${#args[@]} > 0 )); then set -- "${args[@]}"; else set --; fi

# ── Which runtime, and who chose it ──────────────────────────────────────────
# A one-launch flag wins over VIS_RUNTIME, which wins over the persisted default
# in ~/.vis/runtime. No selection at all means automatic: follow the releases.
persisted_runtime="$(read_state "$vis_runtime_file")"
case "$persisted_runtime" in
  native|jvm|dev) ;;
  "") ;;
  *) warn "ignoring invalid runtime in $vis_runtime_file: $persisted_runtime"; persisted_runtime="" ;;
esac

selected_runtime=""
runtime_origin="automatic"
if [[ -n "$flag_runtime" ]]; then
  selected_runtime="$flag_runtime"
  runtime_origin="--$flag_runtime"
elif [[ -n "${VIS_RUNTIME:-}" ]]; then
  case "$VIS_RUNTIME" in
    native|jvm|dev) selected_runtime="$VIS_RUNTIME"; runtime_origin="VIS_RUNTIME" ;;
    *) warn "ignoring invalid VIS_RUNTIME '$VIS_RUNTIME' (use native, jvm, or dev)" ;;
  esac
fi
if [[ -z "$selected_runtime" && -n "$persisted_runtime" ]]; then
  selected_runtime="$persisted_runtime"
  runtime_origin="$vis_runtime_file"
fi
dev_mode=0
if [[ "$selected_runtime" == dev ]]; then dev_mode=1; fi

# ── --jfr: Java Flight Recorder profiling ────────────────────────────────────
# Export VIS_JFR=1 so the client and detached gateway daemon each create their
# own role-tagged recording. This works for both JVM source and native-image.
if (( jfr )); then
  export VIS_JFR=1
  mkdir -p "$vis_home" 2>/dev/null || true
  warn "JFR profiling on → $vis_home/vis-{client,gateway}-<pid>-<ts>.jfr"
  warn "  snapshot: jcmd <pid> JFR.dump name=vis-<role>"
fi

# Dev mode — and only dev mode — hands off to the live checkout's own launcher.
# Carry the installed sidecar across that handoff: the checkout wrapper otherwise
# cannot discover the native runtime beside the original installed wrapper.
if (( dev_mode )) \
      && [[ -z "${VIS_NO_DEV_CHECKOUT:-}" \
      && "$launcher_parent" != "$dev_checkout" \
      && -x "$dev_checkout/bin/vis-agent" \
      && -f "$dev_checkout/deps.edn" ]]; then
  export VIS_NO_DEV_CHECKOUT=1
  export VIS_RUNTIME=dev
  if [[ -x "$bundled_native" ]]; then export VIS_INSTALLED_NATIVE="$bundled_native"; fi
  exec "$dev_checkout/bin/vis-agent" "$@"
fi

# ── Measurement ──────────────────────────────────────────────────────────────
measure_enabled() {
  case "${VIS_MEASURE:-0}" in
    1|true|TRUE|yes|YES|on|ON) return 0 ;;
    *) return 1 ;;
  esac
}

measure_now_ms() {
  perl -MTime::HiRes=time -e 'printf "%.3f", time() * 1000'
}

measure_log_since() {
  local label="$1"
  local start_ms="$2"
  if measure_enabled; then
    local end_ms elapsed_ms
    end_ms="$(measure_now_ms)"
    elapsed_ms="$(awk -v end="$end_ms" -v start="$start_ms" 'BEGIN { printf "%.1f", end - start }')"
    printf '[vis measure] shell:%s %s ms\n' "$label" "$elapsed_ms" >&2
  fi
}

measure_log() {
  if measure_enabled; then
    printf '[vis measure] shell:%s\n' "$1" >&2
  fi
}

run_measured_or_exec() {
  local label="$1"
  shift
  if measure_enabled; then
    local start_ms code
    start_ms="$(measure_now_ms)"
    "$@"
    code=$?
    measure_log_since "$label exit=$code" "$start_ms"
    exit "$code"
  else
    exec "$@"
  fi
}

# ── User extensions (JVM runtime only) ───────────────────────────────────────
edn_escape_string() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  printf '%s' "$s"
}

extension_dep_symbol() {
  local scope="$1"
  local name="$2"
  name="$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9._-]+/-/g; s/^-+//; s/-+$//')"
  [[ -n "$name" ]] || name="extension"
  printf 'vis-user-extension.%s/%s' "$scope" "$name"
}

collect_user_extension_sdeps() {
  local roots=("project:$invocation_cwd/.vis/vis-extensions" "global:$vis_home/vis-extensions")
  local root_spec root_scope root deps_file ext_dir ext_name dep_sym escaped
  local -a entries=()
  shopt -s nullglob
  for root_spec in "${roots[@]}"; do
    root_scope="${root_spec%%:*}"
    root="${root_spec#*:}"
    for deps_file in "$root"/*/deps.edn; do
      [[ -f "$deps_file" ]] || continue
      ext_dir="$(cd -P "$(dirname "$deps_file")" && pwd)"
      ext_name="$(basename "$ext_dir")"
      dep_sym="$(extension_dep_symbol "$root_scope" "$ext_name")"
      escaped="$(edn_escape_string "$ext_dir")"
      entries+=("$dep_sym {:local/root \"$escaped\"}")
    done
  done
  shopt -u nullglob
  if (( ${#entries[@]} > 0 )); then
    printf '{:deps {'
    printf '%s ' "${entries[@]}"
    printf '}}'
  fi
}

# ── Runtime discovery ────────────────────────────────────────────────────────
# The source checkout each runtime runs: dev = the live checkout; jvm = the
# checkout Vis owns and pins to a release tag. Running a checkout's own launcher
# runs that checkout — that is what invoking it means.
find_jvm_source() {
  if (( dev_mode )); then
    # dev names ONE checkout. If it is not there, say so — never run another.
    [[ -f "$dev_checkout/deps.edn" ]] || return 1
    printf '%s\n' "$dev_checkout"
  elif (( launcher_is_checkout )); then
    printf '%s\n' "$launcher_parent"
  elif [[ -f "$managed_src/deps.edn" ]]; then
    printf '%s\n' "$managed_src"
  else
    return 1
  fi
}

find_native() {
  local source_root candidate
  source_root="$(find_jvm_source 2>/dev/null || true)"
  for candidate in "${VIS_INSTALLED_NATIVE:-}" "$bundled_native" \
                   "$vis_install_dir/vis-agent-native" \
                   "${source_root:+$source_root/target/vis}"; do
    [[ -n "$candidate" && -x "$candidate" ]] || continue
    printf '%s\n' "$candidate"
    return 0
  done
  return 1
}

# Automatic means "follow the releases": the published native runtime when it is
# installed, otherwise release-tagged source. A live checkout is never picked
# implicitly — that is dev mode, and it must be asked for.
runtime_effective() {
  if [[ -n "$selected_runtime" ]]; then
    printf '%s\n' "$selected_runtime"
  elif find_native >/dev/null 2>&1; then
    printf 'native\n'
  else
    printf 'jvm\n'
  fi
}

vis_runtime() {
  case "${1:-show}" in
    show)
      if [[ -n "${2:-}" ]]; then
        warn "runtime show takes no arguments (got '$2')"
        vis_runtime_usage
        return 2
      fi
      local effective native source_root ref
      effective="$(runtime_effective)"
      native="$(find_native 2>/dev/null || printf 'not installed')"
      source_root="$(find_jvm_source 2>/dev/null || printf 'not installed')"
      ref="$(read_state "$managed_ref_file")"
      [[ -n "$ref" ]] || ref="unpinned"
      printf 'Runtime:      %s (%s)\n' "$effective" "$runtime_origin"
      printf 'Native:       %s\n' "$native"
      printf 'Source:       %s\n' "$source_root"
      printf 'Pinned at:    %s\n' "$ref"
      printf 'Dev checkout: %s\n' "$dev_checkout"
      ;;
    use)
      if [[ -n "${3:-}" ]]; then
        warn "runtime use names one runtime (got '$2' and '$3')"
        vis_runtime_usage
        return 2
      fi
      case "${2:-}" in
        native|jvm|dev)
          mkdir -p "$vis_home"
          printf '%s\n' "$2" > "$vis_runtime_file.tmp"
          mv -f "$vis_runtime_file.tmp" "$vis_runtime_file"
          say "runtime is now $2"
          runtime_readiness "$2"
          ;;
        auto)
          rm -f "$vis_runtime_file"
          say "runtime is now automatic: native if installed, else source at the newest release tag"
          ;;
        -h|--help) vis_runtime_usage; return 0 ;;
        *) vis_runtime_usage; return 2 ;;
      esac
      ;;
    -h|--help|help) vis_runtime_usage; return 0 ;;
    *) vis_runtime_usage; return 2 ;;
  esac
}

# A persisted choice must not become a surprise at the next launch: say now what
# the chosen runtime still needs, with the command that supplies it.
runtime_readiness() {
  case "$1" in
    native)
      if ! find_native >/dev/null 2>&1; then
        say "no native runtime is installed yet — get it: vis-agent update --native"
      fi
      ;;
    jvm)
      if [[ ! -f "$managed_src/deps.edn" ]] && (( ! launcher_is_checkout )); then
        say "no source is installed yet — get it: vis-agent update --jvm"
      fi
      say_missing_clojure
      ;;
    dev)
      say "dev follows the live checkout at $dev_checkout (VIS_DEV_CHECKOUT overrides it)"
      if [[ ! -f "$dev_checkout/deps.edn" ]]; then
        say "there is no checkout there yet — clone one, or point VIS_DEV_CHECKOUT at yours"
      fi
      say_missing_clojure
      ;;
  esac
}

say_missing_clojure() {
  if ! command -v clojure >/dev/null 2>&1; then
    say "source runtimes run 'clojure -M:vis', and 'clojure' is not on PATH yet"
    say "  install it: https://clojure.org/guides/install_clojure"
  fi
}

vis_runtime_usage() {
  cat >&2 <<'EOF'
Usage: vis-agent runtime [show]
       vis-agent runtime use native|jvm|dev|auto
         native  the published runtime, downloaded by 'vis-agent update'
         jvm     source pinned to the newest release tag
         dev     a live checkout, tracking its branch
         auto    forget the choice: native if installed, else tagged source
EOF
}

# ── Release bundle ───────────────────────────────────────────────────────────
# Every release publishes exactly one asset per platform: the bundle that carries
# the launcher together with its native runtime.
#   vis-agent-<os>-<arch>-community.tar.gz
vis_platform_asset() {
  local os arch
  case "$(uname -s)" in
    Darwin) os=macos ;;
    Linux)  os=linux ;;
    *) die "update: unsupported OS $(uname -s)" ;;
  esac
  case "$(uname -m)" in
    arm64|aarch64) arch=arm64 ;;
    x86_64|amd64)  arch=x64 ;;
    *) die "update: unsupported architecture $(uname -m)" ;;
  esac
  printf 'vis-agent-%s-%s-community.tar.gz' "$os" "$arch"
}

# Exact-name match: the trailing quote keeps the bundle from matching a longer
# sibling asset (checksum, signature) that shares its name as a prefix.
vis_asset_url() {
  local json="$1" name="$2" url
  url="$(printf '%s' "$json" | grep -o "https://[^\"]*/${name}\"" | head -1)" || url=""
  printf '%s' "${url%\"}"
}

require_cmd() {
  local cmd="$1" why="$2"
  command -v "$cmd" >/dev/null 2>&1 || die "update: $why needs '$cmd' on PATH"
}

build_native_runtime() {
  local source_root="$1"
  require_cmd clojure "--rebuild"
  say "building the native runtime from $source_root ('clojure -T:build native')"
  ( cd "$source_root" && clojure -T:build native ) || exit 1
}

# ── update: source runtime ───────────────────────────────────────────────────
# Follow tagged commits: the checkout Vis owns is moved onto the newest release
# tag, or onto an exact ref you name. A developer's own checkout is never moved
# by this path — that is what `update --dev` is for.
update_source() {
  local ref="${1:-}"
  require_cmd git "the source runtime"
  if [[ ! -d "$managed_src/.git" ]]; then
    say "cloning $vis_repo_slug into $managed_src"
    git clone --filter=blob:none "https://github.com/$vis_repo_slug.git" "$managed_src" || exit 1
  fi
  say "fetching release tags for $managed_src"
  git -C "$managed_src" fetch --tags --force --prune origin || exit 1
  if [[ -z "$ref" ]]; then
    ref="$(git -C "$managed_src" tag --list 'v*' --sort=-v:refname | head -1)"
    [[ -n "$ref" ]] || die "update: no release tag (vX.Y.Z) is published yet" \
                          "Pin an exact commit instead: vis-agent update <sha>"
  fi
  git -C "$managed_src" checkout --force --detach "$ref" || exit 1
  mkdir -p "$vis_install_dir"
  printf '%s\n' "$ref" > "$managed_ref_file"
  say "source pinned at $ref ($managed_src)"
  [[ "$(runtime_effective)" == jvm ]] || say "run it with 'vis-agent runtime use jvm'"
}

# ── update: dev runtime ──────────────────────────────────────────────────────
# The only runtime that follows a moving branch, so the only update that pulls.
update_dev() {
  require_cmd git "the dev runtime"
  [[ -d "$dev_checkout/.git" ]] || die "update --dev: no git checkout at $dev_checkout" \
                                       "Clone one there, or point VIS_DEV_CHECKOUT at it."
  say "updating $dev_checkout (git fetch + pull --ff-only)"
  git -C "$dev_checkout" fetch --tags origin || exit 1
  git -C "$dev_checkout" pull --ff-only || {
    # Say WHAT blocked the fast-forward: dirty tree vs. diverged history (usually
    # an upstream force-push), with the counts and the exact recovery command.
    # A bare 'not possible to fast-forward' tells the user nothing.
    local branch upstream counts ahead behind
    branch="$(git -C "$dev_checkout" rev-parse --abbrev-ref HEAD 2>/dev/null)"
    upstream="$(git -C "$dev_checkout" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)"
    warn "update --dev: 'git pull --ff-only' failed on branch '${branch:-?}'."
    if [[ -n "$(git -C "$dev_checkout" status --porcelain 2>/dev/null)" ]]; then
      echo "  - Working tree has local changes: commit or stash them, then retry." >&2
    fi
    if [[ -n "$upstream" ]]; then
      counts="$(git -C "$dev_checkout" rev-list --left-right --count "HEAD...$upstream" 2>/dev/null)"
      ahead="${counts%%[[:space:]]*}"
      behind="${counts##*[[:space:]]}"
      if [[ -n "$counts" && ( "$ahead" != 0 || "$behind" != 0 ) ]]; then
        echo "  - '$branch' and '$upstream' have diverged: $ahead local commit(s), $behind upstream commit(s)." >&2
      fi
      if [[ "${ahead:-0}" != 0 ]]; then
        echo "      keep your work:    git -C '$dev_checkout' rebase $upstream" >&2
      fi
      echo "      discard local commits (DESTRUCTIVE, after an upstream force-push):" >&2
      echo "                         git -C '$dev_checkout' reset --hard $upstream" >&2
    else
      echo "  - Branch '${branch:-?}' has no upstream; set one with 'git branch -u origin/main'." >&2
    fi
    echo "    Then run 'vis-agent update --dev' again." >&2
    exit 1
  }
  say "checkout updated; the dev runtime uses it on the next launch"
}

# ── update: native runtime ───────────────────────────────────────────────────
# Releases ship the launcher and its native runtime as a single bundle, so both
# are replaced together and can never drift apart.
update_native() {
  local target="${1:-latest}"
  require_cmd curl "the native runtime"
  require_cmd tar "the native runtime"
  local asset api dl json archive unpack native_dir
  asset="$(vis_platform_asset)"
  if [[ "$target" == latest ]]; then
    api="https://api.github.com/repos/$vis_repo_slug/releases/latest"
  else
    api="https://api.github.com/repos/$vis_repo_slug/releases/tags/$target"
  fi
  say "resolving $asset from $api"
  json="$(curl -fsSL "$api")" || true
  # `set -o pipefail` + `set -e` would kill this function on a no-match grep,
  # swallowing the actionable message below. Keep the failure local.
  dl="$(vis_asset_url "$json" "$asset")"
  if [[ -z "$dl" ]]; then
    die "update: no native runtime published for '$asset'." \
        "Checked $api" \
        "Releases currently carry Linux x64 and arm64 only." \
        "Elsewhere, run the source runtime: vis-agent update --jvm && vis-agent runtime use jvm"
  fi

  # Where the private runtime belongs: beside an installed launcher, or in Vis
  # state when the launcher is a tracked checkout file we must never overwrite.
  if (( launcher_is_checkout )); then
    mkdir -p "$vis_install_dir"
    native_dir="$vis_install_dir"
  else
    [[ -w "$bin_dir" && -w "$launcher_path" ]] || \
      die "update: cannot replace the installation in $bin_dir (permission denied)" \
          "Re-run with the permissions used for that directory."
    native_dir="$bin_dir"
  fi

  archive="$(mktemp "${TMPDIR:-/tmp}/vis-agent-bundle.XXXXXX.tar.gz")"
  unpack="$(mktemp -d "${TMPDIR:-/tmp}/vis-agent-unpack.XXXXXX")"
  trap 'rm -rf "$unpack" "$archive"' RETURN
  say "downloading $dl"
  curl -fSL "$dl" -o "$archive" || exit 1
  tar -xzf "$archive" -C "$unpack" || exit 1
  [[ -x "$unpack/vis-agent" && -x "$unpack/vis-agent-native" ]] || \
    die "update: the release bundle is missing its launcher or native runtime"

  mv -f "$unpack/vis-agent-native" "$native_dir/vis-agent-native"
  if (( launcher_is_checkout )); then
    # Never overwrite a tracked development launcher: the released one lives in
    # Vis state; source stays the checkout's responsibility.
    mv -f "$unpack/vis-agent" "$vis_install_dir/vis-agent"
    [[ ! -f "$unpack/install-vis-agent" ]] || mv -f "$unpack/install-vis-agent" "$vis_install_dir/install-vis-agent"
  else
    # Installed bundles are co-located: the public wrapper and its private native
    # sidecar update together. This Bash process has already read itself.
    mv -f "$unpack/vis-agent" "$launcher_path"
    [[ ! -f "$unpack/install-vis-agent" ]] || mv -f "$unpack/install-vis-agent" "$bin_dir/install-vis-agent"
  fi
  rm -rf "$unpack" "$archive"
  trap - RETURN
  say "installed launcher + native runtime from $asset"
  [[ "$(runtime_effective)" == native ]] || say "run it with 'vis-agent runtime use native'"
}

vis_update_usage() {
  cat >&2 <<'EOF'
Usage: vis-agent update [--native|--jvm|--dev] [--rebuild] [vX.Y.Z|<sha>]
         (no flag)  update the runtime that is in effect
         --native   download the published launcher + native runtime
         --jvm      move the source Vis owns onto the newest release tag, or onto a ref you name
         --dev      fast-forward your live checkout
         --rebuild  after a source update, build the native runtime from that source
EOF
}

# `update` updates the runtime that is in effect; a flag updates another one.
vis_do_update() {
  local target="" rebuild=0 want="" arg
  for arg in "$@"; do
    case "$arg" in
      --native|--jvm|--dev)
        want="${arg#--}"
        ;;
      --rebuild) rebuild=1 ;;
      -h|--help) vis_update_usage; exit 0 ;;
      -*) die "update: unknown option $arg" "Usage: vis-agent update [--native|--jvm|--dev] [--rebuild] [vX.Y.Z|<sha>]" ;;
      *)
        [[ -z "$target" ]] || die "update: one target at a time, not '$target' and '$arg'"
        target="$arg"
        ;;
    esac
  done
  mkdir -p "$vis_install_dir"

  # A target that is not a release tag is a git ref, and git refs mean source.
  local target_is_ref=0
  if [[ -n "$target" && ! "$target" =~ ^(latest|v[0-9].*)$ ]]; then
    target_is_ref=1
    [[ "$want" != native ]] || die "update --native: expected a release tag (vX.Y.Z) or 'latest', got '$target'" \
                                   "Pin source to a commit with: vis-agent update --jvm $target"
    [[ -z "$want" || "$want" == jvm ]] || die "update --$want: '$target' is a git ref; use 'vis-agent update --jvm $target'"
    want=jvm
  fi
  [[ -n "$want" ]] || want="$(runtime_effective)"

  case "$want" in
    dev)
      [[ -z "$target" ]] || die "update --dev: dev follows its branch and takes no target" \
                                "Pin the managed source instead: vis-agent update --jvm $target"
      update_dev
      if (( rebuild )); then build_native_runtime "$dev_checkout"; fi
      ;;
    jvm)
      if (( target_is_ref )); then say "pinning source to $target"; fi
      update_source "$target"
      if (( rebuild )); then build_native_runtime "$managed_src"; fi
      ;;
    native)
      (( ! rebuild )) || die "update --native: --rebuild builds FROM source" \
                             "Use: vis-agent update --jvm --rebuild (or --dev --rebuild)"
      update_native "${target:-latest}"
      ;;
  esac
  exit 0
}

# ── Wrapper-owned commands. The Vis app never sees these. ────────────────────
case "${1:-}" in
  runtime)
    shift
    vis_runtime "$@"
    exit $?
    ;;
  update)
    shift
    vis_do_update "$@"
    ;;
esac

# ── Launch ───────────────────────────────────────────────────────────────────
runtime="$(runtime_effective)"
case "$runtime" in
  native)
    native_runtime="$(find_native 2>/dev/null || true)"
    [[ -n "$native_runtime" ]] || die "the native runtime is selected ($runtime_origin), but none is installed" \
                                      "Download it:  vis-agent update --native" \
                                      "Or switch:    vis-agent runtime use jvm"
    measure_log "native → $native_runtime"
    cd "$invocation_cwd"
    # Native-image does not derive Java's user.home from HOME. Pass it through
    # the wrapper so release and container builds never retain the builder's home.
    run_measured_or_exec "process native runtime" "$native_runtime" "-Duser.home=${HOME:-$vis_home}" "$@"
    ;;
  jvm|dev)
    source_root="$(find_jvm_source 2>/dev/null || true)"
    if [[ -z "$source_root" ]]; then
      if (( dev_mode )); then
        die "the dev runtime is selected ($runtime_origin), but $dev_checkout is not a checkout" \
            "Clone one there (or set VIS_DEV_CHECKOUT)," \
            "or leave dev mode: vis-agent runtime use auto"
      fi
      die "the jvm runtime is selected ($runtime_origin), but no source is installed" \
          "Install release-tagged source:  vis-agent update --jvm" \
          "Or use the native runtime:      vis-agent update --native"
    fi
    # A source runtime is only as real as its toolchain. Say which tool is
    # missing here, instead of letting exec fail with 'clojure: not found'.
    if ! command -v clojure >/dev/null 2>&1; then
      die "the $runtime runtime runs 'clojure -M:vis', but 'clojure' is not on PATH" \
          "Install the Clojure CLI:  https://clojure.org/guides/install_clojure" \
          "Or run the published one: vis-agent update --native && vis-agent runtime use native"
    fi
    if ! command -v java >/dev/null 2>&1 && [[ -z "${JAVA_CMD:-}" && -z "${JAVA_HOME:-}" ]]; then
      die "the $runtime runtime needs a Java 25 runtime, and no 'java' is on PATH" \
          "Install the pinned JDK:   $source_root/bin/require-graalvm --install" \
          "Or run the published one: vis-agent update --native && vis-agent runtime use native"
    fi
    ;;
esac

# ── JVM source launch ────────────────────────────────────────────────────────
# A JVM launch must not inherit an incompatible GraalVM from a long-lived parent
# (IDE, terminal multiplexer, service runner, …). Clojure's launcher prefers
# JAVA_CMD / the `java` on PATH over JAVA_HOME, so merely running `sdk env` in a
# newer shell does not repair an already-started runner.
#
# Stock JDKs are deliberately accepted: the Maven-pinned Truffle runtime runs
# unchained there. When the selected JVM IS GraalVM, however, its built-in
# Truffle must be the exact CE release pinned by this source. Resolve an
# already-installed pin through the repository's single JDK gate and export all
# three selectors that the Clojure CLI may consult.
ensure_compatible_jvm_runtime() {
  local java_cmd vendor pinned_home

  if [[ -n "${JAVA_CMD:-}" ]]; then
    java_cmd="$(command -v "$JAVA_CMD" 2>/dev/null || true)"
  else
    java_cmd="$(command -v java 2>/dev/null || true)"
  fi
  [[ -n "$java_cmd" ]] || return 0

  vendor="$("$java_cmd" -XshowSettings:properties -version 2>&1 |
    sed -n 's/^ *java\.vendor\.version = //p' | head -n1)"
  [[ "$vendor" == *GraalVM* ]] || return 0

  # shellcheck source=/dev/null
  . "$source_root/.graalvm-version"
  [[ "$vendor" == "$GRAAL_VENDOR_VERSION" ]] && return 0

  if pinned_home="$("$source_root/bin/require-graalvm" 2>/dev/null)"; then
    export JAVA_HOME="$pinned_home"
    export GRAALVM_HOME="$pinned_home"
    export JAVA_CMD="$pinned_home/bin/java"
    export PATH="$pinned_home/bin:$PATH"
    warn "JVM launcher replaced incompatible $vendor with $GRAAL_VENDOR_VERSION."
    measure_log "selected pinned JVM $pinned_home"
    return 0
  fi

  warn "incompatible JVM runtime: $vendor"
  warn "this source embeds GraalPy/Truffle $GRAAL_VERSION and requires $GRAAL_VENDOR_VERSION."
  warn "install it with '$source_root/bin/require-graalvm --install', or run on a stock JDK 25."
  return 1
}

user_extension_sdeps="$(collect_user_extension_sdeps)"
vis_extension_sdeps=()
if [[ -n "$user_extension_sdeps" ]]; then
  vis_extension_sdeps=(-Sdeps "$user_extension_sdeps")
  measure_log "user extension deps enabled"
fi

stream_trace_jvm_opts=()
case "${VIS_STREAM_TRACE:-0}" in
  1|true|TRUE|yes|YES|on|ON)
    stream_trace_jvm_opts=("-J-Dsvar.stream.trace=true")
    measure_log "svar stream trace enabled"
    ;;
esac

# Preserve the invocation directory through user.dir while resolving deps from
# the selected source.
measure_log "exec cold clojure -M:vis from $source_root"
ensure_compatible_jvm_runtime || exit 1
cd "$source_root"
if (( ${#vis_extension_sdeps[@]} > 0 )); then
  run_measured_or_exec "process cold clojure -M:vis" clojure "-J-Duser.dir=$invocation_cwd" ${stream_trace_jvm_opts[@]+"${stream_trace_jvm_opts[@]}"} "${vis_extension_sdeps[@]}" -M:vis "$@"
else
  run_measured_or_exec "process cold clojure -M:vis" clojure "-J-Duser.dir=$invocation_cwd" ${stream_trace_jvm_opts[@]+"${stream_trace_jvm_opts[@]}"} -M:vis "$@"
fi
