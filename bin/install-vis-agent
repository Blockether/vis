#!/usr/bin/env bash
# Install the `vis-agent` command.
#
# Step 1 installs the public Bash wrapper — the only command a user ever runs.
# Step 2 hands off to it: `vis-agent update --jvm` checks the source Vis owns
# out at the newest commit of the development branch and selects that runtime.
#
# There is one runtime here: the JVM source runtime. No native binary is
# downloaded and no release tag is checked out — every install and every
# `vis-agent update` lands on the newest commit of the branch, because that is
# where fixes land first.
#
# The two SCRIPTS are a different question: they are downloaded as GitHub
# RELEASE ASSETS (github.com/OWNER/REPO/releases/download/installer/...), never
# from raw.githubusercontent.com — that host is blocked on many corporate
# networks while github.com and its release downloads are not. `installer` is a
# ROLLING release: every commit on main that touches these two scripts re-uploads
# them, so the assets are never older than the branch. Step 2 refreshes the
# wrapper from the source it just pinned, so a stale asset never survives an
# install.
#
# Runtime acquisition therefore always belongs to vis-agent itself, so the
# command and its runtime can never drift apart.

set -euo pipefail

repo_slug="${VIS_REPO_SLUG:-Blockether/vis}"
install_dir="${VIS_INSTALL_DIR:-$HOME/.local/bin}"
vis_home="${VIS_HOME:-$HOME/.vis}"
branch="${VIS_BRANCH:-main}"

usage() {
  cat <<EOF
Usage: install-vis-agent [--install-dir PATH]

Installs the public command first:
  $install_dir/vis-agent          the command you run

then lets it acquire its own runtime:
  $vis_home/install/src           source at the newest commit on $branch
                                  (needs Java 25+, the Clojure CLI, git)

Environment overrides:
  VIS_INSTALL_DIR    command directory (default: ~/.local/bin)
  VIS_HOME           state directory (default: ~/.vis)
  VIS_BRANCH         branch to follow (default: main)
  VIS_REPO_SLUG      GitHub OWNER/REPO (default: Blockether/vis)
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --install-dir)
      [[ $# -ge 2 ]] || { echo "vis-agent install: --install-dir requires a path" >&2; exit 2; }
      install_dir="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "vis-agent install: unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

# Fail before writing anything rather than half-way through. curl fetches the
# wrapper here; the rest is what the source runtime needs in step 2.
missing=()
for cmd in curl git java; do
  command -v "$cmd" >/dev/null 2>&1 || missing+=("$cmd")
done
if (( ${#missing[@]} > 0 )); then
  echo "vis-agent install: missing required command(s): ${missing[*]}" >&2
  echo "  The source runtime needs Java 25+, git, and curl." >&2
  echo "  Vis installs the Clojure CLI automatically on first JVM use." >&2
  exit 1
fi

java_version_output="$(java -version 2>&1)" || {
  echo "vis-agent install: java exists but failed to run: java -version" >&2
  exit 1
}
java_version="$(printf '%s\n' "$java_version_output" | sed -n '1s/.*version "\([^"]*\)".*/\1/p')"
java_major="${java_version%%.*}"
[[ "$java_major" != "1" ]] || java_major="$(printf '%s' "$java_version" | cut -d. -f2)"
if [[ ! "$java_major" =~ ^[0-9]+$ || "$java_major" -lt 25 ]]; then
  echo "vis-agent install: Java 25 or newer is required (found: ${java_version:-unknown})." >&2
  exit 1
fi
# The wrapper installs the official Clojure CLI when the source runtime is first used.

if ! mkdir -p "$install_dir" 2>/dev/null || [[ ! -w "$install_dir" ]]; then
  echo "vis-agent install: cannot write to $install_dir" >&2
  echo "  Choose a user-writable location with VIS_INSTALL_DIR, or rerun with" >&2
  echo "  the permissions required by that directory." >&2
  exit 1
fi
if [[ -d "$install_dir/vis-agent" ]]; then
  echo "vis-agent install: an install target is a directory; move it aside first" >&2
  exit 1
fi

# ── 1. install the vis-agent command ────────────────────────────────────────
# The wrapper is downloaded from the rolling `installer` release, which every
# commit on main that touches it refreshes (raw.githubusercontent.com is
# unreachable from many corporate networks). It is only a bootstrap: step 2
# refreshes it from the source it pins, so the two can only ever end up the same
# file.
# file. Run from a checkout and the wrapper next to this script is used
# directly; the sibling deps.edn proves it is a real checkout rather than an
# unrelated file in the current directory.
wrapper=""
here="$(cd -P "$(dirname "${BASH_SOURCE[0]:-$0}")" 2>/dev/null && pwd || true)"
if [[ -n "$here" && -f "$here/vis-agent" && -f "$here/../deps.edn" ]]; then
  wrapper="$here/vis-agent"
  echo "vis-agent install: using the vis-agent command from this checkout"
else
  wrapper="$(mktemp "${TMPDIR:-/tmp}/vis-agent.XXXXXX")"
  trap 'rm -f "$wrapper"' EXIT
  echo "vis-agent install: downloading the vis-agent command ($repo_slug, installer assets)"
  if ! curl -fsSL "https://github.com/$repo_slug/releases/download/installer/vis-agent" \
         -o "$wrapper" 2>/dev/null || ! head -1 "$wrapper" | grep -q '^#!'; then
    echo "vis-agent install: could not download the vis-agent command from $repo_slug (releases/download/installer/vis-agent)" >&2
    exit 1
  fi
fi

install -m 0755 "$wrapper" "$install_dir/vis-agent.tmp"
mv -f "$install_dir/vis-agent.tmp" "$install_dir/vis-agent"
echo "vis-agent install: installed $install_dir/vis-agent"

path_configured=0
case ":$PATH:" in
  *":$install_dir:"*) path_configured=1 ;;
esac

profile=""
if (( ! path_configured )); then
  case "${SHELL:-}" in
    */zsh) profile="${ZDOTDIR:-$HOME}/.zshrc" ;;
    */bash)
      if [[ "$(uname -s)" == Darwin ]]; then profile="$HOME/.bash_profile"; else profile="$HOME/.bashrc"; fi
      ;;
    *) profile="$HOME/.profile" ;;
  esac

  if [[ "$install_dir" == "$HOME/.local/bin" ]]; then
    path_line="export PATH=\"\$HOME/.local/bin:\$PATH\""
  else
    printf -v quoted_install_dir '%q' "$install_dir"
    path_line="export PATH=$quoted_install_dir:\$PATH"
  fi
  touch "$profile"
  if ! grep -Fqx "$path_line" "$profile"; then
    printf '\n# Vis Agent command\n%s\n' "$path_line" >> "$profile"
  fi
  echo "vis-agent install: added $install_dir to PATH in $profile"
fi

# ── 2. vis-agent acquires its own runtime ───────────────────────────────────
# VIS_NO_DEV_CHECKOUT keeps a developer's ~/vis checkout from hijacking the
# freshly installed wrapper: this run must install into $install_dir. Naming the
# runtime on `update` also persists it, so there is nothing left to select.
if ! ( VIS_NO_DEV_CHECKOUT=1 VIS_HOME="$vis_home" VIS_RUNTIME=jvm VIS_BRANCH="$branch" \
       "$install_dir/vis-agent" update --jvm && \
       VIS_NO_DEV_CHECKOUT=1 VIS_HOME="$vis_home" VIS_RUNTIME=jvm VIS_BRANCH="$branch" \
       "$install_dir/vis-agent" runtime use jvm ); then
  if (( ! path_configured )); then
    cat >&2 <<EOF

Start a new shell (or run: source "$profile") before using vis-agent by name.
EOF
  fi
  exit 1
fi

cat <<EOF

Vis Agent is installed for this user:
  $install_dir/vis-agent          the command
  $vis_home/install/src           source runtime, at the newest commit on $branch

  vis-agent help
  vis-agent runtime show          what is installed and selected
  vis-agent update                moves both onto the newest commit
EOF

if (( ! path_configured )); then
  cat <<EOF

Start a new shell (or run: source "$profile") before using vis-agent by name.
EOF
fi
