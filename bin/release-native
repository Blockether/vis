#!/usr/bin/env bash
# Build the native release assets ON THIS MACHINE and (optionally) attach them to
# a release — the alternative to waiting on GitHub CI.
#
# WHY this exists (measured, not preference):
#   * The image is GC-BOUND, not CPU-bound. The points-to analysis live set is
#     ~13.7 GiB; a free 16 GB hosted runner spends 70-79 % of a ~2 h build in GC.
#     A 32 GB+ machine never enters that regime and finishes in a fraction of it.
#   * GitHub has NO macOS runner that fits: free arm64 macOS is 3 cores / 7 GB and
#     even the paid macos-*-xlarge is 14 GB. The macOS asset can therefore ONLY
#     come from an Apple-silicon machine like this one (or a self-hosted runner,
#     which is the same machine wearing a CI hat).
#   * On Apple silicon, linux-arm64 is a NATIVE container build, and linux-x64
#     is a ROSETTA-translated one. Measured here with a native-image hello
#     world: 15.8 s on linux/arm64 vs 1 m 16 s on linux/amd64 — 4.8x, which is
#     slow but still under the 86-130 min the free x64 runner takes when it
#     does not OOM outright. So this ONE host can build ALL THREE assets.
#
# Usage:
#   bin/release-native                          # every target this host can build
#   bin/release-native --targets macos-arm64
#   bin/release-native --tag v0.1.25 --upload   # attach to that release
#   bin/release-native --list
#
# Targets:
#   macos-arm64  `clojure -T:build native` on this Mac  (>= 32 GB RAM)
#   linux-arm64  container build --platform linux/arm64 (native on Apple silicon)
#   linux-x64    container build --platform linux/amd64. Needs FAST emulation:
#                a podman machine with Rosetta (`[machine] rosetta = true` in
#                ~/.config/containers/containers.conf, applied at `machine init`)
#                or Docker Desktop's "Use Rosetta for x86_64/amd64 emulation".
#                qemu-user's TCG interpreter is another order of magnitude below
#                that and the analysis dies before it finishes, so this script
#                MEASURES the emulator and refuses the slow one instead of
#                burning a night. CI stays the fallback:
#                  gh workflow run native-release.yml -f tag=vX.Y.Z
#
# Assets land in the repo root as vis-agent-<os>-<arch>-community.tar.gz, exactly
# like the CI ones — both go through bin/stage-release-bundle.
set -euo pipefail

repo_root="$(cd -P "$(dirname "${BASH_SOURCE[0]:-$0}")/.." && pwd)"
cd "$repo_root"

say()  { printf '\033[1mrelease-native:\033[0m %s\n' "$*" >&2; }
die()  { printf 'release-native: %s\n' "$@" >&2; exit 1; }

targets=""
tag=""
upload=0
list=0
while (( $# )); do
  case "$1" in
    --targets) targets="${2:-}"; shift 2 ;;
    --tag)     tag="${2:-}"; shift 2 ;;
    --upload)  upload=1; shift ;;
    --list)    list=1; shift ;;
    -h|--help) sed -n '2,30p' "${BASH_SOURCE[0]:-$0}"; exit 0 ;;
    *) die "unknown argument $1" "Usage: bin/release-native [--targets a,b] [--tag vX.Y.Z] [--upload]" ;;
  esac
done

host_os="$(uname -s)"
host_arch="$(uname -m)"

# What this host can actually build. Kept honest: an Intel Mac cannot produce the
# arm64 assets, and a foreign-arch container target still has to prove its
# emulator is Rosetta-fast before it is allowed to run (see build_linux).
buildable=()
case "$host_os/$host_arch" in
  Darwin/arm64)
    buildable=(macos-arm64 linux-arm64 linux-x64) ;;
  Linux/aarch64|Linux/arm64)
    buildable=(linux-arm64 linux-x64) ;;
  Linux/x86_64)
    buildable=(linux-x64 linux-arm64) ;;
  *)
    die "no native release target for $host_os/$host_arch" ;;
esac

if (( list )); then
  printf '%s\n' "${buildable[@]}"
  exit 0
fi

if [[ -n "$targets" ]]; then
  IFS=, read -r -a selected <<< "$targets"
  for t in "${selected[@]}"; do
    case " ${buildable[*]} " in
      *" $t "*) ;;
      *) die "this host ($host_os/$host_arch) cannot build '$t'" \
             "It can build: ${buildable[*]}" ;;
    esac
  done
else
  selected=("${buildable[@]}")
fi

if (( upload )); then
  [[ -n "$tag" ]] || tag="v$(tr -d '[:space:]' < VIS_VERSION)"
  command -v gh >/dev/null 2>&1 || die "--upload needs the GitHub CLI (gh)"
  gh release view "$tag" >/dev/null 2>&1 || \
    die "no release for tag $tag" "Cut it first, or pass an existing --tag."
fi

# ── macos-arm64 ──────────────────────────────────────────────────────────────
build_macos_arm64() {
  local asset="vis-agent-macos-arm64-community.tar.gz"
  say "building macos-arm64 (clojure -T:build native)"
  # build.clj sizes the builder heap from this machine's RAM and re-execs under
  # the pinned GraalVM CE by itself; nothing to tune here.
  clojure -T:build native
  bin/stage-release-bundle target/vis "$asset"
  say "smoke: help + gateway boot"
  target/release-bundle/vis-agent --native help >/dev/null
  local out
  out="$(target/release-bundle/vis-agent --native providers status anthropic 2>&1 || true)"
  if printf '%s\n' "$out" | grep -q 'did not become ready'; then
    printf '%s\n' "$out" >&2
    die "the gateway daemon failed to boot — not shipping this binary"
  fi
  target/release-bundle/vis-agent --native gateway stop >/dev/null 2>&1 || true
  # The sidecar is the whole point of this bundle: prove the runtime imports the
  # Python stdlib THROUGH the staged directory, not through a build leftover.
  say "smoke: GraalPy stdlib from the staged language resources"
  VIS_NATIVE_RESOURCES="$repo_root/target/release-bundle/vis-agent-resources" \
    target/release-bundle/vis-agent --native python -c "import ast, json, os; print('py-ok')" \
    | grep -qx 'py-ok' || die "the staged language resources do not load: no Python stdlib"
  built_asset="$asset"
}

# ── linux targets (container build) ──────────────────────────────────────────
# `docker` on this host may BE podman (podman ships a `docker` shim) and podman
# has no `buildx` subcommand, so resolve the engine first and then speak its
# dialect. `VIS_CONTAINER_CLI` forces one; `VIS_CONTAINER_CONNECTION` selects a
# non-default podman machine (`--connection`) or docker context (`--context`).
# It is rarely needed: when podman's default machine is too small for the
# builder JVM, resolve_engine picks a bigger running machine by itself, so the
# small everyday default is neither used nor disturbed.
container_engines() {
  local candidate
  for candidate in ${VIS_CONTAINER_CLI:+"$VIS_CONTAINER_CLI"} docker podman; do
    command -v "$candidate" >/dev/null 2>&1 && printf '%s\n' "$candidate"
  done | awk '!seen[$0]++'
}

engine=""
flavor=""
engine_args=()
# bash 3.2 (what macOS ships) treats "${empty[@]}" as unset under `set -u`.
eng() { "$engine" ${engine_args[@]+"${engine_args[@]}"} "$@"; }

probe_image="debian:bookworm-slim"

# The builder JVM needs ~14 GiB INSIDE the VM. Both engines default to far less
# and the build dies in [4/8] with an OOM after ~40 wasted minutes.
builder_min_mem=16000000000

# RAM the connection currently selected in engine_args can offer; 0 when it is
# unreachable or answers with something that is not a byte count.
engine_memory() {
  local mem
  if [[ "$flavor" == podman ]]; then
    mem="$(eng info --format '{{.Host.MemTotal}}' 2>/dev/null || echo 0)"
  else
    mem="$(eng info --format '{{.MemTotal}}' 2>/dev/null || echo 0)"
  fi
  [[ "$mem" =~ ^[0-9]+$ ]] || mem=0
  printf '%s\n' "$mem"
}

# Choose the machine to build in. An explicit VIS_CONTAINER_CONNECTION always
# wins. Otherwise, when podman's DEFAULT machine cannot hold the builder JVM —
# it usually cannot, it is the small everyday one — any OTHER machine that is up
# and big enough is taken automatically, so this script uses the dedicated
# builder machine without having to be told about it.
# Point engine_args at the machine/context to build in, for whichever engine is
# currently in $engine/$flavor. An explicit VIS_CONTAINER_CONNECTION always
# wins. Otherwise, when podman's DEFAULT machine cannot hold the builder JVM —
# it usually cannot, it is the small everyday one — any OTHER machine that is up
# and big enough is taken automatically, so this script uses the dedicated
# builder machine without having to be told about it.
select_connection() {
  local conn mem
  if [[ -n "${VIS_CONTAINER_CONNECTION:-}" ]]; then
    if [[ "$flavor" == podman ]]; then
      engine_args=(--connection "$VIS_CONTAINER_CONNECTION")
    else
      engine_args=(--context "$VIS_CONTAINER_CONNECTION")
    fi
  elif [[ "$flavor" == podman ]] && (( $(engine_memory) < builder_min_mem )); then
    for conn in $("$engine" system connection list --format '{{.Name}}' 2>/dev/null | tr -d '*' | sort -u); do
      engine_args=(--connection "$conn")
      mem="$(engine_memory)"
      if (( mem >= builder_min_mem )); then
        say "using podman connection $conn ($((mem / 1000000000)) GB) — the default machine is too small"
        break
      fi
      engine_args=()
    done
  fi
}

# Why the currently selected engine cannot build this, or nothing when it can.
engine_problem() {
  local mem
  eng info >/dev/null 2>&1 || {
    printf '%s\n' "$engine is installed but its Linux VM is not reachable"
    return 0
  }
  mem="$(engine_memory)"
  if (( mem > 0 && mem < builder_min_mem )); then
    printf '%s\n' "$engine only has $((mem / 1000000000)) GB of RAM; this build needs >= 16 GB"
  fi
}

# Being on PATH proves NOTHING: Docker Desktop is routinely installed and not
# running on a Mac whose podman builder machine is up, and stopping there cost a
# whole release round. Try every installed engine, keep the first that can
# actually build, and only complain when none of them can.
resolve_engine() {
  [[ -z "$engine" ]] || return 0
  local candidate problem first=""
  for candidate in $(container_engines); do
    engine="$candidate"
    flavor=docker
    "$engine" --version 2>/dev/null | grep -qi podman && flavor=podman
    engine_args=()
    select_connection
    problem="$(engine_problem)"
    if [[ -z "$problem" ]]; then
      [[ -z "$first" ]] || say "$first — using $engine instead"
      return 0
    fi
    [[ -n "$first" ]] || first="$problem"
  done
  engine=""
  flavor=""
  engine_args=()
  die "${first:-a linux target needs docker or podman on PATH}" \
      "podman: podman machine init (once), then podman machine start; grow one with" \
      "        podman machine stop && podman machine set --memory 24576 --cpus 8 && podman machine start" \
      "        (VIS_CONTAINER_CONNECTION=<machine> forces one explicitly)" \
      "docker: start Docker Desktop; Settings -> Resources -> Memory >= 16 GB"
}

# How fast is this platform HERE? Nothing in `docker info` says which emulator
# binfmt_misc hands a foreign binary to, and that single fact decides whether
# linux-x64 is an hour or a lost night — so measure it with a fixed integer loop.
# Measured on an M-series Mac, podman applehv, 8 vCPU (1e6 shell iterations):
#   linux/arm64, no emulation   2 s
#   linux/amd64 through Rosetta 11 s   (native-image itself: 4.8x, hello world
#                                       15.8 s arm64 vs 1 m 16 s amd64)
# qemu-user's TCG interpreter is another order of magnitude below Rosetta, and
# an analysis at that speed does not finish.
platform_loop_seconds() {
  local platform="$1" started
  eng run --rm --platform "$platform" "$probe_image" true >/dev/null 2>&1 || \
    die "$engine cannot run $platform containers here" \
        "podman: recreate the machine with Rosetta — put '[machine]' + 'rosetta = true' in" \
        "        ~/.config/containers/containers.conf, then podman machine init (it is an" \
        "        init-time setting; 'podman machine set' cannot turn it on)" \
        "docker: Settings -> General -> Use Rosetta for x86_64/amd64 emulation"
  started=$SECONDS
  eng run --rm --platform "$platform" "$probe_image" \
    sh -c 'i=0; while [ "$i" -lt 1000000 ]; do i=$((i+1)); done' >/dev/null
  printf '%s\n' "$(( SECONDS - started ))"
}

require_usable_platform() {
  local platform="$1" seconds budget
  budget="${VIS_EMULATION_MAX_SECONDS:-40}"
  say "probing $platform (is this emulator Rosetta or qemu?)"
  seconds="$(platform_loop_seconds "$platform")"
  say "$platform ran the reference loop in ${seconds}s (native ~2s, Rosetta ~11s)"
  (( seconds <= budget )) || [[ -n "${VIS_ALLOW_SLOW_EMULATION:-}" ]] || \
    die "$platform is emulated far below Rosetta speed here (${seconds}s vs ~11s)" \
        "That is qemu-user, and a native-image analysis on it runs for many hours" \
        "and usually dies. Give the engine Rosetta, use a real host of that arch," \
        "or leave this asset to CI:" \
        "  gh workflow run native-release.yml -f tag=${tag:-vX.Y.Z}" \
        "VIS_ALLOW_SLOW_EMULATION=1 overrides this, at that cost."
}

# The sha `vis-agent --version` reports. `.dockerignore` drops `.git`, so a
# container build cannot ask git itself and stamps "dev" unless the host tells
# it; `build.clj` prefers this value over its own probe.
build_sha() { git rev-parse --short HEAD 2>/dev/null || true; }

# podman exports the stage out of a CONTAINER instead of through `--output`:
# `-o type=local,dest=…` is a LOCAL-only flag, and a Mac client drives its Linux
# VM in REMOTE mode, where podman rejects it outright ("'--output' option is not
# supported in remote mode") after the whole build has already run. Building the
# stage as an image and copying the bundle out of a created — never started —
# container works remotely and locally alike, so podman always takes this path.
# The scratch stage's entire filesystem is exactly the four entries
# stage-release-bundle expects.
podman_export() {
  local platform="$1" graal_arch="$2" out="$3"
  local image="vis-native-export:${platform##*/}" ctr entry
  eng build \
    --target native-export \
    --platform "$platform" \
    --build-arg GRAAL_ARCH="$graal_arch" \
    --build-arg VIS_NATIVE_EXTRA_ARGS="${VIS_NATIVE_EXTRA_ARGS:-}" \
    --build-arg VIS_BUILD_SHA="$(build_sha)" \
    -t "$image" \
    .
  ctr="$(eng create --platform "$platform" "$image" /vis-agent)" || \
    die "podman could not create a container from $image"
  for entry in vis-agent vis-agent-native install-vis-agent vis-agent-resources; do
    eng cp "$ctr:/$entry" "$out/$entry" || {
      eng rm -f "$ctr" >/dev/null 2>&1 || true
      die "podman cp failed for /$entry out of $image"
    }
  done
  eng rm -f "$ctr" >/dev/null
}

# The builder inside the container sizes its own heap from what the VM reports
# (60% of RAM, capped at 18 GiB — see build.clj), so a 20 GiB machine yields
# -J-Xmx12g: exactly the ceiling that OOMed CI's x64 job from v0.1.23 on. Give
# the machine more RAM, or set VIS_NATIVE_EXTRA_ARGS — it is forwarded into the
# build so this host can override both -J flags without touching the Dockerfile.
build_linux() {
  local target="$1" platform graal_arch asset out
  case "$target" in
    linux-arm64) platform=linux/arm64 graal_arch=aarch64 ;;
    linux-x64)   platform=linux/amd64 graal_arch=x64 ;;
    *)           die "unknown linux target $target" ;;
  esac
  asset="vis-agent-${target}-community.tar.gz"
  out="target/native-export/$target"
  resolve_engine
  require_usable_platform "$platform"
  say "building $target ($engine, $platform)"
  rm -rf "$out"
  mkdir -p "$out"
  if [[ "$flavor" == podman ]]; then
    podman_export "$platform" "$graal_arch" "$out"
  else
    eng buildx build \
      --target native-export \
      --platform "$platform" \
      --build-arg GRAAL_ARCH="$graal_arch" \
      --build-arg VIS_NATIVE_EXTRA_ARGS="${VIS_NATIVE_EXTRA_ARGS:-}" \
      --build-arg VIS_BUILD_SHA="$(build_sha)" \
      --output "type=local,dest=$out" \
      .
  fi
  bin/stage-release-bundle --from-dir "$out" "$asset"
  say "smoke: help inside a $platform container"
  eng run --rm --platform "$platform" \
    -v "$repo_root/target/release-bundle:/bundle:ro" \
    "$probe_image" /bundle/vis-agent --native help >/dev/null
  say "smoke: GraalPy stdlib inside that container"
  eng run --rm --platform "$platform" \
    -v "$repo_root/target/release-bundle:/bundle:ro" \
    "$probe_image" /bundle/vis-agent --native python -c "import ast; print('py-ok')" \
    | grep -qx 'py-ok' || die "the $target bundle cannot import the Python stdlib"
  built_asset="$asset"
}

# Builders stream their (long) output straight to this terminal and hand the
# finished asset back through `built_asset` — never through a command
# substitution, which would swallow an hour of build log.
assets=()
built_asset=""
for t in "${selected[@]}"; do
  case "$t" in
    macos-arm64)           build_macos_arm64; assets+=("$built_asset") ;;
    linux-arm64|linux-x64) build_linux "$t"; assets+=("$built_asset") ;;
  esac
done

say "built: ${assets[*]}"

if (( upload )); then
  say "uploading to $tag"
  gh release upload "$tag" "${assets[@]}" --clobber
  say "attached ${assets[*]} to $tag"
else
  say "not uploaded (pass --upload [--tag vX.Y.Z] to attach them to a release)"
fi
