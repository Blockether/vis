#!/usr/bin/env bash
# Fetch the reference clips that Pocket TTS speaks with, and pack them as
# `pocket-voice-clips.tar.bz2`, one small asset in the assets-pack release,
# carried by the `pocket-voice-clips` manifest entry.
#
# WHY THESE CLIPS
#   * Pocket clones a REFERENCE CLIP instead of selecting a baked speaker, so a
#     voice in that engine is a WAV file and nothing else.
#   * These are the voices of Kyutai's own catalogue (`pocket-tts` 1.0.3:
#     alba, marius, javert, fantine, eponine, azelma), from the source
#     recordings in https://huggingface.co/kyutai/tts-voices. The engine then
#     sounds like itself, not like another engine.
#   * Only clips that may ship in a release asset are here. jean (EARS) and
#     cosette (Expresso) are CC BY-NC 4.0, and NonCommercial binds the
#     distributor, so they are deliberately absent.
#   * Licences: alba is Alba MacKenna, CC BY 4.0. fantine, eponine and azelma
#     are VCTK speakers p244, p262 and p303, CC BY 4.0. marius and javert are
#     Unmute voice donations, CC0.
#
# Each clip is the whole source recording (10 to 13 seconds), resampled to the
# 24 kHz mono that the Mimi encoder wants and levelled to a -3 dBFS peak. The
# text beside each clip is its transcript: sherpa passes it to the model as
# the reference text. It ends up in the manifest as `:clip-text`.
#
# Usage:
#   bin/make-voice-clips                     # dist/pocket-voice-clips
#   bin/make-voice-clips --out /tmp/clips
#
# Then upload the pack and paste the printed sha256 and byte count into the
# `pocket-voice-clips` entry of the model manifest:
#   gh release upload assets-pack dist/pocket-voice-clips/pocket-voice-clips.tar.bz2
#
# Requires: ffmpeg, tar, curl. No Hugging Face token: the repository is public.

set -euo pipefail

CLIP_RATE=24000 # what the Mimi encoder wants; sherpa resamples anything else
PACK_NAME="pocket-voice-clips"
# A pinned revision, so the same command fetches the same bytes.
REVISION="323332d33f997de8394f24a193e1a76df720e01a"
UPSTREAM="https://huggingface.co/kyutai/tts-voices/resolve/${REVISION}"

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
out_dir="${repo_root}/dist/${PACK_NAME}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --out) out_dir="$2"; shift 2 ;;
    -h|--help) sed -n '2,31p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done

for tool in ffmpeg tar curl; do
  command -v "$tool" >/dev/null 2>&1 || { echo "missing required tool: $tool" >&2; exit 1; }
done

digest_of() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | cut -d' ' -f1
  else
    shasum -a 256 "$1" | cut -d' ' -f1
  fi
}

# id|label|gender|licence|source path|sha256|transcript
# The sha256 is the source recording's, and it is verified: a clip may only
# ship because of WHICH recording it is.
voice_rows() {
  cat <<'ROWS'
alba|Alba|female|CC-BY-4.0|alba-mackenna/casual.wav|46264e83cb99115c3d210260e029117566d9c64f20266d10daa78107759ede3e|How am I doing? How's it going? How can I help? Need anything? Not right now. Sorry, I can't. Maybe later. I'm afraid not. I couldn't.
marius|Marius|male|CC0-1.0|voice-donations/Selfie.wav|076968c3122520f3412eb7090e8c1c3f75fe57be1e24a2f96465583d84c71e16|know if it's the first ten seconds or the last ten seconds that you're going to use. It says it's the last ten seconds, and if that's the case and I'd showed up previously, there would just be ten seconds.
javert|Javert|male|CC0-1.0|voice-donations/Butter.wav|b889e080eec3efa824bddaf875b4f531d75464f88128d08941ae648d9d3ade70|I would like to buy an avocado. One that is green on the outside and green
fantine|Fantine|female|CC-BY-4.0|vctk/p244_023.wav|3a9d5c27bd89911a58b0e68b4f5e80082d2a6a67e112a9ce17c5a6dc54c9271e|If the red of the second bow falls upon the green of the first, the result is to give a bow with an abnormally wide yellow band, since red and green light when mixed form yellow.
eponine|Eponine|female|CC-BY-4.0|vctk/p262_023.wav|064c63ee786a58b605ac288f0d97d1adcb6b9662bde39e2fc3eabf17a2eb1715|If the red of the second bow falls upon the green of the first, the result is to give a bow with an abnormally wide yellow band, since red and green light when mixed form yellow.
azelma|Azelma|female|CC-BY-4.0|vctk/p303_023.wav|0f71ceb87f24d1d13367fdbe064d7f7afc93d5758c7beaddfc49c697f87ca60e|If the red of the second bow falls upon the green of the first, the result is to give a bow with an abnormally wide yellow band, since red and green light when mixed form yellow.
ROWS
}

work_dir="$(mktemp -d "${TMPDIR:-/tmp}/vis-voice-clips.XXXXXX")"
trap 'rm -rf "$work_dir"' EXIT
pack_dir="${work_dir}/${PACK_NAME}"
mkdir -p "${pack_dir}/voices" "$out_dir"

while IFS='|' read -r id label gender licence source sha text; do
  [[ -z "$id" ]] && continue
  raw="${work_dir}/${id}-source.wav"
  echo "==> ${id}: ${label}, ${gender}, ${licence}"
  curl -fsSL "${UPSTREAM}/${source}" -o "$raw"
  actual="$(digest_of "$raw")"
  if [[ "$actual" != "$sha" ]]; then
    echo "${source}: expected sha256 ${sha}, got ${actual}" >&2
    exit 1
  fi
  # Measure the peak, then scale it to -3 dBFS: clips of one catalogue
  # must not differ in loudness.
  peak_db="$(ffmpeg -nostdin -v info -i "$raw" -af volumedetect -f null - 2>&1 \
    | sed -n 's/.*max_volume: \(-\{0,1\}[0-9.]*\) dB.*/\1/p')"
  gain="$(awk -v p="$peak_db" 'BEGIN { printf "%.2f", -3 - p }')"
  ffmpeg -nostdin -v error -y -i "$raw" -af "volume=${gain}dB" -ac 1 -ar "$CLIP_RATE" \
    -c:a pcm_s16le "${pack_dir}/voices/${id}.wav"
  printf '%s\n' "$text" > "${pack_dir}/voices/${id}.txt"
done < <(voice_rows)

# One top-level directory, because the installer strips exactly one on the way in.
# COPYFILE_DISABLE keeps the macOS AppleDouble `._*` files out of the pack.
pack="${out_dir}/${PACK_NAME}.tar.bz2"
COPYFILE_DISABLE=1 tar -cjf "$pack" -C "$work_dir" "$PACK_NAME"
cp -R "${pack_dir}/." "${out_dir}/"

cat <<EOF

==> packed into ${pack}
    bytes   $(wc -c < "$pack" | tr -d ' ')
    sha256  $(digest_of "$pack")

Upload it, then move those two numbers into the pocket-voice-clips entry of
resources/vis-models/manifest.edn.
EOF
