#!/usr/bin/env bash
# Stage (and tar) ONE native release bundle — the single definition of what a
# `vis-agent-<os>-<arch>-community.tar.gz` contains. Used by
# .github/workflows/native-release.yml AND by bin/release-native, so a CI asset
# and a locally built asset can never drift apart.
#
#   bin/stage-release-bundle target/vis vis-agent-linux-arm64-community.tar.gz
#   bin/stage-release-bundle --from-dir out/linux-arm64 vis-agent-linux-arm64-community.tar.gz
#
# Bundle layout (exactly what `vis-agent update` unpacks):
#   vis-agent             the public Bash wrapper
#   vis-agent-native      the private native runtime
#   vis-agent-python/     the embedded CPython: cdylib + vendored interpreter
#   vis-agent-native.build  the build stamp: version, commit, track, timestamp
#   install-vis-agent     the installer, so a bundle can bootstrap itself
#
# The interpreter DIRECTORY is not optional. It is tens of megabytes, so
# `clojure -T:build native` stages it beside the binary instead of embedding it
# (build.clj `stage-python-sidecar!`), the wrapper points
# VIS_PYTHON_NATIVE_PATH at it, and shipping the binary alone gives every user a
# runtime whose first Python call dies with a library-not-found. Hence: hard
# error, never a warning.
set -euo pipefail

die() { printf 'stage-release-bundle: %s\n' "$@" >&2; exit 1; }

repo_root="$(cd -P "$(dirname "${BASH_SOURCE[0]:-$0}")/.." && pwd)"
bundle="${VIS_BUNDLE_DIR:-$repo_root/target/release-bundle}"

from_dir=""
native=""
asset=""
while (( $# )); do
  case "$1" in
    --from-dir) from_dir="${2:-}"; shift 2 ;;
    -h|--help) sed -n '2,20p' "${BASH_SOURCE[0]:-$0}"; exit 0 ;;
    -*) die "unknown option $1" ;;
    *)
      if [[ -z "$native" && -z "$from_dir" ]]; then native="$1"
      elif [[ -z "$asset" ]]; then asset="$1"
      else die "too many arguments: $1"
      fi
      shift ;;
  esac
done

[[ -n "$asset" ]] || die "usage: stage-release-bundle <native-binary>|--from-dir <dir> <asset.tar.gz>"

rm -rf "$bundle"
mkdir -p "$bundle"

if [[ -n "$from_dir" ]]; then
  # A bundle another builder already produced (the Dockerfile's `native-export`
  # stage). Only re-check and pack it; never rewrite its wrapper from THIS
  # checkout, or a cross-built asset would carry a wrapper the binary never saw.
  [[ -d "$from_dir" ]] || die "no such directory: $from_dir"
  for entry in vis-agent vis-agent-native install-vis-agent; do
    [[ -f "$from_dir/$entry" ]] || die "$from_dir is missing $entry"
    install -m 0755 "$from_dir/$entry" "$bundle/$entry"
  done
  [[ -d "$from_dir/vis-agent-python" ]] || \
    die "$from_dir is missing vis-agent-python/ — the embedded CPython sidecar" \
        "Rebuild it: 'clojure -T:build native' stages it beside the image."
  cp -R "$from_dir/vis-agent-python" "$bundle/vis-agent-python"
  [[ -f "$from_dir/vis-agent-native.build" ]] || \
    die "$from_dir is missing vis-agent-native.build — the build stamp" \
        "'clojure -T:build native' writes it beside the image; without it nobody" \
        "can tell which commit an installed runtime came from."
  install -m 0644 "$from_dir/vis-agent-native.build" "$bundle/vis-agent-native.build"
else
  [[ -x "$native" ]] || die "no native runtime at $native"
  native_dir="$(cd -P "$(dirname "$native")" && pwd)"
  python_dir="${VIS_NATIVE_PYTHON:-$native_dir/vis-agent-python}"
  [[ -d "$python_dir" ]] || \
    die "no embedded CPython sidecar at $python_dir" \
        "'clojure -T:build native' stages it beside the image; rebuild instead" \
        "of packing a runtime with no interpreter."
  install -m 0755 "$repo_root/bin/vis-agent" "$bundle/vis-agent"
  install -m 0755 "$native" "$bundle/vis-agent-native"
  install -m 0755 "$repo_root/bin/install-vis-agent" "$bundle/install-vis-agent"
  cp -R "$python_dir" "$bundle/vis-agent-python"
  # Provenance travels WITH the binary, and beside it: a runtime that aborts on
  # every command still has to answer which commit built it.
  [[ -f "$native.build" ]] || \
    die "no build stamp at $native.build" \
        "'clojure -T:build native' writes it beside the image; rebuild instead of" \
        "packing a runtime nobody can date."
  install -m 0644 "$native.build" "$bundle/vis-agent-native.build"
fi

tar -C "$bundle" -czf "$asset" .
printf 'stage-release-bundle: %s (%s)\n' "$asset" "$(du -sh "$asset" | cut -f1)"
