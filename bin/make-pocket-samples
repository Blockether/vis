#!/usr/bin/env bash
# Speak ONE sentence in every Pocket voice that Vis ships, so a reader can hear
# what the ENGINE sounds like before downloading the 96 MB model. The result is
# `pocket-voice-samples.tar.bz2`, one small asset in the assets-pack release,
# carried by the `pocket-voice-samples` manifest entry.
#
# A pocket voice is a reference clip, but the clip is what the engine copies,
# not what it says. So each sample is Pocket's own speech of the Piper sample
# sentence (`tts/sample-text`), cloned from the voice's clip in
# `pocket-voice-clips` and levelled to the same -3 dBFS peak as the other packs.
#
# Licence: pocket-tts is CC BY 4.0 (Kyutai) and the clips are CC BY 4.0 or CC0,
# so the audio can ship in a release asset with the credits in the manifest.
#
# Usage:
#   bin/make-pocket-samples                     # dist/pocket-voice-samples
#   bin/make-pocket-samples --out /tmp/samples
#
# Then upload the pack and paste the printed sha256 and byte count into the
# `pocket-voice-samples` entry of the model manifest:
#   gh release upload assets-pack dist/pocket-voice-samples/pocket-voice-samples.tar.bz2
#
# Requires: clojure, tar and the installed model
# (`vis-agent speech models download --pocket-tts`). The clips
# install on first use.

set -euo pipefail

PACK_NAME="pocket-voice-samples"

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
out_dir="${repo_root}/dist/${PACK_NAME}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --out) out_dir="$2"; shift 2 ;;
    -h|--help) sed -n '2,25p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done

for tool in clojure tar; do
  command -v "$tool" >/dev/null 2>&1 || { echo "missing required tool: $tool" >&2; exit 1; }
done

digest_of() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | cut -d' ' -f1
  else
    shasum -a 256 "$1" | cut -d' ' -f1
  fi
}

work_dir="$(mktemp -d "${TMPDIR:-/tmp}/vis-pocket-samples.XXXXXX")"
trap 'rm -rf "$work_dir"' EXIT
pack_dir="${work_dir}/${PACK_NAME}"
mkdir -p "$pack_dir" "$out_dir"

echo "==> speaking every voice into ${pack_dir}"
cd "$repo_root"
clojure -M -e "
(require '[clojure.java.io :as io]
         '[com.blockether.vis.internal.speech.assets :as assets]
         '[com.blockether.vis.internal.speech.sherpa :as sherpa]
         '[com.blockether.vis.internal.speech.tts :as tts]
         '[com.blockether.vis.internal.speech.vibevoice :as vibevoice])
(when-not (assets/installed? (tts/pocket-asset))
  (binding [*out* *err*] (println \"Install the model first: vis-agent speech models download --pocket-tts\"))
  (System/exit 1))
(sherpa/ensure-native!)
(doseq [{:keys [id]} (:voices (tts/pocket-clips-asset))]
  (let [spoken (io/file (str (:audio-path (tts/synthesize! :pocket-tts {:text tts/sample-text :voice-id id}))))
        {:keys [samples sample-rate]} (vibevoice/read-wav spoken)]
    (vibevoice/write-wav! (io/file \"${pack_dir}\" (str id \".wav\")) (vibevoice/level samples) (long sample-rate))
    (.delete spoken)
    (println \"   \" id)))
(shutdown-agents)
(System/exit 0)"

# One top-level directory, because the installer strips exactly one on the way in.
# COPYFILE_DISABLE keeps the macOS AppleDouble `._*` files out of the pack.
pack="${out_dir}/${PACK_NAME}.tar.bz2"
COPYFILE_DISABLE=1 tar -cjf "$pack" -C "$work_dir" "$PACK_NAME"
cp -R "${pack_dir}/." "${out_dir}/"

cat <<EOF

==> packed into ${pack}
    bytes   $(wc -c < "$pack" | tr -d ' ')
    sha256  $(digest_of "$pack")

Upload it, then move those two numbers into the pocket-voice-samples entry of
resources/vis-models/manifest.edn.
EOF
