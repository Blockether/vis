#!/usr/bin/env bash
# Export Kyutai's pocket-tts to the ONNX bundle sherpa-onnx loads — from the
# ORIGINAL weights, with tooling this repository owns, so the artifact Vis
# publishes is Vis' own.
#
# WHY this exists (licence, not preference):
#   * Kyutai publishes pocket-tts under CC BY 4.0. Commercial use and
#     redistribution of an adaptation are both permitted, with attribution — so
#     an export WE make is ours to ship in the voice assets release.
#   * The ready-made ONNX bundle everyone else uses is a THIRD PARTY's export,
#     and the README inside that archive says "It is for non-commercial" while
#     the LICENSE beside it is plain CC BY 4.0. Nobody here can resolve someone
#     else's contradiction, so Vis does not mirror that file: it exports the
#     weights itself and ships the result under CC BY 4.0 with attribution.
#
# WHERE THE EXPORT CODE LIVES:
#   scripts/pocket-tts-onnx/ — the ONNX export layer, MIT, vendored into this
#   repository and pinned by content rather than fetched from a network at
#   build time. It runs against Kyutai's OWN package (`pocket-tts` on PyPI),
#   which is where every model module comes from; the layer only wraps those
#   modules so torch can trace them, and quantizes what comes out. Vendored so
#   the build pulls no code it has not pinned, the revision cannot move under a
#   release, and the graphs are ours to fix.
#
# WHY THIS EXPORT AND NOT A NEWER ONE (measured, not preferred):
#   a later revision of that layer retargets the 2026-04 checkpoint and writes
#   the Mimi encoder at opset 18 with latents shaped [1, frames, 1024].
#   sherpa-onnx reads the transposed layout the vendored one emits, so the newer
#   bundle loads and runs and produces noise — Parakeet transcribed its speech
#   as an empty string, where this bundle came back verbatim. `--check` below is
#   that round trip; keep it green before changing anything under scripts/.
#
# The Hugging Face token is a BUILD-TIME credential and never reaches a user:
# kyutai/pocket-tts is gated (auto-approve), so fetching the weights needs an
# account. Everything this script produces is published in the voice assets
# release, which needs no account, no token and no Hugging Face at all.
#
# Usage:
#   HF_TOKEN=… bin/export-pocket-tts                       # export, check, package
#   HF_TOKEN=… bin/export-pocket-tts --voices ~/clips      # reference clips to bundle
#   HF_TOKEN=… bin/export-pocket-tts --out /tmp/pack --keep-work
#
# Adding clips to a bundle this script already made needs NO token and no
# weights - it unpacks, adds, re-checks and re-packages:
#   bin/export-pocket-tts --from dist/voice-assets/pocket-tts-onnx.tar.bz2 \
#                         --voices dist/voice-clips
#
# `bin/make-voice-clips` is what records those clips, and says why only some
# voices may be recorded at all.
#
# Then, deliberately and only when asked:
#   gh release upload voice-assets-pack <out>/pocket-tts-onnx.tar.bz2 --repo Blockether/vis
#
# Requires: uv, tar, bzip2. ~10 GB of disk and a few minutes.

set -euo pipefail

# The model code the export traces. Pinned: an export is only reproducible if
# the modules it wraps are. Bump this, re-export, and publish the new digest.
POCKET_TTS_VERSION="1.0.3"
WEIGHTS_REPO="kyutai/pocket-tts"
VARIANT="b6369a24" # the checkpoint exported here: tts_b6369a24.safetensors
PYTHON_VERSION="3.12"
SHERPA_VERSION="1.13.5" # only for --check; never shipped

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exporter="${repo_root}/scripts/pocket-tts-onnx"
out_dir="${repo_root}/dist/voice-assets"
work_dir=""
voices_dir=""
from_bundle=""
keep_work=0
do_check=1

while [[ $# -gt 0 ]]; do
  case "$1" in
    --out) out_dir="$2"; shift 2 ;;
    --work) work_dir="$2"; shift 2 ;;
    --voices) voices_dir="$2"; shift 2 ;;
    --from) from_bundle="$2"; shift 2 ;;
    --keep-work) keep_work=1; shift ;;
    --no-check) do_check=0; shift ;;
    -h|--help) sed -n '2,54p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done

token="${HF_TOKEN:-${HUGGING_FACE_HUB_TOKEN:-}}"
if [[ -z "$token" && -z "$from_bundle" ]]; then
  cat >&2 <<'EOF'
No Hugging Face token.

  kyutai/pocket-tts is gated (auto-approve): accept the terms once at
  https://huggingface.co/kyutai/pocket-tts, then

      HF_TOKEN=hf_… bin/export-pocket-tts

  This credential is used ONCE, here, to fetch CC BY 4.0 weights. It is not
  needed to USE anything this script produces, and --from needs none of it.
EOF
  exit 1
fi

for tool in uv tar; do
  command -v "$tool" >/dev/null 2>&1 || { echo "missing required tool: $tool" >&2; exit 1; }
done

if [[ -z "$work_dir" ]]; then
  work_dir="$(mktemp -d "${TMPDIR:-/tmp}/vis-pocket-tts-export.XXXXXX")"
fi
mkdir -p "$work_dir" "$out_dir"
cleanup() {
  if [[ "$keep_work" -eq 0 && -d "$work_dir" ]]; then rm -rf "$work_dir"; fi
}
trap cleanup EXIT

echo "==> work    ${work_dir}"
echo "==> out     ${out_dir}"
if [[ -n "$from_bundle" ]]; then
  echo "==> source  ${from_bundle} (re-packaged, not re-exported)"
else
  echo "==> weights ${WEIGHTS_REPO} ${VARIANT} (CC BY 4.0)"
  echo "==> export  scripts/pocket-tts-onnx (MIT) on pocket-tts ${POCKET_TTS_VERSION}"
fi

echo "==> creating the export environment (python ${PYTHON_VERSION})"
uv venv --quiet --python "$PYTHON_VERSION" "${work_dir}/venv"
# shellcheck disable=SC1091
source "${work_dir}/venv/bin/activate"
stage="${work_dir}/sherpa-onnx-pocket-tts-int8"
rm -rf "$stage"
mkdir -p "$stage"

if [[ -n "$from_bundle" ]]; then
  # Re-packaging a bundle this script already made: no weights, no token, no
  # export. Adding a voice must not depend on a gated download staying gated in
  # the same way a year from now.
  echo "==> unpacking ${from_bundle}"
  tar -xjf "$from_bundle" -C "$work_dir"
  for required in lm_main.int8.onnx lm_flow.int8.onnx encoder.onnx \
    decoder.int8.onnx text_conditioner.onnx vocab.json token_scores.json; do
    if [[ ! -f "${stage}/${required}" ]]; then
      echo "${from_bundle} is not a pocket-tts bundle: no ${required}" >&2
      exit 1
    fi
  done
else
  # pocket-tts brings torch, beartype, safetensors and the rest of the model's own
  # dependencies; onnx/onnxruntime/onnxscript are the export and quantization side.
  # pyyaml is named because pocket_tts.utils.config imports it without declaring it.
  uv pip install --quiet "pocket-tts==${POCKET_TTS_VERSION}" onnx onnxruntime onnxscript pyyaml

  weights_dir="${work_dir}/weights"
  echo "==> fetching the weights"
  HF_TOKEN="$token" HUGGING_FACE_HUB_TOKEN="$token" \
    python - "$WEIGHTS_REPO" "$VARIANT" "$weights_dir" <<'PY'
import sys

from huggingface_hub import hf_hub_download

repo, variant, target = sys.argv[1], sys.argv[2], sys.argv[3]
for name in (f"tts_{variant}.safetensors", "tokenizer.model"):
    print("   ", hf_hub_download(repo_id=repo, filename=name, local_dir=target))
PY
  weights="${weights_dir}/tts_${VARIANT}.safetensors"

  onnx_dir="${work_dir}/onnx"
  mkdir -p "$onnx_dir"
  echo "==> exporting ${VARIANT} (this is the slow part)"
  python "${exporter}/export_mimi_and_conditioner.py" --output_dir "$onnx_dir" --weights_path "$weights"
  python "${exporter}/export_flow_lm.py" --output_dir "$onnx_dir" --weights_path "$weights"
  python "${exporter}/quantize.py" --input_dir "$onnx_dir" --output_dir "$onnx_dir"

  # sherpa-onnx reads seven files under names of its own. Everything else the
  # export wrote is either a duplicate precision or runtime metadata its C++
  # loader does not read, and shipping it would only make the archive bigger.
  copy_as() {
    local from="${onnx_dir}/$1" to="${stage}/$2"
    [[ -f "$from" ]] || { echo "the export did not produce $1" >&2; exit 1; }
    cp "$from" "$to"
  }
  copy_as flow_lm_main_int8.onnx  lm_main.int8.onnx
  copy_as flow_lm_flow_int8.onnx  lm_flow.int8.onnx
  copy_as mimi_encoder.onnx       encoder.onnx
  copy_as mimi_decoder_int8.onnx  decoder.int8.onnx
  copy_as text_conditioner.onnx   text_conditioner.onnx

  # sherpa's C++ tokenizer reads plain JSON instead of linking sentencepiece, so
  # the vocabulary is flattened here (the same transformation as
  # k2-fsa/sherpa-onnx scripts/pocket-tts/convert_tokenizer.py, Apache-2.0).
  echo "==> flattening the tokenizer"
  python - "${weights_dir}/tokenizer.model" "$stage" <<'PY'
import json
import sys

import sentencepiece as spm

model, stage = sys.argv[1], sys.argv[2]
sp = spm.SentencePieceProcessor(model_file=model)
vocab = {sp.id_to_piece(i): i for i in range(sp.get_piece_size())}
scores = {sp.id_to_piece(i): sp.get_score(i) for i in range(sp.get_piece_size())}
for name, data in (("vocab.json", vocab), ("token_scores.json", scores)):
    with open(f"{stage}/{name}", "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2, ensure_ascii=False)
PY
fi

# A pocket voice IS a reference clip the model clones, so the bundle carries its
# own under voices/, each with the transcript sherpa passes to the model as the
# reference text. Only clips that may be redistributed belong here -
# `bin/make-voice-clips` records the ones Vis is allowed to publish.
if [[ -n "$voices_dir" ]]; then
  mkdir -p "${stage}/voices"
  cp "${voices_dir}"/*.wav "${stage}/voices/"
  for clip in "${stage}/voices"/*.wav; do
    transcript="${voices_dir}/$(basename "${clip%.wav}").txt"
    [[ -f "$transcript" ]] && cp "$transcript" "${stage}/voices/"
  done
  echo "==> bundled $(find "${stage}/voices" -name '*.wav' | wc -l | tr -d ' ') reference clips"
fi

# The export is only worth publishing if sherpa can speak with it. A bundle
# whose encoder layout sherpa misreads still loads and still returns audio — it
# just returns noise — so the check is a round trip: clone a clip, say a
# sentence, and require the audio to last as long as the sentence does.
if [[ "$do_check" -eq 1 ]]; then
  echo "==> checking the bundle through sherpa-onnx ${SHERPA_VERSION}"
  # numpy reads the clip and measures the answer; the export path gets it
  # from torch, and --from installs neither.
  uv pip install --quiet "sherpa-onnx==${SHERPA_VERSION}" numpy
  check_wav="${work_dir}/check.wav"
  check_text=""
  bundled_clip="$(find "${stage}/voices" -name '*.wav' 2>/dev/null | head -1 || true)"
  if [[ -n "$bundled_clip" ]]; then
    # Check with a clip the bundle SHIPS and the transcript beside it: exactly
    # what a caller does, rather than a clip nobody will ever hear.
    check_wav="$bundled_clip"
    transcript="${bundled_clip%.wav}.txt"
    if [[ -f "$transcript" ]]; then check_text="$(cat "$transcript")"; fi
  elif [[ "$(uname)" == "Darwin" ]]; then
    check_text="The quick brown fox jumps over the lazy dog, and the voice you hear is only a reference clip."
    say -v Samantha --data-format=LEI16@24000 -o "$check_wav" \
      "The quick brown fox jumps over the lazy dog, and the voice you hear is only a reference clip."
  else
    echo "no reference clip and no 'say' to record one: skipping the check" >&2
    check_wav=""
  fi
  if [[ -n "$check_wav" ]]; then
    python - "$stage" "$check_wav" "$check_text" <<'PY'
import sys
import wave

import numpy as np
import sherpa_onnx as so

stage, clip, prompt = sys.argv[1], sys.argv[2], sys.argv[3]
tts = so.OfflineTts(so.OfflineTtsConfig(model=so.OfflineTtsModelConfig(num_threads=4,
    pocket=so.OfflineTtsPocketModelConfig(
        lm_main=f"{stage}/lm_main.int8.onnx", lm_flow=f"{stage}/lm_flow.int8.onnx",
        encoder=f"{stage}/encoder.onnx", decoder=f"{stage}/decoder.int8.onnx",
        text_conditioner=f"{stage}/text_conditioner.onnx",
        vocab_json=f"{stage}/vocab.json", token_scores_json=f"{stage}/token_scores.json"))))
with wave.open(clip) as w:
    rate = w.getframerate()
    samples = np.frombuffer(w.readframes(w.getnframes()), dtype=np.int16).astype(np.float32) / 32768.0
text = "Local speech now runs entirely on this machine, with no account and no network."
audio = tts.generate(text, prompt_text=prompt, prompt_samples=samples, sample_rate=rate)
data = np.asarray(audio.samples, dtype=np.float32)
seconds = len(data) / audio.sample_rate
level = float(np.sqrt((data ** 2).mean()))
print(f"    spoke {seconds:.2f}s at {audio.sample_rate} Hz, rms {level:.3f}")
if seconds < 3.0 or level < 0.01:
    raise SystemExit(f"the bundle does not speak: {seconds:.2f}s of audio for {len(text)} characters")
PY
  fi
fi

cat > "${stage}/LICENSE" <<EOF
Kyutai pocket-tts, exported to ONNX by the Vis project.

Weights: https://huggingface.co/${WEIGHTS_REPO}
Licence: Creative Commons Attribution 4.0 International (CC BY 4.0)
         https://creativecommons.org/licenses/by/4.0/

This bundle is an adaptation of Kyutai's model: their published weights,
converted to ONNX and quantized to int8 by \`bin/export-pocket-tts\`. It is
distributed under the same CC BY 4.0 terms, with attribution to Kyutai.

Reference clips under voices/, when present, are public domain: they are
generated by \`bin/make-voice-clips\` from public-domain Piper voices (Bryce
Beattie, https://brycebeattie.com/files/tts/) and carry no further terms. The
transcript beside each clip is the reference text the model is given.
EOF

cat > "${stage}/README.md" <<EOF
# pocket-tts (int8), exported by Vis

| | |
|---|---|
| weights | [${WEIGHTS_REPO}](https://huggingface.co/${WEIGHTS_REPO}) — CC BY 4.0, checkpoint \`${VARIANT}\` |
| model code | \`pocket-tts ${POCKET_TTS_VERSION}\`, Kyutai's own package |
| exported | $(date -u +%Y-%m-%d) |
| reproduce | \`bin/export-pocket-tts\` |

Vis exports these weights itself rather than mirroring a ready-made bundle;
\`bin/export-pocket-tts\` says why in its header. Attribution belongs to Kyutai.
EOF

archive="${out_dir}/pocket-tts-onnx.tar.bz2"
echo "==> packaging ${archive}"
tar -cjf "$archive" -C "$work_dir" "$(basename "$stage")"

if command -v sha256sum >/dev/null 2>&1; then
  digest="$(sha256sum "$archive" | cut -d' ' -f1)"
else
  digest="$(shasum -a 256 "$archive" | cut -d' ' -f1)"
fi
bytes="$(wc -c < "$archive" | tr -d ' ')"

cat <<EOF

Done.

  ${archive}
  sha256 ${digest}
  bytes  ${bytes}

Paste into extensions/common/vis-foundation-voice/resources/vis-models/manifest.edn:

   :sha256 "${digest}"
   :bytes ${bytes}
EOF
