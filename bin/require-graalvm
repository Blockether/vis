#!/usr/bin/env bash
# Resolve — and if asked, install — THE JDK this repo builds and runs with:
# GraalVM Community Edition, exact version, as pinned in .graalvm-version.
#
# Why this exists at all: three different JDKs will happily start a Clojure REPL
# here and only fail later, expensively.
#   * a stock JDK 25 (temurin/oracle): boots, then the embedded GraalPy refuses
#     to initialise (no Truffle runtime) and there is no `native-image` at all;
#   * Oracle GraalVM: builds fine but relicenses the shipped binary under GFTC —
#     the exact thing audit/README.md §4.1 says we do not do;
#   * a NEAR version (CE 25.0.2, CE 25.1.1): Truffle/SVM hard-refuse the
#     org.graalvm.* 25.1.3 jars pinned in deps.edn, mid-build or mid-boot.
# So: one pinned edition+version, one check, one installer, used by CI, the
# Dockerfile, build.clj and humans.
#
# Usage:
#   bin/require-graalvm              # print the resolved GraalVM CE home (or fail)
#   bin/require-graalvm --check      # verify only the ACTIVE java; no search
#   bin/require-graalvm --install    # download + checksum + install, then print home
#   bin/require-graalvm --native-image   # additionally require bin/native-image
#   eval "$(bin/require-graalvm --export)"   # export JAVA_HOME/GRAALVM_HOME/PATH
#
# Exit 0 = stdout is a usable home. Every diagnostic goes to stderr, so the
# stdout capture is always safe to interpolate.

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=/dev/null
. "${repo_root}/.graalvm-version"

want_install=0 want_export=0 want_ni=0 check_only=0
for arg in "$@"; do
  case "$arg" in
    --install) want_install=1 ;;
    --export) want_export=1 ;;
    --native-image) want_ni=1 ;;
    --check) check_only=1 ;;
    -h|--help) sed -n '2,30p' "${BASH_SOURCE[0]}"; exit 0 ;;
    *) echo "require-graalvm: unknown flag $arg" >&2; exit 2 ;;
  esac
done

say() { echo "$*" >&2; }

# A home is correct iff the JVM reports exactly the pinned vendor version. That
# single property distinguishes CE from Oracle GraalVM AND from every stock JDK,
# which is why it is preferred over parsing `java -version` banners.
vendor_version() {
  local home="$1"
  [ -x "${home}/bin/java" ] || return 1
  "${home}/bin/java" -XshowSettings:properties -version 2>&1 |
    sed -n 's/^ *java\.vendor\.version = //p' | head -n1
}

is_pinned() {
  local home="$1" got
  got="$(vendor_version "$home" || true)"
  [ "$got" = "$GRAAL_VENDOR_VERSION" ] || return 1
  [ "$want_ni" = 1 ] && { [ -x "${home}/bin/native-image" ] || return 1; }
  return 0
}

sdkman_dir="${SDKMAN_DIR:-$HOME/.sdkman}"
pinned_home="${sdkman_dir}/candidates/java/${GRAAL_SDKMAN_CANDIDATE}"

find_home() {
  local c
  for c in "${GRAALVM_HOME:-}" "${JAVA_HOME:-}" "$pinned_home" \
           "${sdkman_dir}/candidates/java"/*; do
    [ -n "$c" ] && is_pinned "$c" && { echo "$c"; return 0; }
  done
  # A `java` on PATH may be the pinned JDK reached through a wrapper/symlink.
  if command -v java >/dev/null 2>&1; then
    c="$(cd "$(dirname "$(command -v java)")/.." && pwd)"
    is_pinned "$c" && { echo "$c"; return 0; }
  fi
  # macOS: JDKs installed outside SDKMAN.
  if [ -x /usr/libexec/java_home ]; then
    while read -r c; do
      [ -n "$c" ] && is_pinned "$c" && { echo "$c"; return 0; }
    done < <(/usr/libexec/java_home -V 2>&1 | sed -n 's|.*\(/.*/Contents/Home\)$|\1|p')
  fi
  return 1
}

install_graalvm() {
  local os arch file sha url tmp extracted home
  case "$(uname -s)" in
    Linux) os=linux ;;
    Darwin) os=macos ;;
    *) say "require-graalvm: unsupported OS $(uname -s)"; return 1 ;;
  esac
  case "$(uname -m)" in
    x86_64|amd64) arch=x64 ;;
    arm64|aarch64) arch=aarch64 ;;
    *) say "require-graalvm: unsupported arch $(uname -m)"; return 1 ;;
  esac
  # We consume linux-x64, linux-aarch64 and macos-aarch64 only — Intel macOS
  # has NO community build and never will, and Windows is not a target.
  eval "sha=\${GRAAL_SHA256_${os}_${arch}:-}"
  if [ -z "$sha" ]; then
    say "require-graalvm: no ${GRAAL_EDITION} ${GRAAL_VERSION} build for ${os}-${arch}"
    return 1
  fi
  file="graalvm-community-jdk-${GRAAL_ASSET_VERSION}_${os}-${arch}_bin.tar.gz"
  url="https://github.com/graalvm/graalvm-ce-builds/releases/download/${GRAAL_TAG}/${file}"
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' RETURN
  say "· downloading ${file}"
  curl -fL --retry 3 --retry-delay 5 -o "${tmp}/jdk.tar.gz" "$url" >&2
  say "· verifying sha256"
  if command -v sha256sum >/dev/null 2>&1; then
    echo "${sha}  ${tmp}/jdk.tar.gz" | sha256sum -c - >&2
  else
    echo "${sha}  ${tmp}/jdk.tar.gz" | shasum -a 256 -c - >&2
  fi
  tar -xzf "${tmp}/jdk.tar.gz" -C "$tmp"
  # macOS archives nest the home under Contents/Home; Linux ones do not.
  extracted="$(find "$tmp" -type f -name java -path '*/bin/*' | head -n1)"
  [ -n "$extracted" ] || { say "require-graalvm: no java in the archive"; return 1; }
  home="$(cd "$(dirname "$extracted")/.." && pwd)"
  mkdir -p "$(dirname "$pinned_home")"
  rm -rf "$pinned_home"
  cp -R "$home" "$pinned_home"
  say "· installed ${pinned_home}"
  echo "$pinned_home"
}

fail() {
  local active="${1:-}"
  say ""
  say "  ✗ ${GRAAL_EDITION} ${GRAAL_VERSION} is required and was not found."
  [ -n "$active" ] && say "    active java reports: ${active}"
  say "    expected java.vendor.version: ${GRAAL_VENDOR_VERSION}"
  say ""
  say "    install it:   bin/require-graalvm --install"
  say "    then use it:  sdk env            # honours .sdkmanrc"
  say "         or:      eval \"\$(bin/require-graalvm --export)\""
  say ""
  say "    Stock JDKs and Oracle GraalVM are NOT substitutes — see .graalvm-version."
  say ""
  exit 1
}

if [ "$check_only" = 1 ]; then
  active_home="${JAVA_HOME:-}"
  [ -n "$active_home" ] || active_home="$(cd "$(dirname "$(command -v java)")/.." && pwd)"
  is_pinned "$active_home" || fail "$(vendor_version "$active_home" || echo 'no java')"
  say "✓ ${GRAAL_EDITION} ${GRAAL_VERSION} — ${active_home}"
  echo "$active_home"
  exit 0
fi

if home="$(find_home)"; then
  :
elif [ "$want_install" = 1 ]; then
  home="$(install_graalvm)" || fail
  is_pinned "$home" || fail "$(vendor_version "$home" || echo 'unreadable')"
else
  fail "$(vendor_version "${JAVA_HOME:-}" || echo "${JAVA_HOME:-unset}")"
fi

if [ "$want_export" = 1 ]; then
  echo "export JAVA_HOME=${home}"
  echo "export GRAALVM_HOME=${home}"
  echo "export PATH=${home}/bin:\$PATH"
else
  echo "$home"
fi
say "✓ ${GRAAL_EDITION} ${GRAAL_VERSION} — ${home}"
