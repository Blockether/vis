#!/usr/bin/env bash
# Resolve — and if asked, install — THE JDK this repo builds and runs with:
# GraalVM Community Edition, exact version, as pinned in .graalvm-version.
#
# Why this exists at all: three different JDKs will happily start a Clojure REPL
# here and only fail later, expensively.
#   * a stock JDK 25 (temurin/oracle): boots, then the embedded GraalPy refuses
#     to initialise (no Truffle runtime) and there is no `native-image` at all;
#   * Oracle GraalVM: builds fine but relicenses the shipped binary under GFTC —
#     the exact thing audit/README.md §4.1 says we do not do;
#   * a NEAR version (CE 25.0.2, CE 25.1.1): Truffle/SVM hard-refuse the
#     org.graalvm.* 25.1.3 jars pinned in deps.edn, mid-build or mid-boot.
# So: one pinned edition+version, one check, one installer, used by CI, the
# Dockerfile, build.clj and humans.
#
# Usage:
#   bin/require-graalvm              # print the resolved GraalVM CE home (or fail)
#   bin/require-graalvm --check      # verify only the ACTIVE java; no search
#   bin/require-graalvm --check-pins # verify deps.edn/.sdkmanrc against the pin only
#   bin/require-graalvm --install    # download + checksum + install, then print home
#   bin/require-graalvm --native-image   # additionally require bin/native-image
#   bin/require-graalvm --truststore # print the truststore to use (see VIS_CA_CERT)
#   eval "$(bin/require-graalvm --export)"   # export JAVA_HOME/GRAALVM_HOME/PATH
#                                            # (+ JAVA_TOOL_OPTIONS behind a proxy)
#
# Corporate CA / TLS interception: VIS_CA_CERT=/path/ca.pem (PEM, imported into
# a cached COPY of the JDK's cacerts) or VIS_TRUSTSTORE=/path/store.p12 with
# VIS_TRUSTSTORE_PASSWORD / VIS_TRUSTSTORE_TYPE. The installed JDK is never
# modified. See the "Corporate CAs" section below.
#
# Exit 0 = stdout is a usable home. Every diagnostic goes to stderr, so the
# stdout capture is always safe to interpolate.

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=/dev/null
. "${repo_root}/.graalvm-version"

want_install=0 want_export=0 want_ni=0 check_only=0 pins_only=0 trust_only=0
for arg in "$@"; do
  case "$arg" in
    --install) want_install=1 ;;
    --export) want_export=1 ;;
    --native-image) want_ni=1 ;;
    --check) check_only=1 ;;
    --check-pins) pins_only=1 ;;
    --truststore) trust_only=1 ;;
    -h|--help) sed -n '2,33p' "${BASH_SOURCE[0]}"; exit 0 ;;
    *) echo "require-graalvm: unknown flag $arg" >&2; exit 2 ;;
  esac
done

say() { echo "$*" >&2; }

# ── Corporate CAs: trust extra roots WITHOUT touching the JDK's cacerts ──────
# A freshly downloaded JDK trusts the public roots and nothing else. Behind a
# TLS-intercepting proxy every network step under it — this very download,
# dependency resolution, `native-image` — then dies with
#   SunCertPathBuilderException: unable to find valid certification path …
# while the system JDK keeps working, because the corporate installer patched
# THAT one's cacerts. Two supported inputs, neither of which mutates the
# installed JDK (a patched cacerts is silently lost on the next reinstall):
#   VIS_CA_CERT=/path/ca.pem      extra root(s), PEM. curl gets --cacert, and
#                                 the bundle is imported into a COPY of the
#                                 JDK's own cacerts, cached under
#                                 ${XDG_CACHE_HOME:-~/.cache}/vis — so the
#                                 public roots keep working too.
#   VIS_TRUSTSTORE=/path/ts.p12   a ready keystore, used verbatim, plus
#                                 VIS_TRUSTSTORE_PASSWORD (default changeit)
#                                 and VIS_TRUSTSTORE_TYPE (default PKCS12).
# `--truststore` prints the resolved store; `--export` adds it to
# JAVA_TOOL_OPTIONS, which every JVM this shell starts (clojure, native-image,
# the build's own children) reads by itself.
ca_cert="${VIS_CA_CERT:-}"
trust_store="${VIS_TRUSTSTORE:-}"
trust_store_type="${VIS_TRUSTSTORE_TYPE:-PKCS12}"
trust_store_password="${VIS_TRUSTSTORE_PASSWORD:-changeit}"
trust_cache="${XDG_CACHE_HOME:-$HOME/.cache}/vis"

if [ -n "$ca_cert" ] && [ ! -r "$ca_cert" ]; then
  say "require-graalvm: VIS_CA_CERT=${ca_cert} is not a readable file"; exit 1
fi
if [ -n "$trust_store" ] && [ ! -r "$trust_store" ]; then
  say "require-graalvm: VIS_TRUSTSTORE=${trust_store} is not a readable file"; exit 1
fi

# bash 3.2 (macOS) + `set -u` treats an empty array expansion as unbound, hence
# the `${a[@]+…}` guard at every use site.
curl_ca_args=()
[ -z "$ca_cert" ] || curl_ca_args=(--cacert "$ca_cert")

sha256_of() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -d' ' -f1
  else shasum -a 256 "$1" | cut -d' ' -f1; fi
}

# keytool imports exactly ONE certificate per invocation, so a bundle is split
# first; the destination starts as a copy of the JDK's cacerts so nothing that
# already worked stops working.
build_truststore() {
  local home="$1" out="$2" src="$1/lib/security/cacerts" tmp cert n=0
  [ -x "${home}/bin/keytool" ] || { say "require-graalvm: no keytool in ${home}"; return 1; }
  [ -f "$src" ] || { say "require-graalvm: no cacerts in ${home}"; return 1; }
  tmp="$(mktemp -d)"
  cp "$src" "${tmp}/store"
  awk -v dir="$tmp" '/BEGIN CERTIFICATE/ { n++ } n > 0 { print > (dir "/cert-" n ".pem") }' "$ca_cert"
  for cert in "${tmp}"/cert-*.pem; do
    [ -f "$cert" ] || continue
    n=$((n + 1))
    if ! "${home}/bin/keytool" -importcert -noprompt -trustcacerts \
           -alias "vis-custom-ca-${n}" -file "$cert" \
           -keystore "${tmp}/store" -storepass changeit >&2; then
      rm -rf "$tmp"; say "require-graalvm: could not import ${ca_cert} (certificate ${n})"; return 1
    fi
  done
  if [ "$n" = 0 ]; then
    rm -rf "$tmp"; say "require-graalvm: no PEM certificate found in ${ca_cert}"; return 1
  fi
  mkdir -p "$(dirname "$out")"
  mv "${tmp}/store" "$out"
  rm -rf "$tmp"
  say "· imported ${n} certificate(s) from ${ca_cert} into ${out}"
}

# Sets trust_store/-type/-password to what this run should actually use. A
# user-supplied keystore always wins; a PEM is converted once per (bundle, JDK)
# pair and reused, because keytool costs a JVM start.
resolve_truststore() {
  local home="$1" out
  [ -z "$trust_store" ] || return 0
  [ -n "$ca_cert" ] || return 0
  out="${trust_cache}/truststore-${GRAAL_VERSION}-$(sha256_of "$ca_cert").p12"
  [ -f "$out" ] || build_truststore "$home" "$out" || return 1
  trust_store="$out"
  trust_store_type="PKCS12"
  trust_store_password="changeit"
}

trust_java_options() {
  [ -n "$trust_store" ] || return 0
  printf '%s' "-Djavax.net.ssl.trustStore=${trust_store}"
  printf '%s' " -Djavax.net.ssl.trustStoreType=${trust_store_type}"
  printf '%s' " -Djavax.net.ssl.trustStorePassword=${trust_store_password}"
}


# ── The OTHER half of the pin ────────────────────────────────────────────────
# A correct JDK is only half the contract. deps.edn's org.graalvm.* jars and
# .sdkmanrc's candidate must name the SAME version as .graalvm-version, or the
# failure is late and opaque: Truffle refuses a runtime whose built-in version
# differs from the polyglot jars, minutes into the image build. Until now only
# the Dockerfile checked it (`check-graal-pins`), so a host build could drift
# silently — this script is the one gate CI, build.clj, the Dockerfile and
# humans all pass through, so it enforces the whole pin, everywhere.
check_pins() {
  local bad=0 v
  # ── The pin is LOCKED (see .graalvm-version) ───────────────────────────────
  # 25.1.3, nothing higher: 25.2.x's points-to analysis never converges on this
  # tree and OOMs the builder at every heap size. The lock is ENFORCED here
  # rather than trusted to a comment, because every build path passes through
  # this script.
  if [ "${GRAAL_PIN_LOCKED:-}" = "true" ] && [ "$GRAAL_VERSION" != "${GRAAL_MAX_VERSION:-}" ]; then
    say "  ✗ .graalvm-version is LOCKED at ${GRAAL_MAX_VERSION:-<unset>} (NOT UPGRADABLE),"
    say "    but GRAAL_VERSION=${GRAAL_VERSION}. Move GRAAL_MAX_VERSION deliberately"
    say "    (or set GRAAL_PIN_LOCKED=\"false\") — see .graalvm-version."
    exit 1
  fi
  if [ -f "${repo_root}/deps.edn" ]; then
    while read -r v; do
      [ "$v" = "$GRAAL_VERSION" ] || {
        say "  ✗ deps.edn pins org.graalvm.* ${v}, .graalvm-version says ${GRAAL_VERSION}"
        bad=1
      }
    done < <(sed -n 's|.*org\.graalvm\.[^ ]* *{:mvn/version *"\([^"]*\)".*|\1|p' \
                    "${repo_root}/deps.edn")
  fi
  if [ -f "${repo_root}/.sdkmanrc" ]; then
    v="$(sed -n 's/^java=//p' "${repo_root}/.sdkmanrc" | head -n1)"
    [ -z "$v" ] || [ "$v" = "$GRAAL_SDKMAN_CANDIDATE" ] || {
      say "  ✗ .sdkmanrc pins java=${v}, .graalvm-version says ${GRAAL_SDKMAN_CANDIDATE}"
      bad=1
    }
  fi
  [ "$bad" = 0 ] || {
    say "    .graalvm-version is the single source of truth — bump it and every pin together."
    exit 1
  }
}
check_pins
# `[ … ] && { … }` would trip `set -e` on the false branch — use a plain if.
if [ "$pins_only" = 1 ]; then
  say "✓ pins agree with .graalvm-version (${GRAAL_EDITION} ${GRAAL_VERSION}${GRAAL_PIN_LOCKED:+, LOCKED — not upgradable})"
  exit 0
fi

# A home is correct iff the JVM reports exactly the pinned vendor version. That
# single property distinguishes CE from Oracle GraalVM AND from every stock JDK,
# which is why it is preferred over parsing `java -version` banners.
vendor_version() {
  local home="$1"
  [ -x "${home}/bin/java" ] || return 1
  "${home}/bin/java" -XshowSettings:properties -version 2>&1 |
    sed -n 's/^ *java\.vendor\.version = //p' | head -n1
}

is_pinned() {
  local home="$1" got
  got="$(vendor_version "$home" || true)"
  [ "$got" = "$GRAAL_VENDOR_VERSION" ] || return 1
  [ "$want_ni" = 1 ] && { [ -x "${home}/bin/native-image" ] || return 1; }
  return 0
}

sdkman_dir="${SDKMAN_DIR:-$HOME/.sdkman}"
pinned_home="${sdkman_dir}/candidates/java/${GRAAL_SDKMAN_CANDIDATE}"

find_home() {
  local c
  for c in "${GRAALVM_HOME:-}" "${JAVA_HOME:-}" "$pinned_home" \
           "${sdkman_dir}/candidates/java"/*; do
    [ -n "$c" ] && is_pinned "$c" && { echo "$c"; return 0; }
  done
  # A `java` on PATH may be the pinned JDK reached through a wrapper/symlink.
  if command -v java >/dev/null 2>&1; then
    c="$(cd "$(dirname "$(command -v java)")/.." && pwd)"
    is_pinned "$c" && { echo "$c"; return 0; }
  fi
  # macOS: JDKs installed outside SDKMAN.
  if [ -x /usr/libexec/java_home ]; then
    while read -r c; do
      [ -n "$c" ] && is_pinned "$c" && { echo "$c"; return 0; }
    done < <(/usr/libexec/java_home -V 2>&1 | sed -n 's|.*\(/.*/Contents/Home\)$|\1|p')
  fi
  return 1
}

install_graalvm() {
  local os arch file sha url tmp extracted home
  case "$(uname -s)" in
    Linux) os=linux ;;
    Darwin) os=macos ;;
    *) say "require-graalvm: unsupported OS $(uname -s)"; return 1 ;;
  esac
  case "$(uname -m)" in
    x86_64|amd64) arch=x64 ;;
    arm64|aarch64) arch=aarch64 ;;
    *) say "require-graalvm: unsupported arch $(uname -m)"; return 1 ;;
  esac
  # We consume linux-x64, linux-aarch64 and macos-aarch64 only — Intel macOS
  # has NO community build and never will, and Windows is not a target.
  eval "sha=\${GRAAL_SHA256_${os}_${arch}:-}"
  if [ -z "$sha" ]; then
    say "require-graalvm: no ${GRAAL_EDITION} ${GRAAL_VERSION} build for ${os}-${arch}"
    return 1
  fi
  file="graalvm-community-jdk-${GRAAL_ASSET_VERSION}_${os}-${arch}_bin.tar.gz"
  url="https://github.com/graalvm/graalvm-ce-builds/releases/download/${GRAAL_TAG}/${file}"
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' RETURN
  say "· downloading ${file}"
  if ! curl -fL --retry 3 --retry-delay 5 ${curl_ca_args[@]+"${curl_ca_args[@]}"} \
            -o "${tmp}/jdk.tar.gz" "$url" >&2; then
    say "require-graalvm: download failed — ${url}"
    [ -n "$ca_cert" ] || say "    TLS error behind a corporate proxy? Point VIS_CA_CERT at the proxy's CA PEM (or VIS_TRUSTSTORE at a keystore) and retry."
    return 1
  fi
  say "· verifying sha256"
  if command -v sha256sum >/dev/null 2>&1; then
    echo "${sha}  ${tmp}/jdk.tar.gz" | sha256sum -c - >&2
  else
    echo "${sha}  ${tmp}/jdk.tar.gz" | shasum -a 256 -c - >&2
  fi
  tar -xzf "${tmp}/jdk.tar.gz" -C "$tmp"
  # macOS archives nest the home under Contents/Home; Linux ones do not.
  extracted="$(find "$tmp" -type f -name java -path '*/bin/*' | head -n1)"
  [ -n "$extracted" ] || { say "require-graalvm: no java in the archive"; return 1; }
  home="$(cd "$(dirname "$extracted")/.." && pwd)"
  mkdir -p "$(dirname "$pinned_home")"
  rm -rf "$pinned_home"
  cp -R "$home" "$pinned_home"
  say "· installed ${pinned_home}"
  echo "$pinned_home"
}

fail() {
  local active="${1:-}"
  say ""
  say "  ✗ ${GRAAL_EDITION} ${GRAAL_VERSION} is required and was not found."
  [ -n "$active" ] && say "    active java reports: ${active}"
  say "    expected java.vendor.version: ${GRAAL_VENDOR_VERSION}"
  say ""
  say "    install it:   bin/require-graalvm --install"
  say "    then use it:  sdk env            # honours .sdkmanrc"
  say "         or:      eval \"\$(bin/require-graalvm --export)\""
  say ""
  say "    Stock JDKs and Oracle GraalVM are NOT substitutes — see .graalvm-version."
  say ""
  exit 1
}

if [ "$check_only" = 1 ]; then
  active_home="${JAVA_HOME:-}"
  [ -n "$active_home" ] || active_home="$(cd "$(dirname "$(command -v java)")/.." && pwd)"
  is_pinned "$active_home" || fail "$(vendor_version "$active_home" || echo 'no java')"
  say "✓ ${GRAAL_EDITION} ${GRAAL_VERSION} — ${active_home}"
  echo "$active_home"
  exit 0
fi

if home="$(find_home)"; then
  :
elif [ "$want_install" = 1 ]; then
  home="$(install_graalvm)" || fail
  is_pinned "$home" || fail "$(vendor_version "$home" || echo 'unreadable')"
else
  fail "$(vendor_version "${JAVA_HOME:-}" || echo "${JAVA_HOME:-unset}")"
fi

# The home is known, so a PEM can now be converted with ITS keytool, against
# ITS cacerts.
resolve_truststore "$home" || exit 1

if [ "$trust_only" = 1 ]; then
  [ -z "$trust_store" ] || echo "$trust_store"
  exit 0
fi

if [ "$want_export" = 1 ]; then
  echo "export JAVA_HOME=${home}"
  echo "export GRAALVM_HOME=${home}"
  echo "export PATH=${home}/bin:\$PATH"
  if [ -n "$trust_store" ]; then
    # JAVA_TOOL_OPTIONS, not JDK_JAVA_OPTIONS: the latter is honoured only by
    # the `java` launcher, so native-image and every forked builder JVM would
    # miss it. Existing content is preserved, ours wins by coming last.
    echo "export JAVA_TOOL_OPTIONS=\"\${JAVA_TOOL_OPTIONS:+\$JAVA_TOOL_OPTIONS }$(trust_java_options)\""
    echo "export VIS_TRUSTSTORE=${trust_store}"
    if [ -n "$ca_cert" ]; then
      echo "export CURL_CA_BUNDLE=${ca_cert}"
      echo "export SSL_CERT_FILE=${ca_cert}"
    fi
  fi
else
  echo "$home"
fi
say "✓ ${GRAAL_EDITION} ${GRAAL_VERSION} — ${home}"
