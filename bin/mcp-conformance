#!/usr/bin/env bash
# Run the official MCP client conformance suite against the MCP client of Vis.
# The suite starts its own MCP and authorization servers on loopback and starts
# the client one time for each scenario. For a released version, each scenario of
# the suite runs, and a failed check or a warning fails the run. For a draft
# revision, its requirement set runs, and a failed check of a scenario that the
# revision requires fails the run. `extensions` runs the authorization extensions
# that no revision scores: a failed check of one fails the run.
#
# Usage: bin/mcp-conformance [spec-version | extensions ...]   # default: each below
#
#   VIS_MCP_CONFORMANCE_SUITE    the npm package of the suite, with its version
#   VIS_MCP_CONFORMANCE_RESULTS  keep the result files of the suite in this directory
#
# Needs: java, clojure and npx on PATH.
set -euo pipefail

suite="${VIS_MCP_CONFORMANCE_SUITE:-@modelcontextprotocol/conformance@0.2.0-alpha.12}"
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
versions=("$@")
[ "${#versions[@]}" -gt 0 ] || versions=(2025-03-26 2025-06-18 2025-11-25 2026-07-28 extensions)
drafts=" 2026-07-28 "
# The grants that need no person, and DPoP.
extensions=(auth/client-credentials-jwt auth/client-credentials-basic
  auth/enterprise-managed-authorization auth/dpop auth/dpop-nonce auth/wif-jwt-bearer)

work="$(mktemp -d "${TMPDIR:-/tmp}/vis-mcp-conformance.XXXXXX")"
trap 'rm -rf "$work"' EXIT
results="${VIS_MCP_CONFORMANCE_RESULTS:-$work/results}"
export VIS_MCP_CONFORMANCE_WORK="$work"

cd "$root"
# The suite starts the client about 70 times. A client that loads compiled classes
# starts four times faster than one that compiles its namespaces again from source.
classpath="$work/classes:$(clojure -Spath -A:test)"
mkdir -p "$work/classes"
java -cp "$classpath" clojure.main -e \
  "(binding [*compile-path* \"$work/classes\"] (compile 'com.blockether.vis.mcp-conformance))" > /dev/null
printf '%s\n' "$classpath" > "$work/classpath"

status=0
run_suite() {
  # A Node option of the caller can break the suite.
  env -u NODE_OPTIONS npx --yes "$suite" client \
    --command "$root/bin/mcp-conformance-client" \
    "$@" --timeout 180000 || status=1
}

for version in "${versions[@]}"; do
  if [ "$version" = extensions ]; then
    echo "== MCP client conformance, authorization extensions"
    for scenario in "${extensions[@]}"; do
      run_suite --scenario "$scenario" -o "$results/extensions/${scenario//\//-}"
    done
    continue
  fi
  echo "== MCP client conformance, specification $version"
  if [[ "$drafts" == *" $version "* ]]; then
    run_suite --requirements "$version" -o "$results/$version"
  else
    run_suite --suite all --spec-version "$version" -o "$results/$version"
  fi
done
exit "$status"
