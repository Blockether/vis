;; Vis' build: the engine, its providers and store on one classpath; `packages/*` are the
;; libraries it also publishes, linked in as :local/root deps. Nothing formats this file, so the
;; order is hand-kept: this tree's own projects first, then third party, then aliases, alphabetical.
{;; "packages/vis-agent/src" is a resource root, not Clojure source: it holds the `vis` Python
 ;; module PyPI ships as `vis-agent`, which the engine execs into every extension context.
 :paths ["src" "resources" "packages/vis-agent/src"]
 ;; JitPack hosts sherpa-onnx. tools.deps reads :mvn/repos only from the project it is invoked on.
 :mvn/repos {"jitpack" {:url "https://jitpack.io"}}
 :deps {com.blockether/vis-contract {:local/root "packages/vis-contract"}
        babashka/fs {:mvn/version "0.5.34"}
        babashka/process {:mvn/version "0.6.25"}
        com.blockether/anomaly {:mvn/version "1.0.1"}
        com.blockether/fff {:mvn/version "0.12.9"}
        ;; Imaging over a Rust cdylib with embedded fonts, replacing AWT/Java2D/ImageIO/jsvg:
        ;; no headless bootstrap, no fontconfig. `java.desktop` still loads, for mic capture.
        com.blockether/imaging {:mvn/version "0.1.10"}
        com.blockether/rift {:mvn/version "0.0.10-11"}
        com.blockether/ruff {:mvn/version "0.3.5"}
        com.blockether/svar {:mvn/version "0.7.172"}
        ;; The embedded CPython the sandbox runs; the per-platform interpreter comes from that
        ;; repository's release archive. A fresh checkout needs `clojure -X:deps prep`.
        com.blockether/vis-python-runtime {:git/sha "7ad9c2b9673ed4a5864ea21440b008d3001cfa0b"
                                           :git/url
                                           "https://github.com/Blockether/vis-python-runtime.git"}
        com.cnuernber/charred {:mvn/version "1.041"}
        ;; Jackson 2.x arrives only through clj-kondo -> cheshire; core/smile/cbor must stay on
        ;; one version. databind stays excluded: cheshire never binds, and it is the CVE surface.
        com.fasterxml.jackson.core/jackson-core {:mvn/version "2.22.1"}
        com.fasterxml.jackson.dataformat/jackson-dataformat-cbor
        {:exclusions [com.fasterxml.jackson.core/jackson-databind] :mvn/version "2.22.1"}
        com.fasterxml.jackson.dataformat/jackson-dataformat-smile
        {:exclusions [com.fasterxml.jackson.core/jackson-databind] :mvn/version "2.22.1"}
        com.github.k2-fsa.sherpa-onnx/sherpa-onnx-jvm {:mvn/version "v1.13.5"}
        com.github.seancorfield/honeysql {:mvn/version "2.7.1425"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.1118"}
        com.google.zxing/core {:mvn/version "3.5.4"}
        com.taoensso/nippy {:mvn/version "3.8.0"}
        com.taoensso/telemere {:mvn/version "1.2.1"}
        ;; Version must match com.taoensso/telemere.
        com.taoensso/telemere-slf4j {:mvn/version "1.2.1"}
        ;; The logging facade svar emits through; `config/route-svar-logs!` backs it with Telemere.
        com.taoensso/trove {:mvn/version "1.1.0"}
        ;; A real pool for the SQLite session store: xerial's pooled DataSource opens a new
        ;; physical connection per `getConnection()`, churning WAL files into SQLITE_CANTOPEN.
        com.zaxxer/HikariCP {:mvn/version "7.1.0"}
        ;; Jetty 12 core adapter, not ring/ring-jetty-adapter: no ee9 servlet layer on the SSE hot
        ;; path, and it tracks Jetty's own releases, which is why no Jetty CVE pins live here.
        info.sunng/ring-jetty9-adapter {:mvn/version "0.40.3"}
        io.github.java-diff-utils/java-diff-utils {:mvn/version "4.17"}
        io.github.tonsky/clojure-plus {:mvn/version "1.7.2"}
        metosin/reitit-ring {:mvn/version "0.10.1"}
        org.apache.commons/commons-compress {:mvn/version "1.28.0"}
        org.babashka/http-client {:mvn/version "0.4.24"}
        ;; X.509 minting for the egress proxy's per-session MITM CA. No provider is registered;
        ;; bcpkix uses the default JCA signer, which the native image can build.
        org.bouncycastle/bcpkix-jdk18on {:mvn/version "1.85"}
        org.bouncycastle/bcprov-jdk18on {:mvn/version "1.85"}
        ;; Must stay pinned: `clojure -M:vis` inherits the user's CLI, whose own deps.edn makes
        ;; Clojure a top-level dep, so an older CLI's 1.11 beat the 1.12 syntax the engine needs.
        org.clojure/clojure {:mvn/version "1.12.5"}
        org.clojure/core.memoize {:mvn/version "1.2.281"}
        ;; Downloads the per-platform FFM native jars on the plain-JVM path only. Excluding the
        ;; S3 transporter (no `s3://` repos here) keeps cognitect.aws out of cold native builds.
        org.clojure/tools.deps {:exclusions [org.clojure/tools.deps.maven-s3-transporter]
                                :mvn/version "0.31.1638"}
        org.commonmark/commonmark {:mvn/version "0.29.0"}
        org.commonmark/commonmark-ext-gfm-strikethrough {:mvn/version "0.29.0"}
        org.commonmark/commonmark-ext-gfm-tables {:mvn/version "0.29.0"}
        ;; The session store's migration runner. Flyway 10.x split the SQLite driver out of
        ;; flyway-core; without it Flyway does not recognize a `jdbc:sqlite:` URL.
        org.flywaydb/flyway-core {:mvn/version "12.11.0"}
        org.flywaydb/flyway-database-nc-sqlite {:mvn/version "12.11.0"}
        org.xerial/sqlite-jdbc {:mvn/version "3.53.2.1"}
        org.yamlstar/yamlstar {:mvn/version "0.1.21"}
        ring/ring-core {:mvn/version "1.15.5"}
        ;; CVE pin over Flyway's tools.jackson jackson-databind 3.1.4 (CVE-2026-59889).
        tools.jackson.core/jackson-databind {:mvn/version "3.2.1"}}
 :aliases
 {:antq {:deps {com.github.liquidz/antq {:mvn/version "RELEASE"}} :main-opts ["-m" "antq.core"]}
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                 org.apache.commons/commons-compress {:mvn/version "1.28.0"}
                 slipset/deps-deploy {:mvn/version "0.2.5"}}
          ;; Silences the provider banner slf4j-nop prints on every build JVM start.
          :jvm-opts ["-Dslf4j.internal.verbosity=WARN"]
          :ns-default build}
  :clj-watson {:main-opts ["-m" "clj-watson.cli"]
               :replace-deps {io.github.clj-holmes/clj-watson
                              {:git/sha "be98e4db74fb8927db4825cc73bbe2606e44e5e3"
                               :git/tag "v6.1.0"}}}
  ;; Regenerates the static theme assets `apps/vis-companion` ships, from `theme.clj`.
  :companion-themes {:exec-fn com.blockether.vis.dev.companion-themes/write! :extra-paths ["dev"]}
  ;; The static-analysis gate CI runs. :replace-deps keeps the project's classpath out; clj-kondo
  ;; reads sources and `.clj-kondo` from disk. Command-line paths append to the defaults.
  :lint {:main-opts ["-m" "clj-kondo.main" "--lint" "src" "test" "dev"]
         :replace-deps {clj-kondo/clj-kondo {:mvn/version "2026.07.24"}}}
  :native {:extra-deps {com.github.clj-easy/graal-build-time {:mvn/version "1.0.6"}}}
  ;; The whole-repo suite. :extra-paths is the classpath, the bare paths after `lazytest.main` are
  ;; what Lazytest walks (`dev` is classpath-only); keep them in step. --hook bans remote HTTP.
  :test {:extra-deps {io.github.noahtheduke/lazytest {:mvn/version "2.1.0"}}
         :extra-paths ["test" "dev"]
         :jvm-opts ["-Xmx2g" "-XX:+IgnoreUnrecognizedVMOptions" "--enable-native-access=ALL-UNNAMED"
                    "--enable-preview" "--sun-misc-unsafe-memory-access=allow"
                    "-Dvis.drafts.dir=target/vis-drafts-test"]
         :main-opts ["-m" "lazytest.main" "--hook"
                     "com.blockether.vis.test-network-guard/no-network" "test"]}
  ;; What only `target/vis` can answer, after `clojure -T:build native`; separate so it fails
  ;; loudly when the binary is missing. No network hook: the binary is a separate process.
  :test-native {:extra-deps {io.github.noahtheduke/lazytest {:mvn/version "2.1.0"}}
                :extra-paths ["test-native"]
                :jvm-opts ["-XX:+IgnoreUnrecognizedVMOptions" "--enable-native-access=ALL-UNNAMED"
                           "--enable-preview" "--sun-misc-unsafe-memory-access=allow"]
                :main-opts ["-m" "lazytest.main" "test-native"]}
  ;; The gateway JVM, tuned for idle RSS: periodic GC plus the free ratios make G1 shrink toward
  ;; the live set and uncommit (60s keeps each cycle's CPU blip rare), -Xmx5g is the same ceiling
  ;; on every host so the pressure gates in internal.loop stay reachable, and string deduplication
  ;; folds the retained transcript text onto shared arrays.
  :vis {:jvm-opts ["-XX:+IgnoreUnrecognizedVMOptions" "--enable-native-access=ALL-UNNAMED"
                   "--enable-preview" "--sun-misc-unsafe-memory-access=allow"
                   "-XX:+G1PeriodicGCInvokesConcurrent" "-XX:G1PeriodicGCInterval=60000"
                   "-XX:MinHeapFreeRatio=10" "-XX:MaxHeapFreeRatio=25" "-Xmx5g"
                   "-XX:+UseStringDeduplication"]
        :main-opts ["-m" "com.blockether.vis.core"]}}}
