# Build context trim for the native-image gateway build. Keep sources + deps
# metadata; drop build outputs, VCS, node/vite caches, and local state.
.git
target
**/target
.cpcache
**/.cpcache
.verification
.gitworktrees
**/.venv
**/__pycache__
**/.pytest_cache
**/.ruff_cache
**/.cache
**/node_modules
apps/vis-companion/dist
apps/vis-companion/.vite
# Mobile projects and build products are generated locally, not gateway sources.
apps/vis-companion/android
apps/vis-companion/ios
apps/vis-companion/build
apps/vis-companion/dist-ssr
apps/vis-companion/storybook-static
**/*.jfr
**/.omc
.vis
*.log
.DS_Store

# The Dockerfile is not needed INSIDE the image, and including it makes every
# edit to it bust `COPY . .` — a ~11 minute native-image rebuild per comment.
Dockerfile
.dockerignore
