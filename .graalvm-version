# Single source of truth for the JDK vis builds and runs on.
#
# STATUS: PINNED AND LOCKED — 25.1.3, NOTHING HIGHER, NOT UPGRADABLE FOR NOW.
#
# GraalVM COMMUNITY Edition 25.1.3 — NOT Oracle GraalVM, NOT a stock JDK.
#   * CE is GPLv2 + Classpath Exception; Oracle GraalVM is GFTC. Only CE keeps the
#     redistribution story of the shipped binary FOSS (audit/README.md §4.1).
#   * The version is EXACT: the embedded GraalPy/Truffle jars pinned in deps.edn
#     (org.graalvm.* 25.1.3) refuse a JDK whose built-in Truffle differs.
# Bump this file and deps.edn's org.graalvm.* pins together. Everything else
# (CI action, Dockerfile, build.clj, bin/require-graalvm) reads THIS file.
#
# DO NOT MOVE TO 25.2.x — the 25.2 native-image builder cannot build this image.
#   Measured on macOS arm64 / 36 GB RAM with `clojure -T:build native`:
#   GraalVM CE 25.2.4's points-to analysis needs a ~13–15 GiB LIVE set for vis and
#   never converges. It is NOT a deadlock or an infinite loop — jstack showed every
#   ForkJoin worker RUNNABLE inside the analysis (AbstractVirtualInvokeTypeFlow/
#   ConcurrentLightHashSet); the heap held 110M ConcurrentHashMap$Node (3.5 GB) plus
#   8.4M AnalysisFuture, old gen pinned at 100%, 41 full GCs in 95 s of wall clock,
#   i.e. a GC death spiral advancing ~1k methods per 95 s. Every attempt ended in
#   "Terminating due to java.lang.OutOfMemoryError: Java heap space":
#   -J-Xmx12g, -J-Xmx14g, -J-Xmx18g, and the default cap (80% of RAM) which swap-
#   thrashes the machine first. 25.1.3 builds the very same tree successfully.
#   25.1.3 still needs a BIG builder heap (the live set is ~12 GiB), so build.clj
#   no longer inherits native-image's "80% of RAM" default: it passes
#   -J-Xmx<clamp(60% of RAM, 6..18)>g -J-Xms<that/3>g itself. Override per runner
#   with VIS_NATIVE_EXTRA_ARGS='-J-Xmx6g -J-Xms2g' (spliced last, so it wins).
#
# Sourced by POSIX shell AND parsed by build.clj — keep it plain KEY=value.

GRAAL_EDITION="GraalVM CE"
GRAAL_VERSION="25.1.3"

# ── PIN LOCK: 25.1.3, NOTHING HIGHER ─────────────────────────────────────────
# This pin is LOCKED, i.e. NOT UPGRADABLE for now. GRAAL_VERSION must equal
# GRAAL_MAX_VERSION exactly; anything else is REFUSED — by bin/require-graalvm
# (check_pins), by build.clj (assert-graal-pins!), by .github/actions/
# setup-graalvm-25 and by com.blockether.vis.graalvm-pin-test. So a drive-by
# bump of one file fails at the first gate instead of six minutes into a
# native-image build that then dies of OutOfMemoryError.
# Lifting the lock is a DELIBERATE act: move BOTH keys together (plus deps.edn's
# org.graalvm.* pins, the tag, the asset version and the shas), and only after
# `clojure -T:build native` has been proven to complete end to end on the new
# version. 25.2.x does NOT — see the block above.
GRAAL_PIN_LOCKED="true"
GRAAL_MAX_VERSION="25.1.3"

# graalvm-ce-builds release tag + asset version. The 25.1 "innovation" train
# names the asset after its JDK base (25.0.3), not the Graal version.
GRAAL_TAG="graal-25.1.3"
GRAAL_ASSET_VERSION="25i1-25.0.3"

# `java.vendor.version` of a correct JDK — the one string every check compares.
GRAAL_VENDOR_VERSION="GraalVM CE 25.1.3+9.1"

# SDKMAN candidate name used by .sdkmanrc / bin/require-graalvm --install.
GRAAL_SDKMAN_CANDIDATE="25.1.3-graalce"

# sha256 of each published asset we consume. There is NO macos-x64 (Intel)
# community build, and Windows is not a supported target.
