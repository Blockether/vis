# Single source of truth for the JDK vis builds and runs on.
#
# GraalVM COMMUNITY Edition 25.1.3 — NOT Oracle GraalVM, NOT a stock JDK.
#   * CE is GPLv2 + Classpath Exception; Oracle GraalVM is GFTC. Only CE keeps the
#     redistribution story of the shipped binary FOSS (audit/README.md §4.1).
#   * The version is EXACT: the embedded GraalPy/Truffle jars pinned in deps.edn
#     (org.graalvm.* 25.1.3) refuse a JDK whose built-in Truffle differs.
# Bump this file and deps.edn's org.graalvm.* pins together. Everything else
# (CI action, Dockerfile, build.clj, bin/require-graalvm) reads THIS file.
#
# Sourced by POSIX shell AND parsed by build.clj — keep it plain KEY=value.

GRAAL_EDITION="GraalVM CE"
GRAAL_VERSION="25.1.3"

# graalvm-ce-builds release tag + asset version. The 25.1 "innovation" train
# names the asset after its JDK base (25.0.3), not the Graal version.
GRAAL_TAG="graal-25.1.3"
GRAAL_ASSET_VERSION="25i1-25.0.3"

# `java.vendor.version` of a correct JDK — the one string every check compares.
GRAAL_VENDOR_VERSION="GraalVM CE 25.1.3+9.1"

# SDKMAN candidate name used by .sdkmanrc / bin/require-graalvm --install.
GRAAL_SDKMAN_CANDIDATE="25.1.3-graalce"

# sha256 of each published asset. There is NO macos-x64 (Intel) community build.
GRAAL_SHA256_linux_x64="e9cd1637be853e105f8b09125b4b19fbce385696465d782cbca8bb80e1df8f0d"
GRAAL_SHA256_linux_aarch64="5e79978983439d28506ebef82254fe9f98995121208dc8be77c604f4ad5bc579"
GRAAL_SHA256_macos_aarch64="b41cdde27691a0e04a1f2b0660624bc37e59c738e536888860c4c9f65a4a9a3b"
