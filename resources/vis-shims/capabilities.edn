rl=None, headers=None, files=None, data=None, params=None, auth=None, cookies=None, json=None, **kw)"} {:kind "class", :name "RequestException", :sig "RequestException(*args, response=None, request=None)"} {:kind "class", :name "RequestsCookieJar", :sig "RequestsCookieJar(...)"} {:kind "class", :name "RequestsDependencyWarning", :sig "RequestsDependencyWarning(...)"} {:kind "class", :name "RequestsWarning", :sig "RequestsWarning(...)"} {:kind "class", :name "Response", :sig "Response()"} {:kind "class", :name "RetryError", :sig "RetryError(*args, response=None, request=None)"} {:kind "class", :name "SSLError", :sig "SSLError(*args, response=None, request=None)"} {:kind "class", :name "Session", :sig "Session()"} {:kind "class", :name "StreamConsumedError", :sig "StreamConsumedError(*args, response=None, request=None)"} {:kind "class", :name "Timeout", :sig "Timeout(*args, response=None, request=None)"} {:kind "class", :name "TooManyRedirects", :sig "TooManyRedirects(*args, response=None, request=None)"} {:kind "class", :name "URLRequired", :sig "URLRequired(*args, response=None, request=None)"} {:kind "class", :name "UnrewindableBodyError", :sig "UnrewindableBodyError(*args, response=None, request=None)"} {:kind "module", :name "adapters", :sig "adapters"} {:kind "module", :name "api", :sig "api"} {:kind "module", :name "auth", :sig "auth"} {:kind "module", :name "cookies", :sig "cookies"} {:kind "function", :name "delete", :sig "delete(url, **kwargs)"} {:kind "module", :name "exceptions", :sig "exceptions"} {:kind "function", :name "get", :sig "get(url, params=None, **kwargs)"} {:kind "function", :name "head", :sig "head(url, **kwargs)"} {:kind "module", :name "models", :sig "models"} {:kind "function", :name "options", :sig "options(url, **kwargs)"} {:kind "function", :name "patch", :sig "patch(url, data=None, **kwargs)"} {:kind "function", :name "post", :sig "post(url, data=None, json=None, **kwargs)"} {:kind "function", :name "put", :sig "put(url, data=None, **k