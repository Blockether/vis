"ruff" {:doc "In-process Ruff, no pip or PATH: `python -m ruff check|format <paths>` (`--fix`, `--check`, `--diff`) and the `format_/check_/fix_{str,file}` import API, honouring the nearest config per file. A reduced in-process shim, not a full Ruff wheel.", :kind "module", :names [{:doc "A ruff failure: unknown selector, bad configuration, unparsable source.", :kind "class", :name "RuffError", :sig "RuffError(...)"} {:doc "Lint one file on disk with its own discovered configuration.", :kind "function", :name "check_file", :sig "check_file(path, config=None, **kwargs)"} {:doc "Lint Python `source`, returning a list of diagnostic dicts.", :kind "function", :name "check_str", :sig "check_str(source, path=None, config=None, line_length=0, select=None, ignore=None, preview=False)"} {:doc "Nearest ruff configuration file governing `path`, or None.", :kind "function", :name "config_for", :sig "config_for(path)"} {:doc "`vis-agent python -m ruff ...` entry point. Returns a process exit code.", :kind "function", :name "console_main", :sig "console_main(argv=None)"} {:doc "Apply Ruff fixes to one file. Returns (changed, fixed_source).", :kind "function", :name "fix_file", :sig "fix_file(path, config=None, write=True, **kwargs)"} {:doc "Apply Ruff's safe fixes, plus unsafe fixes when explicitly enabled.", :kind "function", :name "fix_str", :sig "fix_str(source, path=None, config=None, line_length=0, select=None, ignore=None, preview=False, unsafe_fixes=False)"} {:doc "Format one file on disk. Returns (changed, formatted_source).", :kind "function", :name "format_file", :sig "format_file(path, config=None, write=True, line_length=0)"} {:doc "Format Python `source`, returning the reformatted text.", :kind "function", :name "format_str", :sig "format_str(source, path=None, config=None, line_length=0)"} {:doc "Every Python file under `paths`, honoring Ruff excludes for directory targets.", :kind "function", :name "iter_files", :sig "iter_files(paths, explicit_config=None)"} {:doc "`vis-agent python -m ruff ...` entry point. Returns a process exit code.", :kind "function", :name "main", :sig "main(argv=None)"} {:doc "`ruff X.Y.Z (vis shim, clj-ruff A.B.C)` -- ruff's own version first,", :kind "function", :name "version", :sig "version()"}], :sig "ruff"}

"show_attachment" {:doc "Put a stored IMAGE in front of the model for exactly the NEXT request, then stored-only again; nothing is re-stored. A local path is a source, not an attachment address: use show_attachment(attach(path)). Images replay only while they fit the request's image budget, and this is the way back to one that dropped out. Same addressing as get_attachment - an image this block attached for the model is on the wire already, so showing it is a no-op.\n\nRaw result: {id, filename, media_type, size} for the image now queued for the next request.", :kind "function", :sig "show_attachment(target, version=None)"}

