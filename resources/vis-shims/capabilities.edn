m_url(url, **kw)"} {:kind "module", :name "connectionpool", :sig "connectionpool"} {:doc "Silences the shim's security warnings -- the very call real code makes", :kind "function", :name "disable_warnings", :sig "disable_warnings(category=None)"} {:doc "Encodes `fields` as multipart/form-data, like urllib3.filepost.", :kind "function", :name "encode_multipart_formdata", :sig "encode_multipart_formdata(fields, boundary=None)"} {:kind "module", :name "exceptions", :sig "exceptions"} {:kind "module", :name "fields", :sig "fields"} {:kind "module", :name "filepost", :sig "filepost"} {:doc "Builds a request header dict, like urllib3.util.make_headers.", :kind "function", :name "make_headers", :sig "make_headers(keep_alive=None, accept_encoding=None, user_agent=None, basic_auth=None, proxy_basic_auth=None, disable_cache=None)"} {:doc "Parses `url` into a `Url`, like urllib3.util.parse_url.", :kind "function", :name "parse_url", :sig "parse_url(url)"} {:kind "module", :name "poolmanager", :sig "poolmanager"} {:kind "function", :name "proxy_from_url", :sig "proxy_from_url(url, **kw)"} {:kind "function", :name "request", :sig "request(method, url, **kw)"} {:kind "module", :name "response", :sig "response"} {:kind "module", :name "util", :sig "util"}], :sig "urllib3"}

