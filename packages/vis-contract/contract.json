{
  "version": 6,
  "ops": [
    {
      "name": "state_get",
      "global": "__vis_host_state_get__",
      "arity": 1,
      "summary": "Read one value out of the extension's durable state.",
      "outside": "local"
    },
    {
      "name": "state_put",
      "global": "__vis_host_state_put__",
      "arity": 2,
      "summary": "Write one JSON value into the extension's durable state.",
      "outside": "local"
    },
    {
      "name": "state_del",
      "global": "__vis_host_state_del__",
      "arity": 1,
      "summary": "Drop one key from the extension's durable state.",
      "outside": "local"
    },
    {
      "name": "state_keys",
      "global": "__vis_host_state_keys__",
      "arity": 0,
      "summary": "List every key the extension's durable state holds.",
      "outside": "local"
    },
    {
      "name": "log",
      "global": "__vis_host_log__",
      "arity": 2,
      "summary": "Emit one engine log line at a level.",
      "outside": "local"
    },
    {
      "name": "notify",
      "global": "__vis_host_notify__",
      "arity": 2,
      "summary": "Show one notification on the user's channel.",
      "outside": "local"
    },
    {
      "name": "shell",
      "global": "__vis_host_shell__",
      "arity": 1,
      "summary": "Run one shell op \u2014 start, logs, type, wait or stop.",
      "outside": "local"
    },
    {
      "name": "jailed_shell",
      "global": "__vis_host_jailed_shell__",
      "arity": 1,
      "summary": "Run one shell op inside the workspace jail.",
      "outside": "refuse",
      "refusal": "vis.jailed_shell needs the Vis host's jail; nothing outside a Vis process can enforce it. Run the command with vis.shell when an unjailed process is what you meant, or run this extension under vis-agent."
    },
    {
      "name": "jailed_shell_session",
      "global": "__vis_host_jailed_shell_session__",
      "arity": 1,
      "summary": "Run one shell op inside a persistent jailed session.",
      "outside": "refuse",
      "refusal": "vis.jailed_shell_session needs the Vis host's jail; nothing outside a Vis process can enforce it. Run the command with vis.shell when an unjailed process is what you meant, or run this extension under vis-agent."
    },
    {
      "name": "request_input",
      "global": "__vis_host_request_input__",
      "arity": 3,
      "summary": "Ask the human, and block until the answer settles or is cancelled.",
      "outside": "prompt"
    },
    {
      "name": "live",
      "global": "__vis_host_live__",
      "arity": 1,
      "summary": "Open, patch, read or close one live view.",
      "outside": "local"
    },
    {
      "name": "reveal_secret",
      "global": "__vis_host_reveal_secret__",
      "arity": 1,
      "summary": "Resolve a `vis-secret:` handle to its plaintext.",
      "outside": "local"
    },
    {
      "name": "forget_secret",
      "global": "__vis_host_forget_secret__",
      "arity": 1,
      "summary": "Drop the plaintext a secret handle stands for.",
      "outside": "local"
    },
    {
      "name": "declare_env",
      "global": "__vis_host_declare_env__",
      "arity": 1,
      "summary": "Resolve the environment variables the extension declared.",
      "outside": "local"
    }],
  "shell":
  {
    "default_op": "run",
    "spawn_ops": ["run","background"],
    "handle_ops": ["logs","wait","send","stop"]
  },
  "live":
  {
    "default_op": "open",
    "spawn_ops": ["open"],
    "handle_ops": ["patch","state","close"],
    "flush_ms": 100
  },
  "gateway":
  {
    "protocol":
    {
      "minimum_gateway": 12,
      "minimum_client": 12,
      "version": 12
    },
    "replay":
    {
      "cursor_key": "seq",
      "generation_start_event": "turn.started",
      "ready_event": "subscription.ready",
      "cursor_header": "last-event-id"
    },
    "envelopes":
    {
      "handshake":
      {
        "keys":
        {
          "protocol": "protocol",
          "min_client": "min_client",
          "build": "build",
          "version": "version",
          "min_gateway": "min_gateway"
        }
      },
      "session_event":
      {
        "stamp_keys":
        {
          "schema": "schema",
          "timestamp": "ts",
          "sequence": "seq",
          "type": "type",
          "session_id": "session_id"
        },
        "schema": 1
      },
      "journal_line":
      {
        "metadata_keys":
        {
          "pid": "_pid",
          "producer": "_producer",
          "store": "_store"
        }
      },
      "subscription_ready":
      {
        "event": "subscription.ready",
        "optional_keys":
        {
          "latest_iteration": "latest_iteration"
        },
        "required_keys":
        {
          "current_turn_id": "current_turn_id",
          "cursor": "cursor",
          "type": "type",
          "server_time_ms": "server_time_ms",
          "session_id": "session_id",
          "is_live": "is_live"
        }
      },
      "settled_turn":
      {
        "meta_keys": ["model","provider","llm_selected","llm_actual","is_llm_fallback","llm_routing_trace","tokens","cost","confidence","eval","duration_ms","utilization"]
      },
      "error_response":
      {
        "body_keys":
        {
          "error": "error"
        },
        "error_keys":
        {
          "message": "message",
          "type": "type"
        }
      }
    },
    "events":
    {
      "queue_mirror": ["turn.queued.deleted","queue.resumed","turn.queued","queue.paused","turn.queued.updated","turn.queued.drained"],
      "push": ["turn.end"],
      "turn_terminal": ["turn.failed","turn.completed","turn.cancelled"],
      "jobs":
      {
        "transcribe": "voice.job",
        "synthesize": "speech.job"
      },
      "session": ["block.activity","block.output","block.preview","block.started","content.block.completed","content.block.delta","content.block.started","context.updated","iteration.completed","iteration.error","provider.retry","queue.paused","queue.resumed","session.model_updated","session.status","session.title_updated","subscription.ready","turn.cancelled","turn.completed","turn.failed","turn.progress","turn.queued","turn.queued.deleted","turn.queued.drained","turn.queued.updated","turn.started","view.close","view.open","view.patch"],
      "view":
      {
        "patch": "view.patch",
        "close": "view.close",
        "open": "view.open"
      }
    },
