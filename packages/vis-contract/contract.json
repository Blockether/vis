      "if_none_match": "if-none-match",
      "last_event_id": "last-event-id",
      "minimum_gateway_protocol": "x-vis-min-gateway-protocol",
      "protocol": "x-vis-protocol",
      "suppress_registry_recovery": "x-vis-suppress-registry-recovery"
    },
