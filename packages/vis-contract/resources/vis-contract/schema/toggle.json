{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract.blockether.com/vis/schema/toggle.json",
  "title": "Feature-toggle contract",
  "description": "Feature-toggle contributions and the boolean tokens accepted by settings.",
  "$defs": {
    "boolean_true": {
      "type": "string",
      "enum": [
        "1",
        "on",
        "true",
        "yes"
      ]
    },
    "boolean_false": {
      "type": "string",
      "enum": [
        "0",
        "false",
        "no",
        "off"
      ]
    },
    "boolean_wire": {
      "oneOf": [
        {
          "$ref": "#/$defs/boolean_true"
        },
        {
          "$ref": "#/$defs/boolean_false"
        }
      ]
    },
    "contribution": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
        },
        "label": {
          "$ref": "common.json#/$defs/non_blank_string"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^\\r\\n]+$"
        },
        "default": {},
        "owner": {
          "anyOf": [
            {
              "const": "vis"
            },
            {
              "type": "string"
            }
          ]
        },
        "since": {
          "type": "string"
        },
        "is_persist": {
          "type": "boolean"
        },
        "is_experimental": {
          "type": "boolean",
          "description": "Marks an opt-in experimental feature in settings."
        },
        "is_settings": {
          "type": "boolean"
        },
        "group": {
          "$ref": "common.json#/$defs/non_blank_string"
        },
        "type": {
          "enum": [
            "boolean",
            "enum"
          ],
          "default": "boolean"
        },
        "choices": {
          "type": "array",
          "items": {},
          "minItems": 1
        },
        "channels": {
          "type": "array",
          "items": {
            "$ref": "common.json#/$defs/non_blank_string"
          },
          "minItems": 1
        },
        "visible_fn": {}
      },
      "required": [
        "id",
        "label",
        "default"
      ]
    }
  },
  "$ref": "#/$defs/contribution"
}
