{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract.blockether.com/vis/schema/symbol.json",
  "title": "Inert Python extension symbol description",
  "$ref": "#/$defs/declaration",
  "$defs": {
    "type": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "any",
            "null",
            "scalar",
            "opaque",
            "unresolved",
            "union",
            "literal",
            "generic",
            "record",
            "reference"
          ]
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "sequence_field": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^_]",
          "description": "Public dataclass field containing the received sequence items; grants local iteration, length, truth testing, integer indexing and slicing."
        },
        "variadic": {
          "const": true,
          "description": "For tuple[T, ...], true with exactly one item type in arguments. Omitted for fixed-length tuples."
        },
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/type"
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "values": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "integer",
              "boolean",
              "null"
            ]
          }
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "allOf": [{
        "if": {"required": ["sequence_field"]},
        "then": {
          "properties": {"kind": {"const": "record"}},
          "required": ["fields"]
        }
      }],
      "if": {"required": ["variadic"]},
      "then": {
        "properties": {
          "kind": {"const": "generic"},
          "name": {"const": "tuple"},
          "arguments": {"minItems": 1, "maxItems": 1}
        },
        "required": ["arguments"]
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/type"
        },
        "required": {
          "type": "boolean"
        },
        "has_default": {
          "type": "boolean"
        },
        "default_is_none": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "type",
        "required",
        "has_default",
        "default_is_none"
      ]
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/type"
        },
        "required": {
          "type": "boolean"
        },
        "has_default": {
          "type": "boolean"
        },
        "default_is_none": {
          "type": "boolean"
        },
        "default_source": {
          "type": ["string", "null"],
          "description": "Inert Python source for a representable declared default; null for required parameters or defaults that cannot be rendered within the inspection budget. Omission still uses the original callable's default."
        },
        "kind": {
          "enum": [
            "positional_only",
            "positional_or_keyword",
            "var_positional",
            "keyword_only",
            "var_keyword"
          ]
        }
      },
      "required": [
        "name",
        "type",
        "required",
        "has_default",
        "default_is_none",
        "default_source",
        "kind"
      ],
      "allOf": [{
        "if": {"properties": {"default_source": {"type": "string"}}},
        "then": {"properties": {"has_default": {"const": true}}}
      }, {
        "if": {"properties": {"default_is_none": {"const": true}}},
        "then": {"properties": {"default_source": {"const": "None"}}}
      }]
    },
    "callable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "enum": [
            "observation",
            "mutation",
            "verification",
            "external"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "string"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },
        "returns": {
          "$ref": "#/$defs/type"
        }
      },
      "required": [
        "version",
        "name",
        "tag",
        "description",
        "signature",
        "parameters",
        "returns"
      ]
    },
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "name": {
          "type": "string"
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/callable"
          }
        }
      },
      "required": [
        "version",
        "name",
        "members"
      ]
    },
    "declaration": {
      "oneOf": [
        {
          "$ref": "#/$defs/callable"
        },
        {
          "$ref": "#/$defs/namespace"
        }
      ]
    }
  }
}
