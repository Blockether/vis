        "llm_actual": {},
        "is_llm_fallback": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "llm_routing_trace": {},
        "tokens": {},
        "cost": {
          "type": [
            "number",
            "null"
          ]
        },
        "confidence": {},
        "eval": {},
        "duration_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "utilization": {}
      }
    },
    "subscription_ready": {
      "type": "object",
      "properties": {
