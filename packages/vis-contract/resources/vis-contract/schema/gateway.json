                    },
                    "tag": {
                      "enum": [
                        "observation",
                        "mutation"
                      ]
                    },
                    "hidden": {
                      "type": "boolean"
                    },
                    "doc": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 32768
                    },
                    "contract": {
                      "type": "object"
                    },
                    "params": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "maxItems": 128
                    },
                    "varargs": {
                      "type": "boolean"
                    },
                    "activity": {
                      "type": "object"
                    }
                  },
                  "required": [
                    "name",
                    "tag",
                    "hidden",
                    "doc",
                    "contract",
                    "params",
                    "varargs",
                    "activity"
                  ]
                },
                "maxItems": 128
              }
            },
            "required": [
              "name",
              "description",
              "alias",
              "symbols"
            ]
          },
          "minItems": 1,
          "maxItems": 32
        }
      },
      "required": [
        "extensions"
      ]
    },
    "client_call_result": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "success"
