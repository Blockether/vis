{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract.blockether.com/vis/schema/gateway.json",
  "title": "Gateway contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "$ref": "common.json#/$defs/version"
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "minimum_client": {
          "type": "integer",
          "minimum": 1
        },
        "minimum_gateway": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "version",
        "minimum_client",
        "minimum_gateway"
      ]
    },
    "headers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "common.json#/$defs/non_blank_string"
      }
    },
    "client_lease": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ttl_ms": {
          "type": "integer",
          "minimum": 1
        },
        "touch_ms": {
          "type": "integer",
          "minimum": 1
        },
        "keepalive_ms": {
          "type": "integer",
          "minimum": 1
        },
        "keepalive_timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "keepalive_route": {
          "$ref": "common.json#/$defs/non_blank_string"
        },
        "semantics": {
          "$ref": "common.json#/$defs/non_blank_string"
        }
      },
      "required": [
        "ttl_ms",
        "touch_ms",
        "keepalive_ms",
        "keepalive_timeout_ms",
        "keepalive_route",
        "semantics"
      ]
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "audience": {
            "enum": [
              "administration",
              "public",
              "sdk"
            ]
          },
          "operations": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "delete": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "request": {
                    "enum": [
                      "binary",
                      "json",
                      "none"
                    ]
                  },
                  "response": {
                    "enum": [
                      "binary",
                      "empty",
                      "html",
                      "json",
                      "markdown",
                      "negotiated",
                      "resource",
                      "sse"
                    ]
                  },
                  "response_schema": {
                    "enum": [
                      "session",
                      "session_list"
                    ]
                  }
                },
                "required": [
                  "request",
                  "response"
                ]
              },
              "get": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "request": {
                    "enum": [
                      "binary",
                      "json",
                      "none"
                    ]
                  },
                  "response": {
                    "enum": [
                      "binary",
                      "empty",
                      "html",
                      "json",
                      "markdown",
                      "negotiated",
                      "resource",
                      "sse"
                    ]
                  },
                  "response_schema": {
                    "enum": [
                      "session",
                      "session_list"
                    ]
                  }
                },
                "required": [
                  "request",
                  "response"
                ]
              },
              "patch": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "request": {
                    "enum": [
                      "binary",
                      "json",
                      "none"
                    ]
                  },
                  "response": {
                    "enum": [
                      "binary",
                      "empty",
                      "html",
                      "json",
                      "markdown",
                      "negotiated",
                      "resource",
                      "sse"
                    ]
                  },
                  "response_schema": {
                    "enum": [
                      "session",
                      "session_list"
                    ]
                  }
                },
                "required": [
                  "request",
                  "response"
                ]
              },
              "post": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "request": {
                    "enum": [
                      "binary",
                      "json",
                      "none"
                    ]
                  },
                  "response": {
                    "enum": [
                      "binary",
                      "empty",
                      "html",
                      "json",
                      "markdown",
                      "negotiated",
                      "resource",
                      "sse"
                    ]
                  },
                  "response_schema": {
                    "enum": [
                      "session",
                      "session_list"
                    ]
                  }
                },
                "required": [
                  "request",
                  "response"
                ]
              },
              "put": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "request": {
                    "enum": [
                      "binary",
                      "json",
                      "none"
                    ]
                  },
                  "response": {
                    "enum": [
                      "binary",
                      "empty",
                      "html",
                      "json",
                      "markdown",
                      "negotiated",
                      "resource",
                      "sse"
                    ]
                  },
                  "response_schema": {
                    "enum": [
                      "session",
                      "session_list"
                    ]
                  }
                },
                "required": [
                  "request",
                  "response"
                ]
              }
            },
            "minProperties": 1
          }
        },
        "required": [
          "path",
          "audience",
          "operations"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session": {
          "type": "array",
          "items": {
            "$ref": "common.json#/$defs/non_blank_string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "jobs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "transcribe": {
              "$ref": "common.json#/$defs/non_blank_string"
            },
            "synthesize": {
              "$ref": "common.json#/$defs/non_blank_string"
            }
          },
          "required": [
            "transcribe",
            "synthesize"
          ]
        },
        "push": {
          "type": "array",
          "items": {
            "$ref": "common.json#/$defs/non_blank_string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "turn_terminal": {
          "type": "array",
          "items": {
            "$ref": "common.json#/$defs/non_blank_string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "queue_mirror": {
          "type": "array",
          "items": {
            "$ref": "common.json#/$defs/non_blank_string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "view": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "open": {
              "$ref": "common.json#/$defs/non_blank_string"
            },
            "patch": {
              "$ref": "common.json#/$defs/non_blank_string"
            },
            "close": {
              "$ref": "common.json#/$defs/non_blank_string"
            }
          },
          "required": [
            "open",
            "patch",
            "close"
          ]
        }
      },
      "required": [
        "session",
        "jobs",
        "push",
        "turn_terminal",
        "queue_mirror",
        "view"
      ]
    },
    "envelopes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "error_response": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "body_keys": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "$ref": "common.json#/$defs/non_blank_string"
              }
            },
            "error_keys": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "$ref": "common.json#/$defs/non_blank_string"
              }
            }
          },
          "required": [
            "body_keys",
            "error_keys"
          ]
        },
        "handshake": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "keys": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "$ref": "common.json#/$defs/non_blank_string"
              }
            }
          },
          "required": [
            "keys"
          ]
        },
        "journal_line": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "metadata_keys": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "$ref": "common.json#/$defs/non_blank_string"
              }
            }
          },
          "required": [
            "metadata_keys"
          ]
        },
        "session_event": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "stamp_keys": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "$ref": "common.json#/$defs/non_blank_string"
              }
            }
          },
          "required": [
            "schema",
            "stamp_keys"
          ]
        },
        "settled_turn": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "meta_keys": {
              "type": "array",
              "items": {
                "$ref": "common.json#/$defs/non_blank_string"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "meta_keys"
          ]
        },
        "subscription_ready": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "event": {
              "$ref": "common.json#/$defs/non_blank_string"
            },
            "required_keys": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "$ref": "common.json#/$defs/non_blank_string"
              }
            },
            "optional_keys": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "$ref": "common.json#/$defs/non_blank_string"
              }
            }
          },
          "required": [
            "event",
            "required_keys",
            "optional_keys"
          ]
        }
      },
      "required": [
        "error_response",
        "handshake",
        "journal_line",
        "session_event",
        "settled_turn",
        "subscription_ready"
      ]
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cursor_header": {
          "$ref": "common.json#/$defs/non_blank_string"
        },
        "cursor_key": {
          "$ref": "common.json#/$defs/non_blank_string"
        },
        "ready_event": {
          "$ref": "common.json#/$defs/non_blank_string"
        },
        "generation_start_event": {
          "$ref": "common.json#/$defs/non_blank_string"
        }
      },
      "required": [
        "cursor_header",
        "cursor_key",
        "ready_event",
        "generation_start_event"
      ]
    },
    "session_goal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "statuses": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "max_objective_chars": {
          "type": "integer",
          "minimum": 1
        },
        "max_reason_chars": {
          "type": "integer",
          "minimum": 1
        },
        "status_labels": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "active": {
              "type": "string",
              "minLength": 1
            },
            "paused": {
              "type": "string",
              "minLength": 1
            },
            "blocked": {
              "type": "string",
              "minLength": 1
            },
            "budget_limited": {
              "type": "string",
              "minLength": 1
            },
            "complete": {
              "type": "string",
              "minLength": 1
            },
            "cancelled": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "active",
            "paused",
            "blocked",
            "budget_limited",
            "complete",
            "cancelled"
          ]
        }
      },
      "required": [
        "statuses",
        "max_objective_chars",
        "max_reason_chars",
        "status_labels"
      ]
    }
  },
  "required": [
    "version",
    "protocol",
    "headers",
    "client_lease",
    "routes",
    "events",
    "envelopes",
    "replay",
    "session_goal"
  ],
  "$defs": {
    "session_goal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "\\S"
        },
        "status": {
          "enum": [
            "active",
            "paused",
            "blocked",
            "budget_limited",
            "complete",
            "cancelled"
          ]
        },
        "token_budget": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "tokens_used": {
          "type": "integer",
          "minimum": 0
        },
        "time_used_ms": {
          "type": "integer",
          "minimum": 0
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "created_at": {
          "type": "integer",
          "minimum": 0
        },
        "updated_at": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "objective",
        "status",
        "token_budget",
        "tokens_used",
        "time_used_ms",
        "revision",
        "version",
        "reason",
        "created_at",
        "updated_at"
      ]
    },
    "session": {
      "type": "object",
      "description": "Session metadata. goal is null until an explicit /goal or SDK request creates it. Other session fields are not yet constrained here.",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/session_goal"
            }
          ]
        }
      },
      "required": [
        "id",
        "goal"
      ]
    },
    "session_list": {
      "type": "object",
      "properties": {
        "sessions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/session"
          }
        }
      },
      "required": [
        "sessions"
      ]
    }
  }
}
