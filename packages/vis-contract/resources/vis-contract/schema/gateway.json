  "$defs": {
    "session_goal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "\\S"
        },
        "status": {
          "oneOf": [
            {
              "const": "active",
              "title": "Active"
            },
            {
              "const": "paused",
              "title": "Paused"
            },
            {
              "const": "blocked",
              "title": "Blocked"
            },
            {
              "const": "budget_limited",
              "title": "Iteration limit reached"
            },
            {
              "const": "complete",
              "title": "Complete"
            },
            {
              "const": "cancelled",
              "title": "Cancelled"
            }
          ]
        },
        "iteration_budget": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "Maximum loop iterations for this goal; null means unlimited. Tokens are not a budget unit."
        },
        "tokens_used": {
          "type": "integer",
          "minimum": 0
        },
        "time_used_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Accumulated active wall-clock milliseconds through updated_at, including tools. While status is active, add max(0, now - updated_at) for the live duration. Inactive time is excluded; resume preserves this count and replacement resets it."
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "created_at": {
          "type": "integer",
          "minimum": 0
        },
        "updated_at": {
          "type": "integer",
          "minimum": 0
        },
        "iterations_used": {
          "type": "integer",
          "minimum": 0,
          "description": "Completed model responses and their tools, including prose, empty responses and the completion summary. Provider retries within one request are not separate iterations."
        }
      },
      "required": [
        "id",
        "objective",
        "status",
        "iteration_budget",
        "iterations_used",
        "tokens_used",
        "time_used_ms",
        "revision",
        "version",
        "reason",
        "created_at",
        "updated_at"
      ]
    },
    "session": {
      "type": "object",
      "description": "Session metadata. goal is null until an explicit /goal or SDK request creates it. Other session fields are not yet constrained here.",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/session_goal"
            }
          ]
        },
        "agent_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Coding-agent name resolved by the gateway from the session workspace configuration."
        }
      },
      "required": [
        "id",
        "goal"
      ]
    },
    "session_group_color": {
      "type": "string",
      "description": "Closed palette token a session group is painted with. Every channel maps a token to its own theme, so a group keeps its identity across the TUI, the companion app and the web UI. Never a hex string.",
      "enum": [
        "slate",
        "blue",
        "green",
        "amber",
        "red",
        "violet",
        "cyan",
        "pink"
      ]
    },
    "session_list": {
      "type": "object",
      "properties": {
        "sessions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/session"
          }
        }
      },
      "required": [
        "sessions"
      ]
    },
    "client_extensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extensions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "alias": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "prompt": {
                "type": "string",
                "maxLength": 32768
              },
              "version": {
