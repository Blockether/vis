          "type": "integer",
          "minimum": 0
        },
        "goal": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/session_goal"
            }
          ]
        },
        "agent_name": {
          "type": "string"
        },
        "latest_iteration": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "session_id",
        "cursor",
        "current_turn_id",
        "is_live",
        "server_time_ms",
        "goal"
      ]
    }
