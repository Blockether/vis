{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vis.blockether.com/schema/task.json",
  "title": "Task",
  "type": "object",
  "required": [
    "id",
    "session_id",
    "kind",
    "name",
    "state",
    "origin",
    "started_at",
    "view_ids",
    "detached"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "$ref": "#/$defs/kind"
    },
    "name": {
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/state"
    },
    "origin": {
      "$ref": "#/$defs/origin"
    },
    "started_at": {
      "type": "integer"
    },
    "ended_at": {
      "type": "integer"
    },
    "cancel_reason": {
      "enum": [
        "agent",
        "person",
        "turn",
        "reload",
        "session_close",
        "worker_death"
      ]
    },
    "error": {
      "type": "string"
    },
    "view_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "detached": {
      "type": "boolean"
    }
  },
  "$defs": {
    "status": {
      "type": "object",
      "required": [
        "task"
      ],
      "additionalProperties": false,
      "properties": {
        "task": {
          "$ref": "#"
        },
        "record": {
          "$ref": "agents.json#/$defs/record"
        },
        "value": {}
      },
      "if": {
        "properties": {
          "task": {
            "properties": {
              "kind": {
                  "const": "subagent"
                }
              }
            }
          }
        },
        "then": {
          "required": [
            "record"
          ]
        }
      },
    "cancel": {
      "type": "object",
      "required": ["requested"],
      "additionalProperties": false,
      "properties": {
        "requested": {"type": "boolean"},
        "reason": {"enum": ["already_ended", "already_requested"]}
      },
      "if": {"properties": {"requested": {"const": false}}},
      "then": {"required": ["reason"]},
      "else": {"not": {"required": ["reason"]}}
    },
    "kind": {
      "enum": [
        "tool",
        "shell",
        "mcp",
        "subagent"
      ]
    },
    "state": {
      "enum": [
        "running",
        "done",
        "failed",
        "cancelled"
      ]
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "turn": {
          "type": [
            "integer",
            "null"
          ]
        },
        "iteration": {
          "type": [
            "integer",
            "null"
          ]
        },
        "block": {
          "type": "string"
        }
      }
    }
  }
}
