{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vis.blockether.com/schema/config.json",
  "$defs": {
    "nonBlankString": {
      "type": "string",
      "pattern": ".*\\S.*"
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": ".*\\S.*"
      }
    },
    "command": {
      "oneOf": [
        {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": ".*\\S.*"
          },
          "minItems": 1
        }
      ]
    },
    "apiStyle": {
      "type": "string",
      "oneOf": [
        {
          "enum": [
            "anthropic",
            "anthropic-messages",
            "anthropic_messages",
            "claude",
            "messages"
          ],
          "default": "anthropic",
          "x-vis-runtime": "anthropic"
        },
        {
          "enum": [
            "openai",
            "openai-chat",
            "openai_chat",
            "openai-compatible",
            "openai_compatible",
            "openai-compatible-chat",
            "openai_compatible_chat",
            "chat",
            "chat-completions",
            "chat_completions"
          ],
          "default": "openai",
          "x-vis-runtime": "openai-compatible-chat"
        },
        {
          "enum": [
            "openai-responses",
            "openai_responses",
            "openai-compatible-responses",
            "openai_compatible_responses",
            "responses"
          ],
          "default": "openai-responses",
          "x-vis-runtime": "openai-compatible-responses"
        },
        {
          "enum": [
            "gemini",
            "google",
            "google-gemini",
            "google_gemini"
          ],
          "default": "gemini",
          "x-vis-runtime": "gemini"
        }
      ]
    },
    "yamlValue": {
      "oneOf": [
        {
          "type": [
            "string",
            "boolean",
            "number",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/yamlValue"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/yamlValue"
          }
        }
      ]
    },
    "networkTimeout": {
      "type": "object",
      "properties": {
        "timeout_ms": {
          "type": "number",
          "minimum": 0
        },
        "ttft_timeout_ms": {
          "type": "number",
          "minimum": 0
        },
        "first_byte_timeout_ms": {
          "type": "number",
          "minimum": 0
        },
        "idle_timeout_ms": {
          "type": "number",
          "minimum": 0
        },
        "semantic_timeout_ms": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "context": {
          "type": "integer",
          "minimum": 1
        },
        "input_limit": {
          "type": "integer",
          "minimum": 1
        },
        "tokenizer": {
          "type": "string",
          "minLength": 1
        },
        "output_limit": {
          "type": "integer",
          "minimum": 1
        },
        "is_tool_calls_supported": {
          "type": "boolean"
        },
        "is_tool_call": {
          "type": "boolean"
        },
        "is_vision_supported": {
          "type": "boolean"
        },
        "is_image_input": {
          "type": "boolean"
        },
        "is_reasoning": {
          "type": "boolean"
        },
        "is_parallel_tool_calls": {
          "type": "boolean"
        },
        "api_style": {
          "$ref": "#/$defs/apiStyle"
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "provider": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "api_key": {
          "type": "string"
        },
        "api_key_command": {
          "$ref": "#/$defs/command"
        },
        "models": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "pattern": ".*\\S.*"
              },
              {
                "$ref": "#/$defs/model"
              }
            ]
          }
        },
        "model_metadata": {
          "type": "object",
          "properties": {
            "identity": {
              "type": "string",
              "minLength": 1
            },
            "models": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/model"
              }
            }
          },
          "required": [
            "identity",
            "models"
          ],
          "additionalProperties": false
        },
        "base_url": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "compatibility": {
          "$ref": "#/$defs/apiStyle"
        },
        "api_style": {
          "$ref": "#/$defs/apiStyle"
        },
        "responses_path": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "llm_headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "extra_body": {
          "$ref": "#/$defs/yamlValue"
        },
        "network": {
          "$ref": "#/$defs/networkTimeout"
        },
        "is_stateless": {
          "type": "boolean"
        },
        "is_vision_supported": {
          "type": "boolean"
        },
        "is_image_input": {
          "type": "boolean"
        },
        "reasoning_level": {
          "enum": [
            "quick",
            "balanced",
            "deep"
          ]
        },
        "reasoning_effort": {
          "type": "string",
          "pattern": ".*\\S.*"
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "rateLimit": {
      "type": "object",
      "properties": {
        "same_provider_delays_ms": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "fallback_after_ms": {
          "type": "integer",
          "minimum": 1
        },
        "is_respect_retry_after": {
          "type": "boolean"
        },
        "is_fallback_provider": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "routerNetwork": {
      "type": "object",
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "ttft_timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "first_byte_timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "idle_timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "semantic_timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "max_retries": {
          "type": "integer",
          "minimum": 1
        },
        "initial_delay_ms": {
          "type": "integer",
          "minimum": 1
        },
        "max_delay_ms": {
          "type": "integer",
          "minimum": 1
        },
        "multiplier": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_cost": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "tokens": {
      "type": "object",
      "properties": {
        "is_check_context": {
          "type": "boolean"
        },
        "pricing": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": ".*\\S.*"
          },
          "additionalProperties": {
            "$ref": "#/$defs/yamlValue"
          }
        },
        "context_limits": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": ".*\\S.*"
          },
          "additionalProperties": {
            "type": "number"
          }
        },
        "output_reserve": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "router": {
      "type": "object",
      "properties": {
        "rate_limit": {
          "$ref": "#/$defs/rateLimit"
        },
        "network": {
          "$ref": "#/$defs/routerNetwork"
        },
        "budget": {
          "$ref": "#/$defs/budget"
        },
        "tokens": {
          "$ref": "#/$defs/tokens"
        },
        "failure_threshold": {
          "type": "integer",
          "minimum": 1
        },
        "recovery_ms": {
          "type": "integer",
          "minimum": 1
        },
        "transient_status_codes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "uniqueItems": true
        },
        "window_ms": {
          "type": "integer",
          "minimum": 1
        },
        "cooldown_ms": {
          "type": "integer",
          "minimum": 1
        },
        "max_wait_ms": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "workspaceOs": {
      "enum": [
        "macos",
        "linux",
        "wsl",
        "windows"
      ]
    },
    "workspaceWhen": {
      "type": "object",
      "properties": {
        "os": {
          "oneOf": [
            {
              "$ref": "#/$defs/workspaceOs"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/workspaceOs"
              },
              "minItems": 1
            }
          ]
        },
        "exists": {
          "type": "string",
          "pattern": "^(?:/|~(?:/|$))"
        }
      },
      "additionalProperties": false
    },
    "workspaceEntry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "path": {
          "type": "string",
          "pattern": "^(?:/|~(?:/|$))"
        },
        "python_name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*_path$",
          "description": "Explicit prebound Python Path name; defaults to the directory name in snake_case plus _path."
        },
        "description": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "access": {
          "enum": [
            "read-only",
            "readonly",
            "ro",
            "read-write",
            "readwrite",
            "rw"
          ],
          "x-vis-enum-aliases": {
            "readonly": "read-only",
            "ro": "read-only",
            "readwrite": "read-write",
            "rw": "read-write"
          }
        },
        "search": {
          "type": "boolean"
        },
        "when": {
          "$ref": "#/$defs/workspaceWhen"
        },
        "optional": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "path"
      ]
    },
    "workspace": {
      "type": "object",
      "properties": {
        "filesystem": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/workspaceEntry"
          }
        }
      },
      "additionalProperties": false
    },
    "jailFilesystem": {
      "type": "object",
      "properties": {
        "allow": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": ".*\\S.*"
          }
        },
        "deny_read": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": ".*\\S.*"
          }
        },
        "deny_write": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": ".*\\S.*"
          }
        }
      },
      "additionalProperties": false
    },
    "networkRuleAllow": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "path": {
          "type": "string",
          "pattern": ".*\\S.*"
        }
      },
      "additionalProperties": false,
      "required": [
        "method"
      ]
    },
    "networkRule": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "access": {
          "enum": [
            "read-only",
            "readonly",
            "ro",
            "read-write",
            "readwrite",
            "rw",
            "full",
            "all",
            "none",
            "deny",
            "closed"
          ],
          "x-vis-enum-aliases": {
            "readonly": "read-only",
            "ro": "read-only",
            "readwrite": "read-write",
            "rw": "read-write",
            "full": "read-write",
            "all": "read-write",
            "deny": "none",
            "closed": "none"
          }
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": ".*\\S.*"
          }
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "allow": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/networkRuleAllow"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "host"
      ]
    },
    "network": {
      "type": "object",
      "properties": {
        "allowed_domains": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": ".*\\S.*"
          }
        },
        "denied_domains": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": ".*\\S.*"
          }
        },
        "exclude_domains": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": ".*\\S.*"
          }
        },
        "allow_private": {
          "type": "boolean"
        },
        "inbound_ports": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "uniqueItems": true
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/networkRule"
          }
        }
      },
      "additionalProperties": false
    },
    "toolList": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_*][A-Za-z0-9_.*]*$",
        "maxLength": 200
      },
      "description": "Tool names as py3 binds them, such as memo.recall. * matches any characters."
    },
    "tools": {
      "type": "object",
      "properties": {
        "allow": {
          "$ref": "#/$defs/toolList",
          "description": "Keep only these tools of each extension that the list names. Other tools of that extension, also later ones, are off."
        },
        "deny": {
          "$ref": "#/$defs/toolList",
          "description": "Turn these tools off."
        }
      },
      "additionalProperties": false,
      "description": "Tools of optional extensions that a session can call. Every scope applies: a narrower scope can turn tools off, never on."
    },
    "jail": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "filesystem": {
          "$ref": "#/$defs/jailFilesystem"
        },
        "network": {
          "$ref": "#/$defs/network"
        },
        "deny_exec": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": ".*\\S.*"
          }
        },
        "keychain": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "prompt": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "is_replace": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "text"
          ]
        }
      ]
    },
    "gateway": {
      "type": "object",
      "properties": {
        "advertise": {
          "$ref": "#/$defs/nonBlankString"
        },
        "proxy": {
          "$ref": "#/$defs/gatewayProxy"
        }
      },
      "additionalProperties": false
    },
    "gatewayProxyDomain": {
      "description": "A host name pattern. `example.com` and `*.example.com` both match example.com and each subdomain. `*` alone is not permitted, because then the gateway is an open proxy.",
      "type": "string",
      "pattern": "^\\s*(\\*\\.)?[A-Za-z0-9_\\[\\]:.-]+\\s*$"
    },
    "gatewayProxy": {
      "description": "The forward proxy of the gateway. Paired clients open these hosts through the network of the gateway machine, for example a company VPC.",
      "type": "object",
      "properties": {
        "allowed_domains": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/gatewayProxyDomain"
          }
        },
        "denied_domains": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gatewayProxyDomain"
          }
        },
        "ports": {
          "description": "The target ports that the proxy opens. The default is 80 and 443.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "port": {
          "description": "The port that the proxy listens on. Without it, the system gives a free port on each start.",
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "required": [
        "allowed_domains"
      ],
      "additionalProperties": false
    },
    "grep": {
      "type": "object",
      "properties": {
        "include_gitignored_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": ".*\\S.*"
          }
        },
        "always_exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": ".*\\S.*"
          }
        }
      },
      "additionalProperties": false
    },
    "db": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "path": {
          "type": "string",
          "pattern": ".*\\S.*"
        }
      },
      "additionalProperties": false,
      "required": [
        "backend"
      ]
    },
    "tui": {
      "type": "object",
      "properties": {
        "theme_name": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "contributors_disabled": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": ".*\\S.*"
          }
        }
      },
      "additionalProperties": false
    },
    "python": {
      "type": "object",
      "properties": {
        "tls_strict": {
          "type": "boolean",
          "default": true,
          "description": "Python worker TLS policy. False removes only VERIFY_X509_STRICT; certificate trust and hostname verification remain enabled. Applies to sandbox execution and trusted Python extensions at worker startup."
        },
        "index_url": {
          "type": "string",
          "pattern": "^https?://[^\\s/?#@]+(?:/[^\\s?#@]*)?$",
          "description": "Primary index for Vis-managed pip installs and the default index for uv CLI and project preparation. Explicit uv index environment settings and --default-index take precedence. Credentials, query strings and fragments are not accepted; configure authentication outside committed YAML."
        },
        "environment": {
          "type": "string",
          "enum": [
            "project",
            "shared"
          ],
          "default": "project",
          "description": "Environment for project Python: the uv projects of project extensions inside the project tree and the Python language tools. project uses each project's own environment, normally .venv. shared prepares extension projects like vis-agent python --shared uv sync, loads them from Vis shared packages and runs the Python language tools with vis-agent python --shared."
        },
        "dependency_sync": {
          "type": "string",
          "enum": [
            "auto",
            "never"
          ],
          "default": "auto",
          "description": "Dependency installation by the Python language tools. auto installs the dependencies of the project before its Python starts. never installs nothing: the tools use the environment as it is, for an environment that is prepared and must not change."
        },
        "source_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": ".*\\S.*"
          }
        }
      },
      "additionalProperties": false
    },
    "mcpAuth": {
      "type": "object",
      "properties": {
        "client_name": {
          "type": "string",
          "pattern": ".*\\S.*",
          "description": "Client name sent during OAuth registration. Defaults to Claude Code. Does not change the MCP handshake name."
        },
        "client_id": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "client_metadata_url": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^https://[^\\s/]+/\\S+$"
            },
            {
              "const": false
            }
          ],
          "description": "URL of a Client ID Metadata Document to send as the client_id when the authorization server reads such documents. Defaults to the document of Vis. Set false to register a client instead."
        },
        "client_secret": {
          "type": "string",
          "pattern": "^\\$\\{[A-Za-z_][A-Za-z0-9_]*\\}$",
          "description": "Secret of a pre-registered client as an environment reference, such as ${FIGMA_CLIENT_SECRET}. Plain text is refused. Without it, Vis uses the secret that vis-agent mcp add --client-secret keeps outside the config."
        },
        "callback_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Fixed port of the sign-in callback. The redirect URI is then http://localhost:<port>/callback. Use it for a client whose redirect URI is registered. Without it, Vis uses a free port."
        },
        "scope": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "authorization_timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "grant": {
          "enum": [
            "client_credentials",
            "jwt_bearer",
            "enterprise_managed"
          ],
          "description": "A grant that needs no person: the client gets the token by itself, with no browser. Without it, a person signs in."
        },
        "private_key": {
          "type": "string",
          "pattern": "^\\$\\{[A-Za-z_][A-Za-z0-9_]*\\}$",
          "description": "PEM private key that signs the client assertion (private_key_jwt), as an environment reference. Plain text is refused."
        },
        "private_key_file": {
          "type": "string",
          "pattern": ".*\\S.*",
          "description": "Path of the PEM private key that signs the client assertion."
        },
        "signing_algorithm": {
          "enum": [
            "ES256",
            "RS256"
          ],
          "description": "Algorithm of the client assertion. Defaults to the algorithm of the private key."
        },
        "assertion": {
          "type": "string",
          "pattern": "^\\$\\{[A-Za-z_][A-Za-z0-9_]*\\}$",
          "description": "JWT for the grant jwt_bearer, as an environment reference. Plain text is refused."
        },
        "assertion_file": {
          "type": "string",
          "pattern": ".*\\S.*",
          "description": "Path of the JWT for the grant jwt_bearer, such as a workload identity token. Read for each token request."
        },
        "idp_token_endpoint": {
          "type": "string",
          "pattern": "^https?://\\S+$",
          "description": "Token endpoint of the identity provider for the grant enterprise_managed."
        },
        "idp_issuer": {
          "type": "string",
          "pattern": "^https?://\\S+$",
          "description": "Issuer of the identity provider. Vis reads the token endpoint from its OpenID configuration."
        },
        "idp_client_id": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "idp_client_secret": {
          "type": "string",
          "pattern": "^\\$\\{[A-Za-z_][A-Za-z0-9_]*\\}$",
          "description": "Secret of the client at the identity provider, as an environment reference. Plain text is refused."
        },
        "idp_id_token": {
          "type": "string",
          "pattern": "^\\$\\{[A-Za-z_][A-Za-z0-9_]*\\}$",
          "description": "Identity token of the person, as an environment reference. Plain text is refused."
        },
        "idp_id_token_file": {
          "type": "string",
          "pattern": ".*\\S.*",
          "description": "Path of the identity token of the person. Read for each token request."
        },
        "dpop": {
          "type": "boolean",
          "description": "Bind each token to a key of this client (DPoP, RFC 9449). Defaults to true when the MCP server asks for DPoP and the authorization server accepts ES256 proofs."
        }
      },
      "additionalProperties": false
    },
    "mcpServer": {
      "type": "object",
      "properties": {
        "transport": {
          "enum": [
            "stdio",
            "streamable_http",
            "sse"
          ]
        },
        "command": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "url": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "enabled": {
          "type": "boolean"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "listen": {
          "type": "boolean"
        },
        "roots": {
          "type": "boolean",
          "description": "Give the server the workspace of the session as MCP roots. Defaults to true for stdio and to false for a remote server."
        },
        "sampling": {
          "type": "boolean",
          "description": "Let the server ask the model for an answer. The person allows each request. Defaults to false."
        },
        "auth": {
          "$ref": "#/$defs/mcpAuth"
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "transport": {
              "const": "stdio"
            }
          },
          "required": [
            "transport",
            "command"
          ],
          "not": {
            "anyOf": [
              { "required": ["url"] },
              { "required": ["headers"] },
              { "required": ["listen"] },
              { "required": ["auth"] }
            ]
          }
        },
        {
          "properties": {
            "transport": {
              "enum": [
                "streamable_http",
                "sse"
              ]
            }
          },
          "required": [
            "transport",
            "url"
          ],
          "not": {
            "anyOf": [
              { "required": ["command"] },
              { "required": ["args"] },
              { "required": ["cwd"] },
              { "required": ["env"] }
            ]
          }
        }
      ]
    },
    "mcp": {
      "type": "object",
      "properties": {
        "servers": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": ".*\\S.*"
          },
          "additionalProperties": {
            "$ref": "#/$defs/mcpServer"
          }
        }
      },
      "additionalProperties": false
    },
    "titling": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "llm",
            "first_sentence",
            "first_words",
            "disabled"
          ]
        },
        "provider": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "model": {
          "type": "string",
          "pattern": ".*\\S.*"
        }
      },
      "additionalProperties": false
    },
    "visionFact": {
      "type": "object",
      "properties": {
        "learned_at": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": ".*\\S.*"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "learned_at"
      ]
    },
    "visionFacts": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": ".*\\S.*"
      },
      "additionalProperties": {
        "$ref": "#/$defs/visionFact"
      }
    },
    "visionEye": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "model": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "learned_at": {
          "type": "string",
          "pattern": ".*\\S.*"
        }
      },
      "additionalProperties": false,
      "required": [
        "provider",
        "learned_at"
      ]
    },
    "visionMemory": {
      "type": "object",
      "properties": {
        "blind_providers": {
          "$ref": "#/$defs/visionFacts"
        },
        "blind_models": {
          "$ref": "#/$defs/visionFacts"
        },
        "working_eye": {
          "$ref": "#/$defs/visionEye"
        }
      },
      "additionalProperties": false
    },
    "environmentSource": {
      "type": "object",
      "properties": {
        "env": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "dotenv": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "keychain": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "account": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "literal": {
          "oneOf": [
            {
              "type": "string",
              "pattern": ".*\\S.*"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ]
        }
      },
      "additionalProperties": false,
      "minProperties": 1,
      "oneOf": [
        {
          "required": [
            "env"
          ]
        },
        {
          "required": [
            "dotenv"
          ]
        },
        {
          "required": [
            "keychain"
          ]
        },
        {
          "required": [
            "command"
          ]
        },
        {
          "required": [
            "literal"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "account"
            ]
          },
          "then": {
            "required": [
              "keychain"
            ]
          }
        }
      ]
    },
    "environmentSourceNoLiteral": {
      "type": "object",
      "properties": {
        "env": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "dotenv": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "keychain": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "account": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "literal": {
          "oneOf": [
            {
              "type": "string",
              "pattern": ".*\\S.*"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ]
        }
      },
      "additionalProperties": false,
      "minProperties": 1,
      "oneOf": [
        {
          "required": [
            "env"
          ]
        },
        {
          "required": [
            "dotenv"
          ]
        },
        {
          "required": [
            "keychain"
          ]
        },
        {
          "required": [
            "command"
          ]
        },
        {
          "required": [
            "literal"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "account"
            ]
          },
          "then": {
            "required": [
              "keychain"
            ]
          }
        }
      ],
      "not": {
        "required": [
          "literal"
        ]
      }
    },
    "environment": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "patternProperties": {
        "^(?:.*_)?(?:[Kk][Ee][Yy]|[Tt][Oo][Kk][Ee][Nn]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Pp][Aa][Ss][Ss][Pp][Hh][Rr][Aa][Ss][Ee]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll][Ss])$": {
          "$ref": "#/$defs/environmentSourceNoLiteral"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/environmentSource"
      }
    },
    "extensionPackage": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "subdirectory": {
          "type": "string",
          "maxLength": 1024,
          "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*)?$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "source"
      ],
      "not": {
        "required": [
          "version",
          "revision"
        ]
      },
      "additionalProperties": false,
      "description": "Explicit extension sync declaration. Review source and run extension sync --trust; config loading never installs code. Omitted selector chooses the latest approved stable release once, retained until --refresh; version: latest rechecks it on every sync. A local source with *, ? or [ is a glob of extension entries: it takes no other keys, loads in place at each load and /reload, and sync ignores it."
    },
    "extensions": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "maxLength": 128
      },
      "additionalProperties": {
        "$ref": "#/$defs/extensionPackage"
      },
      "description": "Packages keyed by normalized manifest name. Later tiers replace the entire same-named declaration. Global and project installations remain separate; project entries win at load time."
    },
    "config": {
      "type": "object",
      "properties": {
        "providers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provider"
          }
        },
        "removed_providers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": ".*\\S.*"
          }
        },
        "default_provider": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "default_model": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "fallback_provider": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "fallback_model": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "router": {
          "$ref": "#/$defs/router"
        },
        "system_prompt": {
          "$ref": "#/$defs/prompt"
        },
        "workspace": {
          "$ref": "#/$defs/workspace"
        },
        "jail": {
          "$ref": "#/$defs/jail"
        },
        "tools": {
          "$ref": "#/$defs/tools"
        },
        "environment": {
          "$ref": "#/$defs/environment"
        },
        "db_spec": {
          "$ref": "#/$defs/db"
        },
        "gateway": {
          "$ref": "#/$defs/gateway"
        },
        "grep": {
          "$ref": "#/$defs/grep"
        },
        "toggles": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": ".*\\S.*"
          },
          "additionalProperties": {
            "description": "The value of one setting. An object setting, such as sound_presets, stores an object or a list; its owner checks the shape.",
            "type": [
              "string",
              "boolean",
              "number",
              "null",
              "object",
              "array"
            ]
          }
        },
        "tui_settings": {
          "$ref": "#/$defs/tui"
        },
        "mcp": {
          "$ref": "#/$defs/mcp"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "python": {
          "$ref": "#/$defs/python"
        },
        "titling": {
          "$ref": "#/$defs/titling"
        },
        "vision_memory": {
          "$ref": "#/$defs/visionMemory"
        },
        "machine_order": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9_-]+$" },
          "description": "Stable gateway ids in the primary gateway's durable Companion order."
        },
        "agent_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f]+$",
          "description": "Coding-agent name shared by the JVM prompt and gateway clients. Defaults to Vis. The environment variable VIS_AGENT_NAME overrides it and locks it."
        },
        "agent_name_locked": {
          "type": "boolean",
          "description": "Only in the machine configuration. true makes the machine `agent_name` the only name of the agent: no project changes it and no client can rename the agent."
        },
        "machine_name": {
          "$ref": "#/$defs/machineName"
        }
      },
      "additionalProperties": false
    },
    "machineName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f]+$",
      "description": "Name of this machine that the gateway reports to its clients. The environment variable VIS_MACHINE_NAME overrides it. Without a name, a client shows the host of the gateway address."
    }
  },
  "$ref": "#/$defs/config"
}
