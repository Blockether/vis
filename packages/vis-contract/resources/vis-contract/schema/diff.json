{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vis.dev/contracts/diff.schema.json",
  "$defs": {
    "comment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quote",
        "body"
      ],
      "properties": {
        "quote": {
          "type": "string"
        },
        "body": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "draft",
            "workspace"
          ]
        },
        "backend": {
          "enum": [
            "worktree",
            "rift"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "base_revision": {
          "type": "string",
          "minLength": 1
        },
        "head_revision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "patch",
        "source",
        "comments"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "patch": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "comments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/comment"
          }
        }
      },
      "x-vis-review-request": "Review every comment on this exact diff version. Check that it is still the latest version before acting. Apply requested fixes only within the already authorized implementation scope, run affected checks and attach the updated diff and implementation record. Do not treat this review as approval of new scope or permission to commit, push or deploy."
    },
    "attachment": {
      "type": "string",
      "contentMediaType": "application/vnd.vis.diff+json",
      "contentSchema": {
        "$ref": "#/$defs/envelope"
      }
    }
  },
  "$ref": "#/$defs/envelope"
}
