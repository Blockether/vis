{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vis.dev/contracts/diff.schema.json",
  "$defs": {
    "comment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quote",
        "body"
      ],
      "properties": {
        "quote": {
          "type": "string"
        },
        "body": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "draft",
            "workspace"
          ]
        },
        "backend": {
          "enum": [
            "worktree",
            "rift"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "base_revision": {
          "type": "string",
          "minLength": 1
        },
        "head_revision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "patch",
        "source"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "patch": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "comments": {
          "description": "Review comments that older Vis versions stored. Readers ignore them.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/comment"
          }
        }
      }
    },
    "attachment": {
      "type": "string",
      "contentMediaType": "application/vnd.vis.diff+json",
      "contentSchema": {
        "$ref": "#/$defs/envelope"
      }
    }
  },
  "$ref": "#/$defs/envelope"
}
