{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract.blockether.com/vis/schema/provider.json",
  "title": "Provider limits contract",
  "description": "The portable limits vocabulary every SDK renders: what a report may say, what one row is measured against, what it counts, how its window is anchored, and how exactly and from where its numbers are known.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "limits"
  ],
  "properties": {
    "version": {
      "$ref": "common.json#/$defs/version"
    },
    "limits": {
      "$ref": "#/$defs/limits"
    }
  },
  "$defs": {
    "limits": {
      "description": "The closed vocabularies one limits report is judged by. Every list is a SET: sorted, unique, and lower-case, so two SDKs cannot disagree about spelling or order.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statuses",
        "scopes",
        "kinds",
        "window_kinds",
        "window_units",
        "precisions",
        "sources"
      ],
      "properties": {
        "statuses": {
          "description": "What a whole report may say about itself.",
          "$ref": "common.json#/$defs/token_list"
        },
        "scopes": {
          "description": "What one row is measured against.",
          "$ref": "common.json#/$defs/token_list"
        },
        "kinds": {
          "description": "What one row counts.",
          "$ref": "common.json#/$defs/token_list"
        },
        "window_kinds": {
          "description": "How a row's window is anchored.",
          "$ref": "common.json#/$defs/token_list"
        },
        "window_units": {
          "description": "Calendar units a row's window may be sized in.",
          "$ref": "common.json#/$defs/token_list"
        },
        "precisions": {
          "description": "How exactly a row's numbers are known.",
          "$ref": "common.json#/$defs/token_list"
        },
        "sources": {
          "description": "Where a row's numbers came from.",
          "$ref": "common.json#/$defs/token_list"
        }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "kind": {
          "enum": [
            "calendar",
            "lifetime",
            "rolling"
          ]
        },
        "unit": {
          "enum": [
            "day",
            "hour",
            "minute",
            "month",
            "week",
            "year"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "resets_at_ms": {
          "type": "integer"
        }
      },
      "required": [
        "kind"
      ]
    },
    "limit_row": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "common.json#/$defs/non_blank_string"
        },
        "label": {
          "$ref": "common.json#/$defs/non_blank_string"
        },
        "scope": {
          "enum": [
            "account",
            "model",
            "plan",
            "workspace"
          ]
        },
        "subject": {
          "type": "object"
        },
        "kind": {
          "enum": [
            "credits",
            "rate",
            "requests",
            "sessions",
            "tokens",
            "usd"
          ]
        },
        "precision": {
          "enum": [
            "derived",
            "estimate",
            "exact",
            "unknown"
          ]
        },
        "source": {
          "enum": [
            "derived",
            "local",
            "provider-api",
            "static"
          ]
        },
        "used": {
          "type": "number"
        },
        "limit": {
          "type": "number"
        },
        "remaining": {
          "type": "number"
        },
        "is_unlimited": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        },
        "window": {
          "$ref": "#/$defs/window"
        }
      },
      "required": [
        "id",
        "label",
        "scope",
        "kind",
        "precision",
        "source",
        "is_unlimited"
      ]
    },
    "report": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "provider_id": {
          "$ref": "common.json#/$defs/non_blank_string"
        },
        "status": {
          "enum": [
            "error",
            "ok",
            "unauthenticated",
            "unknown-provider",
            "unsupported"
          ]
        },
        "fetched_at_ms": {
          "type": "integer"
        },
        "static": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "rpm": {
              "type": "integer",
              "minimum": 0
            },
            "tpm": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "dynamic": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "limits": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/limit_row"
              }
            },
            "note": {
              "type": "string"
            }
          },
          "required": [
            "limits"
          ]
        },
        "error": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "type": {
              "$ref": "common.json#/$defs/non_blank_string"
            },
            "message": {
              "$ref": "common.json#/$defs/non_blank_string"
            },
            "data": {
              "type": "object"
            }
          },
          "required": [
            "type",
            "message"
          ]
        }
      },
      "required": [
        "provider_id",
        "status",
        "fetched_at_ms",
        "static",
        "dynamic"
      ]
    }
  }
}
