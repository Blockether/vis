{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract.blockether.com/vis/schema/provider.json",
  "title": "Provider limits contract",
  "description": "The portable limits vocabulary every SDK renders: what a report may say, what one row is measured against, what it counts, how its window is anchored, and how exactly and from where its numbers are known.",
  "$ref": "#/$defs/report",
  "$defs": {
    "window": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "kind": {
          "enum": [
            "calendar",
            "lifetime",
            "rolling"
          ]
        },
        "unit": {
          "enum": [
            "day",
            "hour",
            "minute",
            "month",
            "week",
            "year"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "resets_at_ms": {
          "type": "integer"
        }
      },
      "required": [
        "kind"
      ]
    },
    "limit_row": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "common.json#/$defs/non_blank_string"
        },
        "label": {
          "$ref": "common.json#/$defs/non_blank_string"
        },
        "scope": {
          "enum": [
            "account",
            "model",
            "plan",
            "workspace"
          ]
        },
        "subject": {
          "type": "object"
        },
        "kind": {
          "enum": [
            "credits",
            "rate",
            "requests",
            "sessions",
            "tokens",
            "usd"
          ]
        },
        "precision": {
          "enum": [
            "derived",
            "estimate",
            "exact",
            "unknown"
          ]
        },
        "source": {
          "enum": [
            "derived",
            "local",
            "provider-api",
            "static"
          ]
        },
        "used": {
          "type": "number"
        },
        "limit": {
          "type": "number"
        },
        "remaining": {
          "type": "number"
        },
        "is_unlimited": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        },
        "window": {
          "$ref": "#/$defs/window"
        }
      },
      "required": [
        "id",
        "label",
        "scope",
        "kind",
        "precision",
        "source",
        "is_unlimited"
      ]
    },
    "reset_credits": {
      "description": "Account-scoped allowance for explicitly confirmed limit resets. Missing availability is never zero. Credentials must not appear here.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "error",
            "ok",
            "unsupported"
          ]
        },
        "available_count": {
          "type": "integer",
          "minimum": 0
        },
        "account_id": {
          "$ref": "common.json#/$defs/non_blank_string"
        },
        "message": {
          "type": "string"
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "required": [
          "available_count",
          "account_id"
        ]
      },
      "else": {
        "not": {
          "required": [
            "available_count"
          ]
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "provider_id": {
          "$ref": "common.json#/$defs/non_blank_string"
        },
        "status": {
          "enum": [
            "error",
            "ok",
            "unauthenticated",
            "unknown-provider",
            "unsupported"
          ]
        },
        "fetched_at_ms": {
          "type": "integer"
        },
        "static": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "rpm": {
              "type": "integer",
              "minimum": 0
            },
            "tpm": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "dynamic": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "limits": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/limit_row"
              }
            },
            "reset_credits": {
              "$ref": "#/$defs/reset_credits"
            },
            "note": {
              "type": "string"
            }
          },
          "required": [
            "limits"
          ]
        },
        "error": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "type": {
              "$ref": "common.json#/$defs/non_blank_string"
            },
            "message": {
              "$ref": "common.json#/$defs/non_blank_string"
            },
            "data": {
              "type": "object"
            }
          },
          "required": [
            "type",
            "message"
          ]
        }
      },
      "required": [
        "provider_id",
        "status",
        "fetched_at_ms",
        "static",
        "dynamic"
      ]
    }
  }
}
