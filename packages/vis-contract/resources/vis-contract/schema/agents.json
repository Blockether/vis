{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract.blockether.com/vis/schema/agents.json",
  "$ref": "#/$defs/agent",
  "x-vis-max-team-children": 128,
  "x-vis-max-active-children": 16,
  "$comment": "Child-count limits are enforced against persisted team and leader state, not one agent payload.",
  "$defs": {
    "spawn": {
      "type": "object",
      "properties": {
        "task": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "\\S"
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "iteration_budget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600,
          "default": 120
        },
        "allowed_models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/model_pair"
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        },
        "files": {
          "$ref": "#/$defs/files"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "task"
      ],
      "dependentRequired": {
        "model": [
          "provider"
        ],
        "provider": [
          "model"
        ]
      },
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "properties": {
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/spawn/properties/task"
              },
              {
                "type": "object",
                "properties": {
                  "task": {
                    "$ref": "#/$defs/spawn/properties/task"
                  },
                  "role": {
                    "$ref": "#/$defs/spawn/properties/role"
                  },
                  "model": {
                    "$ref": "#/$defs/spawn/properties/model"
                  },
                  "provider": {
                    "$ref": "#/$defs/spawn/properties/provider"
                  },
                  "iteration_budget": {
                    "$ref": "#/$defs/spawn/properties/iteration_budget"
                  },
                  "files": {
                    "$ref": "#/$defs/spawn/properties/files"
                  }
                },
                "required": [
                  "task"
                ],
                "dependentRequired": {
                  "model": [
                    "provider"
                  ],
                  "provider": [
                    "model"
                  ]
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "timeout_secs": {
          "$ref": "#/$defs/wait/properties/timeout_secs"
        }
      },
      "required": [
        "tasks"
      ],
      "additionalProperties": false
    },
    "wait": {
      "type": "object",
      "properties": {
        "session_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "timeout_secs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800,
          "default": 240
        }
      },
      "additionalProperties": false
    },
    "list": {
      "type": "object",
      "additionalProperties": false
    },
    "cancel": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "session_id"
      ],
      "additionalProperties": false
    },
    "extend": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        }
      },
      "required": [
        "session_id",
        "iterations"
      ],
      "additionalProperties": false
    },
    "deny": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        }
      },
      "required": [
        "session_id",
        "reason"
      ],
      "additionalProperties": false
    },
    "answer": {
      "$comment": "A person answers the open question of a subagent for its parent.",
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "\\S"
        }
      },
      "required": [
        "session_id",
        "text"
      ],
      "additionalProperties": false
    },
    "grant": {
      "$comment": "Add file rules to the grant of a subagent. A child without write rules already writes where its parent writes, so a write grant changes nothing for it. A write rule under a read_only or deny rule of the child fails.",
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "$ref": "#/$defs/files"
        }
      },
      "required": [
        "session_id",
        "files"
      ],
      "additionalProperties": false
    },
    "ask_files": {
      "type": "object",
      "properties": {
        "files": {
          "$ref": "#/$defs/files"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        }
      },
      "required": [
        "files",
        "reason"
      ],
      "additionalProperties": false
    },
    "resume": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "task": {
          "$ref": "#/$defs/spawn/properties/task"
        },
        "files": {
          "$comment": "Replace the grant of the child for the follow-up task.",
          "$ref": "#/$defs/files"
        },
        "timeout_secs": {
          "$ref": "#/$defs/wait/properties/timeout_secs"
        }
      },
      "required": [
        "session_id",
        "task"
      ],
      "additionalProperties": false
    },
    "route": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "model",
        "provider"
      ],
      "additionalProperties": false
    },
    "role": {
      "description": "Choose the role by the result that you need: facts, changed files, a pass or fail, or findings.",
      "$comment": "A role is a label for people and the leader. It sets no tool, file or model limit. The TUI writes the role name. The Companion draws a Lucide icon for each role.",
      "oneOf": [
        {
          "const": "research",
          "title": "Finds facts",
          "description": "Finds facts. Reads code, docs, logs and history, and answers one question with evidence. Use it before you decide or plan."
        },
        {
          "const": "implement",
          "title": "Changes files",
          "description": "Changes files. Writes code, tests, docs or configuration and runs the checks for its change. Use it for one bounded change."
        },
        {
          "const": "verify",
          "title": "Proves it works",
          "description": "Proves that something works. Runs tests, reproduces a bug or checks the app, and reports pass or fail with evidence."
        },
        {
          "const": "audit",
          "title": "Judges the work",
          "description": "Judges finished work. Reviews a change, plan or release for risks and mistakes, and reports findings. Give it the work, not your conclusion."
        }
      ]
    },
    "model_pair": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "provider",
        "model"
      ],
      "additionalProperties": false
    },
    "files": {
      "$comment": "A subagent file grant. Each rule is a path or a glob, absolute, ~ or relative to the parent's workspace root. Rules also cover files that do not exist yet. deny wins over read_only, and read_only wins over write. With write rules, the child writes only there. An empty or missing list adds no rules.",
      "type": "object",
      "properties": {
        "write": {
          "$ref": "#/$defs/file_rules"
        },
        "read_only": {
          "$ref": "#/$defs/file_rules"
        },
        "deny": {
          "$ref": "#/$defs/file_rules"
        }
      },
      "additionalProperties": false
    },
    "file_rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "\\S"
      },
      "maxItems": 64,
      "uniqueItems": true
    },
    "agent": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "parent_id": {
          "type": "string",
          "minLength": 1
        },
        "leader_id": {
          "type": "string",
          "minLength": 1
        },
        "team_id": {
          "type": "string",
          "minLength": 1
        },
        "task": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "completed",
            "failed",
            "cancelled",
            "budget_limited"
          ]
        },
        "iteration_budget": {
          "$ref": "#/$defs/spawn/properties/iteration_budget"
        },
        "iterations_used": {
          "type": "integer",
          "minimum": 0
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "routing_locked": {
          "type": "boolean"
        },
        "pending_input": {
          "type": "boolean"
        },
        "pending_input_count": {
          "type": "integer",
          "minimum": 0
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "question_entry_id": {
          "type": "integer",
          "minimum": 1
        },
        "budget_request": {
          "type": "object",
          "properties": {
            "iterations": {
              "type": "integer",
              "minimum": 1
            },
            "reason": {
              "type": "string"
            }
          }
        },
        "files_request": {
          "type": "object",
          "properties": {
            "files": {
              "$ref": "#/$defs/files"
            },
            "reason": {
              "type": "string"
            }
          }
        },
        "activity": {
          "$comment": "The latest Activity line of a queued or running agent, such as Patched ~/src/a.clj.",
          "type": "string",
          "minLength": 1
        },
        "usage": {
          "type": [
            "object",
            "null"
          ]
        },
        "files": {
          "$ref": "#/$defs/files"
        }
      },
      "required": [
        "session_id",
        "parent_id",
        "leader_id",
        "team_id",
        "task",
        "status",
        "iteration_budget",
        "iterations_used"
      ],
      "additionalProperties": true
    },
    "record": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "asking",
            "held",
            "completed",
            "failed",
            "cancelled",
            "budget_limited",
            "lost",
            "unknown"
          ]
        },
        "answer": {
          "type": [
            "string",
            "null"
          ]
        },
        "question": {
          "type": [
            "string",
            "null"
          ]
        },
        "question_entry_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "budget_request": {
          "type": "object",
          "properties": {
            "iterations": {
              "type": "integer",
              "minimum": 1
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "iterations"
          ],
          "additionalProperties": false
        },
        "files_request": {
          "type": "object",
          "properties": {
            "files": {
              "$ref": "#/$defs/files"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "files"
          ],
          "additionalProperties": false
        },
        "files": {
          "$ref": "#/$defs/files"
        },
        "iteration_budget": {
          "$ref": "#/$defs/spawn/properties/iteration_budget"
        },
        "iterations_used": {
          "type": "integer",
          "minimum": 0
        },
        "activity": {
          "description": "The latest Activity line of a running child.",
          "type": "string"
        },
        "notes": {
          "description": "The new progress notes of a running child since the last wait.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "messages": {
          "description": "The new Council messages of a running child since the last wait.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "entry_id": {
                "type": "integer",
                "minimum": 1
              },
              "kind": {
                "type": "string"
              },
              "content": {
                "type": "string"
              }
            },
            "required": [
              "entry_id",
              "kind",
              "content"
            ],
            "additionalProperties": false
          }
        },
        "step_secs": {
          "description": "The seconds that a running child is in its current step.",
          "type": "integer",
          "minimum": 0
        },
        "elapsed_secs": {
          "description": "The seconds since a running child started its current task.",
          "type": "integer",
          "minimum": 0
        },
        "alerts": {
          "description": "For a running child: slow_step after 300 s in one step, errors for three failed steps of the last five, budget at 80% of the iteration budget.",
          "type": "array",
          "items": {
            "enum": [
              "slow_step",
              "errors",
              "budget"
            ]
          }
        },
        "warning": {
          "type": "string"
        },
        "error": {
          "description": "Why a failed child stopped. Code rate_limited means a 429 from its provider.",
          "type": "object",
          "properties": {
            "code": {
              "enum": [
                "rate_limited"
              ]
            },
            "message": {
              "type": "string"
            },
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        },
        "alternatives": {
          "description": "Working provider and model routes for a new child, outside a rate-limit or authentication cooldown.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/model_pair"
          }
        }
      },
      "required": [
        "session_id",
        "status"
      ],
      "additionalProperties": false
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  }
}
