{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract.blockether.com/vis/schema/agents.json",
  "$ref": "#/$defs/agent",
  "x-vis-max-team-children": 128,
  "x-vis-max-active-children": 16,
  "$comment": "Child-count limits are enforced against persisted team and leader state, not one agent payload.",
  "$defs": {
    "spawn": {
      "type": "object",
      "properties": {
        "task": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "\\S"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "iteration_budget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600,
          "default": 120
        },
        "allowed_models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/model_pair"
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        },
        "files": {
          "$ref": "#/$defs/files"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "task"
      ],
      "dependentRequired": {
        "model": [
          "provider"
        ],
        "provider": [
          "model"
        ]
      },
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "properties": {
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/spawn/properties/task"
              },
              {
                "type": "object",
                "properties": {
                  "task": {
                    "$ref": "#/$defs/spawn/properties/task"
                  },
                  "model": {
                    "$ref": "#/$defs/spawn/properties/model"
                  },
                  "provider": {
                    "$ref": "#/$defs/spawn/properties/provider"
                  },
                  "iteration_budget": {
                    "$ref": "#/$defs/spawn/properties/iteration_budget"
                  },
                  "files": {
                    "$ref": "#/$defs/spawn/properties/files"
                  }
                },
                "required": [
                  "task"
                ],
                "dependentRequired": {
                  "model": [
                    "provider"
                  ],
                  "provider": [
                    "model"
                  ]
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "timeout_secs": {
          "$ref": "#/$defs/wait/properties/timeout_secs"
        }
      },
      "required": [
        "tasks"
      ],
      "additionalProperties": false
    },
    "wait": {
      "type": "object",
      "properties": {
        "session_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "timeout_secs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800,
          "default": 240
        }
      },
      "additionalProperties": false
    },
    "list": {
      "type": "object",
      "additionalProperties": false
    },
    "cancel": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "session_id"
      ],
      "additionalProperties": false
    },
    "extend": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        }
      },
      "required": [
        "session_id",
        "iterations"
      ],
      "additionalProperties": false
    },
    "deny": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        }
      },
      "required": [
        "session_id",
        "reason"
      ],
      "additionalProperties": false
    },
    "grant": {
      "$comment": "Add file rules to the grant of a subagent. A child without write rules writes only the granted rules after a write grant.",
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "$ref": "#/$defs/files"
        }
      },
      "required": [
        "session_id",
        "files"
      ],
      "additionalProperties": false
    },
    "ask_files": {
      "type": "object",
      "properties": {
        "files": {
          "$ref": "#/$defs/files"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        }
      },
      "required": [
        "files",
        "reason"
      ],
      "additionalProperties": false
    },
    "resume": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "task": {
          "$ref": "#/$defs/spawn/properties/task"
        },
        "timeout_secs": {
          "$ref": "#/$defs/wait/properties/timeout_secs"
        }
      },
      "required": [
        "session_id",
        "task"
      ],
      "additionalProperties": false
    },
    "route": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "model",
        "provider"
      ],
      "additionalProperties": false
    },
    "model_pair": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "provider",
        "model"
      ],
      "additionalProperties": false
    },
    "files": {
      "$comment": "A subagent file grant. Each rule is a path or a glob, absolute, ~ or relative to the parent's workspace root. Rules also cover files that do not exist yet. deny wins over read_only, and read_only wins over write. With write rules, the child writes only there. An empty or missing list adds no rules.",
      "type": "object",
      "properties": {
        "write": {
          "$ref": "#/$defs/file_rules"
        },
        "read_only": {
          "$ref": "#/$defs/file_rules"
        },
        "deny": {
          "$ref": "#/$defs/file_rules"
        }
      },
      "additionalProperties": false
    },
    "file_rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "\\S"
      },
      "maxItems": 64,
      "uniqueItems": true
    },
    "agent": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "parent_id": {
          "type": "string",
          "minLength": 1
        },
        "leader_id": {
          "type": "string",
          "minLength": 1
        },
        "team_id": {
          "type": "string",
          "minLength": 1
        },
        "task": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "completed",
            "failed",
            "cancelled",
            "budget_limited"
          ]
        },
        "iteration_budget": {
          "$ref": "#/$defs/spawn/properties/iteration_budget"
        },
        "iterations_used": {
          "type": "integer",
          "minimum": 0
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "routing_locked": {
          "type": "boolean"
        },
        "pending_input": {
          "type": "boolean"
        },
        "pending_input_count": {
          "type": "integer",
          "minimum": 0
        },
        "usage": {
          "type": [
            "object",
            "null"
          ]
        },
        "files": {
          "$ref": "#/$defs/files"
        }
      },
      "required": [
        "session_id",
        "parent_id",
        "leader_id",
        "team_id",
        "task",
        "status",
        "iteration_budget",
        "iterations_used"
      ],
      "additionalProperties": true
    },
    "record": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "asking",
            "held",
            "completed",
            "failed",
            "cancelled",
            "budget_limited",
            "lost",
            "unknown"
          ]
        },
        "answer": {
          "type": [
            "string",
            "null"
          ]
        },
        "question": {
          "type": [
            "string",
            "null"
          ]
        },
        "question_entry_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "budget_request": {
          "type": "object",
          "properties": {
            "iterations": {
              "type": "integer",
              "minimum": 1
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "iterations"
          ],
          "additionalProperties": false
        },
        "files_request": {
          "type": "object",
          "properties": {
            "files": {
              "$ref": "#/$defs/files"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "files"
          ],
          "additionalProperties": false
        },
        "files": {
          "$ref": "#/$defs/files"
        },
        "iteration_budget": {
          "$ref": "#/$defs/spawn/properties/iteration_budget"
        },
        "iterations_used": {
          "type": "integer",
          "minimum": 0
        },
        "warning": {
          "type": "string"
        },
        "error": {
          "description": "Why a failed child stopped. Code rate_limited means a 429 from its provider.",
          "type": "object",
          "properties": {
            "code": {
              "enum": [
                "rate_limited"
              ]
            },
            "message": {
              "type": "string"
            },
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        },
        "alternatives": {
          "description": "Working provider and model routes for a new child, outside a rate-limit or authentication cooldown.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/model_pair"
          }
        }
      },
      "required": [
        "session_id",
        "status"
      ],
      "additionalProperties": false
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  }
}
