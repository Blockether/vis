{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract.blockether.com/vis/schema/common.json",
  "title": "Shared contract definitions",
  "description": "Shared scalar constraints referenced by Vis payload schemas.",
  "$defs": {
    "non_blank_string": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "snake_case_id": {
      "description": "A canonical snake_case identifier.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    }
  }
}
