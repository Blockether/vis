{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract.blockether.com/vis/schema/activity.json",
  "title": "Activity contract",
  "$defs": {
    "presenter": {
      "type": "string",
      "enum": [
        "generic",
        "shell",
        "tests",
        "patch",
        "observation",
        "lint",
        "repl",
        "format",
        "list"
      ]
    },
    "signal": {
      "type": "string",
      "enum": [
        "generic",
        "observation",
        "mutation",
        "verification"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "idle",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "text_format": {
      "type": "string",
      "enum": [
        "inline",
        "markdown"
      ]
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "presenter": {
          "$ref": "#/$defs/presenter"
        },
        "label": {
          "type": "string",
          "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$",
          "maxLength": 96
        },
        "show_start": {
          "type": "boolean",
          "default": true
        }
      },
      "required": [
        "presenter"
      ]
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "pattern": "\\S"
        },
        "id": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "type",
        "id"
      ]
    },
    "diff_line": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "header",
            "hunk",
            "context",
            "addition",
            "deletion"
          ]
        },
        "text": {
          "type": "string",
          "x-vis-truncate-bytes": 512
        },
        "is_redacted": {
          "const": true
        }
      },
      "required": [
        "kind",
        "text"
      ]
    },
    "evidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "arguments",
                "result",
                "error"
              ]
            },
            "text": {
              "type": "string",
              "x-vis-truncate-bytes": 2048
            }
          },
          "required": [
            "kind",
            "text"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "diff"
            },
            "text": {
              "type": "string"
            },
            "lines": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/diff_line"
              }
            },
            "additions": {
              "type": "integer",
              "minimum": 0
            },
            "deletions": {
              "type": "integer",
              "minimum": 0
            },
            "modifications": {
              "type": "integer",
              "minimum": 0
            },
            "is_truncated": {
              "type": "boolean"
            },
            "is_redacted": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "text",
            "lines",
            "additions",
            "deletions",
            "modifications",
            "is_truncated",
            "is_redacted"
          ]
        }
      ]
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "\\S"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "operation": {
          "type": "string",
          "pattern": "\\S",
          "x-vis-group-labels": {
            "cat": "Read",
            "patch": "Patch",
            "shell": "Shell",
            "grep": "Search",
            "ls": "List"
          }
        },
        "presenter": {
          "$ref": "#/$defs/presenter"
        },
        "signal": {
          "$ref": "#/$defs/signal"
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "summary": {
          "type": "string"
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          },
          "maxItems": 8
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "argument_key": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "read_key": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "group_token": {
          "type": "string",
          "pattern": "\\S"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "result_summary": {
          "type": "string"
        },
        "error_summary": {
          "type": "string"
        },
        "summary_format": {
          "$ref": "#/$defs/text_format"
        },
        "result_format": {
          "$ref": "#/$defs/text_format"
        },
        "is_truncated": {
          "const": true
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/row1"
          }
        },
        "presentation": {
          "$ref": "#/$defs/presentation"
        },
        "handle_id": {
          "$ref": "#/$defs/handle_id"
        }
      },
      "required": [
        "id",
        "sequence",
        "operation",
        "presenter",
        "signal",
        "state",
        "summary",
        "resources",
        "evidence"
      ]
    },
    "row1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "\\S"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "operation": {
          "type": "string",
          "pattern": "\\S"
        },
        "presenter": {
          "$ref": "#/$defs/presenter"
        },
        "signal": {
          "$ref": "#/$defs/signal"
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "summary": {
          "type": "string"
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          },
          "maxItems": 8
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "argument_key": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "read_key": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "group_token": {
          "type": "string",
          "pattern": "\\S"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "result_summary": {
          "type": "string"
        },
        "error_summary": {
          "type": "string"
        },
        "summary_format": {
          "$ref": "#/$defs/text_format"
        },
        "result_format": {
          "$ref": "#/$defs/text_format"
        },
        "is_truncated": {
          "const": true
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/row2"
          }
        },
        "presentation": {
          "$ref": "#/$defs/presentation"
        },
        "handle_id": {
          "$ref": "#/$defs/handle_id"
        }
      },
      "required": [
        "id",
        "sequence",
        "operation",
        "presenter",
        "signal",
        "state",
        "summary",
        "resources",
        "evidence"
      ]
    },
    "row2": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "\\S"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "operation": {
          "type": "string",
          "pattern": "\\S"
        },
        "presenter": {
          "$ref": "#/$defs/presenter"
        },
        "signal": {
          "$ref": "#/$defs/signal"
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "summary": {
          "type": "string"
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          },
          "maxItems": 8
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "argument_key": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "read_key": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "group_token": {
          "type": "string",
          "pattern": "\\S"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "result_summary": {
          "type": "string"
        },
        "error_summary": {
          "type": "string"
        },
        "summary_format": {
          "$ref": "#/$defs/text_format"
        },
        "result_format": {
          "$ref": "#/$defs/text_format"
        },
        "is_truncated": {
          "const": true
        },
        "presentation": {
          "$ref": "#/$defs/presentation"
        },
        "handle_id": {
          "$ref": "#/$defs/handle_id"
        }
      },
      "required": [
        "id",
        "sequence",
        "operation",
        "presenter",
        "signal",
        "state",
        "summary",
        "resources",
        "evidence"
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "running": {
          "type": "integer",
          "minimum": 0
        },
        "succeeded": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "cancelled": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "omitted": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rows": {
          "type": "integer",
          "minimum": 0
        },
        "by_classification": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/signal"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "required": [
        "rows",
        "by_classification"
      ]
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "$ref": "#/$defs/state"
        },
        "counts": {
          "$ref": "#/$defs/counts"
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/row"
          }
        },
        "omitted": {
          "$ref": "#/$defs/omitted"
        },
        "history": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "after": {
              "type": "integer",
              "minimum": 0
            },
            "next_after": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          },
          "required": [
            "id",
            "revision",
            "total",
            "after",
            "next_after"
          ],
          "x-vis-max-page-rows": 32,
          "x-vis-page-target-bytes": 1048576
        }
      },
      "required": [
        "state",
        "counts",
        "rows",
        "omitted"
      ],
      "x-vis-max-event-bytes": 262144
    },
    "content": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "heading"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "text"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "text"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "text"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "markdown"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "text"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "code"
              },
              "text": {
                "type": "string"
              },
              "language": {
                "type": "string",
                "maxLength": 256
              }
            },
            "required": [
              "type",
              "text"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "diff"
              },
              "text": {
                "type": "string"
              },
              "language": {
                "type": "string",
                "maxLength": 256
              }
            },
            "required": [
              "type",
              "text"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "table"
              },
              "columns": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "type",
              "columns",
              "rows"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "image"
              },
              "attachment_id": {
                "type": "string",
                "pattern": "\\S",
                "maxLength": 256
              },
              "label": {
                "type": "string",
                "maxLength": 256
              }
            },
            "required": [
              "type",
              "attachment_id",
              "label"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "video"
              },
              "attachment_id": {
                "type": "string",
                "pattern": "\\S",
                "maxLength": 256
              },
              "label": {
                "type": "string",
                "maxLength": 256
              }
            },
            "required": [
              "type",
              "attachment_id",
              "label"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "audio"
              },
              "attachment_id": {
                "type": "string",
                "pattern": "\\S",
                "maxLength": 256
              },
              "label": {
                "type": "string",
                "maxLength": 256
              }
            },
            "required": [
              "type",
              "attachment_id",
              "label"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "file"
              },
              "attachment_id": {
                "type": "string",
                "pattern": "\\S",
                "maxLength": 256
              },
              "label": {
                "type": "string",
                "maxLength": 256
              }
            },
            "required": [
              "type",
              "attachment_id",
              "label"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "progress"
              },
              "label": {
                "type": "string",
                "maxLength": 256
              },
              "value": {
                "type": "number",
                "minimum": 0
              },
              "total": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "type",
              "label"
            ],
            "dependentRequired": {
              "value": [
                "total"
              ],
              "total": [
                "value"
              ]
            }
          }
        ]
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f\\u2028\\u2029]+$"
        },
        "summary": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f\\u2028\\u2029]*$",
          "x-vis-max-bytes": 512
        },
        "summary_format": {
          "$ref": "#/$defs/text_format"
        },
        "content": {
          "$ref": "#/$defs/content"
        }
      },
      "required": [
        "headline",
        "summary",
        "content"
      ]
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headline": {
          "$ref": "#/$defs/section/properties/headline"
        },
        "summary": {
          "$ref": "#/$defs/section/properties/summary"
        },
        "summary_format": {
          "$ref": "#/$defs/section/properties/summary_format"
        },
        "content": {
          "$ref": "#/$defs/content"
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          }
        },
        "handle_id": {
          "$ref": "#/$defs/handle_id"
        }
      },
      "required": [
        "headline",
        "summary",
        "content"
      ]
    },
    "handle_id": {
      "type": "string",
      "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$",
      "maxLength": 256,
      "x-vis-max-bytes": 512
    }
  },
  "$ref": "#/$defs/projection"
}
