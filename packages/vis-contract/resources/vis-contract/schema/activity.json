{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract.blockether.com/vis/schema/activity.json",
  "title": "Activity contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "operation_groups": {"const": {"cat": "Read", "patch": "Patch", "shell": "Shell", "grep": "Search", "ls": "List", "run_tests": "Test", "lint_code": "Lint", "format_code": "Format", "repl_eval": "Eval"}},
    "version": {
      "const": 1
    },
    "event": {
      "const": "block.activity"
    },
    "presenters": {
      "const": [
        "generic",
        "shell",
        "tests",
        "patch",
        "observation",
        "lint",
        "repl",
        "format",
        "list"
      ]
    },
    "signals": {
      "const": [
        "generic",
        "observation",
        "mutation",
        "verification"
      ]
    },
    "states": {
      "const": [
        "idle",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "text_formats": {
      "const": [
        "inline",
        "markdown"
      ]
    },
    "limits": {
      "const": {
        "max_rows": 128,
        "max_depth": 2,
        "max_resources": 8,
        "max_receipt_bytes": 65536,
        "max_summary_bytes": 512,
        "max_detail_bytes": 2048,
        "max_event_bytes": 262144,
        "max_diff_line_bytes": 512
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ownership": {
          "type": "string",
          "pattern": "\\S"
        },
        "delivery": {
          "type": "string",
          "pattern": "\\S"
        },
        "lifecycle": {
          "type": "string",
          "pattern": "\\S"
        },
        "counts": {
          "type": "string",
          "pattern": "\\S"
        },
        "bounds": {
          "type": "string",
          "pattern": "\\S"
        },
        "declaration": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "ownership",
        "delivery",
        "lifecycle",
        "counts",
        "bounds",
        "declaration"
      ]
    }
  },
  "required": [
    "operation_groups",
    "version",
    "event",
    "presenters",
    "signals",
    "states",
    "text_formats",
    "limits",
    "semantics"
  ],
  "$defs": {
    "presenter": {
      "type": "string",
      "enum": [
        "generic",
        "shell",
        "tests",
        "patch",
        "observation",
        "lint",
        "repl",
        "format",
        "list"
      ]
    },
    "signal": {
      "type": "string",
      "enum": [
        "generic",
        "observation",
        "mutation",
        "verification"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "idle",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "text_format": {
      "type": "string",
      "enum": [
        "inline",
        "markdown"
      ]
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "presenter": {
          "$ref": "#/$defs/presenter"
        },
        "label": {
          "type": "string",
          "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$",
          "maxLength": 96
        }
      },
      "required": [
        "presenter"
      ]
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "pattern": "\\S"
        },
        "id": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "type",
        "id"
      ]
    },
    "diff_line": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "header",
            "hunk",
            "context",
            "addition",
            "deletion"
          ]
        },
        "text": {
          "type": "string"
        },
        "is_redacted": {
          "const": true
        }
      },
      "required": [
        "kind",
        "text"
      ]
    },
    "evidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "arguments",
                "result",
                "error"
              ]
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "diff"
            },
            "text": {
              "type": "string"
            },
            "lines": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/diff_line"
              }
            },
            "additions": {
              "type": "integer",
              "minimum": 0
            },
            "deletions": {
              "type": "integer",
              "minimum": 0
            },
            "modifications": {
              "type": "integer",
              "minimum": 0
            },
            "is_truncated": {
              "type": "boolean"
            },
            "is_redacted": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "text",
            "lines",
            "additions",
            "deletions",
            "modifications",
            "is_truncated",
            "is_redacted"
          ]
        }
      ]
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "\\S"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "operation": {
          "type": "string",
          "pattern": "\\S"
        },
        "presenter": {
          "$ref": "#/$defs/presenter"
        },
        "signal": {
          "$ref": "#/$defs/signal"
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "summary": {
          "type": "string"
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          },
          "maxItems": 8
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "group_token": {
          "type": "string",
          "pattern": "\\S"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "result_summary": {
          "type": "string"
        },
        "error_summary": {
          "type": "string"
        },
        "summary_format": {
          "$ref": "#/$defs/text_format"
        },
        "result_format": {
          "$ref": "#/$defs/text_format"
        },
        "is_truncated": {
          "const": true
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/row1"
          }
        },
        "presentation": {
          "$ref": "#/$defs/presentation"
        }
      },
      "required": [
        "id",
        "sequence",
        "operation",
        "presenter",
        "signal",
        "state",
        "summary",
        "resources",
        "evidence"
      ]
    },
    "row1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "\\S"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "operation": {
          "type": "string",
          "pattern": "\\S"
        },
        "presenter": {
          "$ref": "#/$defs/presenter"
        },
        "signal": {
          "$ref": "#/$defs/signal"
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "summary": {
          "type": "string"
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          },
          "maxItems": 8
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "group_token": {
          "type": "string",
          "pattern": "\\S"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "result_summary": {
          "type": "string"
        },
        "error_summary": {
          "type": "string"
        },
        "summary_format": {
          "$ref": "#/$defs/text_format"
        },
        "result_format": {
          "$ref": "#/$defs/text_format"
        },
        "is_truncated": {
          "const": true
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/row2"
          }
        },
        "presentation": {
          "$ref": "#/$defs/presentation"
        }
      },
      "required": [
        "id",
        "sequence",
        "operation",
        "presenter",
        "signal",
        "state",
        "summary",
        "resources",
        "evidence"
      ]
    },
    "row2": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "\\S"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "operation": {
          "type": "string",
          "pattern": "\\S"
        },
        "presenter": {
          "$ref": "#/$defs/presenter"
        },
        "signal": {
          "$ref": "#/$defs/signal"
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "summary": {
          "type": "string"
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          },
          "maxItems": 8
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "group_token": {
          "type": "string",
          "pattern": "\\S"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "result_summary": {
          "type": "string"
        },
        "error_summary": {
          "type": "string"
        },
        "summary_format": {
          "$ref": "#/$defs/text_format"
        },
        "result_format": {
          "$ref": "#/$defs/text_format"
        },
        "is_truncated": {
          "const": true
        },
        "presentation": {
          "$ref": "#/$defs/presentation"
        }
      },
      "required": [
        "id",
        "sequence",
        "operation",
        "presenter",
        "signal",
        "state",
        "summary",
        "resources",
        "evidence"
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "running": {
          "type": "integer",
          "minimum": 0
        },
        "succeeded": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "cancelled": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "omitted": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rows": {
          "type": "integer",
          "minimum": 0
        },
        "by_classification": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/signal"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "required": [
        "rows",
        "by_classification"
      ]
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "$ref": "#/$defs/state"
        },
        "counts": {
          "$ref": "#/$defs/counts"
        },
        "rows": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/row"
          }
        },
        "omitted": {
          "$ref": "#/$defs/omitted"
        }
      },
      "required": [
        "state",
        "counts",
        "rows",
        "omitted"
      ]
    },
    "content": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "heading"
              },
              "text": {
                "type": "string",
                "maxLength": 16384
              }
            },
            "required": [
              "type",
              "text"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "text"
              },
              "text": {
                "type": "string",
                "maxLength": 16384
              }
            },
            "required": [
              "type",
              "text"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "markdown"
              },
              "text": {
                "type": "string",
                "maxLength": 16384
              }
            },
            "required": [
              "type",
              "text"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "code"
              },
              "text": {
                "type": "string",
                "maxLength": 16384
              },
              "language": {
                "type": "string",
                "maxLength": 256
              }
            },
            "required": [
              "type",
              "text"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "diff"
              },
              "text": {
                "type": "string",
                "maxLength": 16384
              },
              "language": {
                "type": "string",
                "maxLength": 256
              }
            },
            "required": [
              "type",
              "text"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "table"
              },
              "columns": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "string",
                  "maxLength": 256
                }
              },
              "rows": {
                "type": "array",
                "maxItems": 200,
                "items": {
                  "type": "array",
                  "maxItems": 16,
                  "items": {
                    "type": "string",
                    "maxLength": 256
                  }
                }
              }
            },
            "required": [
              "type",
              "columns",
              "rows"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "image"
              },
              "attachment_id": {
                "type": "string",
                "pattern": "\\S",
                "maxLength": 256
              },
              "label": {
                "type": "string",
                "maxLength": 256
              }
            },
            "required": [
              "type",
              "attachment_id",
              "label"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "video"
              },
              "attachment_id": {
                "type": "string",
                "pattern": "\\S",
                "maxLength": 256
              },
              "label": {
                "type": "string",
                "maxLength": 256
              }
            },
            "required": [
              "type",
              "attachment_id",
              "label"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "audio"
              },
              "attachment_id": {
                "type": "string",
                "pattern": "\\S",
                "maxLength": 256
              },
              "label": {
                "type": "string",
                "maxLength": 256
              }
            },
            "required": [
              "type",
              "attachment_id",
              "label"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "file"
              },
              "attachment_id": {
                "type": "string",
                "pattern": "\\S",
                "maxLength": 256
              },
              "label": {
                "type": "string",
                "maxLength": 256
              }
            },
            "required": [
              "type",
              "attachment_id",
              "label"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "progress"
              },
              "label": {
                "type": "string",
                "maxLength": 256
              },
              "value": {
                "type": "number",
                "minimum": 0
              },
              "total": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "type",
              "label"
            ],
            "dependentRequired": {
              "value": [
                "total"
              ],
              "total": [
                "value"
              ]
            }
          }
        ]
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f\\u2028\\u2029]+$"
        },
        "summary": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f\\u2028\\u2029]*$"
        },
        "content": {
          "$ref": "#/$defs/content"
        }
      },
      "required": [
        "headline",
        "summary",
        "content"
      ]
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f\\u2028\\u2029]+$"
        },
        "summary": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f\\u2028\\u2029]*$"
        },
        "content": {
          "$ref": "#/$defs/content"
        },
        "sections": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/section"
          }
        }
      },
      "required": [
        "headline",
        "summary",
        "content"
      ]
    }
  }
}
