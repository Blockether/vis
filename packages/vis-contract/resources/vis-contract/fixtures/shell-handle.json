{
  "description": "ShellTask and ShellResult rules. Each case starts a shell with `args` and `kwargs`, then runs `steps` as Python. The steps see `sh` (the handle), `view`, and `door` (the call that started the shell) and put the result in `answer`. `expect` is the answer of `vis.shell` in the engine. The engine test `shell-handle-contract-test` runs each case in a real extension worker through `vis.shell` and `vis.tools.shell`. Both return an SDK Future. The SDK test `test_shell_contract.py` runs each case on the host outside Vis. Where one door answers differently, the case has a `tools` or `outside` object with a `reason` (a key of `exceptions`) and its own `expect`. The Python `runner` also accepts a sandbox ShellTask. A handle id in an answer shows as '<id>'.",
  "exceptions": {
    "pipe": "Outside Vis, a child process has pipes and no terminal. A line ends with one byte, typed text has no echo, `type` needs a command that started with `stdin: tty`, and Ctrl-D does not end the input.",
    "sh": "Outside Vis, the command runs with `/bin/sh -c`. The engine runs it with `bash -lc`.",
    "op-key": "The answer of the `shell` tool has the `op` key. The SDK handle does not have it.",
    "local": "Outside Vis, no session holds the shell. `attach` is empty, `note` says that the command is a local process, and `keys` is empty after `type`.",
    "roots": "`vis.tools.shell` is the `shell` tool of the model. It keeps the working directory in the filesystem roots of the session, and it checks that first.",
    "other-origin": "Outside Vis, there is no second active session tool with a separate trust origin."
  },
  "runner": [
    "import asyncio",
    "from concurrent.futures import CancelledError, wait",
    "import json",
    "import time",
    "",
    "FIELDS = (\"out\", \"offset\", \"next_offset\", \"is_eof\", \"out_omitted_chars\")",
    "",
    "",
    "def view(page, *names):",
    "    return [page[name] for name in names or FIELDS]",
    "",
    "",
    "def until(sh, text):",
    "    # Wait for `text` in the log, so that a step does not race the program.",
    "    for _ in range(400):",
    "        if text in sh.logs()[\"out\"]:",
    "            return",
    "        time.sleep(0.05)",
    "    raise AssertionError(f\"the log never showed {text!r}\")",
    "",
    "",
    "def finish(sh, seconds=30):",
    "    if wait([sh], timeout=seconds).not_done:",
    "        raise TimeoutError()",
    "    return sh.result()",
    "",
    "",
    "def refusal(error):",
    "    text = error.args[0] if isinstance(error, KeyError) and error.args else str(error)",
    "    return {\"error\": str(text), \"is_runtime_error\": isinstance(error, RuntimeError)}",
    "",
    "",
    "def masked(value, token):",
    "    if isinstance(value, str):",
    "        return value.replace(token, \"'<id>'\")",
    "    if isinstance(value, list):",
    "        return [masked(item, token) for item in value]",
    "    if isinstance(value, dict):",
    "        return {key: masked(item, token) for key, item in value.items()}",
    "    return value",
    "",
    "",
    "def drive(door, case, other_door=None):",
    "    try:",
    "        sh = door(*case.get(\"args\", []), **case.get(\"kwargs\", {}))",
    "    except Exception as error:",
    "        return refusal(error)",
    "    token = \"'\" + str(sh.get(\"id\")) + \"'\"",
    "    scope = {\"asyncio\": asyncio, \"CancelledError\": CancelledError, \"sh\": sh, \"view\": view, \"door\": door, \"until\": until, \"finish\": finish, \"other_door\": other_door, \"wait\": wait}",
    "    try:",
    "        exec(\"\\n\".join(case[\"steps\"]), scope)",
    "        answer = scope.get(\"answer\")",
    "    except Exception as error:",
    "        answer = refusal(error)",
    "    finally:",
    "        if hasattr(sh, \"cancel\") and not sh.done():",
    "            sh.cancel()",
    "            if wait([sh], timeout=10).not_done:",
    "                raise AssertionError(\"the previous shell did not stop\")",
    "    return masked(json.loads(json.dumps(answer)), token)"
  ],
