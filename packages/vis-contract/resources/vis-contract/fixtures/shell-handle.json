      "name": "a bounded observation does not cancel a command",
      "steps": [
        "until(sh, 'ready')",
        "async def observe():",
        "    done, pending = await asyncio.wait([sh], timeout=0.02)",
        "    current = [not done, pending == {sh}, sh.cancelled(), sh.snapshot().out]",
        "    sh.type('finish')",
        "    done, pending = await asyncio.wait([sh], timeout=5)",
        "    final = await sh",
        "    return current + [done == {sh}, not pending, final.exit, sh.out.endswith('readyfinish')]",
        "answer = asyncio.run(observe())"
      ],
