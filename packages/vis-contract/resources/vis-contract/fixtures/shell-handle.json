        "exited"
      ],
      "outside": {
        "reason": "pipe",
        "expect": [
          false,
          true,
          "running"
        ]
      },
      "args": [
        "cat; echo ended"
      ],
      "kwargs": {
        "stdin": "tty"
      }
    },
    {
      "name": "attach to the live generation without starting a command",
      "steps": [
        "attached = door(op=\"attach\", id=sh[\"id\"])",
        "answer = [attached[\"pid\"] == sh[\"pid\"], attached[\"stage\"], attached[\"already_running\"], attached.cancel()]"
      ],
      "expect": [
        true,
        "run",
        true,
        true
      ],
      "args": [
        "sleep 30"
      ]
    },
    {
      "name": "refuse to attach after exit",
      "steps": [
        "finish(sh)",
        "door(op=\"attach\", id=sh[\"id\"])"
      ],
      "expect": {
        "error": "No running background shell '<id>' in this session.",
        "is_runtime_error": true
      },
      "args": [
        "true"
      ]
    },
    {
      "name": "refuse to attach from another trust origin",
      "steps": [
        "if other_door is None:",
        "    answer = \"no second trust origin\"",
        "else:",
        "    other_door(op=\"attach\", id=sh[\"id\"])"
      ],
      "expect": {
        "error": "Shell '<id>' was started by a different trust origin.",
        "is_runtime_error": true
      },
      "outside": {
        "reason": "other-origin",
        "expect": "no second trust origin"
      },
      "args": [
        "sleep 30"
      ]
    },
    {
      "name": "live fields do not refresh the start result",
      "args": [
        "printf ready; sleep 30"
      ],
      "steps": [
        "until(sh, 'ready')",
        "answer = [sh.out, sh['out'], sh.get('out'), sh.snapshot().out, sh.out]"
      ],
      "expect": [
        "",
        "",
        "",
        "ready",
        ""
      ]
    },
    {
      "name": "type does not coerce a number to text",
      "args": [
        "cat"
      ],
      "kwargs": {
        "stdin": "tty"
      },
      "steps": [
        "sh.type(123)"
      ],
      "expect": {
        "error": "shell `text` must be a string.",
        "is_runtime_error": false
      }
    },
    {
      "name": "type does not coerce the Enter flag",
      "args": [
        "cat"
      ],
      "kwargs": {
        "stdin": "tty"
      },
      "steps": [
        "sh.type('a', is_enter=1)"
      ],
      "expect": {
        "error": "shell `is_enter` must be a bool.",
        "is_runtime_error": false
      }
    }
  ]
}
