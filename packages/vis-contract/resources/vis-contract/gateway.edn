 :gateway/events
 {;; Events in the session journal / multiplexed session stream.
  :session #{"block.activity" "block.output" "block.preview" "block.started"
             "content.block.completed" "content.block.delta" "content.block.started"
             "context.updated" "iteration.completed" "iteration.error" "provider.retry"
             "queue.paused" "queue.resumed" "session.model_updated" "session.status"
             "session.title_updated" "subscription.ready" "turn.cancelled" "turn.completed"
             "turn.failed" "turn.progress" "turn.queued" "turn.queued.deleted" "turn.queued.drained"
             "turn.queued.updated" "turn.started" "view.close" "view.open" "view.patch"}
  ;; Dedicated speech/voice job SSE streams and relay push payloads.
  :jobs {:synthesize "speech.job" :transcribe "voice.job"}
  :push #{"turn.end"}
  ;; Semantic subsets consumed by every blocking reader / attached queue mirror.
  :turn-terminal #{"turn.cancelled" "turn.completed" "turn.failed"}
  :queue-mirror #{"queue.paused" "queue.resumed" "turn.queued" "turn.queued.deleted"
                  "turn.queued.drained" "turn.queued.updated"}
  ;; One lifecycle for both input and live View kinds.
  :view {:close "view.close" :open "view.open" :patch "view.patch"}}
 :gateway/envelopes
 {:error-response {:body-keys {:error "error"} :error-keys {:message "message" :type "type"}}
  :handshake {:keys {:build "build"
                     :min-client "min_client"
                     :min-gateway "min_gateway"
                     :protocol "protocol"
                     :version "version"}}
  :journal-line {:metadata-keys {:pid "_pid" :producer "_producer" :store "_store"}}
  :session-event
  {:schema 1
   :stamp-keys
   {:schema "schema" :sequence "seq" :session-id "session_id" :timestamp "ts" :type "type"}}
  :settled-turn {:meta-keys ["model" "provider" "llm_selected" "llm_actual" "is_llm_fallback"
                             "llm_routing_trace" "tokens" "cost" "confidence" "eval" "duration_ms"
                             "utilization"]}
  :subscription-ready {:event "subscription.ready"
                       :optional-keys {:latest-iteration "latest_iteration"}
                       :required-keys {:current-turn-id "current_turn_id"
                                       :cursor "cursor"
                                       :is-live "is_live"
                                       :server-time-ms "server_time_ms"
                                       :session-id "session_id"
                                       :type "type"}}}
 ;; Cursor replay starts after the caller's last observed seq. A fresh subscription
 ;; announces readiness; a running-turn replay rewinds to its generation start.
 :gateway/replay {:cursor-header :last-event-id
                  :cursor-key "seq"
                  :generation-start-event "turn.started"
                  :ready-event "subscription.ready"}}
