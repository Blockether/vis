 :gateway/events
 {;; Events in the session journal / multiplexed session stream.
  :session
  #{"block.activity"
    "block.output"
    "block.preview"
    "block.started"
    "content.block.completed"
    "content.block.delta"
    "content.block.started"
    "context.updated"
    "iteration.completed"
    "iteration.error"
    "provider.retry"
    "queue.paused"
    "queue.resumed"
    "session.model_updated"
    "session.status"
    "session.title_updated"
    "subscription.ready"
    "turn.cancelled"
    "turn.completed"
    "turn.failed"
    "turn.progress"
    "turn.queued"
    "turn.queued.deleted"
    "turn.queued.drained"
    "turn.queued.updated"
    "turn.started"
    "view.close"
    "view.open"
    "view.patch"}

  ;; Dedicated speech/voice job SSE streams and relay push payloads.
  :jobs #{"speech.job" "voice.job"}
  :push #{"turn.end"}

  ;; Semantic subsets consumed by every blocking reader / attached queue mirror.
  :turn-terminal #{"turn.cancelled" "turn.completed" "turn.failed"}
  :queue-mirror
  #{"queue.paused"
    "queue.resumed"
    "turn.queued"
    "turn.queued.deleted"
    "turn.queued.drained"
    "turn.queued.updated"}

  ;; One lifecycle for both input and live View kinds.
  :view {:open "view.open" :patch "view.patch" :close "view.close"}}

 ;; Cursor replay starts after the caller's last observed seq. A fresh subscription
 ;; announces readiness; a running-turn replay rewinds to its generation start.
 :gateway/replay
 {:cursor-header :last-event-id
  :cursor-key "seq"
  :ready-event "subscription.ready"
  :generation-start-event "turn.started"}}
