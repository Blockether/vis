{:contract/version 1
 :gateway/protocol {:minimum-client 12 :minimum-gateway 12 :version 12}
 ;; Every header whose spelling is part of the gateway contract. Keys are semantic;
 ;; values are the canonical lower-case Ring/Fetch spelling.
 :gateway/headers {:accept "accept"
                   :authorization "authorization"
                   :client "x-vis-client"
                   :client-id "x-vis-client-id"
                   :client-pid "x-vis-client-pid"
                   :client-version "x-vis-client-version"
                   :content-type "content-type"
                   :etag "etag"
                   :gateway-secret "x-vis-gateway-secret"
                   :if-none-match "if-none-match"
                   :last-event-id "last-event-id"
                   :minimum-gateway-protocol "x-vis-min-gateway-protocol"
                   :protocol "x-vis-protocol"
                   :suppress-registry-recovery "x-vis-suppress-registry-recovery"}
