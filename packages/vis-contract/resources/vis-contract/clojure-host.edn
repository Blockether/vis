    com.blockether.vis.internal.foundation.environment.repositories
    com.blockether.vis.internal.foundation.surface-contract
    com.blockether.vis.internal.gateway.wire com.blockether.vis.internal.git
    com.blockether.vis.internal.header com.blockether.vis.internal.human-input
    com.blockether.vis.internal.human-input.spec com.blockether.vis.internal.iteration
    com.blockether.vis.internal.limits-format com.blockether.vis.internal.oauth
    com.blockether.vis.internal.paths com.blockether.vis.internal.prompt-templates
    com.blockether.vis.internal.provider-error com.blockether.vis.internal.python-project
    com.blockether.vis.internal.python-test-runner com.blockether.vis.internal.render
    com.blockether.vis.internal.runtime-settings com.blockether.vis.internal.test-contract
    com.blockether.vis.internal.theme com.blockether.vis.internal.voice
    com.blockether.vis.internal.workspace}

  ;; Required from `extensions/**/test`. A test may reach deeper than the code it
  ;; covers, but it is still coupling and it is still counted.
  :debt/test
  #{
    com.blockether.vis.internal.attachments com.blockether.vis.internal.config
    com.blockether.vis.internal.env-python com.blockether.vis.internal.extension
