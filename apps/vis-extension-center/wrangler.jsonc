{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vis-extension-center",
  "main": "worker.js",
  "compatibility_date": "2026-02-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/extensions/*",
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vis-extension-center",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "ratelimits": [
    {
      "name": "SUBMISSIONS_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "vars": {
    "TURNSTILE_SITE_KEY": "",
    "DOCS_URL": "https://blockether.github.io/vis/"
  }
}
