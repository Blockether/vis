{
  "name": "vis-companion-relay",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare relay for Companion push notifications.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "node --test test/deploy.test.mjs && vitest run",
    "format:check": "prettier --check test/*.mjs scripts/*.mjs",
    "lint": "eslint test/*.mjs scripts/*.mjs",
    "test:watch": "vitest",
    "dev": "wrangler dev --remote",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "jsonc-parser": "^3.3.1",
    "prettier": "^3.6.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.0.0"
  },
  "overrides": {
    "sharp": "0.35.5",
    "undici": "7.30.1"
  }
}
