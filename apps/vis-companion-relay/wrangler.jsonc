{
  // Push uses sealed grants. Council Rooms uses a separate D1 database.
  // Webhook inboxes (src/hooks) use their own tables in the same database.
  // scripts/prepare-deploy.mjs adds its private binding for migrations and deployment.
  // Grants carry their contents sealed under RELAY_SEAL_KEY (src/seal.ts).
  // Abuse counters live in Cloudflare's rate limiting bindings at the edge.
  //
  // Deploying is three secrets and one command:
  //
  //   wrangler secret put RELAY_SEAL_KEY        # openssl rand -base64 32
  //   wrangler secret put APNS_KEY_P8           # the .p8 PEM, whole file
  //   wrangler secret put FCM_SERVICE_ACCOUNT   # the service-account JSON
  //   npm run deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vis-companion-relay",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "observability": { "enabled": true },
  // Metering without storage. `namespace_id` is any integer unique to the
  // account; `period` may only be 10 or 60 seconds. Counters are kept in the
  // Cloudflare location serving the request, so a refusal costs no write
  // anywhere and cannot be made expensive by flooding it.
  "ratelimits": [
    // Minting is public by design — an app must be able to sign up with no
    // account — so it is the address that pays for it.
    { "name": "MINT_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    // Checked BEFORE a grant is even opened: a flood of forged grants must not
    // buy one decryption each.
    { "name": "PUSH_ADDRESS_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    // Keyed by the DEVICE, not the grant: minting a second grant for the same
    // phone therefore buys no extra pushes to it.
    { "name": "PUSH_DEVICE_LIMIT", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
    // Rooms has separate counters. Presence refresh and inbox reads share these budgets.
    { "name": "ROOMS_ADDRESS_LIMIT", "namespace_id": "1004", "simple": { "limit": 2400, "period": 60 } },
    { "name": "ROOMS_MACHINE_LIMIT", "namespace_id": "1005", "simple": { "limit": 1200, "period": 60 } },
    // Webhook inboxes. Creating an inbox is public, so the address pays for it.
    { "name": "HOOKS_CREATE_LIMIT", "namespace_id": "1006", "simple": { "limit": 5, "period": 60 } },
    // Keyed by the inbox token digest: polls and acknowledgements of one gateway.
    { "name": "HOOKS_INBOX_LIMIT", "namespace_id": "1007", "simple": { "limit": 240, "period": 60 } },
    // Keyed by the inbox, not the sender: GitHub sends from shared addresses.
    { "name": "HOOKS_SENDER_LIMIT", "namespace_id": "1008", "simple": { "limit": 120, "period": 60 } }
  ],
  // The hourly cleanup of expired inbox requests and idle inboxes.
  "triggers": { "crons": ["23 * * * *"] },
  // Public configuration only. Key material is a secret, never a var:
  //   wrangler secret put RELAY_SEAL_KEY / APNS_KEY_P8 / FCM_SERVICE_ACCOUNT
  "vars": {
    "APNS_KEY_ID": "",
    "APNS_TEAM_ID": "",
    "APNS_TOPIC": "",
    "APNS_DEFAULT_ENV": "production",
    "GRANT_TTL_DAYS": "90",
    // The request body cap, in bytes. Cloudflare's own limit is the account
    // plan's (100 MB on Free) and nothing lowers it, and a workers.dev
    // subdomain is not a zone, so no WAF rule runs in front of the Worker:
    // this is the only cap there is. It may only TIGHTEN the 16384 ceiling
    // compiled into src/index.ts — a bigger number changes nothing.
    "MAX_REQUEST_BYTES": "16384"
  }
}
