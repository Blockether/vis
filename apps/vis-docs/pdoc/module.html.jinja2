{% extends "default/module.html.jinja2" %}

{% block head %}<link rel="stylesheet" href="/assets/theme.css">{% endblock %}

{% block body %}
    <a class="api-skip" href="#api-title">Skip to content</a>
    <nav class="pdoc" aria-label="Python SDK">
        <details class="api-navigation" open>
            <summary>Browse Python SDK</summary>
            <div>{{ self.nav() }}</div>
        </details>
    </nav>
    {{ self.content() }}
    <script>{% include "navigation.js" %}</script>
{% endblock %}

{% block module_list_link %}
    <a class="api-home" href="/">Vis documentation</a>
{% endblock %}

{% block nav_title %}<p class="api-label">Python SDK reference</p>{% endblock %}

{% block search_box %}
    <input type="search" placeholder="Find a class or method…" aria-label="Search Python SDK" pattern=".+" required>
    <ul class="api-modules">
        {% for name in all_modules | sort %}
            <li><a href="/python-sdk-api/{{ name.replace('.', '/') }}.html"{% if name == module.modulename %} aria-current="page"{% endif %}>{{ name }}</a></li>
        {% endfor %}
    </ul>
{% endblock %}

{% block nav_submodules %}{% endblock %}

{% block nav_members %}
    {% if module.own_members | rejectattr("kind", "equalto", "module") | list %}
        <h2>API symbols</h2>
        <div class="api-symbols">{{ nav_members(module.own_members) }}</div>
    {% endif %}
{% endblock %}

{% block attribution %}<a class="api-generator" href="https://pdoc.dev/">Generated with pdoc</a>{% endblock %}

{% block module_info %}
    <section class="module-info">
        <h1 id="api-title" tabindex="-1">{{ module.modulename }}</h1>
        {{ docstring(module) }}
    </section>
{% endblock %}

{% block module_contents %}
    {% for m in module.flattened_own_members if is_public(m) | trim %}
        <section id="{{ m.qualname or m.name }}">
            {{ member(m) }}
            {% if m.kind == "class" %}
                {{ attributes(m.own_members) }}
                {# Link to documented bases; render APIs from hidden bases in place. #}
                {% set inherited_docs %}
                    {% for base, members in m.inherited_members.items() %}
                        {% set base_class = module.get(base[1]) %}
                        {% if not base_class or base_class.taken_from != base %}
                            {% set base_module = all_modules.get(base[0]) %}
                            {% set base_class = base_module.get(base[1]) if base_module else None %}
                        {% endif %}
                        {{ attributes(members, base_class and is_public(base_class) | trim) }}
                    {% endfor %}
                {% endset %}
                {% if inherited_docs | trim %}
                    <details class="api-inherited">
                        <summary>Inherited methods and attributes</summary>
                        {{ inherited_docs }}
                    </details>
                {% endif %}
            {% endif %}
        </section>
    {% endfor %}
{% endblock %}

{% macro attributes(members, reference=False) %}
    {% for attr in members if attr.kind != "class" and is_public(attr) | trim and attr.taken_from[0].startswith("blockether.vis") %}
        <div id="{{ attr.qualname }}" class="classattr">
            {% if reference %}
                <p class="docstring">Inherited from {{ attr.taken_from | link }}.</p>
            {% else %}
                {{ member(attr) }}
            {% endif %}
        </div>
    {% endfor %}
{% endmacro %}

{% macro nav_members(members) %}
    <ul class="memberlist">
        {% for m in members if m.kind != "module" and is_public(m) | trim and m.taken_from[0].startswith("blockether.vis") %}
            <li>
                {% if m.kind == "class" %}
                    <details>
                        <summary><a href="#{{ m.qualname }}">{{ m.name }}</a></summary>
                        {{ nav_members(m.members.values()) }}
                    </details>
                {% elif m.name == "__init__" %}
                    <a href="#{{ m.qualname }}">Constructor</a>
                {% else %}
                    <a href="#{{ m.qualname }}">{{ m.name }}</a>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
{% endmacro %}
