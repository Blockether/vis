node_modules
.npm-cache
dist
dist-ssr
# `npm run build:web` output: the bundle `vis-agent web` serves from a gateway.
dist-web
# `npm run perf` output: the released bundle with the memory overlay on.
dist-perf

# `storybook build` output. The gallery is READ from source by `npm run
# storybook`; a built copy is a screenshot of the tree at some past minute.
storybook-static
# Storybook's crash report, written to the working directory when a command fails.
debug-storybook.log
# Release artefacts (xcarchives, ipas) written by scripts/ios-release.mjs.
/build
*.local

# tsc --build incremental state (tsconfig.*.tsbuildinfo): a regenerated build
# artifact, rewritten by every `npm run build`. Never version it.
*.tsbuildinfo

# Capacitor native projects are generated with `cap add`; keep them out of VCS
# until the platform is intentionally committed. Anchored to this directory:
# unanchored `ios` also swallowed the TRACKED native/ios/ sources that
# scripts/ios-prepare.mjs stamps back into the generated project.
/android
/ios

.DS_Store
