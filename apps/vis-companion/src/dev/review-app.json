   "patch": "diff --git a/assets/blob.bin b/assets/blob.bin\nBinary files differ\ndiff --git a/assets/logo.png b/assets/logo.png\nBinary files differ\ndiff --git a/assets/new_icon.png b/assets/new_icon.png\nnew file mode 100644\nBinary files differ\ndiff --git a/docs/README.md b/docs/README.md\n--- a/docs/README.md\n+++ b/docs/README.md\n@@ -1,3 +1,7 @@\n # Fixture\n \n A small project for diff checks.\n+\n+## Usage\n+\n+Run the tests with `pytest`.\ndiff --git a/pkg/mod_03.py b/pkg/mod_03.py\n--- a/pkg/mod_03.py\n+++ b/pkg/mod_03.py\n@@ -1 +1 @@\n-N = 3\n+N = 30\ndiff --git a/pkg/mod_07.py b/pkg/mod_07.py\n--- a/pkg/mod_07.py\n+++ b/pkg/mod_07.py\n@@ -1 +1 @@\n-N = 7\n+N = 70\ndiff --git a/src/calc.py b/src/calc.py\n--- a/src/calc.py\n+++ b/src/calc.py\n@@ -2,9 +2,16 @@\n     return a + b\n \n \n-def sub(a, b):\n+def subtract(a, b):\n+    \"\"\"Return a minus b.\"\"\"\n     return a - b\n \n \n def mul(a, b):\n     return a * b\n+\n+\n+def div(a, b):\n+    if b == 0:\n+        raise ZeroDivisionError('b is zero')\n+    return a / b\ndiff --git a/src/gone.py b/src/gone.py\ndeleted file mode 100644\n--- a/src/gone.py\n+++ /dev/null\n@@ -1,2 +0,0 @@\n-def unused():\n-    return None\ndiff --git a/src/greeting.py b/src/greeting.py\nnew file mode 100644\n--- /dev/null\n+++ b/src/greeting.py\n@@ -0,0 +1,5 @@\n+GREETING = 'hello'\n+\n+\n+def greet(name):\n+    return f'{GREETING}, {name}'\ndiff --git a/src/long.py b/src/long.py\n--- a/src/long.py\n+++ b/src/long.py\n@@ -48,7 +48,7 @@\n VALUE_47 = 47\n VALUE_48 = 48\n VALUE_49 = 49\n-VALUE_50 = 50\n+VALUE_50 = 5000\n VALUE_51 = 51\n VALUE_52 = 52\n VALUE_53 = 53\n@@ -298,7 +298,7 @@\n VALUE_297 = 297\n VALUE_298 = 298\n VALUE_299 = 299\n-VALUE_300 = 300\n+VALUE_300 = 'changed'\n VALUE_301 = 301\n VALUE_302 = 302\n VALUE_303 = 303\ndiff --git a/src/new_feature.py b/src/new_feature.py\nnew file mode 100644\n--- /dev/null\n+++ b/src/new_feature.py\n@@ -0,0 +1,6 @@\n+class Feature:\n+    def __init__(self, name: str) -> None:\n+        self.name = name\n+\n+    def enabled(self) -> bool:\n+        return bool(self.name)\ndiff --git a/src/old_name.py b/src/old_name.py\ndeleted file mode 100644\n--- a/src/old_name.py\n+++ /dev/null\n@@ -1,5 +0,0 @@\n-GREETING = 'hello'\n-\n-\n-def greet(name):\n-    return f'{GREETING}, {name}'\ndiff --git a/src/util.ts b/src/util.ts\n--- a/src/util.ts\n+++ b/src/util.ts\n@@ -1,5 +1,6 @@\n export function clamp(value: number, low: number, high: number): number {\n+  if (low > high) throw new RangeError('low > high');\n   return Math.min(Math.max(value, low), high);\n }\n \n-export const VERSION = '1.0.0';\n+export const VERSION = '1.1.0';\ndiff --git a/src/wide.js b/src/wide.js\n--- a/src/wide.js\n+++ b/src/wide.js\n@@ -1 +1 @@\n-const message = 'this line is intentionally very long so that the wrap toggle has a visible effect in the diff panel when the window is narrow';\n+const message = 'this line is intentionally very long so that the wrap toggle has a visible effect in the diff panel when the narrow window is used';\ndiff --git a/tests/test_calc.py b/tests/test_calc.py\n--- a/tests/test_calc.py\n+++ b/tests/test_calc.py\n@@ -1,5 +1,9 @@\n-from src.calc import add\n+from src.calc import add, div\n \n \n def test_add():\n     assert add(1, 2) == 3\n+\n+\n+def test_div():\n+    assert div(6, 3) == 2\n",
