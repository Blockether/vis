{
  "is_cancellable": true,
  "id": "req-1",
  "submit_label": "Submit",
  "cancel_label": "Cancel",
  "title": "Deploy?",
  "fields": [
    {
      "description": "Where this deploy lands",
      "is_required": false,
      "default": "prod",
      "name": "env",
      "type": "select",
      "label": "Env",
      "id": "env",
      "options": [
        {
          "value": "prod",
          "label": "prod"
        },
        {
          "value": "stg",
          "label": "Staging"
        }
      ]
    },
    {
      "id": "key",
      "name": "key",
      "type": "password",
      "label": "key",
      "is_required": true,
      "max_length": 40
    },
    {
      "id": "ok",
      "name": "ok",
      "type": "checkbox",
      "label": "Confirm",
      "is_required": false,
      "default": true
    },
    {
      "id": "tags",
      "name": "tags",
      "type": "multiselect",
      "label": "tags",
      "is_required": false,
      "options": [
        {
          "value": "a",
          "label": "a"
        },
        {
          "value": "b",
          "label": "b"
        }
      ],
      "default": []
    },
    {
      "min": 0,
      "label": "Risk budget",
      "max": 10,
      "id": "risk",
      "is_required": false,
      "name": "risk",
      "type": "range",
      "default": 2.5,
      "description": "How much of the error budget this may spend",
      "step": 0.5
    },
    {
      "description": "From the authenticator on your phone",
      "is_required": true,
      "max_length": 6,
      "min_length": 4,
      "name": "code",
      "type": "otp",
      "label": "One-time code",
      "id": "code"
    },
    {
      "id": "notify",
      "name": "notify",
      "type": "plaintext",
      "label": "Notify",
      "is_required": false,
      "validate": [
        {
          "kind": "type",
          "type": "email",
          "message": "must be an email address"
        },
        {
          "kind": "length",
          "max": 60,
          "message": "keep it short"
        }
      ]
    }
  ],
  "session_id": "sid-1",
  "timeout_ms": 300000,
  "description": "prod"
