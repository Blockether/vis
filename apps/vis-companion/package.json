{
  "name": "vis-companion",
  "version": "0.5.35",
  "private": true,
  "description": "Universal (web / Android / iOS) companion for the vis gateway — React + Tailwind + Capacitor.",
  "type": "module",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "sync:version": "node scripts/version.mjs",
    "gen:themes": "cd ../.. && clojure -X:companion-themes",
    "dev": "vite",
    "predev": "node scripts/version.mjs",
    "build": "tsc -b && vite build",
    "prebuild": "node scripts/version.mjs",
    "build:web": "tsc -b && vite build --mode web && vite build --mode export",
    "build:export": "vite build --mode export",
    "prebuild:web": "node scripts/version.mjs",
    "build:perf": "tsc -b && vite build --mode perf",
    "prebuild:perf": "node scripts/version.mjs",
    "perf": "npm run build:perf && vite preview --mode perf",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:storybook": "vitest run --project=storybook",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "storybook:build": "storybook build",
    "storybook:contrast": "storybook build --quiet && node scripts/storybook-contrast.mjs",
    "lint": "node scripts/react-compiler-lint.mjs",
    "postinstall": "npm rebuild typescript-7",
    "cap:config": "node scripts/gen-capacitor-config.mjs",
    "sync": "cap sync",
    "presync": "npm run cap:config",
    "postsync": "node scripts/ios-prepare.mjs",
    "android": "cap run android",
    "preandroid": "npm run cap:config && node scripts/android-prepare.mjs",
    "ios": "cap run ios",
    "preios": "npm run cap:config && node scripts/ios-prepare.mjs",
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "postadd:ios": "node scripts/ios-prepare.mjs",
    "prepare:android": "npm run cap:config && node scripts/android-prepare.mjs",
    "build:android": "npm run build && npm run sync && node scripts/android-prepare.mjs",
    "build:ios": "npm run build && npm run sync",
    "package:desktop": "node scripts/desktop-package.mjs",
    "prepare:ios": "node scripts/ios-prepare.mjs",
    "release:mobile": "node scripts/mobile-release.mjs",
    "release:ios": "node scripts/mobile-release.mjs",
    "release:android": "node scripts/mobile-release.mjs",
    "release:ios:store": "node scripts/ios-release.mjs",
    "release:android:store": "node scripts/android-release.mjs",
    "release:testflight": "node scripts/testflight.mjs",
    "release:expire": "node scripts/expire.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "diagnostics:ios": "node scripts/ios-crashes.mjs",
    "diagnostics:android": "node scripts/android-crashes.mjs",
    "secrets": "node scripts/secrets.mjs"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@capacitor/app": "8.1.2",
    "@capacitor/barcode-scanner": "3.1.4",
    "@capacitor/camera": "8.2.6",
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/core": "8.6.2",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/share": "8.0.3",
    "@capawesome/capacitor-file-picker": "8.1.1",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "dompurify": "3.5.0",
    "fflate": "0.8.3",
    "html2canvas-pro": "2.6.4",
    "jsqr": "1.4.0",
    "lucide-react": "1.78.0",
    "mdast-util-from-markdown": "2.1.0",
    "pdfjs-dist": "6.4.299",
    "pele": "1.13.0",
    "prismjs": "1.30.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@babel/core": "8.1.3",
    "@capacitor/android": "8.6.2",
    "@capacitor/cli": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "@rolldown/plugin-babel": "0.3.1",
    "@storybook/addon-a11y": "10.6.8",
    "@storybook/addon-docs": "10.6.8",
    "@storybook/addon-vitest": "10.6.8",
    "@storybook/react-vite": "10.6.8",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/prismjs": "1.26.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.1",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "31.0.1",
    "playwright": "1.65.1",
    "storybook": "10.6.8",
    "tailwindcss": "4.3.5",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-7": "npm:typescript@7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
