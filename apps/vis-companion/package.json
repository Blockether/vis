{
  "name": "vis-companion",
  "version": "0.1.41",
  "private": true,
  "description": "Universal (web / Android / iOS) companion for the vis gateway — React + Tailwind + Capacitor.",
  "type": "module",
  "scripts": {
    "sync:version": "node scripts/version.mjs",
    "gen:themes": "cd ../.. && clojure -X:companion-themes",
    "dev": "vite",
    "predev": "node scripts/version.mjs",
    "build": "tsc -b && vite build",
    "prebuild": "node scripts/version.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:storybook": "vitest --project=storybook --run && storybook build --quiet && node scripts/storybook-contrast.mjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build",
    "lint": "node scripts/react-compiler-lint.mjs",
    "postinstall": "npm rebuild typescript-7",
    "cap:config": "node scripts/gen-capacitor-config.mjs",
    "sync": "cap sync",
    "presync": "npm run cap:config",
    "postsync": "node scripts/ios-prepare.mjs",
    "android": "cap run android",
    "preandroid": "npm run cap:config && node scripts/android-prepare.mjs",
    "ios": "cap run ios",
    "preios": "npm run cap:config && node scripts/ios-prepare.mjs",
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "prepare:android": "npm run cap:config && node scripts/android-prepare.mjs",
    "build:android": "npm run build && npm run sync && node scripts/android-prepare.mjs",
    "build:ios": "npm run build && npm run sync",
    "prepare:ios": "node scripts/ios-prepare.mjs",
    "release:mobile": "node scripts/mobile-release.mjs",
    "release:ios": "node scripts/mobile-release.mjs",
    "release:android": "node scripts/mobile-release.mjs",
    "release:ios:store": "node scripts/ios-release.mjs",
    "release:android:store": "node scripts/android-release.mjs",
    "release:testflight": "node scripts/testflight.mjs",
    "release:expire": "node scripts/expire.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "diagnostics:ios": "node scripts/ios-crashes.mjs",
    "diagnostics:android": "node scripts/android-crashes.mjs",
    "secrets": "node scripts/secrets.mjs"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.8.1",
    "@capacitor/app": "8.1.1",
    "@capacitor/barcode-scanner": "3.1.0",
    "@capacitor/camera": "8.2.1",
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/core": "8.4.2",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/push-notifications": "8.1.2",
    "@capacitor/share": "8.0.1",
    "@capawesome/capacitor-file-picker": "8.0.3",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "dompurify": "3.4.13",
    "html2canvas-pro": "2.3.3",
    "jsqr": "1.4.0",
    "lucide-react": "1.34.0",
    "pdfjs-dist": "6.2.108",
    "prismjs": "1.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@capacitor/android": "8.4.2",
    "@capacitor/cli": "8.4.2",
    "@capacitor/ios": "8.4.2",
    "@rolldown/plugin-babel": "0.2.3",
    "@storybook/addon-a11y": "10.6.0-beta.0",
    "@storybook/addon-docs": "10.6.0-beta.0",
    "@storybook/addon-mcp": "10.6.0-beta.0",
    "@storybook/addon-vitest": "10.6.0-beta.0",
    "@storybook/react-vite": "10.6.0-beta.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/babel__core": "7.20.5",
    "@types/prismjs": "1.26.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/browser-playwright": "4.1.10",
    "axe-core": "4.13.0",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "29.1.1",
    "playwright": "1.62.1",
    "storybook": "10.6.0-beta.0",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-7": "npm:typescript@7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
