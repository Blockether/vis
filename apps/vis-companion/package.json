{
  "name": "vis-companion",
  "version": "1.0.1",
  "private": true,
  "description": "Universal (web / Android / iOS) companion for the vis gateway — React + Tailwind + Capacitor.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "node scripts/react-compiler-lint.mjs",
    "postinstall": "npm rebuild typescript-7",
    "cap:config": "node scripts/gen-capacitor-config.mjs",
    "sync": "cap sync",
    "presync": "npm run cap:config",
    "android": "cap run android",
    "preandroid": "npm run cap:config && node scripts/android-prepare.mjs",
    "ios": "cap run ios",
    "preios": "npm run cap:config",
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "prepare:android": "npm run cap:config && node scripts/android-prepare.mjs",
    "build:android": "npm run build && npm run sync && node scripts/android-prepare.mjs",
    "build:ios": "npm run build && npm run sync",
    "release:ios": "node scripts/ios-release.mjs",
    "secrets": "node scripts/secrets.mjs"
  },
  "dependencies": {
    "@capacitor/app": "8.1.1",
    "@capacitor/barcode-scanner": "3.1.0",
    "@capacitor/camera": "8.2.1",
    "@capacitor/core": "8.4.2",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/push-notifications": "8.1.2",
    "@capawesome/capacitor-file-picker": "8.0.3",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "jsqr": "1.4.0",
    "prismjs": "1.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@capacitor/android": "8.4.2",
    "@capacitor/cli": "8.4.2",
    "@capacitor/ios": "8.4.2",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/prismjs": "1.26.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "babel-plugin-react-compiler": "1.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.0",
    "typescript-7": "npm:typescript@7.0.2",
    "vite": "8.1.5"
  }
}
