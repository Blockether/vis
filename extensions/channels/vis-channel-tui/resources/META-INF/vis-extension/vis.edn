;; Lanterna TUI channel. Loading the ns calls
;; (channel/register-global! ...). Non-LLM-facing.
;; `:image-nses` — loaded BY NAME on first use (`requiring-resolve`), never at
;; discovery. A JVM can load such a namespace whenever it likes; a native image
;; cannot define classes at run time, so anything not build-time initialized is
;; simply absent from the binary. These are therefore compiled INTO the image
;; without being required at startup.
{tui
 {:nses [com.blockether.vis.ext.channel-tui.core
         com.blockether.vis.ext.channel-tui.builtin-hooks]
  :image-nses [com.blockether.vis.ext.channel-tui.screen
               com.blockether.vis.ext.channel-tui.chat]}}
