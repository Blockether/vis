;; TUI channel — the Lanterna chat UI, an OPTIONAL package: nothing requires its
;; namespaces, the CLI dispatcher resolves
;; `com.blockether.vis.ext.channel-tui.screen/run-chat!` lazily through
;; `requiring-resolve`, so omitting this jar leaves the rest of vis usable.
{:paths ["src" "resources"]
 ;; tools.deps reads :mvn/repos ONLY from the project it is invoked on, never from a
 ;; :local/root dep's deps.edn, so resolving this extension alone needs vis' JitPack
 ;; repo (com.blockether/vis -> the voice extension -> com.github.k2-fsa.sherpa-onnx).
 :mvn/repos {"jitpack" {:url "https://jitpack.io"}}
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        com.blockether/vis {:local/root "../../.."}
        com.taoensso/telemere {:mvn/version "1.2.1"}
        ;; Blockether fork of mabe02/lanterna 3.1.5 — a DROP-IN replacement in the same
        ;; com.googlecode.lanterna.* package, retired when upstream ships equivalents.
        ;; Its subject is STANDARD Unicode widths: lanterna's column model has to match
        ;; what the terminal paints, or every following cell and border slides.
        ;;   1. PR #625 cherry-pick — grapheme-aware emoji rendering in
        ;;      StreamBasedTerminal/AbstractTextGraphics putString.
        ;;   2. BMP `Emoji_Presentation=Yes` glyphs (✅ ⭐ ⚡ ❌ ⏰ …) and genuine
        ;;      astral/surrogate emoji (🏷️ 😊 👀) are 2 columns.
        ;;   3. VS-16 (emoji presentation) graphemes — ⚠️ ❤️ ☑️ — are WIDE, whatever the
        ;;      BARE base glyph does.
        ;;   4. VS-15 (text presentation) graphemes (☑︎) stay single-width.
        ;;   5. Geometric/symbol glyphs without VS-16 — ● ○ ◯ ◎ ◐ ◑ status dots, ▶ ◀
        ;;      media triangles, ⚠ — are ONE column; force-widening them once slid a
        ;;      focused tab's `● ` prefix (and its trailing │) a column left. Disclosure
        ;;      chevrons ▸ ▾ were already narrow (EAW=N).
        ;;   6. East-Asian-Ambiguous (EAW=A) punctuation and letters (· — … λ “” • ™,
        ;;      Greek, Cyrillic) are NARROW, as modern terminals paint them; opt into
        ;;      wide with -Dlanterna.eastAsianAmbiguousWide=true.
        ;;   7. Unicode 15.1 EAW=W/F table for the wide symbols OUTSIDE the CJK blocks
        ;;      (〈〉, Yi, Bopomofo, CJK compat/vertical) that isCharCJK missed — one
        ;;      shared source for display width and the paint. Box/block/geometric
        ;;      chrome and arrows stay single-width.
        ;;   8. Control chars degrade to a space instead of throwing on the render thread.
        ;;   9. Scroll-ghost fix: refreshByDelta skips a wide glyph's trailing half-cell,
        ;;      but content scrolling out from under it left a stale half-glyph on
        ;;      emoji/CJK rows — the wide char is now re-emitted whenever that trailing
        ;;      cell changed.
        ;;  10. Grapheme/EAW-aware text flow in TerminalTextUtils: displayWidth,
        ;;      wordWrap, justify, justifyLine and `foldColumns` — a terminal-style SOFT
        ;;      wrap (char fold that preserves whitespace and alignment) the TUI folds
        ;;      pathologically wide single lines with instead of clipping them.
        ;;  11. Apple Terminal.app IGNORES VS-16 and paints the base glyph at TEXT width
        ;;      (⚠️ ✔️ ☑️ ▶️ ❤️ = ONE column there, TWO on iTerm2/Ghostty/Kitty/tmux), so
        ;;      trusting the two-column model over-advanced the cursor and left ghosts.
        ;;      Auto-detected from TERM_PROGRAM=Apple_Terminal (off inside tmux); force
        ;;      with -Dlanterna.appleTerminalWidths=true|false.
        ;;  12. Inline images in terminal.image.TerminalImage — Kitty graphics protocol /
        ;;      iTerm2 inline images, capability detection, pixel-dimension sniffing,
        ;;      cell-box sizing, escape encoding. channel-tui.terminal-image is a thin
        ;;      adapter over it.
        ;;  13. Terminal chrome builders (TerminalTextUtils/repeat, joinedLine,
        ;;      boxedLine) build `─`, `──┬──` and `┌──┐` in StringBuilder code so hot
        ;;      table/dialog chrome is not rebuilt through Clojure seqs every paint.
        ;;  14. Native TTY control in ansi.TTYDeviceControl — termios + ioctl(TIOCGWINSZ)
        ;;      through the java.lang.foreign (FFM) API, compiled at release 25 with no
        ;;      multi-release layering. UnixTerminal no longer forks /bin/stty six times
        ;;      per acquire/restore, and the window size comes from ONE ioctl instead of
        ;;      the ANSI cursor-parking round-trip that silently degrades to 80x24. Every
        ;;      call falls back to stty; force the old path with
        ;;      -Dcom.googlecode.lanterna.terminal.UnixTerminal.nativeTTY=false. Needs
        ;;      --enable-native-access=ALL-UNNAMED (see the root deps.edn aliases); the
        ;;      native image registers no FFM downcall descriptors, so the binary takes
        ;;      that stty fallback.
        ;;  15. No Swing/AWT emulator: the whole terminal.swing package (17 classes) is
        ;;      DELETED and DefaultTerminalFactory only ever builds a text terminal (its
        ;;      emulator switches are no-ops), so nothing can make AWT reachable from the
        ;;      TUI in the native image.
        ;;  16. ZERO java.desktop: TerminalImage's ImageIO/Graphics2D PNG transcode (now
        ;;      done in Clojure over com.blockether/imaging, which is why the class
        ;;      exposes cellWidth/cellHeight) and TextColor's deprecated `toColor()` are
        ;;      gone, `requires static java.desktop` is dropped from module-info, and the
        ;;      jar carries no java/awt or javax/swing reference at all.
        com.blockether/lanterna {:mvn/version "3.1.5-vis.42"}
        ;; Pure-Java H.264/MP4 encoder for the headless session `cinema` export
        ;; (channel-tui.cinema). CORE ONLY: com.blockether/imaging renders the frames
        ;; and hands them over as jcodec RGB `Picture`s, so the java.desktop-bound
        ;; `jcodec-javase` (AWTSequenceEncoder/AWTUtil) is gone. No native deps.
        org.jcodec/jcodec {:mvn/version "0.2.5"}}
 :aliases {:test {:extra-deps {io.github.noahtheduke/lazytest {:mvn/version "2.0.0"}}
                  :extra-paths ["test"]
                  :main-opts ["-m" "lazytest.main" "test"]}}}
