{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        com.blockether/vis {:local/root "../../.."}
        com.litongjava/sherpa-onnx-java-api {:mvn/version "1.0.1"}
        ;; LOCKED to sherpa's ABI, never "latest". libsherpa-onnx-jni.so is
        ;; linked against the ELF symbol version VERS_1.17.1; any other ONNX
        ;; Runtime makes every transcription die at dlopen on Linux. See
        ;; asr/onnxruntime-version and the onnxruntime-abi-test that pins it.
        com.microsoft.onnxruntime/onnxruntime {:mvn/version "1.17.1"}
        org.apache.commons/commons-compress {:mvn/version "1.28.0"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.noahtheduke/lazytest {:mvn/version "2.0.0"}}
         :main-opts ["-m" "lazytest.main"]}}}
