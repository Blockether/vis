{:paths ["src" "resources"]
 ;; The official k2-fsa artifacts are published through JitPack only; Maven
 ;; Central carries no sherpa-onnx at all.
 :mvn/repos {"jitpack" {:url "https://jitpack.io"}}
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        com.blockether/vis {:local/root "../../.."}
        ;; Upstream sherpa-onnx: a small API jar plus one native jar per platform
        ;; we run on. Each native jar carries libsherpa-onnx-jni AND the exact
        ;; libonnxruntime it was built against side by side under
        ;; sherpa-onnx/native/<platform>/, and sherpa's own LibraryUtils extracts
        ;; both and loads the runtime FIRST. So there is no ONNX Runtime
        ;; coordinate to pin, no ABI to guard and no copy step to run.
        com.github.k2-fsa.sherpa-onnx/sherpa-onnx-jvm {:mvn/version "v1.13.5"}
        com.github.k2-fsa.sherpa-onnx/sherpa-onnx-native-lib-osx-aarch64 {:mvn/version "v1.13.5"}
        com.github.k2-fsa.sherpa-onnx/sherpa-onnx-native-lib-osx-x64 {:mvn/version "v1.13.5"}
        com.github.k2-fsa.sherpa-onnx/sherpa-onnx-native-lib-linux-x64 {:mvn/version "v1.13.5"}
        com.github.k2-fsa.sherpa-onnx/sherpa-onnx-native-lib-linux-aarch64 {:mvn/version "v1.13.5"}
        com.github.k2-fsa.sherpa-onnx/sherpa-onnx-native-lib-win-x64 {:mvn/version "v1.13.5"}
        org.apache.commons/commons-compress {:mvn/version "1.28.0"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.noahtheduke/lazytest {:mvn/version "2.0.0"}}
         :main-opts ["-m" "lazytest.main"]}}}
