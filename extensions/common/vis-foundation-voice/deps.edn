{:paths ["src" "resources"]
 ;; The official k2-fsa artifacts are published through JitPack only; Maven Central
 ;; carries no sherpa-onnx at all.
 :mvn/repos {"jitpack" {:url "https://jitpack.io"}}
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        com.blockether/vis {:local/root "../../.."}
        ;; Upstream sherpa-onnx, API JAR ONLY (187 KB). The JNI and the exact
        ;; libonnxruntime it was linked against live together in one native jar PER
        ;; PLATFORM, 8-13 MB each — depending on all five here made every machine
        ;; download 51 MB to load one of them, and put four foreign platforms'
        ;; libraries on every classpath. `sherpa.clj` provisions the host pair on
        ;; demand and `build.clj` embeds the BUILD HOST's into the native image, so
        ;; there is still no ONNX Runtime coordinate to pin, no ABI to guard and no
        ;; copy step to run.
        com.github.k2-fsa.sherpa-onnx/sherpa-onnx-jvm {:mvn/version "v1.13.5"}
        org.apache.commons/commons-compress {:mvn/version "1.28.0"}}
 :aliases {:test {:extra-deps {io.github.noahtheduke/lazytest {:mvn/version "2.0.0"}}
                  :extra-paths ["test"]
                  :main-opts ["-m" "lazytest.main" "test"]}}}
