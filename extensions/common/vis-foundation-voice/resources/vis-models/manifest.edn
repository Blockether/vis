 ;; OUR export, and nobody else's. Kyutai's weights are CC BY 4.0, but the
 ;; ready-made ONNX bundle k2-fsa publishes carries a README saying non-commercial
 ;; beside a LICENSE saying CC BY 4.0. Neither sentence is ours to resolve, so Vis
 ;; mirrors neither: `bin/export-pocket-tts` exports Kyutai's own checkpoint and
 ;; the pack carries that.
 ;; Opt-in for its size, not its licence - 96 MB for a non-default speaker.
 {:id "pocket-tts-int8"
  :engine :pocket-tts
  :install-dir "sherpa-onnx-pocket-tts-int8"
  ;; REQUIRED: an install predating the clips is incomplete and is replaced, because
  ;; a bundle with no voice cannot speak.
  :requires ["lm_flow.int8.onnx" "lm_main.int8.onnx" "encoder.onnx" "decoder.int8.onnx"
             "text_conditioner.onnx" "vocab.json" "token_scores.json" "voices/kristin.wav"
             "voices/cori.wav" "voices/john.wav"]
  ;; Pocket clones a REFERENCE CLIP instead of selecting a baked speaker, so a voice
  ;; is a WAV in the bundle. Kyutai's own clips are not ours to hand on; these three
  ;; came from `bin/make-voice-clips` over PUBLIC-DOMAIN Piper voices. `:clip-text`
  ;; is what the clip says, passed as the transcript the clone hears.
  :voices
  [{:clip "voices/kristin.wav"
    :clip-text
    "This is a reference recording, read at an ordinary pace. Nothing in it is difficult to say, and that is the point: what should carry is the sound of the voice, not the words it happens to be reading."
    :gender :female
    :id "kristin"
    :label "Kristin (en-US)"
    :language "en-US"}
   {:clip "voices/cori.wav"
    :clip-text
    "A short paragraph, read aloud without hurry, with the pauses left where they fall. Ten seconds of plain speech is enough to hear how a voice moves from one sentence into the next."
    :gender :female
    :id "cori"
    :label "Cori (en-GB)"
    :language "en-GB"}
   {:clip "voices/john.wav"
    :clip-text
    "Reading quietly for a few seconds, plainly and at a steady pace. The manner matters more than the meaning here: where the breath lands, how a sentence turns, and what an unhurried voice sounds like."
    :gender :male
    :id "john"
    :label "John (en-US)"
    :language "en-US"}]
