;; OpenAI Codex (ChatGPT OAuth) provider. Self-registers with
;; `com.blockether.vis.core` at namespace load via the unified
;; Registered explicitly by the closed distribution manifest.
{:paths ["src" "resources"]
 ;; tools.deps reads :mvn/repos ONLY from the project it is invoked on, never from a
 ;; :local/root dep's deps.edn, so resolving this extension alone needs vis' JitPack
 ;; repo (com.blockether/vis -> the voice extension -> com.github.k2-fsa.sherpa-onnx).
 :mvn/repos {"jitpack" {:url "https://jitpack.io"}}
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        com.blockether/vis {:local/root "../../.."}
        com.cnuernber/charred {:mvn/version "1.041"}
        com.taoensso/telemere {:mvn/version "1.2.1"}
        org.babashka/http-client {:mvn/version "0.4.24"}}
 :aliases {:test {:extra-deps {io.github.noahtheduke/lazytest {:mvn/version "2.0.0"}}
                  :extra-paths ["test"]
                  :main-opts ["-m" "lazytest.main" "test"]}}}
