{:paths ["src" "resources"]
 ;; Alibaba Model Studio provider - covers BOTH subscription endpoints in one
 ;; classpath plug-in:
 ;;   - `:alibaba-coding-plan` -> Coding Plan subscription
 ;;   - `:alibaba-token-plan`  -> Token Plan prepaid bundle
 ;; The two endpoints serve overlapping model families (Qwen, GLM, DeepSeek,
 ;; Kimi, MiniMax) but bill against different plans and, verified against the
 ;; live APIs, REJECT each other's keys (HTTP 401 `InvalidApiKey`). So each
 ;; plan gets its own `:provider/id`, env var and auth/get-token/status/logout
 ;; fns over a shared on-disk auth file (`~/.vis/alibaba-auth.json`) keyed by
 ;; plan.
 ;;
 ;; Self-registers with `com.blockether.vis.core` at namespace load
 ;; via the unified `META-INF/vis-extension/vis.edn`.
 :deps
 {org.clojure/clojure   {:mvn/version "1.12.5"}
  ;; vis owns the extension/provider registries.
  com.blockether/vis    {:local/root "../../.."}
  ;; JSON for the persisted auth file (charred is already on the runtime
  ;; classpath via vis itself).
  com.cnuernber/charred {:mvn/version "1.041"}
  com.taoensso/telemere {:mvn/version "1.2.1"}}

 :aliases
 {:test
  {:extra-paths ["test"]
   :extra-deps {io.github.noahtheduke/lazytest {:mvn/version "2.0.0"}}
   :main-opts  ["-m" "lazytest.main" "--dir" "test"]}}}
