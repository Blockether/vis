{:paths ["src" "resources"]
 ;; OpenRouter (https://openrouter.ai) — a single OpenAI-compatible endpoint
 ;; that fans out to every upstream vendor (Anthropic, OpenAI, Google, Z.ai,
 ;; DeepSeek, ...). One static API key (`OPENROUTER_API_KEY`), one base URL,
 ;; vendor-prefixed model slugs (`anthropic/claude-sonnet-4.5`).
 ;;
 ;; Self-registers with `com.blockether.vis.core` at namespace load via the
 ;; unified `META-INF/vis-extension/vis.edn` manifest.
 :deps
 {org.clojure/clojure   {:mvn/version "1.12.5"}
  ;; vis owns the extension/provider registries.
  com.blockether/vis    {:local/root "../../.."}
  ;; JSON for the persisted auth file and the `/api/v1/key` credit probe
  ;; (charred is already on the runtime classpath via vis itself).
  com.cnuernber/charred {:mvn/version "1.041"}
  ;; Live credit/rate-limit probe.
  org.babashka/http-client {:mvn/version "0.4.24"}
  com.taoensso/telemere {:mvn/version "1.2.1"}}

 :aliases
 {:test
  {:extra-paths ["test"]
   :extra-deps {io.github.noahtheduke/lazytest {:mvn/version "2.0.0"}}
   :main-opts  ["-m" "lazytest.main" "--dir" "test"]}}}
