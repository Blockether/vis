;; OpenRouter (https://openrouter.ai) — a single OpenAI-compatible endpoint that
;; fans out to every upstream vendor (Anthropic, OpenAI, Google, Z.ai, DeepSeek,
;; ...). One static API key (`OPENROUTER_API_KEY`), one base URL, vendor-prefixed
;; model slugs (`anthropic/claude-sonnet-4.5`). Registered explicitly by the
;; closed distribution manifest; authentication comes from the shared key store.
{:paths ["src" "resources"]
 ;; tools.deps reads :mvn/repos ONLY from the project it is invoked on, never from a
 ;; :local/root dep's deps.edn, so resolving this extension alone needs vis' JitPack
 ;; repo (com.blockether/vis -> the voice extension -> com.github.k2-fsa.sherpa-onnx).
 :mvn/repos {"jitpack" {:url "https://jitpack.io"}}
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        ;; vis owns the extension/provider registries.
        com.blockether/vis {:local/root "../../.."}
        ;; JSON for the `/api/v1/key` credit probe and the live model catalog
        ;; (charred is already on the runtime classpath via vis itself).
        com.cnuernber/charred {:mvn/version "1.041"}
        ;; Live credit/rate-limit probe.
        org.babashka/http-client {:mvn/version "0.4.24"}}
 :aliases {:test {:extra-deps {io.github.noahtheduke/lazytest {:mvn/version "2.0.0"}}
                  :extra-paths ["test"]
                  :main-opts ["-m" "lazytest.main" "test"]}}}
