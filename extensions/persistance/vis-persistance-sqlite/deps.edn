;; SQLite backend for the vis persistence facade. Owns the JDBC plumbing
;; (sqlite-jdbc, next.jdbc, honeysql, nippy), the migration runner (flyway-core +
;; flyway-database-nc-sqlite) and the SQLite migration resources
;; (resources/db/sqlite/migration/): `migrate!` is a dialect concern, not core
;; runtime, and this is the only consumer of either. Loading
;; `com.blockether.vis.ext.persistance-sqlite.core` auto-registers the `:sqlite`
;; backend with the facade, and `db-open!` runs vis' `persistance.migration/migrate!`
;; against `classpath:db/sqlite/migration`, so every store starts with the canonical
;; schema applied.
{:paths ["src" "resources"]
 ;; tools.deps reads :mvn/repos ONLY from the project it is invoked on, never from a
 ;; :local/root dep's deps.edn, so resolving this extension alone needs vis' JitPack
 ;; repo (com.blockether/vis -> the voice extension -> com.github.k2-fsa.sherpa-onnx).
 :mvn/repos {"jitpack" {:url "https://jitpack.io"}}
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        ;; vis owns the extension-registration contract and the storage facade.
        com.blockether/vis {:local/root "../../.."}
        ;; Binary serialization for definition_state.value blobs.
        com.taoensso/nippy {:mvn/version "3.8.0"}
        ;; JSON, for blob round-trips inside the SQLite query layer.
        com.cnuernber/charred {:mvn/version "1.041"}
        com.github.seancorfield/honeysql {:mvn/version "2.7.1425"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.1118"}
        org.xerial/sqlite-jdbc {:mvn/version "3.53.2.1"}
        ;; A REAL connection pool. xerial's `SQLiteConnectionPoolDataSource` is a
        ;; JNDI-shaped facade that opens a NEW physical connection on every
        ;; `getConnection()` — under bursty writes (5-10 db-store-iteration! per agent
        ;; turn) that churns WAL/-shm files, can race directory-level events on macOS
        ;; APFS and surfaces sporadic SQLITE_CANTOPEN. HikariCP wraps the underlying
        ;; `SQLiteDataSource` in long-lived connections with one dispose hook that
        ;; actually releases handles.
        com.zaxxer/HikariCP {:mvn/version "7.1.0"}
        org.flywaydb/flyway-core {:mvn/version "12.11.0"}
        ;; SQLite-specific Flyway driver, split out of flyway-core in 10.x+ — without
        ;; this jar Flyway cannot recognize a `jdbc:sqlite:` URL.
        org.flywaydb/flyway-database-nc-sqlite {:mvn/version "12.11.0"}
        ;; CVE pin: Flyway 12.11.0 pulls tools.jackson jackson-databind 3.1.4
        ;; (CVE-2026-59889). Declared here so the top-level version wins.
        tools.jackson.core/jackson-databind {:mvn/version "3.2.1"}}
 :aliases {:test {:extra-deps {io.github.noahtheduke/lazytest {:mvn/version "2.0.0"}}
                  :extra-paths ["test"]
                  :main-opts ["-m" "lazytest.main" "test"]}}}
