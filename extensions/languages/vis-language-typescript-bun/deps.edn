;; TypeScript/Bun language pack. Activates ONLY when the workspace looks like a Bun
;; project (bunfig.toml / bun.lock(b) / .bun-version / package.json + *.ts). Adds a
;; MANAGED Bun REPL behind the generic language facade (repl_start / repl_status /
;; repl_stop / repl_eval) — a `bun -e` subprocess running a tiny line-framed JSON eval server
;; (shipped as a resource) with REAL REPL semantics: persistent globals, top-level
;; await, cache-busted reload(). Also wires run_tests -> `bun test`. charred (JSON)
;; rides in from vis core.
{:paths ["src" "resources"]
 ;; tools.deps reads :mvn/repos ONLY from the project it is invoked on, never from a
 ;; :local/root dep's deps.edn, so resolving this extension alone needs vis' JitPack
 ;; repo (com.blockether/vis -> the voice extension -> com.github.k2-fsa.sherpa-onnx).
 :mvn/repos {"jitpack" {:url "https://jitpack.io"}}
 :deps {com.blockether/vis {:local/root "../../.."}}
 :aliases {:test {:extra-deps {io.github.noahtheduke/lazytest {:mvn/version "2.0.0"}}
                  :extra-paths ["test"]
                  :main-opts ["-m" "lazytest.main" "test"]}}}
