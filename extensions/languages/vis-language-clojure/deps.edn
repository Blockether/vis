;; Clojure language pack. Activates ONLY when the workspace language scan sees
;; Clojure files, and surfaces a small `clj/` alias inside the SCI sandbox:
;;   clj/eval    - evaluate code in a running nREPL (per-port connection pool)
;;   clj/repl    - managed nREPL lifecycle (status/start/stop; no restart —
;;                 self-start a project nREPL with aliases in any dir)
;;   clj/outline - collapsed file view (ns + defs + arglists + docline)
;;   clj/find    - name/regex def search across the workspace
;; cljfmt + zprint + nrepl are extension-private: they are only on the classpath
;; when this jar is.
{:paths ["src" "resources"]
 ;; tools.deps reads :mvn/repos ONLY from the project it is invoked on, never from a
 ;; :local/root dep's deps.edn, so resolving this extension alone needs vis' JitPack
 ;; repo (com.blockether/vis -> the voice extension -> com.github.k2-fsa.sherpa-onnx).
 :mvn/repos {"jitpack" {:url "https://jitpack.io"}}
 :deps {com.blockether/vis {:local/root "../../.."}
        ;; The conservative fallback formatter; zprint is canonical when a
        ;; `.zprint.edn` is present.
        dev.weavejester/cljfmt {:mvn/version "0.16.5"}
        ;; zprint stays in LOCKSTEP with the canonical `clojure -M:format`: codestyle
        ;; (io.github.enajski/codestyle, pinned by sha in the root deps.edn) resolves
        ;; zprint 1.2.9, and the repo's `.zprint.edn` `:option-fn`/`:guided` fn-map is
        ;; tuned for it. 1.3.0 changed guided newline handling and reflows let/binding
        ;; forms differently, which makes `format_code` fight the canonical formatter
        ;; (spurious churn). antq bumped this once — hold it by hand.
        zprint/zprint {:mvn/version "1.2.9"}
        nrepl/nrepl {:mvn/version "1.7.0"}
        ;; Static analysis for the `lint_code` language surface, run through its
        ;; programmatic API (clj-kondo.core/run!).
        clj-kondo/clj-kondo {:mvn/version "2026.07.24"}
        ;; Jackson override (audit): clj-kondo -> cheshire 5.13.0 drags in Jackson
        ;; 2.17.0 transitively (vis itself uses charred, not cheshire). Pin the whole
        ;; Jackson 2.x set to one deliberate, patched version so the security audit
        ;; sees a single controlled coordinate instead of a transitive accident;
        ;; core/smile/cbor MUST stay on the same version. jackson-databind is excluded
        ;; on purpose: cheshire uses only the streaming core + smile/cbor factories,
        ;; never ObjectMapper binding, so databind was never on the classpath — keep
        ;; it that way, it is the historically CVE-prone module.
        com.fasterxml.jackson.core/jackson-core {:mvn/version "2.22.1"}
        com.fasterxml.jackson.dataformat/jackson-dataformat-cbor
        {:exclusions [com.fasterxml.jackson.core/jackson-databind] :mvn/version "2.22.1"}
        com.fasterxml.jackson.dataformat/jackson-dataformat-smile
        {:exclusions [com.fasterxml.jackson.core/jackson-databind] :mvn/version "2.22.1"}
        ;; clj_paren_repair: parinferish IS the delimiter repair — Blockether's
        ;; pure-Java parinfer — and the gate too, since whether the delimiters balance
        ;; is asked of the engine that would fix them, one linear scan per file. The
        ;; same artifact carries `com.blockether.parinferish.balance`, the decision the
        ;; foundation asks before a repair is written back. edamame answers the other
        ;; question, and only about a repair's OUTPUT: whether it reads as Clojure,
        ;; which balanced delimiters do not promise.
        com.blockether/parinferish {:mvn/version "0.1.0"}
        borkdude/edamame {:mvn/version "1.6.42"}}
 :aliases {:test {:extra-deps {io.github.noahtheduke/lazytest {:mvn/version "2.0.0"}}
                  :extra-paths ["test"]
                  :main-opts ["-m" "lazytest.main" "test"]}}}
